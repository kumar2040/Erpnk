<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS hosting config for the NkplmErp API.

  IMPORTANT - secrets:
    * Do NOT commit real secrets here. The values below marked __SET_ON_SERVER__
      must be replaced on the production server only (this file ships as a template).
    * The API refuses to start in Production unless Jwt__Key is a strong (>=32 char)
      non-default key. Generate one on the server with:
        $rng=[System.Security.Cryptography.RandomNumberGenerator]::Create();$b=New-Object byte[] 48;$rng.GetBytes($b);[Convert]::ToBase64String($b)
    * Double underscore maps to config: Jwt__Key -> Jwt:Key,
      ConnectionStrings__DefaultConnection -> ConnectionStrings:DefaultConnection.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet"
                  arguments=".\NkplmErp.API.dll"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />

          <!-- REQUIRED: set a strong, unique key on the server (not in source control). -->
          <environmentVariable name="Jwt__Key" value="__SET_STRONG_KEY_ON_SERVER__" />

          <!-- RECOMMENDED: move the DB connection string out of appsettings.json too. -->
          <!-- <environmentVariable name="ConnectionStrings__DefaultConnection"
                                    value="__SET_CONNECTION_STRING_ON_SERVER__" /> -->
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
