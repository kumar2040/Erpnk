@inject NavigationManager Nav

<div class="ad-wrap">
    <div class="ad-card">
        <div class="ad-weave"></div>

        <div class="ad-lock">🔒</div>

        <div class="ad-code">403</div>
        <h1 class="ad-title">@Title</h1>
        <p class="ad-sub">@Message</p>

        <div class="ad-actions">
            <button class="ad-btn primary" @onclick='() => Nav.NavigateTo("/")'>
                <i class="fa-solid fa-house"></i> Back to Dashboard
            </button>
            <button class="ad-btn ghost" @onclick="GoBack">
                <i class="fa-solid fa-arrow-left"></i> Go Back
            </button>
        </div>

        <div class="ad-foot">Natural fibres · Knit · Weave · Silk &nbsp;—&nbsp; access woven by role</div>
        <div class="ad-weave bottom"></div>
    </div>
</div>

<style>
    .ad-wrap { min-height: 80vh; display: flex; align-items: center; justify-content: center; padding: 24px;
               background: #f4f6fa; font-family: 'Inter','DM Sans',sans-serif; }
    .ad-card { position: relative; width: 100%; max-width: 560px; background: #fff; border: 1px solid #e5e9f0;
               border-radius: 16px; padding: 40px 34px; text-align: center;
               box-shadow: 0 10px 40px rgba(26,51,83,.12); overflow: hidden; }

    .ad-weave { position: absolute; left: 0; right: 0; height: 6px; top: 0;
                background: repeating-linear-gradient(90deg, #1a3353 0 14px, #c0392b 14px 28px); opacity: .85; }
    .ad-weave.bottom { top: auto; bottom: 0; }

    .ad-lock { font-size: 3rem; line-height: 1; margin-bottom: 6px; filter: drop-shadow(0 4px 8px rgba(192,57,43,.30)); }

    .ad-code { font-size: 4.6rem; font-weight: 800; letter-spacing: 4px; line-height: 1;
               background: linear-gradient(135deg, #1a3353 0%, #c0392b 100%);
               -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
    .ad-title { margin: 8px 0 6px; font-size: 1.35rem; font-weight: 700; color: #1a3353; }
    .ad-sub { margin: 0 auto 22px; max-width: 440px; font-size: .9rem; line-height: 1.55; color: #5b6b80; }

    .ad-actions { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }
    .ad-btn { border: none; border-radius: 9px; cursor: pointer; font-size: .9rem; font-weight: 700;
              padding: 11px 20px; display: inline-flex; align-items: center; gap: 8px; transition: filter .15s, transform .12s; }
    .ad-btn:hover { transform: translateY(-1px); }
    .ad-btn.primary { background: linear-gradient(135deg, #2ab3b1, #1a8f8d); color: #fff; box-shadow: 0 3px 10px rgba(42,179,177,.35); }
    .ad-btn.ghost { background: #fff; color: #1a3353; border: 1px solid #d6dbe4; }
    .ad-btn.ghost:hover { background: #f3f4f6; }

    .ad-foot { margin-top: 26px; font-size: .72rem; letter-spacing: .5px; text-transform: uppercase; color: #9fb0c4; }
</style>

@code {
    [Parameter] public string Title { get; set; } = "Access Denied";
    [Parameter] public string Message { get; set; } =
        "You don’t have permission to view this page. If you need access, contact your administrator.";

    [Inject] private IJSRuntime JS { get; set; } = default!;

    private async Task GoBack()
    {
        try { await JS.InvokeVoidAsync("history.back"); }
        catch { Nav.NavigateTo("/"); }
    }
}
