@inherits LayoutComponentBase
@implements IDisposable
@using NkplmErp.Blazor.Services.Auth
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject TokenProvider TokenProvider
@inject NkplmErp.Blazor.Services.Toast.ToastService ToastService

<PageTitle> NatureKnit MIS</PageTitle>

<div class="page bg-gray-200">
    <main>
        <header class="sticky top-0 z-50 flex h-16 w-full items-center justify-between border-b border-gray-100 bg-white/80 px-6 backdrop-blur-md">
             <div class="flex items-center gap-1">
            <div class="p-2 hover:bg-gray-50 rounded-lg cursor-pointer">
                <span class="oi oi-menu text-gray-400"></span>
            </div>
            
             
            <div class="flex items-center gap-1">
                <div class="flex items-center gap-2">
                    <img src="logoon.webp" alt="Logo" class="h-10 w-10 object-contain" />
                </div>
            </div>
           </div>
            <div class="flex items-center gap-6">
                

                <!-- Date & Time -->
                <div class="hidden items-center gap-3 text-sm font-medium text-gray-600 md:flex">
                    <span>@DateTime.Now.ToString("dddd, dd MMM, yyyy")</span>
                    <span class="h-4 w-px bg-gray-300"></span>
                    
                </div>

                <!-- User Profile -->
                <AuthorizeView>
                    <Authorized>
                        <div class="flex items-center gap-3">
                        @{
                            var firstName = context.User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.GivenName)?.Value 
                                         ?? context.User.Claims.FirstOrDefault(c => c.Type == "given_name")?.Value
                                         ?? context.User.Claims.FirstOrDefault(c => c.Type.Equals("firstName", StringComparison.OrdinalIgnoreCase))?.Value
                                         ?? context.User.Identity?.Name?.Split('@')[0]
                                         ?? "User";
                        }
                <a href="/profile" class="text-right block hover:opacity-80 transition-opacity" title="View Profile">
                    <p class="text-xs font-bold text-gray-800">@firstName</p>
                    <p class="text-[10px] text-gray-400">@(context.User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value ?? "Staff")</p>
                </a>
                            <!-- Pending task gate: reopens the blocking queue -->
                            <NkplmErp.Blazor.Shared.Components.TaskGateBadge />
                            <!-- Notifications -->
                            <NkplmErp.Blazor.Shared.Components.NotificationBell />
                <div class="w-8 h-8 rounded-full bg-emerald-500 flex items-center justify-center text-white ring-2 ring-emerald-50 ring-offset-2 overflow-hidden">
                     <i class="fa-solid fa-user text-sm"></i>
                </div>
                <span class="oi oi-chevron-bottom text-[10px] text-gray-400 mr-2"></span>
                <button class="h-8 px-3 rounded-lg bg-red-50 text-red-600 hover:bg-red-100 transition-all font-black text-[10px] border border-red-100 flex items-center gap-1.5 shadow-sm group" @onclick="HandleLogout">
                    <span class="oi oi-account-logout transition-transform group-hover:translate-x-0.5" style="font-size: 10px;"></span>
                    LOGOUT
                </button>
            </div>
                         
                    </Authorized>
                    <NotAuthorized>
                         <div class="flex items-center gap-3 rounded-full bg-gray-50 py-1 pl-1 pr-4 border border-gray-100">
                            <div class="h-8 w-8 overflow-hidden rounded-full border-2 border-gray-300">
                                <img src="https://ui-avatars.com/api/?name=Guest&background=random" alt="Avatar" class="h-full w-full object-cover" />
                            </div>
                            <span class="text-sm font-semibold text-gray-700">Guest User</span>
                        </div>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </header>

        <article class="p-[5px] py-4">
            <div class="mx-auto max-w-[1600px]">
                @Body
            </div>
        </article>
    </main>
</div>

@code {
    protected override void OnInitialized()
    {
        TokenProvider.OnSessionExpired += HandleSessionExpired;
    }

    private bool _sessionExpiredHandled = false;

    private void HandleSessionExpired()
    {
        // Guard so multiple concurrent 401s don't stack toasts / redirects.
        if (_sessionExpiredHandled) return;
        _sessionExpiredHandled = true;

        // Capture the page the user is on so we can return them here after re-login.
        var current = new Uri(Navigation.Uri).PathAndQuery;
        var logoutUrl = "/auth/logout";
        if (!string.IsNullOrEmpty(current) && current != "/"
            && !current.StartsWith("/login", StringComparison.OrdinalIgnoreCase)
            && !current.StartsWith("/auth", StringComparison.OrdinalIgnoreCase))
        {
            logoutUrl += "?returnUrl=" + Uri.EscapeDataString(current);
        }

        // Invoke on the UI thread to ensure navigation works correctly from secondary threads
        InvokeAsync(async () =>
        {
            // Show the toast first, then redirect after a short pause so it's visible.
            ToastService.ShowWarning("Your session has expired. Redirecting to login...");
            StateHasChanged();
            await Task.Delay(1800);
            Navigation.NavigateTo(logoutUrl, forceLoad: true);
        });
    }

    private async Task HandleLogout()
    {
        await AuthService.Logout();
        Navigation.NavigateTo("/auth/logout", forceLoad: true);
    }

    public void Dispose()
    {
        TokenProvider.OnSessionExpired -= HandleSessionExpired;
    }
}

<NkplmErp.Blazor.Shared.Components.ToastContainer />
<NkplmErp.Blazor.Shared.Components.TaskGateModal />
<NkplmErp.Blazor.Shared.Components.LoadingOverlay />