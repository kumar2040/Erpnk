<nav class="flex-column">
    <div class="nav-section-label">Main menu</div>

    <div class="nav-item px-3">
        <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
            <span class="oi oi-home" aria-hidden="true"></span> Home
        </NavLink>
    </div>

    @* Pages with no MenuId sit flat under the section label, same as Home above. *@
    @foreach (var pg in UngroupedPages)
    {
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="@pg.PageUrl">
                @if (!string.IsNullOrWhiteSpace(pg.Icon))
                {
                    <i class="@pg.Icon" aria-hidden="true"></i>
                }
                else
                {
                    <span class="oi oi-chevron-right" aria-hidden="true"></span>
                }
                @pg.PageName
            </NavLink>
        </div>
    }

    @* Grouped pages: the group itself is a full row (icon + title + chevron), same
       treatment as a page link, collapsed by default -- click to expand its pages
       indented underneath. *@
    @foreach (var group in GroupedPages)
    {
        <div class="nav-item px-3">
            <button type="button" class="nav-link nav-group-toggle" @onclick="() => ToggleGroup(group.MenuId)" @onclick:stopPropagation="true">
                <i class="@GroupIcon(group.Pages)" aria-hidden="true"></i>
                <span class="nav-group-label">@group.MenuTitle</span>
                <span class="oi @(IsExpanded(group.MenuId) ? "oi-chevron-bottom" : "oi-chevron-right") nav-group-chev" aria-hidden="true"></span>
            </button>
        </div>
        @if (IsExpanded(group.MenuId))
        {
            <div class="nav-subgroup">
                @foreach (var pg in group.Pages)
                {
                    <div class="nav-item nav-item-sub">
                        <NavLink class="nav-link" href="@pg.PageUrl">
                            @if (!string.IsNullOrWhiteSpace(pg.Icon))
                            {
                                <i class="@pg.Icon" aria-hidden="true"></i>
                            }
                            else
                            {
                                <span class="oi oi-chevron-right" aria-hidden="true"></span>
                            }
                            @pg.PageName
                        </NavLink>
                    </div>
                }
            </div>
        }
    }

    <div class="nav-divider"></div>

    <AuthorizePermission Permission="Permissions.Invoices.View">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="fetchdata">
                <span class="oi oi-list-rich" aria-hidden="true"></span> Fetch data
            </NavLink>
        </div>
    </AuthorizePermission>
    <AuthorizeView>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="profile">
                <span class="oi oi-person" aria-hidden="true"></span> Profile
            </NavLink>
        </div>
    </AuthorizeView>
</nav>
