@using NkplmErp.Blazor.Services.Loading
@implements IDisposable
@inject LoadingService Loading

@* Same loader as PLM's components/yarn_loader.php: a wooden spinning wheel turns its bobbin while thread
   winds across. The message is read by screen readers only, exactly like PLM. *@
@if (Loading.IsVisible)
{
    <div class="yarn-loader-overlay" aria-live="polite" aria-busy="true">
        <div class="yarn-loader-card" role="status">
            <div class="yarn-loader-wheel-box" aria-hidden="true">
                <svg viewBox="0 0 180 150" role="presentation">
                    <defs>
                        <linearGradient id="ylWoodGrad" x1="0" y1="0" x2="1" y2="1">
                            <stop offset="0" stop-color="#e6bc82" />
                            <stop offset="1" stop-color="#a97a44" />
                        </linearGradient>
                        <radialGradient id="ylHubGrad">
                            <stop offset="0" stop-color="#8a6636" />
                            <stop offset="1" stop-color="#5c4324" />
                        </radialGradient>
                    </defs>

                    <rect x="20" y="120" width="140" height="7" rx="2.5" fill="url(#ylWoodGrad)" stroke="#8a6636" stroke-width="1" />

                    <g class="yarn-loader-treadle">
                        <line x1="70" y1="127" x2="76" y2="103" stroke="#a97a44" stroke-width="2.4" stroke-linecap="round" />
                        <rect x="52" y="123" width="30" height="5" rx="2" fill="#8a6636" />
                    </g>

                    <path d="M42 120 L57 66 M76 120 L61 66" stroke="url(#ylWoodGrad)" stroke-width="5" stroke-linecap="round" fill="none" stroke-opacity=".95" />
                    <path d="M110 120 L110 58 M128 120 L128 58" stroke="url(#ylWoodGrad)" stroke-width="4" stroke-linecap="round" fill="none" />
                    <line x1="106" y1="58" x2="132" y2="58" stroke="#a97a44" stroke-width="3" stroke-linecap="round" />

                    <g transform="translate(18,20)" fill="#f8ecd9" stroke="#e6d7bc" stroke-width="1">
                        <circle r="6.5" /><circle cx="7" cy="2" r="5.5" /><circle cx="-4" cy="5" r="5" /><circle cx="3" cy="8" r="4.5" />
                    </g>

                    <path class="yarn-loader-thread" d="M20 24 C 42 22, 50 45, 59 60" fill="none" stroke="#5eead4" stroke-width="1.7" stroke-linecap="round" stroke-dasharray="3 4" />
                    <path class="yarn-loader-thread" d="M100 66 C 96 78, 100 90, 119 58" fill="none" stroke="#5eead4" stroke-width="1.7" stroke-linecap="round" stroke-dasharray="3 4" />

                    <g transform="translate(59,66)">
                        <g class="yarn-loader-big-wheel">
                            <circle r="34" fill="none" stroke="url(#ylWoodGrad)" stroke-width="5" />
                            <circle r="34" fill="none" stroke="#8a6636" stroke-width="1" />
                            <g stroke="url(#ylWoodGrad)" stroke-width="3.4" stroke-linecap="round">
                                <line x1="-34" y1="0" x2="34" y2="0" />
                                <line x1="0" y1="-34" x2="0" y2="34" />
                                <line x1="-24" y1="-24" x2="24" y2="24" />
                                <line x1="-24" y1="24" x2="24" y2="-24" />
                                <line x1="-13" y1="-32" x2="13" y2="32" />
                                <line x1="13" y1="-32" x2="-13" y2="32" />
                            </g>
                            <circle r="13" fill="none" stroke="#5eead4" stroke-width="1.6" stroke-dasharray="4 3" opacity=".85" />
                            <circle r="7" fill="url(#ylHubGrad)" />
                            <circle cx="-1.5" cy="-1.5" r="1.6" fill="#d8bd8f" opacity=".7" />
                        </g>
                    </g>

                    <path d="M89 50 Q100 56 106 60 M89 82 Q100 68 106 58" fill="none" stroke="#5eead4" stroke-width="1.6" opacity=".55" stroke-linecap="round" />

                    <g transform="translate(119,58)">
                        <g class="yarn-loader-bobbin">
                            <path d="M-16 -10 Q-20 0 -16 10 M16 -10 Q20 0 16 10" fill="none" stroke="url(#ylWoodGrad)" stroke-width="2.6" stroke-linecap="round" />
                            <circle r="10" fill="none" stroke="#00b8d0" stroke-width="3" />
                            <ellipse rx="6.6" ry="9.3" fill="none" stroke="#5eead4" stroke-width="1" opacity=".75" />
                            <ellipse rx="4" ry="8" fill="none" stroke="#5eead4" stroke-width="1" opacity=".55" />
                            <line x1="-10" y1="0" x2="10" y2="0" stroke="#00b8d0" stroke-width="2" />
                        </g>
                        <circle r="2.4" fill="#5eead4" />
                    </g>
                </svg>
            </div>
            <p class="yarn-loader-caption">@(Loading.Message ?? "Loading…")</p>
        </div>
    </div>
}

<style>
    /* z-index 9998: one below ToastContainer's 9999, so an error toast from a failed load sits above the
       veil; the ConfirmHost (10000) sits above both. */
    .yarn-loader-overlay { position:fixed; inset:0; z-index:9998; display:flex; align-items:center; justify-content:center; padding:1rem; background:rgba(4,18,32,.66); backdrop-filter:blur(5px); animation:yarn-loader-fade .2s ease both; }
    .yarn-loader-card { width:min(100%,15.5rem); padding:0; border:0; border-radius:.85rem; background:transparent; box-shadow:none; animation:yarn-loader-rise .24s cubic-bezier(.2,.8,.2,1) both; }
    .yarn-loader-wheel-box { height:9.5rem; display:flex; align-items:center; justify-content:center; }
    .yarn-loader-wheel-box svg { width:10.5rem; height:auto; filter:drop-shadow(0 6px 14px rgba(4,18,32,.45)); }
    .yarn-loader-big-wheel { transform-box:fill-box; transform-origin:center; animation:yarn-loader-spin 2.6s linear infinite; }
    .yarn-loader-bobbin { transform-box:fill-box; transform-origin:center; animation:yarn-loader-spin .6s linear infinite; }
    .yarn-loader-thread { animation:yarn-loader-thread-flow .8s linear infinite; }
    .yarn-loader-treadle { transform-box:fill-box; transform-origin:bottom center; animation:yarn-loader-rock 1.3s ease-in-out infinite; }
    .yarn-loader-caption { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0; }
    @@keyframes yarn-loader-fade { from { opacity:0; } to { opacity:1; } }
    @@keyframes yarn-loader-rise { from { transform:translateY(-.75rem) scale(.98); } to { transform:translateY(0) scale(1); } }
    @@keyframes yarn-loader-spin { to { transform:rotate(360deg); } }
    @@keyframes yarn-loader-thread-flow { to { stroke-dashoffset:-14; } }
    @@keyframes yarn-loader-rock { 0%,100% { transform:rotate(-4deg); } 50% { transform:rotate(4deg); } }
    @@media (prefers-reduced-motion:reduce) { .yarn-loader-big-wheel,.yarn-loader-bobbin,.yarn-loader-thread,.yarn-loader-treadle { animation:none; } }
</style>

@code {
    protected override void OnInitialized() => Loading.OnChange += HandleChange;

    // InvokeAsync because Show/Hide can be called from a non-render thread, same as
    // ToastContainer does for its own event.
    private async void HandleChange() => await InvokeAsync(StateHasChanged);

    public void Dispose() => Loading.OnChange -= HandleChange;
}
