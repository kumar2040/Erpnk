@using NkplmErp.Blazor.Services.Auth
@inject TokenProvider TokenProvider

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    @if (context.User.Identity?.IsAuthenticated != true)
                    {
                        <RedirectToLogin />
                    }
                    else
                    {
                        <AccessDenied403 />
                    }
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>Page not found — NKPLM Pashmina ERP</PageTitle>
            <LayoutView Layout="@typeof(MainLayout)">
                <NotFound404 />
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>

@code {
    [Parameter] public string? InitialToken { get; set; }

    protected override void OnInitialized()
    {
        Console.WriteLine(">>>> [DEBUG] App.razor Initializing...");
        try
        {
            if (!string.IsNullOrEmpty(InitialToken))
            {
                // Fresh page load: apply the token from the HTTP cookie.
                TokenProvider.Token = InitialToken;
                Console.WriteLine(">>>> [DEBUG] InitialToken applied to TokenProvider.");
            }
            else if (!string.IsNullOrEmpty(TokenProvider.Token))
            {
                // Circuit reconnect after idle: InitialToken is null (no HTTP request).
                // Do NOT wipe the existing in-memory token — keep it alive.
                Console.WriteLine(">>>> [DEBUG] Circuit reconnect detected. Preserving existing TokenProvider token.");
            }
            else
            {
                Console.WriteLine(">>>> [DEBUG] No token available (InitialToken null and TokenProvider empty).");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($">>>> [DEBUG] CRITICAL ERROR in App.razor: {ex.Message}");
        }
    }
}
