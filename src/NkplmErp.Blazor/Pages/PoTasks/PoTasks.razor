@page "/tasks"
@attribute [Authorize]
@using NkplmErp.Shared.DTOs
@using NkplmErp.Blazor.Shared
@using Microsoft.AspNetCore.Components.Forms

@if (AccessDenied)
{
    <AccessDenied403 Message="You don’t have permission to view Tasks. If you need access, contact your administrator." />
}
else
{
<div class="main-body">
    <div class="page-header-container">
        <div class="header-row">
            <div class="page-title-section">
                <h1 class="page-title">Tasks</h1>
            </div>

            <div class="compact-filters">
                @* Reusable date-range picker. The page owns the window (selectedStartDate/
                   selectedEndDate via @bind) and reloads the board on OnChanged. Starts on
                   "All Dates" so the board opens unfiltered, as it always has. *@
                <div class="filter-item">
                    <CompactDateRangeFilter @bind-StartDate="selectedStartDate"
                                            @bind-EndDate="selectedEndDate"
                                            InitialPreset="all"
                                            ShowLabel="false"
                                            OnChanged="OnFilterChanged" />
                </div>

                <div class="filter-item">
                    <div class="seg">
                        <button class="seg-btn @(MineOnly ? "" : "on")" @onclick="() => SetScope(false)">All</button>
                        <button class="seg-btn @(MineOnly ? "on" : "")" @onclick="() => SetScope(true)">My tasks</button>
                    </div>
                </div>

                <div class="filter-item">
                    <input type="text" class="compact-search" placeholder="Search Order No"
                           value="@orderNo" @onchange="OnOrderNoChanged" />
                </div>

                @* Facility filter — one dropdown, always shown, in both All and My tasks.
                   It always offers "All Factories"; when the scope call returns nothing that
                   is the only option, so the control still renders rather than vanishing.
                   A gauge-restricted user's list holds only their own factory, and the SP
                   pins them to it regardless of what's sent, so a single control is safe
                   for everyone. *@
                <div class="filter-item">
                    <select class="compact-select" value="@(selectedFactoryType ?? "")"
                            @onchange="OnFactoryTypeChanged" style="height:34px" title="Filter by facility">
                        <option value="">All Factories</option>
                        @foreach (var ft in FactoryOptions)
                        {
                            <option value="@ft">@ft</option>
                        }
                    </select>
                </div>

                @if (CanEdit)
                {
                    <div class="filter-item">
                        <button type="button" class="add-btn" @onclick="OpenAdd">
                            <span>+ Add task</span>
                        </button>
                    </div>
                }
            </div>
        </div>

        @* Stat cards double as the board filter (like /task's ShowBubble): click one to
           show only that status, click Work Load for the grouped view. Status cards come
           from BoardColumns; Work Load is a view control, injected after On Hold. *@
        <div class="stats-grid">
            @foreach (var col in BoardColumns)
            {
                <div class="stat-card stat-@col.Id.ToLowerInvariant() @(activeView == col.Id ? "active" : "")"
                     @onclick="() => ShowView(col.Id)">
                    <div class="stat-content"><div class="stat-label">@col.Value</div><div class="stat-value">@Count(col.Id)</div></div>
                </div>
                @if (col.Id == "H")
                {
                    <div class="stat-card stat-workload @(activeView == WorkloadView ? "active" : "")"
                         @onclick="() => ShowView(WorkloadView)">
                        <div class="stat-content"><div class="stat-label">Work Load</div><div class="stat-value">@Workload</div></div>
                    </div>
                }
            }
        </div>
    </div>

    @* Columns come from spDropdown (PoTaskBoardColumn): Id is the status flag, Value the
       title, CSS class derived from the flag (col-s / col-p / …). VisibleColumns is the
       workflow group or the one selected status; a single selection flows its cards into
       a grid and drops the column header (the lit stat card already names it). *@
    <div class="board-row cols-@VisibleColumns.Count()">
        @foreach (var col in VisibleColumns)
        {
            <div class="board-col col-@col.Id.ToLowerInvariant() @(SingleView ? "flow" : "")">
                @if (!SingleView)
                {
                    <div class="col-head"><span class="dot"></span> @col.Value <span class="cnt">@Count(col.Id)</span></div>
                }
                @if (loading)
                {
                    <div class="col-empty">Loading…</div>
                }
                else if (Cards(col.Id).Count == 0)
                {
                    <div class="col-empty">—</div>
                }
                else
                {
                    @foreach (var card in Cards(col.Id))
                    {
                        <div class="tcard" @onclick="() => OpenDetail(card.TaskId)">
                            @if (!string.IsNullOrWhiteSpace(card.LinkUrl))
                            {
                                @* The procedure built a URL for this stage, so the name routes
                                   straight there. The board knows no routes — every one lives in
                                   sp_GetPoTask. stopPropagation so the card's status drawer stays shut. *@
                                <div class="tcard-title tcard-title-link" title="Open @card.StageName"
                                     @onclick="() => GoToUrl(card.LinkUrl!)" @onclick:stopPropagation="true">
                                    @(string.IsNullOrWhiteSpace(card.Title) ? "(untitled)" : card.Title)
                                </div>
                            }
                            else if (col.Id == "P" && !string.IsNullOrWhiteSpace(card.OrderNo))
                            {
                                @* In Progress column ONLY: the name links to the return-detail modal
                                   (issued/returned/return-pace only make sense once knitting is under
                                   way). stopPropagation so the card's own status drawer doesn't open. *@
                                <div class="tcard-title tcard-title-link" title="View order @card.OrderNo"
                                     @onclick="() => OpenOrderView(card)" @onclick:stopPropagation="true">
                                    @(string.IsNullOrWhiteSpace(card.Title) ? "(untitled)" : card.Title)
                                </div>
                            }
                            else
                            {
                                <div class="tcard-title">@(string.IsNullOrWhiteSpace(card.Title) ? "(untitled)" : card.Title)</div>
                            }
                            <div class="tcard-meta">
                                <span>@card.StageName</span>
                                @if (!string.IsNullOrWhiteSpace(card.OrderNo)) { <span>· PO @card.OrderNo</span> }
                                @if (card.DueDate is not null) { <span>· due @card.DueDate.Value.ToString("dd MMM")</span> }
                            </div>
                            <div class="tcard-foot">
                                <span class="people">
                                    @if (card.AssigneeTotal > 0)
                                    {
                                        <span class="rollup">@card.AssigneeDone/@card.AssigneeTotal</span>
                                    }
                                </span>
                                @if (card.PriorityName is not null)
                                {
                                    <span class="prio p-@card.PriorityId">@card.PriorityName</span>
                                }
                            </div>

                            @if (MineOnly && card.MyStatus is not null)
                            {
                                <div class="my-step" @onclick:stopPropagation="true">
                                    @* Steps come from spDropdown 'TaskAssigneeStatus'; the Id is the
                                       S/P/C code MyUpdate sends to the API, unchanged. *@
                                    @foreach (var s in AssigneeStatuses)
                                    {
                                        <button class="step @(card.MyStatus == s.Id ? "on" : "")"
                                                @onclick="() => MyUpdate(card.TaskId, s.Id)">@s.Value</button>
                                    }
                                </div>
                            }
                        </div>
                    }
                }
            </div>
        }
    </div>
</div>

@* ---------------------------------------------------------------- Add Task modal *@
@if (showAdd)
{
    <div class="modal-backdrop-tm" @onclick="CloseAdd">
        <div class="modal-card" @onclick:stopPropagation="true">
            <div class="modal-head">
                <h3>Add task</h3>
                <button class="modal-x" @onclick="CloseAdd"><span>✕</span></button>
            </div>
            <div class="modal-body addform">
                <div class="frow">
                    <label class="flbl">Task Name</label>
                    <input type="text" @bind="newTask.Title" placeholder="Task Name" />
                </div>

                <div class="frow">
                    <label class="flbl">Task Start Date</label>
                    <div class="fpair">
                        <DatePicker @bind-Value="newTask.StartDate" Placeholder="Start date" />
                        <label class="flbl inline">Task End Date</label>
                        <DatePicker @bind-Value="newTask.DueDate" Placeholder="End date" MinDate="newTask.StartDate" />
                    </div>
                </div>

                <div class="frow">
                    <label class="flbl">Priority</label>
                    <AutoCompleteSelect Type="TaskPriority" All="0" Placeholder="Select"
                                        CssClass="ac-fullwidth" @bind-Value="PriorityIdStr" />
                </div>

                <div class="frow">
                    <label class="flbl">Task Description</label>
                    <div class="fwithbtn">
                        <input type="text" @bind="newChecklistText" placeholder="Add Task Description"
                               @onkeydown="@(e => { if (e.Key == "Enter") AddChecklistLine(); })" />
                        <button type="button" class="plus-btn" title="Add line" @onclick="AddChecklistLine">+</button>
                    </div>
                </div>
                @if (newTask.ChecklistItems.Count > 0)
                {
                    <div class="frow">
                        <span class="flbl"></span>
                        <div class="chk-items">
                            @foreach (var it in newTask.ChecklistItems)
                            {
                                <span class="chk-chip">@it <span class="x" @onclick="@(() => RemoveChecklistLine(it))">✕</span></span>
                            }
                        </div>
                    </div>
                }

                <div class="frow">
                    <label class="flbl">Notification Date</label>
                    <DatePicker @bind-Value="newTask.NotificationDate" Placeholder="Notification date" />
                </div>

                <div class="frow">
                    <label class="flbl">Progress Update</label>
                    <AutoCompleteSelect Type="TaskUpdateFrequency" All="0" Placeholder="Select Update Frequency"
                                        CssClass="ac-fullwidth" @bind-Value="UpdateFrequencyStr" />
                </div>

                <div class="fsection">Task Assigned To</div>
                <div class="frow">
                    <div class="radio-row">
                        <label><input type="radio" name="assign" checked="@(!assignGroup)" @onchange="() => assignGroup = false" /> Individual Staff</label>
                        <label><input type="radio" name="assign" checked="@assignGroup" @onchange="() => assignGroup = true" /> Group</label>
                    </div>
                </div>

                @if (assignGroup)
                {
                    <div class="frow">
                        <label class="flbl">Group</label>
                        <select @bind="selectedGroupId">
                            <option value="0">Select group…</option>
                            @foreach (var g in groups)
                            {
                                <option value="@g.GroupId">@g.GroupName (@g.MemberCount)</option>
                            }
                        </select>
                    </div>
                }
                else
                {
                    <div class="frow">
                        <label class="flbl">Staff</label>
                        <select value="@staffPick" @onchange="AddStaff">
                            <option value="">Add staff…</option>
                            @foreach (var s in staff.Where(s => !selectedStaff.Contains(s.UserId)))
                            {
                                <option value="@s.UserId">@(string.IsNullOrWhiteSpace(s.FullName) ? s.Email : s.FullName)</option>
                            }
                        </select>
                    </div>
                    @if (selectedStaff.Count > 0)
                    {
                        <div class="frow">
                            <span class="flbl"></span>
                            <div class="chk-items">
                                @foreach (var id in selectedStaff)
                                {
                                    <span class="staff-chip">@StaffName(id) <span class="x" @onclick="@(() => RemoveStaff(id))">✕</span></span>
                                }
                            </div>
                        </div>
                    }
                    @if (selectedStaff.Count > 1)
                    {
                        <div class="frow">
                            <label class="flbl">Completion rule</label>
                            <AutoCompleteSelect Type="TaskCompletionRule" All="0"
                                                CssClass="ac-fullwidth" @bind-Value="CompletionRuleStr" />
                        </div>
                    }
                }

                <div class="fsection">Upload Documents <span class="lt1">(less than 1MB)</span></div>
                <div class="dropzone @(isDragging ? "drag" : "")"
                     @ondragenter="() => isDragging = true"
                     @ondragleave="() => isDragging = false"
                     @ondragover:preventDefault="true">
                    <InputFile OnChange="OnFileSelected" class="dz-input" />
                    <div class="dz-inner">
                        <span class="dz-ic">⬆</span>
                        @if (string.IsNullOrEmpty(attachmentName))
                        {
                            <span class="dz-text">Drag &amp; drop a file here, or <b>click to browse</b></span>
                        }
                        else
                        {
                            <span class="dz-file">@attachmentName</span>
                        }
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(addError))
                {
                    <div class="err">@addError</div>
                }

                <div class="modal-actions">
                    <button class="save-btn" disabled="@saving" @onclick="SaveAsync">
                        @(saving ? "Saving…" : "Save Task")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ---------------------------------------------------------------- Detail drawer *@
@if (showDetail && detail?.Task is not null)
{
    <div class="modal-backdrop-tm" @onclick="CloseDetail">
        <div class="modal-card" @onclick:stopPropagation="true">
            <div class="modal-head">
                <h3>@detail.Task.Title <span class="muted">· @detail.Task.StageName</span></h3>
                <button class="modal-x" @onclick="CloseDetail"><span>✕</span></button>
            </div>
            <div class="modal-body">
                <div class="detail-meta">
                    @if (!string.IsNullOrWhiteSpace(detail.Task.OrderNo)) { <span class="chip">PO @detail.Task.OrderNo</span> }
                    <span class="chip">@detail.Task.StatusName</span>
                    @if (detail.Task.PriorityName is not null) { <span class="chip">@detail.Task.PriorityName</span> }
                    @if (detail.Task.DueDate is not null) { <span class="chip">Due @detail.Task.DueDate.Value.ToString("yyyy-MM-dd")</span> }
                </div>

                @if (!string.IsNullOrWhiteSpace(detail.Task.Detail))
                {
                    <p class="detail-text">@detail.Task.Detail</p>
                }

                <div class="detail-section">Assignees (rolls up: @RuleName(detail.Task.CompletionRule))</div>
                @if (detail.Assignees.Count == 0)
                {
                    <div class="muted">No assignees — single-owner task.</div>
                }
                else
                {
                    <div class="assignee-list">
                        @foreach (var a in detail.Assignees)
                        {
                            <div class="assignee-row">
                                <span class="a-name">@(string.IsNullOrWhiteSpace(a.UserName) ? a.UserId : a.UserName)</span>
                                <span class="a-status s-@a.Status">@StatusName(a.Status)</span>
                            </div>
                        }
                    </div>
                }

                @if (detail.Checklist.Count > 0)
                {
                    <div class="detail-section">Checklist</div>
                    @foreach (var c in detail.Checklist)
                    {
                        <label class="check-row">
                            <input type="checkbox" checked="@c.IsDone" @onchange="() => ToggleChecklist(c.ChecklistId)" />
                            <span class="@(c.IsDone ? "done" : "")">@c.Text</span>
                        </label>
                    }
                }

                @if (CanEdit)
                {
                    <div class="modal-actions wrap">
                        <button class="mini-btn b-prog" @onclick='() => OverrideAsync("P")'>Mark in progress</button>
                        <button class="mini-btn b-done" @onclick='() => OverrideAsync("C")'>Mark complete</button>
                        @if (detail.Task.Status == "H")
                        {
                            <button class="mini-btn b-resolve" @onclick="ResolveAsync">Resolve hold</button>
                        }
                        else
                        {
                            <button class="mini-btn b-hold" @onclick="HoldAsync">Hold</button>
                        }
                        <button class="mini-btn b-cancel" @onclick="CancelAsync">Cancel</button>
                    </div>
                }
            </div>
        </div>
    </div>
}

@* -------------------------------------------------------------- Order modal *@
@* Opened by clicking a card's PO name (separate from the task/status drawer above).
   The full return-detail panel for the task's linked knitter line: buyer + Issued/
   Returned/Order Qty/Machines, the Actual-vs-Expected return-pace chart, and the
   Styles & Colors table. Data: spTaskManagement KH (summary) + KD (chart) + KS (styles). *@
<PanelModal IsVisible="showOrderView"
            Title="@($"Order {orderViewNo}")"
            Icon="fa-solid fa-clipboard-list"
            MaxWidth="860px"
            OnClose="CloseOrderView">
    @if (orderViewLoading)
    {
        <div class="ov-loading">Loading order…</div>
    }
    else if (!orderHasLine || orderSummary is null)
    {
        <div class="ov-empty-state">
            <i class="fa-solid fa-diagram-project"></i>
            <div class="ov-empty-title">No production line linked</div>
            <div class="ov-empty-sub">This task isn’t tied to a knitting line, so there’s no buyer / issue / return detail to show.</div>
        </div>
    }
    else
    {
        <div class="om-grid">
            @* Left: summary *@
            <div class="om-info">
                @if (!string.IsNullOrWhiteSpace(orderSummary.CustomerName) || !string.IsNullOrWhiteSpace(orderSummary.CustomerCode))
                {
                    <div class="om-eyebrow">Buyer</div>
                    <div class="om-customer">@(!string.IsNullOrWhiteSpace(orderSummary.CustomerName) ? orderSummary.CustomerName : orderSummary.CustomerCode)</div>
                }
                <div class="om-meta">
                    <span>PO @orderViewNo</span>
                    @if (orderSummary.StartDate is not null)
                    {
                        <span class="om-dot">•</span>
                        <span>@orderSummary.StartDate.Value.ToString("dd MMM")@(orderSummary.EndDate is not null ? $" – {orderSummary.EndDate.Value:dd MMM, yyyy}" : "")</span>
                    }
                </div>

                <div class="om-stats">
                    <div class="om-stat om-stat-blue">
                        <div class="om-stat-label">Issued</div>
                        <div class="om-stat-value">@(orderSummary.Issue ?? 0)</div>
                    </div>
                    <div class="om-stat om-stat-teal">
                        <div class="om-stat-label">Returned</div>
                        <div class="om-stat-value">@(orderSummary.ReturnQty ?? 0)<span class="om-stat-sub"> / @(orderSummary.Issue ?? 0)</span></div>
                        <div class="om-bar"><span style="width:@(OrderReturnPct)%"></span></div>
                    </div>
                    <div class="om-stat">
                        <div class="om-stat-label">Order Qty</div>
                        <div class="om-stat-value">@(orderSummary.Qty?.ToString() ?? "—")</div>
                    </div>
                    <div class="om-stat">
                        <div class="om-stat-label">Machines</div>
                        <div class="om-stat-value">@(orderSummary.MachineCount?.ToString() ?? "—")</div>
                    </div>
                </div>
            </div>

            @* Right: return-pace chart *@
            <div class="om-chart">
                <div class="om-chart-legend">
                    <span class="ocl-item"><span class="ocl-swatch" style="background:#185FA5"></span>Actual</span>
                    <span class="ocl-item"><span class="ocl-swatch ocl-dash"></span>Expected</span>
                </div>
                <div class="om-chart-canvas">
                    @* Always render the pace chart. With zero issued / no returns the
                       component still draws its axes and a flat baseline — an empty
                       skeleton — instead of a blank "nothing yet" panel. chartStart/
                       chartEnd fall back to the task's planned window (then today) when
                       the line itself carries no dates, so the X axis is always valid. *@
                    <ReturnPaceChart Start="chartStart"
                                     End="chartEnd"
                                     Issue="@(orderSummary.Issue ?? 0)"
                                     Points="returnPoints"
                                     Width="470" Height="210"
                                     PadLeft="44" PadRight="18" PadTop="14" PadBottom="38" />
                </div>
            </div>
        </div>

        <div class="om-items">
            <div class="om-items-title">Styles &amp; Colors</div>
            <div class="om-items-scroll">
                <table class="om-items-table">
                    <thead>
                        <tr><th>SN</th><th>Styles</th><th>Colors</th><th>Size</th><th>Qty</th></tr>
                    </thead>
                    <tbody>
                        @if (orderStyles.Count == 0)
                        {
                            <tr><td colspan="5" class="om-empty-cell">No styles for this line.</td></tr>
                        }
                        else
                        {
                            @for (var i = 0; i < orderStyles.Count; i++)
                            {
                                var s = orderStyles[i];
                                <tr>
                                    <td>@(i + 1)</td>
                                    <td class="om-style">@s.StyleNo</td>
                                    <td>@s.Color</td>
                                    <td>@s.Size</td>
                                    <td class="om-qty">@s.Qty.ToString("0.##")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</PanelModal>
}
