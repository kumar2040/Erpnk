@page "/profile"
@using NkplmErp.Blazor.Services.Auth
@using NkplmErp.Shared.DTOs
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IAuthService AuthService
@inject NavigationManager NavigationManager

<div class="profile-container">
    <div class="profile-card">
        <div class="profile-header">
            <div class="avatar-circle">
                <i class="bi bi-person-fill"></i>
            </div>
            <h2>Account Security</h2>
            <p>Manage your multi-factor authentication and security settings.</p>
        </div>

        <div class="security-section">
            <div class="section-item">
                <div class="item-info">
                    <h4>Multi-Factor Authentication (MFA)</h4>
                    <p>Add an extra layer of security to your account using an authenticator app.</p>
                </div>
                <div class="item-action">
                    @if (mfaSetup?.IsMfaEnabled == true)
                    {
                            <span class="status-badge success">Enabled</span>
                        @* Disable button could go here *@
                    }
                    else if (!isSettingUpMfa)
                    {
                            <button class="btn-setup" @onclick="StartMfaSetup">Set Up MFA</button>
                    }
                </div>
            </div>

            @if (isSettingUpMfa && mfaSetup != null)
            {
                    <div class="mfa-setup-flow">
                        <div class="step">
                            <h5>Step 1: Scan QR Code</h5>
                            <p>Scan this QR code with your Google Authenticator or Microsoft Authenticator app.</p>
                            <div class="qr-container">
                            @if (!string.IsNullOrEmpty(mfaSetup.AuthenticatorUri))
                            {
                                        <img src="@($"https://api.qrserver.com/v1/create-qr-code/?size=200x200&data={Uri.EscapeDataString(mfaSetup.AuthenticatorUri)}")" alt="MFA QR Code" />
                            }
                            </div>
                            <div class="manual-key">
                                <label>Manual Entry Key:</label>
                                <code>@mfaSetup.SharedKey</code>
                            </div>
                        </div>

                        <div class="step">
                            <h5>Step 2: Verify Code</h5>
                            <p>Enter the 6-digit code generated by your app to confirm setup.</p>
                            <div class="form-group">
                                <input @bind="verificationCode" class="form-control mfa-input" placeholder="000000" maxlength="6" />
                            </div>
                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                                    <div class="error-message">@errorMessage</div>
                        }
                            <div class="action-buttons">
                                <button class="btn-cancel" @onclick="() => isSettingUpMfa = false">Cancel</button>
                                <button class="btn-confirm" @onclick="ConfirmMfa" disabled="@isSubmitting">
                                @(isSubmitting ? "Verifying..." : "Confirm & Enable")
                                </button>
                            </div>
                        </div>
                    </div>
            }
            @* MFA Section Content ... *@
        </div>

        <div class="security-section" style="margin-top: 2rem;">
            <div class="section-item">
                <div class="item-info">
                    <h4>Biometric Authentication (Face Unlock)</h4>
                    <p>Log in securely using your device's biometric sensors (FaceID, TouchID, etc.).</p>
                </div>
                <div class="item-action">
                    <button class="btn-setup" @onclick="RegisterBiometric">Add Device</button>
                </div>
            </div>
            @if (!string.IsNullOrEmpty(biometricMessage))
            {
                    <div class="@(biometricSuccess ? "status-message success" : "error-message")" style="margin-top: 1rem;">
                    @biometricMessage
                    </div>
            }
        </div>
    </div>
</div>

<style>
    .profile-container {
        padding: 2rem;
        display: flex;
        justify-content: center;
        background: transparent;
        font-family: 'Inter', sans-serif;
    }

    .profile-card {
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        padding: 3rem;
        border-radius: 2rem;
        width: 100%;
        max-width: 800px;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
    }

    .profile-header {
        text-align: center;
        margin-bottom: 3rem;
    }

    .avatar-circle {
        width: 80px;
        height: 80px;
        background: linear-gradient(135deg, #38bdf8 0%, #0ea5e9 100%);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1.5rem;
        font-size: 2.5rem;
        color: white;
        box-shadow: 0 10px 20px rgba(56, 189, 248, 0.3);
    }

    .profile-header h2 {
        color: white;
        font-weight: 800;
        margin-bottom: 0.5rem;
    }

    .profile-header p {
        color: #94a3b8;
    }

    .security-section {
        background: rgba(255, 255, 255, 0.03);
        border-radius: 1.5rem;
        padding: 2rem;
        border: 1px solid rgba(255, 255, 255, 0.05);
    }

    .section-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .item-info h4 {
        color: #f8fafc;
        margin-bottom: 0.25rem;
    }

    .item-info p {
        color: #64748b;
        font-size: 0.875rem;
    }

    .status-badge {
        padding: 0.5rem 1rem;
        border-radius: 9999px;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
    }

    .status-badge.success {
        background: rgba(34, 197, 94, 0.1);
        color: #4ade80;
        border: 1px solid rgba(34, 197, 94, 0.2);
    }

    .btn-setup {
        background: #38bdf8;
        color: white;
        border: none;
        padding: 0.75rem 1.5rem;
        border-radius: 0.75rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
    }

    .btn-setup:hover {
        background: #0ea5e9;
        transform: translateY(-2px);
    }

    .mfa-setup-flow {
        margin-top: 2.5rem;
        padding-top: 2.5rem;
        border-top: 1px solid rgba(255, 255, 255, 0.1);
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 3rem;
    }

    .step h5 {
        color: #38bdf8;
        margin-bottom: 1rem;
        font-weight: 700;
    }

    .step p {
        color: #cbd5e1;
        font-size: 0.875rem;
        line-height: 1.6;
        margin-bottom: 1.5rem;
    }

    .qr-container {
        background: white;
        padding: 1rem;
        border-radius: 1rem;
        display: inline-block;
        margin-bottom: 1.5rem;
    }

    .manual-key {
        font-size: 0.75rem;
        color: #94a3b8;
    }

    .manual-key code {
        display: block;
        margin-top: 0.25rem;
        color: #f1f5f9;
        font-size: 0.9rem;
        letter-spacing: 0.05em;
    }

    .form-control {
        width: 100%;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        padding: 0.75rem;
        border-radius: 0.75rem;
        color: white;
        font-size: 1.25rem;
        text-align: center;
        letter-spacing: 0.2rem;
    }

    .action-buttons {
        display: flex;
        gap: 1rem;
        margin-top: 2rem;
    }

    .btn-confirm {
        flex: 2;
        background: #22c55e;
        color: white;
        border: none;
        padding: 0.75rem;
        border-radius: 0.75rem;
        font-weight: 600;
        cursor: pointer;
    }

    .btn-cancel {
        flex: 1;
        background: rgba(255, 255, 255, 0.05);
        color: #94a3b8;
        border: 1px solid rgba(255, 255, 255, 0.1);
        padding: 0.75rem;
        border-radius: 0.75rem;
        cursor: pointer;
    }

    .error-message {
        color: #f87171;
        font-size: 0.825rem;
        margin-top: 1rem;
    }

    .status-message.success {
        color: #4ade80;
        font-size: 0.875rem;
    }
</style>

@code {
    private MfaSetupResponse? mfaSetup;
    private bool isSettingUpMfa;
    private string verificationCode = "";
    private string? errorMessage;
    private bool isSubmitting;
    private string? biometricMessage;
    private bool biometricSuccess;

    protected override async Task OnInitializedAsync()
    {
        mfaSetup = await AuthService.GetMfaSetup();
    }

    private async Task StartMfaSetup()
    {
        isSettingUpMfa = true;
        errorMessage = null;
        await Task.CompletedTask;
    }

    private async Task ConfirmMfa()
    {
        if (string.IsNullOrWhiteSpace(verificationCode) || verificationCode.Length < 6)
        {
            errorMessage = "Please enter a valid 6-digit code.";
            return;
        }

        isSubmitting = true;
        errorMessage = null;

        try
        {
            var result = await AuthService.ConfirmMfa(verificationCode);
            if (result.IsSuccess)
            {
                mfaSetup = await AuthService.GetMfaSetup();
                isSettingUpMfa = false;
                verificationCode = "";
            }
            else
            {
                errorMessage = result.Message;
            }
        }
        catch (Exception)
        {
            errorMessage = "An error occurred during verification.";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task RegisterBiometric()
    {
        biometricMessage = "Initializing biometric registration...";
        biometricSuccess = false;

        try
        {
            var deviceName = $"{Environment.OSVersion.Platform} Browser";
            var result = await AuthService.RegisterBiometric(deviceName);

            if (result.IsSuccess)
            {
                biometricSuccess = true;
                biometricMessage = "Biometric device registered successfully!";
            }
            else
            {
                biometricMessage = result.Message;
            }
        }
        catch (Exception ex)
        {
            biometricMessage = $"Registration failed: {ex.Message}";
        }
    }
}
