@page "/profile"
@using NkplmErp.Blazor.Services.Auth
@using NkplmErp.Shared.DTOs
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IAuthService AuthService
@inject NavigationManager NavigationManager

<div class="profile-page bg-[#f8fafc] min-h-screen p-6 font-sans">
    <div class="max-w-4xl mx-auto">
        <!-- Main Card: Account Security -->
        <div class="bg-white shadow-md border border-slate-200 overflow-hidden mb-6">
            <div class="card-header-compact">
                <h3 class="card-title-compact">
                    <i class="fa-solid fa-shield-halved text-indigo-500"></i>
                    <span>Account Security</span>
                </h3>
            </div>
            
            <div class="p-6">
                <!-- MFA Section -->
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-6 border-b border-slate-100">
                    <div class="flex-1">
                        <h4 class="text-sm font-black text-slate-800 uppercase tracking-tight mb-1">Multi-Factor Authentication (MFA)</h4>
                        <p class="text-xs font-bold text-slate-400">Protect your account with an extra layer of security using an authenticator app.</p>
                    </div>
                    <div class="shrink-0 flex items-center gap-3">
                        @if (mfaSetup?.IsMfaEnabled == true)
                        {
                            <div class="flex items-center gap-3">
                                <span class="px-3 py-1 bg-emerald-50 text-emerald-600 border border-emerald-100 rounded-none text-[10px] font-black uppercase tracking-widest">
                                    <i class="fa-solid fa-check-circle mr-1"></i> Enabled
                                </span>
                                <button class="px-3 py-1 bg-rose-50 text-rose-600 border border-rose-100 rounded-none text-[10px] font-black uppercase tracking-widest hover:bg-rose-600 hover:text-white transition-all shadow-sm" 
                                        @onclick="DisableMfa" disabled="@isSubmitting">
                                    @(isSubmitting ? "Disabling..." : "Disable")
                                </button>
                            </div>
                        }
                        else if (!isSettingUpMfa)
                        {
                            <button class="px-5 py-2 bg-[#002d54] text-white text-[11px] font-black uppercase tracking-widest hover:bg-slate-800 transition-all shadow-sm" 
                                    @onclick="StartMfaSetup">
                                Set Up MFA
                            </button>
                        }
                    </div>
                </div>

                @if (isSettingUpMfa && mfaSetup != null)
                {
                    <div class="mt-8 bg-slate-50 border border-slate-200 p-6 animate-in fade-in slide-in-from-top-4 duration-500">
                        <h4 class="text-xs font-black text-indigo-600 uppercase tracking-widest mb-6 flex items-center gap-2">
                            <span class="w-6 h-6 bg-indigo-600 text-white rounded-full flex items-center justify-center text-[10px]">1</span>
                            Configure Authenticator App
                        </h4>
                        
                        <div class="grid grid-cols-1 md:grid-cols-[200px_1fr] gap-8">
                            <div class="flex flex-col items-center gap-3">
                                <div class="bg-white p-3 border border-slate-200 shadow-sm">
                                    @if (!string.IsNullOrEmpty(mfaSetup.AuthenticatorUri))
                                    {
                                        <img src="@($"https://api.qrserver.com/v1/create-qr-code/?size=160x160&data={Uri.EscapeDataString(mfaSetup.AuthenticatorUri)}")" 
                                             class="w-40 h-40" alt="MFA QR Code" />
                                    }
                                </div>
                                <span class="text-[9px] font-bold text-slate-400 uppercase">Scan QR Code</span>
                            </div>

                            <div class="flex flex-col justify-center">
                                <div class="mb-6">
                                    <label class="text-[10px] font-black text-slate-500 uppercase tracking-widest block mb-2">Secret Key (Manual Entry)</label>
                                    <div class="bg-white border border-slate-200 px-3 py-2 font-mono text-sm text-slate-700 flex items-center justify-between group">
                                        <code>@mfaSetup.SharedKey</code>
                                        <i class="fa-regular fa-copy text-slate-300 group-hover:text-indigo-500 cursor-pointer transition-colors" title="Copy key"></i>
                                    </div>
                                </div>

                                <div class="space-y-4">
                                    <label class="text-[10px] font-black text-slate-500 uppercase tracking-widest block">Enter 6-Digit Code</label>
                                    <div class="flex items-center gap-3">
                                        <input @bind="verificationCode" 
                                               class="flex-1 bg-white border border-slate-300 px-4 py-2.5 text-lg font-black text-slate-900 tracking-[0.5em] focus:border-indigo-500 focus:ring-0 focus:outline-none transition-colors text-center" 
                                               placeholder="000000" maxlength="6" />
                                        
                                        <button class="px-6 py-2.5 bg-emerald-600 text-white text-[11px] font-black uppercase tracking-widest hover:bg-emerald-700 transition-all shadow-sm" 
                                                @onclick="ConfirmMfa" disabled="@isSubmitting">
                                            @(isSubmitting ? "Verifying..." : "Enable")
                                        </button>
                                        
                                        <button class="px-6 py-2.5 bg-white border border-slate-200 text-slate-400 text-[11px] font-black uppercase tracking-widest hover:text-slate-600 hover:border-slate-300 transition-all" 
                                                @onclick="() => isSettingUpMfa = false">
                                            Cancel
                                        </button>
                                    </div>
                                    @if (!string.IsNullOrEmpty(errorMessage))
                                    {
                                        <div class="text-[10px] font-bold text-rose-500 flex items-center gap-1">
                                            <i class="fa-solid fa-triangle-exclamation"></i> @errorMessage
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <!-- Biometric Section -->
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pt-6 border-t border-slate-100 mt-6">
                    <div class="flex-1">
                        <h4 class="text-sm font-black text-slate-800 uppercase tracking-tight mb-1">Biometric Authentication</h4>
                        <p class="text-xs font-bold text-slate-400">Log in securely using FaceID, TouchID, or other device sensors.</p>
                    </div>
                    <div class="shrink-0">
                        <button class="px-5 py-2 bg-indigo-50 text-indigo-600 border border-indigo-100 text-[11px] font-black uppercase tracking-widest hover:bg-indigo-600 hover:text-white transition-all shadow-sm" 
                                @onclick="RegisterBiometric">
                            Add Device
                        </button>
                    </div>
                </div>

                @if (mfaSetup?.BiometricDevices?.Any() == true)
                {
                    <div class="mt-6 space-y-3">
                        <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest block mb-2">Registered Devices</label>
                        @foreach (var device in mfaSetup.BiometricDevices)
                        {
                            <div class="flex items-center justify-between p-3 bg-slate-50 border border-slate-200 group">
                                <div class="flex items-center gap-3">
                                    <div class="w-8 h-8 bg-white border border-slate-200 flex items-center justify-center text-slate-400">
                                        <i class="fa-solid fa-fingerprint"></i>
                                    </div>
                                    <div>
                                        <div class="text-[11px] font-black text-slate-700">@device.DeviceFriendlyName</div>
                                        <div class="text-[9px] font-bold text-slate-400">Enrolled on @device.RegDate.ToString("MMM dd, yyyy")</div>
                                    </div>
                                </div>
                                <button class="text-slate-300 hover:text-rose-500 transition-colors px-2 py-1" 
                                        @onclick="() => RemoveDevice(device.Id)" title="Remove device">
                                    <i class="fa-solid fa-trash-can text-[11px]"></i>
                                </button>
                            </div>
                        }
                    </div>
                }

                @if (!string.IsNullOrEmpty(biometricMessage))
                {
                    <div class="mt-4 p-3 @(biometricSuccess ? "bg-emerald-50 text-emerald-700 border-emerald-100" : "bg-rose-50 text-rose-700 border-rose-100") border text-[11px] font-bold flex items-center gap-2 animate-in fade-in duration-300">
                        <i class="fa-solid @(biometricSuccess ? "fa-circle-check" : "fa-circle-xmark")"></i>
                        @biometricMessage
                    </div>
                }
            </div>
        </div>

        <!-- Info Card: Why MFA? -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="bg-white p-5 border border-slate-200 shadow-sm flex gap-4">
                <div class="w-10 h-10 bg-blue-50 text-blue-500 rounded-none flex items-center justify-center shrink-0 border border-blue-100">
                    <i class="fa-solid fa-mobile-screen-button"></i>
                </div>
                <div>
                    <h5 class="text-[11px] font-black text-slate-800 uppercase tracking-widest mb-1">Device Protection</h5>
                    <p class="text-[10px] font-bold text-slate-400 leading-relaxed">Authenticator apps provide time-based codes that are much more secure than SMS codes.</p>
                </div>
            </div>
            <div class="bg-white p-5 border border-slate-200 shadow-sm flex gap-4">
                <div class="w-10 h-10 bg-emerald-50 text-emerald-500 rounded-none flex items-center justify-center shrink-0 border border-emerald-100">
                    <i class="fa-solid fa-fingerprint"></i>
                </div>
                <div>
                    <h5 class="text-[11px] font-black text-slate-800 uppercase tracking-widest mb-1">Face & Touch ID</h5>
                    <p class="text-[10px] font-bold text-slate-400 leading-relaxed">Register multiple devices to ensure you can always access your account securely.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Premium Midnight Blue Theme Matching Dashboard */
    :root {
        --midnight-blue: #002d54;
        --card-bg: #ffffff;
        --header-bg: #e5f1fd !important;
    }

    .card-header-compact {
        background-color: var(--header-bg) !important;
        padding: 0.75rem 1.5rem !important;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid #d1e5f8;
    }

    .card-title-compact {
        font-weight: 800;
        color: var(--midnight-blue);
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    /* Custom Input styling for MFA codes */
    .mfa-input:focus {
        border-color: #4f46e5;
        background-color: white;
    }
</style>

@code {
    private MfaSetupResponse? mfaSetup;
    private bool isSettingUpMfa;
    private string verificationCode = "";
    private string? errorMessage;
    private bool isSubmitting;
    private string? biometricMessage;
    private bool biometricSuccess;

    protected override async Task OnInitializedAsync()
    {
        mfaSetup = await AuthService.GetMfaSetup();
    }

    private async Task StartMfaSetup()
    {
        isSettingUpMfa = true;
        errorMessage = null;
        await Task.CompletedTask;
    }

    private async Task ConfirmMfa()
    {
        if (string.IsNullOrWhiteSpace(verificationCode) || verificationCode.Length < 6)
        {
            errorMessage = "Please enter a valid 6-digit code.";
            return;
        }

        isSubmitting = true;
        errorMessage = null;

        try
        {
            var result = await AuthService.ConfirmMfa(verificationCode);
            if (result.IsSuccess)
            {
                mfaSetup = await AuthService.GetMfaSetup();
                isSettingUpMfa = false;
                verificationCode = "";
            }
            else
            {
                errorMessage = result.Message;
            }
        }
        catch (Exception)
        {
            errorMessage = "An error occurred during verification.";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task DisableMfa()
    {
        isSubmitting = true;
        errorMessage = null;

        try
        {
            var result = await AuthService.DisableMfa();
            if (result.IsSuccess)
            {
                mfaSetup = await AuthService.GetMfaSetup();
            }
            else
            {
                errorMessage = result.Message;
            }
        }
        catch (Exception)
        {
            errorMessage = "An error occurred while disabling MFA.";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task RegisterBiometric()
    {
        biometricMessage = "Initializing biometric registration...";
        biometricSuccess = false;

        try
        {
            var deviceName = $"{Environment.OSVersion.Platform} Browser";
            var result = await AuthService.RegisterBiometric(deviceName);

            if (result.IsSuccess)
            {
                mfaSetup = await AuthService.GetMfaSetup();
                biometricSuccess = true;
                biometricMessage = "Biometric device registered successfully!";
            }
            else
            {
                biometricMessage = result.Message;
            }
        }
        catch (Exception ex)
        {
            biometricMessage = $"Registration failed: {ex.Message}";
        }
    }

    private async Task RemoveDevice(Guid deviceId)
    {
        var result = await AuthService.RemoveBiometric(deviceId);
        if (result.IsSuccess)
        {
            mfaSetup = await AuthService.GetMfaSetup();
            biometricSuccess = true;
            biometricMessage = "Device removed successfully.";
        }
        else
        {
            biometricSuccess = false;
            biometricMessage = result.Message;
        }
    }
}
