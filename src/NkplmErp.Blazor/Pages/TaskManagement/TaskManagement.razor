@page "/task"
@attribute [Authorize]
@using NkplmErp.Blazor.Pages.TaskManagement.Shared

<div class="main-body">
    <div class="page-header-container">
        <div class="header-row">
            <div class="page-title-section">
                <h1 class="page-title">Task Management</h1>
            </div>

            <div class="compact-filters">
                @* Reusable date-range picker. The page owns the window (selectedStartDate/
                   selectedEndDate via @bind) and reloads the board on OnChanged. *@
                <CompactDateRangeFilter @bind-StartDate="selectedStartDate"
                                        @bind-EndDate="selectedEndDate"
                                        OnChanged="OnFilterChanged" />

                <div class="filter-item">
                    <div class="compact-staff-wrapper">
                        <input type="text" class="compact-search" placeholder="Search Order No"
                               value="@selectedOrderNo" @onchange="OnOrderNoChanged" />
                    </div>
                </div>

                @* Factory filter. Admin: editable list of every factory_type.
                   Gauge-restricted user: a single fixed (disabled) value. *@
                @if (scope is not null)
                {
                    <div class="filter-item">
                        @if (scope.IsRestricted)
                        {
                            @* Single-factory user: the factory is fixed, so render a read-only
                               field (gray, lock icon, no caret) instead of a disabled-looking
                               dropdown that invites a click and does nothing. *@
                            <div class="compact-fixed" title="Your factory (fixed)">
                                <svg class="tc-ic tc-ic-14" viewBox="0 0 24 24" aria-hidden="true"><path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zM9 6c0-1.66 1.34-3 3-3s3 1.34 3 3v2H9V6zm9 14H6V10h12v10zm-6-3c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2z" /></svg>
                                <span>@scope.AssignedGauge</span>
                            </div>
                        }
                        else
                        {
                            <select class="compact-select" value="@(selectedFactoryType ?? "")"
                                    @onchange="OnFactoryTypeChanged" style="height:32px" title="Filter by factory">
                                <option value="">All Factories</option>
                                @foreach (var ft in scope.FactoryTypes)
                                {
                                    <option value="@ft">@ft</option>
                                }
                            </select>
                        }
                    </div>
                }

                @* Gauge / Method multi-select — one fixed control in the filter bar; the
                   dynamic option list lives inside its popover so the bar never reflows.
                   Cascades from the active factory + date window; hidden when there are none.
                   Reuses the same state + reload methods the old chip row used. *@
                @if (availableSubCategories.Count > 0)
                {
                    <div class="filter-item">
                        <GaugeMethodFilter Options="availableSubCategories"
                                           Selected="selectedSubCategories"
                                           OnToggle="ToggleSubCategory"
                                           OnSelectAll="OnAllSubCategoriesSelected" />
                    </div>
                }
            </div>
        </div>

        @* Selected gauge/method readout — removable tags for the active picks, shown below
           the filter bar only when something is selected. Each tag removes itself; "Clear
           all" resets to All. Uses the same state + methods as the dropdown. *@
        @if (selectedSubCategories.Count > 0)
        {
            <div class="selected-filter-row">
                <span class="selected-filter-label">Selected</span>
                @foreach (var sub in selectedSubCategories)
                {
                    <button type="button" class="filter-tag" title="Remove @sub"
                            @onclick="@(() => ToggleSubCategory(sub))">
                        <span>@sub</span>
                        <span class="filter-tag-x">✕</span>
                    </button>
                }
                <button type="button" class="filter-clear" @onclick="OnAllSubCategoriesSelected">
                    <span class="filter-clear-x">✕</span>
                    <span>Clear all</span>
                </button>
            </div>
        }

        <!-- Stats cards -->
        <div class="stats-grid">
            <div class="stat-card stat-scheduled@(activeBubble == 1 ? " active" : "")" @onclick="() => ShowBubble(1)">
                <div class="stat-content d-flex justify-content-between">
                    <div class="stat-label">Scheduled</div>
                    <div class="stat-value">@Scheduled</div>
                </div>
            </div>

            <div class="stat-card stat-progress@(activeBubble == 2 ? " active" : "")" @onclick="() => ShowBubble(2)">
                <div class="stat-content d-flex justify-content-between">
                    <div class="stat-label">In Progress</div>
                    <div class="stat-value">@InProgress</div>
                </div>
            </div>

            <div class="stat-card stat-hold@(activeBubble == 5 ? " active" : "")" @onclick="() => ShowBubble(5)">
                <div class="stat-content d-flex justify-content-between">
                    <div class="stat-label">On Hold</div>
                    <div class="stat-value">@OnHoldCount</div>
                </div>
            </div>

            <div class="stat-card stat-workload@(activeBubble == 6 ? " active" : "")" @onclick="() => ShowBubble(6)">
                <div class="stat-content d-flex justify-content-between">
                    <div class="stat-label">Work Load</div>
                    <div class="stat-value">@Workload</div>
                </div>
            </div>

            <div class="stat-card stat-completed@(activeBubble == 3 ? " active" : "")" @onclick="() => ShowBubble(3)">
                <div class="stat-content d-flex justify-content-between">
                    <div class="stat-label">Completed</div>
                    <div class="stat-value">@Completed</div>
                </div>
            </div>

            <div class="stat-card stat-overdue@(activeBubble == 4 ? " active" : "")" @onclick="() => ShowBubble(4)">
                <div class="stat-content d-flex justify-content-between">
                    <div class="stat-label">OverDue</div>
                    <div class="stat-value">@OverDue</div>
                </div>
            </div>
        </div>
    </div>

    <div class="containers">
        <section>
            <div class="row g-2 my-2">
                @if (Box1)
                {
                    <div class="@BoardColClass">
                        <TaskCard Title="Scheduled"
                                  Variant="TaskVariant.Todo"
                                  Items="todotasks"
                                  OnItemClick="OnItemClicked"
                                  ShowScheduleActions="true"
                                  OnAddTask="OpenAddTaskModal"
                                  OnEditTask="OpenEditTaskModal"
                                  FlowCards="SingleFullWidth" />
                    </div>
                }

                @if (Box2)
                {
                    <div class="@BoardColClass">
                        <TaskCard Title="In Progress"
                                  Variant="TaskVariant.Progress"
                                  Items="inprogresstasks"
                                  OnItemClick="OnItemClicked"
                                  OnOrderClick="OnOrderClicked"
                                  FlowCards="SingleFullWidth"
                                  ShowKnitterDetails="true" />
                    </div>
                }

                @if (Box3)
                {
                    <div class="@BoardColClass">
                        <TaskCard Title="Completed"
                                  Variant="TaskVariant.Complete"
                                  Items="completedtasks"
                                  OnItemClick="OnItemClicked"
                                  FlowCards="SingleFullWidth" />
                    </div>
                }

                @if (Box4)
                {
                    <div class="@BoardColClass">
                        <TaskCard Title="Over Due"
                                  Variant="TaskVariant.Due"
                                  Items="overduetasks"
                                  OnItemClick="OnItemClicked"
                                  FlowCards="SingleFullWidth" />
                    </div>
                }

                @if (Box5)
                {
                    <div class="@BoardColClass">
                        <TaskCard Title="On Hold"
                                  Variant="TaskVariant.OnHold"
                                  Items="onholdtasks"
                                  OnItemClick="OnItemClicked"
                                  FlowCards="SingleFullWidth" />
                    </div>
                }
            </div>
        </section>
    </div>
</div>

@* Order-detail modal — opened by clicking an order number in an In Progress card header.
   Left: a compact summary (buyer + stats). Right: the return-pace chart (lazy-loaded). *@
<PanelModal IsVisible="showOrderModal"
            Title="@orderModalTitle"
            Icon="fa-solid fa-clipboard-list"
            MaxWidth="860px"
            OnClose="CloseOrderModal">
        @if (selectedOrder is not null)
        {
            var customer = !string.IsNullOrWhiteSpace(selectedOrder.CustomerName)
                ? selectedOrder.CustomerName
                : selectedOrder.CustomerCode;
            var issue = selectedOrder.Issue ?? 0;
            var ret = selectedOrder.ReturnQty ?? 0;
            var pct = issue > 0 ? Math.Clamp((int)Math.Round(100.0 * ret / issue), 0, 100) : 0;

            <div class="om-grid">
                @* Left: summary *@
                <div class="om-info">
                    @if (!string.IsNullOrWhiteSpace(customer))
                    {
                        <div class="om-eyebrow">Buyer</div>
                        <div class="om-customer">@customer</div>
                    }
                    <div class="om-meta">
                        <span>PO @selectedOrder.TaskId</span>
                        <span class="om-dot">•</span>
                        <span>Knitter @selectedOrder.KnitterId</span>
                    </div>
                    <div class="om-dates">@selectedOrder.TaskStartDate.ToString("dd MMM") – @selectedOrder.TaskEndDate.ToString("dd MMM, yyyy")</div>

                    <div class="om-stats">
                        <div class="om-stat om-stat-blue">
                            <div class="om-stat-label">Issued</div>
                            <div class="om-stat-value">@issue</div>
                        </div>
                        <div class="om-stat om-stat-teal">
                            <div class="om-stat-label">Returned</div>
                            <div class="om-stat-value">@ret<span class="om-stat-sub"> / @issue</span></div>
                            <div class="om-bar"><span style="width:@(pct)%"></span></div>
                        </div>
                        <div class="om-stat">
                            <div class="om-stat-label">Order Qty</div>
                            <div class="om-stat-value">@(selectedOrder.Qty?.ToString() ?? "—")</div>
                        </div>
                        <div class="om-stat">
                            <div class="om-stat-label">Machines</div>
                            <div class="om-stat-value">@(selectedOrder.MachineCount?.ToString() ?? "—")</div>
                        </div>
                    </div>
                </div>

                @* Right: return-pace graph with a graph/table toggle (same height in both views). *@
                <div class="om-chart">
                    <div class="om-chart-top">
                        <button type="button" class="om-toggle"
                                @onclick="() => chartTableView = !chartTableView"
                                title="@(chartTableView ? "Switch to graph" : "Switch to table")">
                            <i class="fa-solid @(chartTableView ? "fa-arrow-up-right-dots" : "fa-table-list")"></i>
                        </button>
                        @if (!chartTableView)
                        {
                            <div class="om-chart-legend">
                                <span class="ocl-item"><span class="ocl-swatch" style="background:#185FA5"></span>Actual</span>
                                <span class="ocl-item"><span class="ocl-swatch ocl-dash"></span>Expected</span>
                            </div>
                        }
                    </div>

                    @if (chartTableView)
                    {
                        <div class="om-chart-table-scroll">
                            <table class="om-items-table">
                                <thead>
                                    <tr>
                                        <th>SN</th>
                                        <th>Qty</th>
                                        <th>Issue</th>
                                        <th>Receive</th>
                                        <th>Receive Date</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (returnPoints.Count == 0)
                                    {
                                        <tr><td colspan="5" class="om-empty-cell">No returns yet</td></tr>
                                    }
                                    else
                                    {
                                        var rsn = 0;
                                        foreach (var p in returnPoints)
                                        {
                                            rsn++;
                                            <tr>
                                                <td>@rsn</td>
                                                <td>@(selectedOrder.Qty?.ToString() ?? "—")</td>
                                                <td>@(selectedOrder.Issue?.ToString() ?? "—")</td>
                                                <td>@p.Count</td>
                                                <td>@p.Date.ToString("dd MMM yyyy HH:mm")</td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="om-chart-canvas">
                            <ReturnPaceChart Start="selectedOrder.TaskStartDate"
                                             End="selectedOrder.TaskEndDate"
                                             Issue="@issue"
                                             Points="returnPoints"
                                             Width="470" Height="210"
                                             PadLeft="44" PadRight="18" PadTop="14" PadBottom="38" />
                        </div>
                    }
                </div>
            </div>

            @if (orderStyles.Count > 0)
            {
                <div class="om-items">
                    <div class="om-items-title">Styles &amp; Colors</div>
                    <div class="om-items-scroll">
                        <table class="om-items-table">
                            <thead>
                                <tr>
                                    <th>SN</th>
                                    <th>Styles</th>
                                    <th>Colors</th>
                                    <th>Size</th>
                                    <th>Qty</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{ var sn = 0; }
                                @foreach (var s in orderStyles)
                                {
                                    sn++;
                                    <tr>
                                        <td>@sn</td>
                                        <td>@s.StyleNo</td>
                                        <td>@s.Color</td>
                                        <td>@s.Size</td>
                                        <td>@s.Qty.ToString("0.##")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        }
</PanelModal>

@* ============================================================================
   Add / Edit Task modal — UI scaffold. Reuses the same PanelModal as the order
   modal above. Opened by the Scheduled column's header "Add" button or any
   Scheduled card's "Edit" button. Fields mirror the Add Task design. No backend
   yet: Save only validates the required field and closes; nothing is persisted.
   ============================================================================ *@
<PanelModal IsVisible="showTaskEditor"
            Title="@taskEditorTitle"
            Icon="fa-solid fa-list-check"
            MaxWidth="680px"
            OnClose="CloseTaskEditor">
    <div class="tf-form">
        <div class="tf-row">
            <label class="tf-label">Task Name</label>
            <input class="tf-input" placeholder="Task Name" @bind="taskFormName" />
        </div>

        <div class="tf-row">
            <label class="tf-label">Task Start Date</label>
            <div class="tf-dual">
                <input type="date" class="tf-input" @bind="taskFormStart" />
                <label class="tf-label tf-label-inline">Task End Date</label>
                <input type="date" class="tf-input" @bind="taskFormEnd" />
            </div>
        </div>

        <div class="tf-row">
            <label class="tf-label">Priority</label>
            <select class="tf-input" @bind="taskFormPriority">
                <option value="">Select</option>
                <option value="High">High</option>
                <option value="Medium">Medium</option>
                <option value="Low">Low</option>
            </select>
        </div>

        <div class="tf-row">
            <label class="tf-label">Task Description</label>
            <input class="tf-input" placeholder="Add Task Description" @bind="taskFormDescription" />
        </div>

        <div class="tf-row">
            <label class="tf-label">Notification Date</label>
            <input type="date" class="tf-input" @bind="taskFormNotifyDate" />
        </div>

        <div class="tf-row">
            <label class="tf-label">Progress Update</label>
            <select class="tf-input" @bind="taskFormFrequency">
                <option value="">Select Update Frequency</option>
                <option value="Daily">Daily</option>
                <option value="Weekly">Weekly</option>
                <option value="Monthly">Monthly</option>
            </select>
        </div>

        <div class="tf-row">
            <label class="tf-label tf-label-strong">Task Assigned To</label>
            <div class="tf-radios">
                <label><input type="radio" name="tf-assign" checked="@(!taskFormAssignGroup)"
                              @onchange="@(() => taskFormAssignGroup = false)" /> Individual Staff</label>
                <label><input type="radio" name="tf-assign" checked="@taskFormAssignGroup"
                              @onchange="@(() => taskFormAssignGroup = true)" /> Group</label>
            </div>
        </div>

        <div class="tf-row">
            <label class="tf-label">@(taskFormAssignGroup ? "Group" : "Staff")</label>
            <select class="tf-input" @bind="taskFormStaff">
                <option value="">Select</option>
                <option value="Bim Li">Bim Li</option>
                <option value="Staff 2">Staff 2</option>
                <option value="Staff 3">Staff 3</option>
            </select>
        </div>

        <div class="tf-row">
            <label class="tf-label tf-label-strong">
                Upload Documents <span class="tf-hint">(less than 1MB)</span>
            </label>
            <label class="tf-file">
                <span class="tf-file-name">@(string.IsNullOrEmpty(taskFormFileName) ? "Please upload a file" : taskFormFileName)</span>
                <InputFile OnChange="OnTaskFileSelected" class="tf-file-input" />
            </label>
        </div>

        @if (!string.IsNullOrEmpty(taskFormError))
        {
            <div class="tf-error">@taskFormError</div>
        }

        <div class="tf-actions">
            <button type="button" class="tf-save" @onclick="SaveTask">Save Task</button>
        </div>
    </div>
</PanelModal>

<style>
    .tf-form { display: flex; flex-direction: column; gap: 14px; padding: 4px 2px; }
    .tf-row { display: grid; grid-template-columns: 150px 1fr; align-items: center; gap: 12px; }
    .tf-label { color: #0e7490; font-weight: 600; font-size: 13px; margin: 0; }
    .tf-label-strong { color: #1f2937; }
    .tf-label-inline { white-space: nowrap; text-align: center; }
    .tf-input {
        width: 100%; height: 36px; padding: 6px 10px; font-size: 13px;
        border: 1px solid #b9d6e2; border-radius: 6px; background: #fff; color: #1f2937;
    }
    .tf-input:focus { outline: none; border-color: #0e7490; box-shadow: 0 0 0 2px rgba(14,116,144,0.15); }
    .tf-dual { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 10px; }
    .tf-radios { display: flex; gap: 24px; align-items: center; font-size: 13px; color: #1f2937; }
    .tf-radios label { display: flex; align-items: center; gap: 6px; margin: 0; cursor: pointer; }
    .tf-hint { color: #dc2626; font-weight: 700; font-size: 11px; }
    .tf-file {
        display: flex; align-items: center; justify-content: space-between; gap: 10px;
        border: 1px solid #b9d6e2; border-radius: 6px; padding: 6px 10px; cursor: pointer; background: #fff;
    }
    .tf-file-name { color: #6b7280; font-size: 13px; }
    .tf-file-input { font-size: 12px; max-width: 150px; }
    .tf-actions { display: flex; justify-content: center; margin-top: 6px; }
    .tf-save {
        background: #1a3353; color: #fff; border: 0; border-radius: 6px;
        padding: 8px 24px; font-size: 13px; font-weight: 600; cursor: pointer;
    }
    .tf-save:hover { background: #24466e; }
    .tf-error { color: #dc2626; font-size: 12px; font-weight: 600; text-align: center; }
    @@media (max-width: 560px) {
        .tf-row { grid-template-columns: 1fr; }
        .tf-dual { grid-template-columns: 1fr; }
    }
</style>
