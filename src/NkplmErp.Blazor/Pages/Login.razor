@page "/login"
@using NkplmErp.Blazor.Services.Auth
@using NkplmErp.Shared.DTOs
@inject IAuthService AuthService
@inject NavigationManager NavigationManager
@inject NkplmErp.Blazor.Services.Toast.ToastService ToastService
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage

<div class="login-container">
    <div class="login-card">
        <div class="login-header">
            <h2>NKPLM ERP</h2>
            <p>Banking-Grade Enterprise Management</p>
        </div>

        @if (!showMfa)
        {
                <EditForm Model="@loginModel" OnValidSubmit="HandleLogin">
                    <DataAnnotationsValidator />

                    <div class="form-group">
                        <label>Email Address</label>
                        <InputText @bind-Value="loginModel.Email" class="form-control" placeholder="admin@nkplm.erp" />
                    </div>

                    <div class="form-group">
                        <label>Password</label>
                        <InputText @bind-Value="loginModel.Password" type="password" class="form-control" placeholder="••••••••" />
                    </div>


                    <button type="submit" class="btn-login" disabled="@isSubmitting">
                    @if (isSubmitting)
                    {
                                <span class="spinner"></span>
                    }
                    else
                    {
                                <span>Sign In</span>
                    }
                    </button>
                </EditForm>

                <div class="divider">
                    <span>OR</span>
                </div>

                <button class="btn-biometric" @onclick="HandleBiometricLogin" disabled="@(isSubmitting || string.IsNullOrEmpty(loginModel.Email))">
                    <i class="oi oi-person"></i> Sign in with Face / Touch ID
                </button>
        }
        else
        {
                <div class="mfa-section">
                    <p>Please enter the verification code from your authenticator app.</p>
                    <div class="form-group">
                        <InputText @bind-Value="mfaCode" class="form-control mfa-input" placeholder="000 000" maxlength="6" />
                    </div>


                    <button @onclick="HandleMfa" class="btn-login" disabled="@isSubmitting">
                        Verify & Continue
                    </button>
                </div>
        }
        
        <div style="margin-top: 2rem; text-align: center;">
            <button @onclick="ClearSession" class="btn-link" style="color: #64748b; background: none; border: none; cursor: pointer; text-decoration: underline; font-size: 0.8rem;">
                Having trouble? Reset Session
            </button>
        </div>
    </div>
</div>

<style>
    .login-container {
        height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
        font-family: 'Inter', sans-serif;
    }

    .login-card {
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        padding: 2.5rem;
        border-radius: 1.5rem;
        width: 100%;
        max-width: 400px;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    }

    .login-header h2 {
        color: #f8fafc;
        margin-bottom: 0.5rem;
        text-align: center;
        letter-spacing: -0.025em;
        font-weight: 800;
    }

    .login-header p {
        color: #94a3b8;
        text-align: center;
        font-size: 0.875rem;
        margin-bottom: 2rem;
    }

    .form-group {
        margin-bottom: 1.5rem;
    }

    .form-group label {
        display: block;
        color: #cbd5e1;
        font-size: 0.875rem;
        margin-bottom: 0.5rem;
    }

    .form-control {
        width: 100%;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.1);
        padding: 0.75rem 1rem;
        border-radius: 0.75rem;
        color: white;
        transition: all 0.2s;
    }

    .form-control:focus {
        outline: none;
        border-color: #38bdf8;
        background: rgba(255, 255, 255, 0.05);
        box-shadow: 0 0 0 4px rgba(56, 189, 248, 0.1);
    }

    .btn-login {
        width: 100%;
        background: #38bdf8;
        color: #0f172a;
        border: none;
        padding: 0.875rem;
        border-radius: 0.75rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
        margin-top: 1rem;
    }

    .btn-login:hover:not(:disabled) {
        background: #7dd3fc;
        transform: translateY(-1px);
    }

    .btn-login:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .error-message {
        color: #f87171;
        font-size: 0.875rem;
        margin-bottom: 1rem;
        text-align: center;
    }

    .divider {
        display: flex;
        align-items: center;
        text-align: center;
        margin: 1.5rem 0;
        color: #64748b;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .divider::before, .divider::after {
        content: '';
        flex: 1;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .divider span {
        padding: 0 0.75rem;
    }

    .btn-biometric {
        width: 100%;
        background: rgba(255, 255, 255, 0.05);
        color: #f8fafc;
        border: 1px solid rgba(255, 255, 255, 0.1);
        padding: 0.875rem;
        border-radius: 0.75rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }

    .btn-biometric:hover:not(:disabled) {
        background: rgba(255, 255, 255, 0.1);
        border-color: #38bdf8;
    }

    .btn-biometric:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .mfa-input {
        text-align: center;
        font-size: 1.5rem;
        letter-spacing: 0.5rem;
    }

    .spinner {
        display: inline-block;
        width: 1.25rem;
        height: 1.25rem;
        border: 2px solid rgba(15, 23, 42, 0.3);
        border-radius: 50%;
        border-top-color: #0f172a;
        animation: spin 0.6s linear infinite;
    }

    @@keyframes spin {
        to { transform: rotate(360deg); }
    }
</style>

@code {
    private LoginRequest loginModel = new();
    private bool isSubmitting;
    private bool showMfa;
    private string mfaCode = "";

    private async Task HandleLogin()
    {
        isSubmitting = true;

        try
        {
            var result = await AuthService.Login(loginModel);
            if (result.IsSuccess)
            {
                if (result.RequiresMfa)
                {
                    showMfa = true;
                }
                else
                {
                    ToastService.ShowSuccess("Welcome back! Login successful.");
                    NavigationManager.NavigateTo("/");
                }
            }
            else
            {
                ToastService.ShowError(result.Message);
            }
        }
        catch (Exception)
        {
            ToastService.ShowError("An unexpected error occurred. Please try again.");
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task HandleMfa()
    {
        isSubmitting = true;

        try
        {
            var result = await AuthService.VerifyMfa(new MfaVerifyRequest
                {
                    Email = loginModel.Email,
                    Code = mfaCode
                });

            if (result.IsSuccess)
            {
                ToastService.ShowSuccess("Verification successful.");
                NavigationManager.NavigateTo("/");
            }
            else
            {
                ToastService.ShowError(result.Message);
            }
        }
        catch (Exception)
        {
            ToastService.ShowError("MFA verification failed.");
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task HandleBiometricLogin()
    {
        if (string.IsNullOrEmpty(loginModel.Email))
        {
            ToastService.ShowWarning("Please enter your email first.");
            return;
        }

        isSubmitting = true;

        try
        {
            var result = await AuthService.LoginBiometric(loginModel.Email);
            if (result.IsSuccess)
            {
                ToastService.ShowSuccess("Biometric login successful.");
                NavigationManager.NavigateTo("/");
            }
            else
            {
                ToastService.ShowError(result.Message);
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Biometric login failed: {ex.Message}");
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task ClearSession()
    {
        await LocalStorage.RemoveItemAsync("authToken");
        await LocalStorage.RemoveItemAsync("refreshToken");
        ToastService.ShowInfo("Session cleared. Please login again.");
    }
}
