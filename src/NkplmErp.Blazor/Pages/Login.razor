@page "/login"
@layout NkplmErp.Blazor.Shared.EmptyLayout
@using NkplmErp.Blazor.Services.Auth
@using NkplmErp.Shared.DTOs
@using Microsoft.AspNetCore.Components.Authorization
@inject IAuthService AuthService
@inject NavigationManager NavigationManager
@inject NkplmErp.Blazor.Services.Toast.ToastService ToastService
@inject IJSRuntime JSRuntime
<PageTitle>Login - NatureKnit MIS</PageTitle>
<div class="login-page-bg">
    <div class="unified-login-card glass-morph">
        <div class="auth-side">
            <div class="auth-header-centered">
                <h1 tabindex=0>NATUREKNIT MIS</h1>
                <div class="sub-header-line">
                    <span class="line"></span>
                    <span class="label">MIS </span>
                    <span class="line"></span>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="auth-error-glass animate-shake">
                    <i class="fa-solid fa-circle-exclamation"></i>
                    <span>@errorMessage</span>
                </div>
            }

            @if (isRedirecting)
            {
                <div class="redirect-glass">
                    <div class="spinner-glass"></div>
                    <p>Securing session...</p>
                </div>
            }
            else
            {
                @if (!showMfa)
                {
                    <div class="auth-form-glass">
                        <EditForm Model="@loginModel" OnValidSubmit="HandleLogin">
                            <DataAnnotationsValidator />

                            <div class="form-group-pill">
                                <i class="fa-solid fa-user"></i>
                                <input @bind="loginModel.Email" class="form-control-pill" placeholder="User ID" autocomplete="username" />
                            </div>

                            <div class="form-group-pill">
                                <i class="fa-solid fa-lock"></i>
                                <input @bind="loginModel.Password" type="password" class="form-control-pill" placeholder="Passkey" autocomplete="current-password" />
                            </div>

                            <div class="btn-login-container">
                                <button type="submit" class="btn-login-circular" disabled="@isSubmitting">
                                    <div class="glass-disk">
                                        @if (isSubmitting)
                                        {
                                            <div class="spinner-glass-tiny"></div>
                                        }
                                        else
                                        {
                                            <i class="fa-solid fa-leaf"></i>
                                        }
                                    </div>
                                    <span class="btn-text">Log In</span>
                                </button>
                            </div>

                            <div class="auth-options-centered">
                                <button type="button" class="btn-link-glass">Forgot Passkey?</button>
                                <button type="button" class="btn-link-glass">First-time Setup?</button>
                            </div>
                            
                            <div class="biometric-center">
                                <button type="button" class="btn-biometric-pill" @onclick="HandleBiometricLogin" disabled="@isSubmitting">
                                    <i class="fa-solid fa-user-shield"></i>
                                    <span>FaceID / Fingerprint</span>
                                </button>
                            </div>

                            <ValidationSummary class="validation-errors-glass" />
                        </EditForm>
                    </div>
                }
                else
                {
                    <div class="mfa-section-glass">
                        <h3>MFA Verification</h3>
                        <div class="form-group-pill">
                            <i class="fa-solid fa-key"></i>
                            <InputText @bind-Value="mfaCode" class="form-control-pill" placeholder="000 000" maxlength="6" />
                        </div>

                        <button @onclick="HandleMfa" class="btn-login-circular" disabled="@isSubmitting">
                            <div class="glass-disk">
                                @if (isSubmitting)
                                {
                                    <div class="spinner-glass-tiny"></div>
                                }
                                else
                                {
                                    <i class="fa-solid fa-check"></i>
                                }
                            </div>
                            <span class="btn-text">Verify</span>
                        </button>
                    </div>
                }

                <div class="auth-footer-centered">
                    <p>NatureKnit &copy; 2026</p>
                </div>
            }
        </div>
    </div>
</div>

<style>
h1:focus {
    outline: none;
}
    :root {
    .login-page-bg {
        min-height: 100vh;
        width: 100vw;
        background: linear-gradient(rgba(0, 0, 0, 0.45), rgba(0, 0, 0, 0.45)), url('images/login.png') center/cover no-repeat fixed;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
    }

    .unified-login-card.glass-morph {
        width: 100%;
        max-width: 400px;
        background: rgba(255, 255, 255, 0.12);
        backdrop-filter: blur(2px);
        -webkit-backdrop-filter: blur(2px);
        border-radius: 2.5rem;
        border: 1px solid rgba(255, 255, 255, 0.25);
        box-shadow: 0 40px 100px -20px rgba(0,0,0,0.4);
        padding: 2.5rem 2rem;
        animation: cardAppear 0.8s cubic-bezier(0.16, 1, 0.3, 1);
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .auth-side {
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .auth-header-centered {
        text-align: center;
        margin-bottom: 2rem;
        color: #ffffff;
        width: 100%;
    }

    .auth-header-centered h1 {
        font-size: 1.6rem;
        font-weight: 300;
        letter-spacing: 0.3em;
        margin-bottom: 0.5rem;
        text-shadow: 0 2px 10px rgba(0,0,0,0.2);
    }

    .sub-header-line {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1.25rem;
        opacity: 0.6;
    }

    .sub-header-line .line {
        height: 1px;
        width: 45px;
        background: rgba(255,255,255,0.4);
    }

    .sub-header-line .label {
        font-size: 0.7rem;
        letter-spacing: 0.15em;
        text-transform: uppercase;
    }

    .form-group-pill {
        position: relative;
        margin-bottom: 1rem;
        width: 100%;
    }

    .form-group-pill i {
        position: absolute;
        left: 1.25rem;
        top: 50%;
        transform: translateY(-50%);
        color: rgba(255,255,255,0.8);
        font-size: 0.9rem;
    }

    .form-control-pill {
        width: 100%;
        background: rgba(255, 255, 255, 0.05);
        border: 1.5px solid rgba(255, 255, 255, 0.3);
        padding: 0.85rem 1.25rem 0.85rem 3rem;
        border-radius: 3rem;
        color: #ffffff;
        font-size: 0.95rem;
        transition: all 0.3s;
    }

    .form-control-pill::placeholder { color: rgba(255,255,255,0.5); font-weight: 300; }
    .form-control-pill:focus {
        background: rgba(255, 255, 255, 0.12);
        border-color: rgba(255, 255, 255, 0.9);
        outline: none;
        box-shadow: 0 0 15px rgba(255,255,255,0.1);
    }

    .btn-login-container {
        display: flex;
        justify-content: center;
        margin: 1.75rem 0 1.5rem;
        width: 100%;
    }

    .btn-login-circular {
        background: none;
        border: none;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.75rem;
        cursor: pointer;
        transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    .btn-login-circular:hover { transform: translateY(-5px); }

    .glass-disk {
        width: 4.8rem;
        height: 4.8rem;
        background: rgba(255, 255, 255, 0.15);
        backdrop-filter: blur(12px);
        border: 2px solid rgba(255, 255, 255, 0.5);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #ffffff;
        font-size: 1.6rem;
        box-shadow: 0 0 30px rgba(255,255,255,0.1);
        position: relative;
        overflow: hidden;
    }

    .glass-disk::after {
        content: '';
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, transparent 70%);
        pointer-events: none;
        animation: rotateGlow 4s linear infinite;
    }

    @@keyframes rotateGlow { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }

    .btn-login-circular:hover .glass-disk {
        background: rgba(255, 255, 255, 0.25);
        border-color: #ffffff;
        box-shadow: 0 0 50px rgba(255,255,255,0.25);
    }

    .btn-text {
        color: rgba(255,255,255,0.8);
        font-size: 0.95rem;
        font-weight: 400;
        letter-spacing: 0.08em;
        text-transform: capitalize;
    }

    .auth-options-centered {
        display: flex;
        justify-content: center;
        gap: 2rem;
        margin-bottom: 2rem;
        width: 100%;
    }

    .btn-link-glass {
        background: none;
        border: none;
        color: rgba(255,255,255,0.5);
        font-size: 0.75rem;
        cursor: pointer;
        text-decoration: underline;
        text-underline-offset: 5px;
        transition: color 0.2s;
    }

    .btn-link-glass:hover { color: #ffffff; text-decoration-color: #ffffff; }

    .biometric-center {
        display: flex;
        justify-content: center;
        margin-top: 0.25rem;
        width: 100%;
    }

    .btn-biometric-pill {
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.15);
        padding: 0.5rem 1.25rem;
        border-radius: 3rem;
        color: rgba(255,255,255,0.6);
        font-size: 12px;
        display: flex;
        align-items: center;
        gap: 0.6rem;
        cursor: pointer;
        transition: all 0.3s;
    }

    .btn-biometric-pill:hover { 
        background: rgba(255,255,255,0.08); 
        border-color: rgba(255,255,255,0.4); 
        color: #ffffff;
    }

    .auth-footer-centered {
        text-align: center;
        margin-top: 2.5rem;
        opacity: 0.3;
        color: #ffffff;
        font-size: 10px;
        letter-spacing: 0.1em;
        width: 100%;
    }

    .spinner-glass {
        width: 2.5rem;
        height: 2.5rem;
        border: 3px solid rgba(255,255,255,0.15);
        border-top-color: #ffffff;
        border-radius: 50%;
        animation: spin 1s linear infinite;
        margin: 0 auto;
    }

    .spinner-glass-tiny {
        width: 1.5rem;
        height: 1.5rem;
        border: 2px solid rgba(255,255,255,0.3);
        border-top-color: #ffffff;
        border-radius: 50%;
        animation: spin 1s linear infinite;
    }

    .redirect-glass {
        text-align: center;
        width: 100%;
        padding: 2.5rem 0;
    }

    .redirect-glass p {
        color: #ffffff;
        margin-top: 1.5rem;
        font-weight: 300;
        letter-spacing: 0.05em;
    }

    .auth-error-glass {
        background: rgba(239, 68, 68, 0.25);
        border: 1px solid rgba(239, 68, 68, 0.5);
        backdrop-filter: blur(15px);
        color: #ffffff;
        padding: 1rem 1.25rem;
        border-radius: 1.25rem;
        margin-bottom: 2rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        font-size: 0.85rem;
        width: 100%;
    }

    @@keyframes spin { to { transform: rotate(360deg); } }
    @@keyframes cardAppear { from { opacity: 0; transform: translateY(30px) scale(0.97); } to { opacity: 1; transform: translateY(0) scale(1); } }

    .validation-errors-glass {
        color: #ffcccc;
        font-size: 0.75rem;
        text-align: center;
        list-style: none;
        margin-top: 1.5rem;
        width: 100%;
    }
</style>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private LoginRequest loginModel = new();
    private bool isSubmitting;
    private bool showMfa;
    private bool isRedirecting;
    private string mfaCode = "";
    private string? errorMessage;
    private string? returnUrl;

    protected override async Task OnInitializedAsync()
    {
        // Pick up the deep-link the session-expiry flow passed through.
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        if (query.TryGetValue("returnUrl", out var rv))
        {
            var candidate = rv.ToString();
            if (!string.IsNullOrEmpty(candidate) && candidate.StartsWith("/")
                && !candidate.StartsWith("//")
                && !candidate.StartsWith("/login", StringComparison.OrdinalIgnoreCase)
                && !candidate.StartsWith("/auth", StringComparison.OrdinalIgnoreCase))
            {
                returnUrl = candidate;
            }
        }

        if (AuthState != null)
        {
            var state = await AuthState;
            if (state.User.Identity?.IsAuthenticated == true)
            {
                NavigationManager.NavigateTo(!string.IsNullOrEmpty(returnUrl) ? returnUrl : "/main-dashboard", replace: true);
            }
        }
    }

    private async Task HandleLogin()
    {
        errorMessage = null;
        if (!string.IsNullOrWhiteSpace(loginModel.Email)) loginModel.Email = loginModel.Email.Trim();
        isSubmitting = true;

        try
        {
            var result = await AuthService.Login(loginModel);
            if (result.IsSuccess)
            {
                if (result.RequiresMfa)
                {
                    showMfa = true;
                }
                else
                {
                    isRedirecting = true;
                    ToastService.ShowSuccess("Welcome back! Login successful.");
                    await Task.Delay(500);
                    await JSRuntime.InvokeVoidAsync("submitToken", result.Token, returnUrl);
                }
            }
            else
            {
                var debugInfo = $"(Sent: {loginModel.Email?.Length ?? 0} ID, {loginModel.Password?.Length ?? 0} PWD)";
                errorMessage = $"{result.Message ?? "Invalid credentials."} {debugInfo}";
                ToastService.ShowError(errorMessage);
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Login error: {ex.Message}");
        }
        finally
        {
            if (!isRedirecting)
            {
                isSubmitting = false;
            }
        }
    }

    private async Task HandleMfa()
    {
        isSubmitting = true;

        try
        {
            var result = await AuthService.VerifyMfa(new MfaVerifyRequest
            {
                Email = loginModel.Email,
                Code = mfaCode
            });

            if (result.IsSuccess)
            {
                isRedirecting = true;
                ToastService.ShowSuccess("Verification successful.");
                await Task.Delay(500);
                await JSRuntime.InvokeVoidAsync("submitToken", result.Token, returnUrl);
            }
            else
            {
                errorMessage = result.Message ?? "Verification failed. Please try again.";
                ToastService.ShowError(errorMessage);
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"MFA error: {ex.Message}");
        }
        finally
        {
            if (!isRedirecting)
            {
                isSubmitting = false;
            }
        }
    }

    private async Task HandleBiometricLogin()
    {
        isSubmitting = true;

        try
        {
            var emailToUse = string.IsNullOrWhiteSpace(loginModel.Email) ? null : loginModel.Email.Trim();
            var result = await AuthService.LoginBiometric(emailToUse);
            if (result.IsSuccess)
            {
                isRedirecting = true;
                ToastService.ShowSuccess("Biometric login successful.");
                await Task.Delay(500);
                await JSRuntime.InvokeVoidAsync("submitToken", result.Token, returnUrl);
            }
            else
            {
                var msg = result.Message ?? "Biometric login failed";
                if (msg.Contains("not found") || msg.Contains("credential"))
                {
                    msg = "Biometric device not recognized. Please register it in your Profile settings first.";
                }
                errorMessage = msg;
                ToastService.ShowError(errorMessage);
            }
        }
        catch (Exception ex)
        {
            var msg = ex.Message;
            if (msg.Contains("NotAllowedError") || msg.Contains("Assertion retrieval failed"))
            {
                msg = "Biometric check was cancelled or timed out. Please try again.";
            }
            else if (msg.Contains("not recognized"))
            {
               msg = "FaceID/Fingerprint not recognized. Please register in Profile first.";
            }
            ToastService.ShowError(msg);
        }
        finally
        {
            if (!isRedirecting)
            {
                isSubmitting = false;
            }
        }
    }

    private async Task ClearSession()
    {
        await AuthService.Logout();
        ToastService.ShowInfo("Session cleared. Please login again.");
    }
}
