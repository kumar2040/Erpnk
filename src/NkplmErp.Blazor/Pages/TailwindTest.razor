@page "/tailwind-test"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Tailwind CSS Test | NKPLM ERP</PageTitle>

<div class="p-8">
    <h1 class="text-4xl font-bold mb-8 bg-gradient-to-r from-blue-400 to-purple-600 bg-clip-text text-transparent">
        Tailwind CSS is Working! 🎉
    </h1>

    <!-- Tailwind Utility Classes Example -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
        <div class="bg-gradient-to-br from-green-500 to-green-600 p-6 rounded-2xl shadow-xl hover:scale-105 transition-transform">
            <h3 class="text-white font-bold text-xl mb-2">Utility Classes</h3>
            <p class="text-green-100">Using Tailwind's utility-first approach</p>
        </div>

        <div class="bg-gradient-to-br from-blue-500 to-blue-600 p-6 rounded-2xl shadow-xl hover:scale-105 transition-transform">
            <h3 class="text-white font-bold text-xl mb-2">Responsive Design</h3>
            <p class="text-blue-100">Built-in responsive breakpoints</p>
        </div>

        <div class="bg-gradient-to-br from-purple-500 to-purple-600 p-6 rounded-2xl shadow-xl hover:scale-105 transition-transform">
            <h3 class="text-white font-bold text-xl mb-2">Animations</h3>
            <p class="text-purple-100">Smooth transitions and effects</p>
        </div>
    </div>

    <!-- Custom Component Classes Example -->
    <div class="glass-card p-8 mb-8">
        <h3 class="text-2xl font-bold mb-4">Custom Component Classes</h3>
        <p class="text-gray-300 mb-4">This card uses the custom <code class="bg-gray-800 px-2 py-1 rounded">.glass-card</code> class defined in tailwind.input.css</p>
        <button class="btn-glass">Custom Glass Button</button>
    </div>

    <!-- Mixed with Existing Styles -->
    <div class="flex gap-4">
        <a href="/" class="px-6 py-3 bg-primary-glow text-slate-900 font-bold rounded-xl hover:bg-sky-400 transition-colors">
            Back to Dashboard
        </a>
        <button class="px-6 py-3 border-2 border-white/20 text-white font-bold rounded-xl hover:bg-white/10 transition-colors">
            Secondary Action
        </button>
    </div>
</div>
