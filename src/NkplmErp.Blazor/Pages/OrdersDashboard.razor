@page "/orders-dashboard"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<PageTitle>Orders Dashboard | NKPLM ERP</PageTitle>

<style>
    /* Override parent layout constraints for full width */
    .content-wrapper {
        max-width: none !important;
        width: 100% !important;
        padding: 0 !important;
    }
    
    .content {
        padding: 0 !important;
    }

    .fixed-header {
        position: sticky;
        top: 0;
        z-index: 40;
        background: #f9fafb; /* matching bg-gray-50 */
        padding: 1rem 5px;
        border-bottom: 1px solid #e5e7eb;
        margin-bottom: 1rem;
    }
</style>

<div class="bg-gray-50 min-h-screen" style="padding: 5px;">
    <!-- Header (Sticky/Fixed) -->
  

    <!-- Dashboard Grid -->
    <div class="grid grid-cols-1 xl:grid-cols-3 gap-4">
        <!-- Order Status Table -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
            <div class="flex items-center justify-between p-5 border-b border-gray-200">
                <h2 class="text-lg font-semibold text-gray-900">Order Status</h2>
                <button class="p-1.5 hover:bg-gray-100 rounded-lg transition-colors">
                    <i class="oi oi-fullscreen-enter text-gray-500 text-sm"></i>
                </button>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead class="bg-gray-50 border-b border-gray-200">
                        <tr>
                            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">S.N.</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Client Name</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">No.of P.O</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Running Quantity</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Waiting P.O</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        @foreach (var order in OrderStatusData)
                        {
                            <tr class="hover:bg-gray-50 transition-colors">
                                <td class="px-4 py-3 text-sm text-gray-900">@order.SN</td>
                                <td class="px-4 py-3 text-sm font-medium text-gray-900">@order.ClientName</td>
                                <td class="px-4 py-3 text-sm text-gray-600">@order.NumberOfPO</td>
                                <td class="px-4 py-3 text-sm text-gray-600">@order.RunningQuantity</td>
                                <td class="px-4 py-3 text-sm text-gray-600">@order.WaitingPO</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Production Status Table -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
            <div class="flex items-center justify-between p-5 border-b border-gray-200">
                <h2 class="text-lg font-semibold text-gray-900">Production Status</h2>
                <button class="p-1.5 hover:bg-gray-100 rounded-lg transition-colors">
                    <i class="oi oi-fullscreen-enter text-gray-500 text-sm"></i>
                </button>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead class="bg-gray-50 border-b border-gray-200">
                        <tr>
                            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">S.N.</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Buyer</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Order No.</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Quantity</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Shipping Date</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Progress</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Projected</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        @foreach (var prod in ProductionStatusData)
                        {
                            <tr class="hover:bg-gray-50 transition-colors">
                                <td class="px-4 py-3 text-sm text-gray-900">@prod.SN</td>
                                <td class="px-4 py-3 text-sm font-medium text-gray-900">@prod.Buyer</td>
                                <td class="px-4 py-3 text-sm text-gray-600">@prod.OrderNo</td>
                                <td class="px-4 py-3 text-sm text-gray-600">@prod.Quantity</td>
                                <td class="px-4 py-3 text-sm text-gray-600">@prod.ShippingDate.ToString("yyyy-MM-dd")</td>
                                <td class="px-4 py-3">
                                    <div class="flex items-center gap-2">
                                        <div class="flex-1 bg-gray-200 rounded-full h-2 max-w-[60px]">
                                            <div class="bg-blue-600 h-2 rounded-full" style="width: @(prod.Progress)%"></div>
                                        </div>
                                        <span class="text-xs font-medium text-gray-700">@(prod.Progress)%</span>
                                    </div>
                                </td>
                                <td class="px-4 py-3 text-sm text-gray-600">@prod.Projected.ToString("yyyy-MM-dd")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Setting Piece Table -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
            <div class="flex items-center justify-between p-5 border-b border-gray-200">
                <h2 class="text-lg font-semibold text-gray-900">Setting Piece</h2>
                <button class="p-1.5 hover:bg-gray-100 rounded-lg transition-colors">
                    <i class="oi oi-fullscreen-enter text-gray-500 text-sm"></i>
                </button>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead class="bg-gray-50 border-b border-gray-200">
                        <tr>
                            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">S.N.</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Order No.</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Style</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Start Date</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        @foreach (var setting in SettingPieceData)
                        {
                            <tr class="hover:bg-gray-50 transition-colors">
                                <td class="px-4 py-3 text-sm text-gray-900">@setting.SN</td>
                                <td class="px-4 py-3 text-sm font-medium text-gray-900">@setting.OrderNo</td>
                                <td class="px-4 py-3 text-sm text-gray-600">@setting.Style</td>
                                <td class="px-4 py-3 text-sm text-gray-600">@setting.StartDate.ToString("yyyy-MM-dd")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
