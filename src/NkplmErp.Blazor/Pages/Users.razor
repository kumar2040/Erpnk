@page "/manage-users"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<PageTitle>Users Management | NKPLM ERP</PageTitle>

<style>
    .content-wrapper {
        max-width: none !important;
        width: 100% !important;
        padding: 0 !important;
    }
    
    .content {
        padding: 0 !important;
    }
</style>

<div class="bg-gray-50 min-h-screen" style="padding: 5px;">
    <!-- Header -->
    <div class="flex items-center justify-between mb-6 px-4 py-4 bg-white rounded-2xl shadow-sm border border-gray-200">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">Users Management</h1>
            <p class="text-sm text-gray-600 mt-1">Manage system users, roles, and permissions</p>
        </div>
        <button @onclick="OpenCreateModal" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors flex items-center gap-2">
            <i class="oi oi-plus"></i>
            Add User
        </button>
    </div>

    <!-- Search and Filter -->
    <div class="mb-4 px-4 py-4 bg-white rounded-2xl shadow-sm border border-gray-200">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div>
                <input @bind="searchTerm" @bind:event="oninput" @onkeyup="FilterUsers" 
                       type="text" placeholder="Search by name or email..." 
                       class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" />
            </div>
            <div>
                <select value="@statusFilter" @onchange="@(e => { statusFilter = e.Value?.ToString() ?? "all"; FilterUsers(); })" 
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                    <option value="all">All Status</option>
                    <option value="active">Active Only</option>
                    <option value="inactive">Inactive Only</option>
                </select>
            </div>
            <div class="flex items-center justify-end">
                <span class="text-sm text-gray-600">Total: @filteredUsers.Count() users</span>
            </div>
        </div>
    </div>

    <!-- Users Table -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
        <div class="grid-container" style="min-height: 400px;">
            <QuickGrid Items="@filteredUsers.AsQueryable()" IsVirtualizing="false" class="w-full text-sm text-left border-collapse">
                <PropertyColumn Property="@(u => u.FullName)" Title="Full Name" Sortable="true" class="px-4 py-4 font-medium text-gray-900 border-b border-gray-100" />
                <PropertyColumn Property="@(u => u.Email)" Title="Email" Sortable="true" class="px-4 py-4 text-gray-600 border-b border-gray-100" />
                
                <TemplateColumn Title="Roles" class="px-4 py-4 border-b border-gray-100">
                    <div class="flex flex-wrap gap-1">
                        @if (context.Roles.Any())
                        {
                            @foreach (var role in context.Roles)
                            {
                                <span class="px-2 py-0.5 text-[10px] font-semibold bg-indigo-50 text-indigo-700 rounded-full border border-indigo-100">@role</span>
                            }
                        }
                        else
                        {
                            <span class="text-gray-400 text-[10px]">No roles</span>
                        }
                    </div>
                </TemplateColumn>

                <TemplateColumn Title="Status" Sortable="true" Property="@((UserListItemDto u) => u.IsActive)" class="px-4 py-4 border-b border-gray-100">
                    @if (context.IsActive)
                    {
                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-emerald-50 text-emerald-700 border border-emerald-100">
                            <span class="w-1.5 h-1.5 mr-1.5 rounded-full bg-emerald-500"></span>
                            Active
                        </span>
                    }
                    else
                    {
                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-slate-50 text-slate-600 border border-slate-200">
                            <span class="w-1.5 h-1.5 mr-1.5 rounded-full bg-slate-400"></span>
                            Inactive
                        </span>
                    }
                </TemplateColumn>

                <PropertyColumn Property="@(u => u.LastLoginAt)" Title="Last Login" Sortable="true" Format="yyyy-MM-dd HH:mm" class="px-4 py-4 text-gray-500 border-b border-gray-100" />

                <TemplateColumn Title="Actions" class="px-4 py-4 text-right border-b border-gray-100">
                    <div class="flex items-center justify-end gap-2">
                        <button @onclick="() => OpenEditModal(context.Id)" 
                                class="p-1.5 text-blue-600 hover:bg-blue-50 rounded-lg transition-colors border border-transparent hover:border-blue-100" title="Edit">
                            <i class="oi oi-pencil text-xs"></i>
                        </button>
                        <button @onclick="() => OpenDeleteConfirm(context.Id, context.FullName)" 
                                class="p-1.5 text-rose-600 hover:bg-rose-50 rounded-lg transition-colors border border-transparent hover:border-rose-100" title="Delete">
                            <i class="oi oi-trash text-xs"></i>
                        </button>
                    </div>
                </TemplateColumn>
            </QuickGrid>
        </div>

        @if (isLoading)
        {
            <div class="absolute inset-0 bg-white/60 backdrop-blur-[1px] flex items-center justify-center z-10 rounded-2xl">
                <div class="flex flex-col items-center">
                    <div class="w-10 h-10 border-4 border-blue-600/20 border-t-blue-600 rounded-full animate-spin"></div>
                    <p class="mt-3 text-sm font-medium text-gray-600">Syncing users...</p>
                </div>
            </div>
        }

        @if (!isLoading && errorMessage != null)
        {
            <div class="p-12 text-center">
                <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-rose-50 text-rose-600 mb-4">
                    <i class="oi oi-warning"></i>
                </div>
                <h3 class="text-sm font-semibold text-gray-900">Database synchronization failed</h3>
                <p class="mt-1 text-sm text-gray-500">@errorMessage</p>
                <button @onclick="LoadUsers" class="mt-6 px-4 py-2 bg-white border border-gray-300 rounded-lg text-sm font-medium text-gray-700 hover:bg-gray-50 shadow-sm transition-all focus:ring-2 focus:ring-blue-500">
                    Reconnect & Retry
                </button>
            </div>
        }

        @if (!isLoading && errorMessage == null && !filteredUsers.Any())
        {
            <div class="p-16 text-center">
                <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-gray-50 text-gray-400 mb-4 border border-gray-100">
                    <i class="oi oi-people text-xl"></i>
                </div>
                <h3 class="text-base font-medium text-gray-900">No users found</h3>
                <p class="mt-1 text-sm text-gray-500">Try adjusting your filters or search criteria.</p>
                @if (!string.IsNullOrEmpty(searchTerm))
                {
                    <button @onclick='() => { searchTerm = ""; }' class="mt-4 text-blue-600 text-sm font-medium hover:underline">
                        Clear search filter
                    </button>
                }
            </div>
        }
    </div>
</div>

<!-- User Form Modal -->
<Modal IsVisible="@showModal" 
       Title="@(isEditMode ? "Edit User" : "Create New User")"
       Size="2xl"
       OnClose="CloseModal">
    <ChildContent>
        @if (formErrorMessage != null)
        {
            <div class="mb-4 p-4 bg-red-50 border border-red-200 rounded-lg">
                <p class="text-sm text-red-600">@formErrorMessage</p>
            </div>
        }

        <div class="space-y-4">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">First Name</label>
                    <input @bind="formData.FirstName" type="text" 
                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Last Name</label>
                    <input @bind="formData.LastName" type="text" 
                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" />
                </div>
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
                <input @bind="formData.Email" type="email" 
                       class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" />
            </div>

            @if (!isEditMode)
            {
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Password</label>
                    <input @bind="formData.Password" type="password" 
                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" />
                </div>
            }

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Roles</label>
                <div class="space-y-2">
                    @foreach (var role in availableRoles)
                    {
                        <label class="flex items-center">
                            <input type="checkbox" 
                                   checked="@formData.Roles.Contains(role)"
                                   @onchange="@(e => ToggleRole(role, (bool)e.Value!))"
                                   class="rounded border-gray-300 text-blue-600 focus:ring-blue-500" />
                            <span class="ml-2 text-sm text-gray-700">@role</span>
                        </label>
                    }
                </div>
            </div>

            <div>
                <label class="flex items-center">
                    <input type="checkbox" @bind="formData.IsActive" 
                           class="rounded border-gray-300 text-blue-600 focus:ring-blue-500" />
                    <span class="ml-2 text-sm font-medium text-gray-700">Active</span>
                </label>
            </div>
        </div>
    </ChildContent>
    <FooterContent>
        <button @onclick="CloseModal" 
                class="px-4 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition-colors">
            Cancel
        </button>
        <button @onclick="SaveUser" disabled="@isSaving"
                class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
            @(isSaving ? "Saving..." : "Save")
        </button>
    </FooterContent>
</Modal>

<!-- Delete Confirmation Modal -->
<ConfirmDialog IsVisible="@showDeleteConfirm"
               Title="Delete User"
               Subtitle="This action cannot be undone"
               Type="danger"
               ConfirmText="Delete"
               IsProcessing="@isDeleting"
               OnConfirm="ConfirmDelete"
               OnCancel="CloseDeleteConfirm">
    <MessageContent>
        <p>Are you sure you want to delete <strong>@deleteUserName</strong>? This will deactivate the user account.</p>
    </MessageContent>
</ConfirmDialog>
