@page "/yarn-orders"
@* /yarn-orders/{id} opens that order straight away — used by the BOM task cards on /tasks. *@
@page "/yarn-orders/{YoId:int?}"
@using NkplmErp.Shared.DTOs

<PageTitle>Saved Yarn Orders</PageTitle>

@if (AccessDenied)
{
    <div class="yo-denied">
        <h3>Access denied</h3>
        <p>You don't have permission to view yarn orders.</p>
    </div>
}
else
{
    <div class="yo-wrap">

        <div class="yo-header">
            <h1 class="yo-title">Saved Yarn Orders <small>PLACED PURCHASE ORDERS</small></h1>

            @* Order-state filter. Options come from spDropdown 'YarnOrderStatus'
               (All="1" makes the proc supply the leading "All" row), so adding
               "Pending" later is a database change, not a redeploy. *@
            <AutoCompleteSelect Type="YarnOrderStatus"
                                All="0"
                                Value="@StatusFilter"
                                ValueChanged="OnStatusFilterChangedAsync" />
        </div>

        <div class="yo-split">

            @* ============ LEFT : ORDER LIST ============ *@
            <div class="yo-col">
                <div class="yo-col-head">
                    <div class="t"><span class="dot imp"></span> Yarn Orders</div>
                    <span class="count">@FilteredOrders.Count()</span>
                </div>
                <div class="yo-col-tools">
                    <input class="yo-input" placeholder="🔍 Search yarn order no" @bind="Search" @bind:event="oninput" />
                </div>
                <div class="yo-col-body">
                    @if (IsLoadingList)
                    {
                        <div class="yo-empty">Loading…</div>
                    }
                    else if (!FilteredOrders.Any())
                    {
                        <div class="yo-empty">No yarn orders placed yet.</div>
                    }
                    else
                    {
                        @foreach (var o in FilteredOrders)
                        {
                            var isSelected = Selected?.YoId == o.YoId;
                            @* Fixed id on whichever card is selected, so the /yarn-orders/{id}
                               deep link can scroll it into view. Only one is ever selected, so
                               it stays unique. Null = attribute omitted. *@
                            <div class="yo-card @(isSelected ? "active" : "")"
                                 id="@(isSelected ? "yo-selected-order" : null)"
                                 @onclick="@(() => SelectOrderAsync(o))">
                                <div class="row1">
                                    <span class="no">@o.YoNo</span>
                                    <span class="kg">@o.TotalKg.ToString("N2") kg</span>
                                </div>
                                <div>
                                    <span class="ordno">@o.order_no</span>
                                </div>
                                <div class="row2">
                                    <span class="date">@o.CreatedDate.ToString("dd MMM yyyy, HH:mm")</span>
                                    <span class="meta">@o.LineCount line · @o.OrderCount order</span>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            @* ============ RIGHT : DETAIL ============ *@
            <div class="yo-col yo-detail">
                <div class="yo-col-head">
                    <div class="t">
                        <span class="dot need"></span> Order Detail
                        @if (Selected != null)
                        {
                            <span class="ord-tag">@Selected.YoNo</span>
                        }
                    </div>
                </div>

                @if (Selected == null)
                {
                    <div class="yo-col-body"><div class="yo-empty">Select a yarn order on the left to view its lines.</div></div>
                }
                else
                {
                    <div class="yo-strip">
                        <div><div class="k">Placed</div><div class="v">@Selected.CreatedDate.ToString("dd MMM yyyy, HH:mm")</div></div>
                        @* "By" removed: created_by holds the raw user GUID, which is noise on screen. *@
                        <div><div class="k">Need</div><div class="v need">@Selected.TotalKg.ToString("N2") kg</div></div>
                        <div><div class="k">Order (cones)</div><div class="v imp">@DetailOrderKg.ToString("N0") kg</div></div>
                        <div><div class="k">Status</div><div class="v">@Selected.Status</div></div>
                    </div>
                    <div class="yo-col-body">
                        @if (Selected.Status == "Ready for Approval")
                        {
                            <div class="yo-status warn" style="background:#fffbe6; border:1px solid #ffe58f; color:#d48806; padding:10px 14px; border-radius:6px; margin-bottom:12px; display:flex; justify-content:space-between; align-items:center;">
                                <div>
                                    <b>Ready to request approval</b>
                                    <div style="font-size:0.85em; margin-top:2px;">Review this import list, then request approval from YarnControl.</div>
                                </div>
                                @if (IsYarn)
                                {
                                    <button class="dc-btn primary" style="background:#1890ff; border-color:#1890ff; padding:4px 12px; font-size:12px;"
                                            disabled="@notifyingYarnControl" @onclick="NotifyYarnControlAsync">
                                        @(notifyingYarnControl ? "Requesting…" : "📩 Request approval")
                                    </button>
                                }
                            </div>
                        }
                        else if (Selected.Status == "Pending Approval")
                        {
                            <div class="yo-status warn" style="background:#fffbe6; border:1px solid #ffe58f; color:#d48806; padding:10px 14px; border-radius:6px; margin-bottom:12px; display:flex; justify-content:space-between; align-items:center;">
                                <div>
                                    <b>⏳ Pending YarnControl approval</b>
                                    <div style="font-size:0.85em; margin-top:2px;">This yarn order must be approved by the YarnControl role before vendor orders can be placed.</div>
                                </div>
                                <div style="display:flex; gap:8px;">
                                    @if (IsYarnControl)
                                    {
                                        <button class="dc-btn primary" style="background:#52c41a; border-color:#52c41a; padding:4px 12px; font-size:12px;"
                                                disabled="@approving" @onclick="() => OpenApprovalModal(true)">
                                            ✓ Accept Approval
                                        </button>
                                        <button class="dc-btn danger" style="padding:4px 12px; font-size:12px;"
                                                disabled="@approving" @onclick="() => OpenApprovalModal(false)">
                                            ✕ Reject
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                        else if (Selected.Status == "Approved" && !VendorOrders.Any())
                        {
                            <div class="yo-status ok" style="background:#f6ffed; border:1px solid #b7eb8f; color:#389e0d; padding:10px 14px; border-radius:6px; margin-bottom:12px; font-weight:600;">
                                @if (IsYarnControl)
                                {
                                    <span>✓ Approved by YarnControl — Saksham can now place vendor orders.</span>
                                }
                                else
                                {
                                    <span>✓ Approved by YarnControl — Ready to place vendor orders below.</span>
                                }
                            </div>
                        }
                        else if (VendorOrders.Any(v => !v.IsInvoiced))
                        {
                            var firstVendor = VendorOrders.FirstOrDefault(v => !v.IsInvoiced) ?? VendorOrders.First();
                            <div class="yo-status ok" style="background:#e6f7ff; border:1px solid #91d5ff; color:#0050b3; margin-bottom:12px; padding:10px 14px; border-radius:6px;">
                                <div style="font-weight:600; display:flex; justify-content:space-between; align-items:center;">
                                    <span>📦 Vendor Order Placed: <b>@firstVendor.VyoNo</b> @(string.IsNullOrWhiteSpace(firstVendor.Vendor) ? "" : $"({firstVendor.Vendor})")</span>
                                    <span style="font-size:0.85em; background:#bae7ff; color:#003a8c; padding:2px 8px; border-radius:4px; font-weight:bold;">@firstVendor.TotalKg.ToString("N2") kg</span>
                                </div>
                                @if (firstVendor.DepartureDate.HasValue || firstVendor.ArrivalDate.HasValue)
                                {
                                    <div style="font-size:0.85em; margin-top:6px; display:flex; gap:16px;">
                                        @if (firstVendor.DepartureDate.HasValue)
                                        {
                                            <span>✈ <b>Departure:</b> @firstVendor.DepartureDate.Value.ToString("dd MMM yyyy")</span>
                                        }
                                        @if (firstVendor.ArrivalDate.HasValue)
                                        {
                                            <span>📦 <b>ETA Arrival:</b> @firstVendor.ArrivalDate.Value.ToString("dd MMM yyyy")</span>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        else if (Selected.Status == "Completed" || (VendorOrders.Any() && VendorOrders.All(v => v.IsInvoiced)))
                        {
                            var invVendor = VendorOrders.FirstOrDefault(v => v.IsInvoiced);
                            <div class="yo-status ok" style="background:#f6ffed; border:1px solid #b7eb8f; color:#275a13; padding:10px 14px; border-radius:6px; margin-bottom:12px;">
                                <div style="font-weight:600;">🎉 Yarn Arrived & Completed</div>
                                @if (invVendor != null)
                                {
                                    <div style="font-size:0.85em; margin-top:2px;">Invoice #<b>@invVendor.InvoiceNo</b> · @(invVendor.Weight?.ToString("N2") ?? invVendor.TotalKg.ToString("N2")) kg · Ready for Knitting / Planning.</div>
                                }
                            </div>
                        }
                        else if (Selected.Status == "Rejected")
                        {
                            <div class="yo-status err" style="margin-bottom:12px;">
                                ❌ Rejected by YarnControl
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(StatusMessage))
                        {
                            <div class="yo-status @(IsError ? "err" : "ok")">@StatusMessage</div>
                        }

                        @if (IsLoadingDetail)
                        {
                            <div class="yo-empty">Loading detail…</div>
                        }
                        else if (!Detail.Any())
                        {
                            <div class="yo-empty">No lines on this order.</div>
                        }
                        else
                        {
                            @if (VendorOrders.Any())
                            {
                                <div class="vplaced">
                                    <div class="vplaced-h">Placed vendor orders</div>
                                    @foreach (var v in VendorOrders)
                                    {
                                        <div class="vplaced-card">
                                            <div class="vplaced-row">
                                                <span class="vno">@v.VyoNo</span>
                                                <span class="vname">@(string.IsNullOrWhiteSpace(v.Vendor) ? "—" : v.Vendor)</span>
                                                <span class="vmeta">@v.LineCount line · @v.TotalKg.ToString("N2") kg</span>
                                                @* The badge tracks the invoice, not the stored status column: no invoice
                                                   means the yarn is still with the vendor however long ago it was placed. *@
                                                <span class="vstat @(v.IsInvoiced ? "done" : "wait")">@(v.IsInvoiced ? "Completed" : "Ordered")</span>
                                                <button class="vxl-btn" title="Download Excel PO" @onclick="@(() => DownloadVendorExcelAsync(v))">⬇ Excel</button>
                                            </div>
                                            <div class="vlife">
                                                <label class="vlife-lbl">Departure</label>
                                                <input type="date" class="vlife-date" value="@DepartureEdit.GetValueOrDefault(v.VyoId)"
                                                       @onchange="@(e => DepartureEdit[v.VyoId] = e.Value?.ToString() ?? "")" />
                                                <button class="vlife-save" @onclick="@(() => SaveDepartureAsync(v))">Save</button>

                                                <label class="vlife-lbl">Arrival</label>
                                                <input type="date" class="vlife-date" value="@ArrivalEdit.GetValueOrDefault(v.VyoId)"
                                                       @onchange="@(e => ArrivalEdit[v.VyoId] = e.Value?.ToString() ?? "")" />
                                                <button class="vlife-save" @onclick="@(() => SaveArrivalAsync(v))">Save</button>

                                                @* Arrived = "the yarn physically arrived from the vendor": invoice,
                                                   weight, pragyapan no, LC/TT no, saved together via sp_ManageYarnOrder
                                                   flag 'I'. Saved ones collapse to a read-only summary; Edit reopens
                                                   the modal pre-filled for a correction. *@
                                                @if (v.IsInvoiced)
                                                {
                                                    <label class="vlife-lbl done">Arrived</label>
                                                    <div class="vlife-arrived">
                                                        <span class="vlife-arrived-item"><span class="k">Invoice</span>@v.InvoiceNo</span>
                                                        <span class="vlife-arrived-item"><span class="k">Weight</span>@(v.Weight?.ToString("N2") ?? "—") kg</span>
                                                        <span class="vlife-arrived-item"><span class="k">Pragyapan</span>@(v.PragyapanNo ?? "—")</span>
                                                        <span class="vlife-arrived-item"><span class="k">LC/TT</span>@(v.LcTtNo ?? "—")</span>
                                                    </div>
                                                    <button class="vlife-edit" title="Correct these arrival details"
                                                            @onclick="@(() => OpenArrivedModal(v))">Edit</button>
                                                }
                                                else
                                                {
                                                    <button class="vlife-arrive" disabled="@(arrivedSaving)" @onclick="@(() => OpenArrivedModal(v))">📦 Arrived</button>
                                                }

                                                @if (IsYarn)
                                                {
                                                    <button class="vlife-drop" title="Vendor dropped a color" @onclick="@(() => OpenDropModal(v))">⚠ Drop color</button>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }

                            @foreach (var vg in VendorGroups)
                            {
                                var placed = VendorPlaced(vg.Key);
                                var canPlace = vg.Key != "— No vendor —"
                                            && !placed
                                            && CanShowVendorOrdering(Selected.Status, IsYarn);
                                <div class="vgroup">
                                    <div class="vhead">
                                        <div class="vh-left">
                                            <span class="vh-name">@vg.Key</span>
                                            <span class="vh-meta">@vg.Count() line · @vg.Sum(x => x.ImportKg).ToString("N2") kg</span>
                                        </div>
                                        @if (placed)
                                        {
                                            <span class="vh-badge done">✓ ordered</span>
                                        }
                                        else if (canPlace)
                                        {
                                            <button class="vh-btn" disabled="@(PlacingVendor != null)"
                                                    @onclick="@(() => PlaceVendorOrderAsync(vg.Key, vg.ToList()))">
                                                @(PlacingVendor == vg.Key ? "Placing…" : "📦 Place order")
                                            </button>
                                        }
                                        else if (vg.Key == Unassigned)
                                        {
                                            <span class="vh-badge muted">no vendor</span>
                                        }
                                        else if (string.Equals(Selected.Status, "Approved", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="vh-badge done" style="color:#389e0d; background:#f6ffed; border:1px solid #b7eb8f; padding:2px 8px; border-radius:4px; font-size:11px;">✓ Approved</span>
                                        }
                                        else
                                        {
                                            <span class="vh-badge wait" style="color:#d48806; background:#fffbe6; border:1px solid #ffe58f; padding:2px 8px; border-radius:4px; font-size:11px;">⏳ Awaiting YarnControl approval</span>
                                        }
                                    </div>
                                    <table class="yo-table">
                                        <tbody>
                                            @foreach (var d in vg)
                                            {
                                                <tr>
                                                    <td class="l"><span class="yname">@d.Display</span></td>
                                                    <td class="l">
                                                        <span class="colorcell">@d.Color</span>
                                                    </td>
                                                    <td class="l"><span class="ochip">@d.OrderNo</span></td>
                                                    <td>@d.ImportKg.ToString("N2")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        }
                    </div>
                }
            </div>

        </div>

        @* ---- Drop-color modal (multi-select; persistence deferred server-side) ---- *@
        @if (showDropModal && dropVendor is not null)
        {
            <div class="dc-overlay" @onclick="CloseDropModal">
                <div class="dc-card" @onclick:stopPropagation="true">
                    <div class="dc-head">
                        <div class="dc-head-l"><span class="dc-ic">⚠</span><span>Drop a color</span></div>
                        <button class="dc-x" @onclick="CloseDropModal" aria-label="Close">✕</button>
                    </div>
                    <div class="dc-body">
                        <div class="dc-ctx">Vendor order <b>@dropVendor.VyoNo</b>@(string.IsNullOrWhiteSpace(dropVendor.Vendor) ? "" : $" · {dropVendor.Vendor}")</div>
                        <div class="dc-help">Select the color(s) the vendor can’t supply.</div>

                        @if (dropItems.Count == 0)
                        {
                            <div class="dc-empty">No color lines found for this vendor order.</div>
                        }
                        else
                        {
                            <div class="dc-sec">Ordered colors <span class="dc-cnt">@dropItems.Count</span></div>
                            <div class="dc-list">
                                @foreach (var item in dropItems)
                                {
                                    var on = dropSelected.Contains(item.Color);
                                    <label class="dc-row @(on ? "sel" : "")">
                                        <input type="checkbox" class="dc-cb" checked="@on"
                                               @onchange="@(e => ToggleDrop(item.Color, (bool)(e.Value ?? false)))" />
                                        <div class="dc-cinfo">
                                            <div class="dc-cname">@item.Color</div>
                                            <div class="dc-cmeta">@item.Yarn@(string.IsNullOrWhiteSpace(item.Ply) ? "" : $" · {item.Ply} ply")</div>
                                        </div>
                                        <span class="dc-qty">@item.Qty.ToString("N2") kg</span>
                                        @if (on)
                                        {
                                            <span class="dc-chip">TO DROP</span>
                                        }
                                    </label>
                                }
                            </div>
                        }

                        <label class="dc-note-l">Note <span>(optional)</span></label>
                        <textarea class="dc-note" @bind="dropNote" placeholder="e.g. vendor confirmed this shade is out of stock"></textarea>
                    </div>
                    <div class="dc-foot">
                        <span class="dc-status-txt">@(dropSelected.Count == 0 ? "No color selected" : $"{dropSelected.Count} selected")</span>
                        <button class="dc-btn ghost" @onclick="CloseDropModal">Cancel</button>
                        <button class="dc-btn danger" disabled="@(dropSelected.Count == 0 || dropping)" @onclick="OpenDropConfirm">
                            @(dropping ? "Dropping…" : "⚠ Drop selected")
                        </button>
                    </div>
                </div>
            </div>
        }

        @* ---- Reusable confirm step before actually dropping (Shared/Components/ConfirmModal) ---- *@
        <ConfirmModal IsVisible="showDropConfirm"
                      Title="Drop these colors?"
                      Icon="⚠"
                      Danger="true"
                      ConfirmText="@($"⚠ Yes, drop {dropSelected.Count} color(s)")"
                      BusyText="Dropping…"
                      Busy="dropping"
                      OnResult="OnDropConfirmResult">
            <div class="dcf-sub">On vendor order <b>@dropVendor?.VyoNo</b>@(string.IsNullOrWhiteSpace(dropVendor?.Vendor) ? "" : $" · {dropVendor!.Vendor}")</div>
            <div class="dcf-lbl">@dropSelected.Count color(s) selected</div>
            <div class="dcf-pills">
                @foreach (var c in dropSelected)
                {
                    <span class="dcf-pill">@c</span>
                }
            </div>
            <div class="dcf-note">This flags the color(s) as dropped by the vendor. Nothing is deleted.</div>
        </ConfirmModal>

        @* ---- Arrived details modal (Client invoice, Weight, Pragyapan no, LC/TT no).
               Saved together via sp_ManageYarnOrder flag 'I' (IYarnOrderManager.SaveInvoiceAsync). ---- *@
        @if (showArrivedModal && arrivedVendor is not null)
        {
            <div class="dc-overlay" @onclick="CloseArrivedModal">
                <div class="dc-card" @onclick:stopPropagation="true">
                    <div class="dc-head">
                        <div class="dc-head-l"><span class="dc-ic">📦</span><span>Mark as arrived</span></div>
                        <button class="dc-x" @onclick="CloseArrivedModal" aria-label="Close">✕</button>
                    </div>
                    <div class="dc-body">
                        <div class="dc-ctx">Vendor order <b>@arrivedVendor.VyoNo</b>@(string.IsNullOrWhiteSpace(arrivedVendor.Vendor) ? "" : $" · {arrivedVendor.Vendor}")</div>

                        <label class="dc-note-l">Client invoice</label>
                        <input class="vlife-inv arr-full" placeholder="Invoice no" maxlength="50"
                               value="@ArrivedInvoiceEdit.GetValueOrDefault(arrivedVendor.VyoId)"
                               @onchange="@(e => ArrivedInvoiceEdit[arrivedVendor.VyoId] = e.Value?.ToString() ?? "")" />

                        <div class="arr-row2">
                            <div>
                                <label class="dc-note-l">Weight (kg)</label>
                                <input class="vlife-inv arr-full" placeholder="0.00" maxlength="20"
                                       value="@ArrivedWeightEdit.GetValueOrDefault(arrivedVendor.VyoId)"
                                       @onchange="@(e => ArrivedWeightEdit[arrivedVendor.VyoId] = e.Value?.ToString() ?? "")" />
                            </div>
                            <div>
                                <label class="dc-note-l">Pragyapan no</label>
                                <input class="vlife-inv arr-full" placeholder="Pragyapan no" maxlength="50"
                                       value="@ArrivedPragyapanEdit.GetValueOrDefault(arrivedVendor.VyoId)"
                                       @onchange="@(e => ArrivedPragyapanEdit[arrivedVendor.VyoId] = e.Value?.ToString() ?? "")" />
                            </div>
                        </div>

                        <label class="dc-note-l">LC / TT no</label>
                        <input class="vlife-inv arr-full" placeholder="LC / TT no" maxlength="50"
                               value="@ArrivedLcTtEdit.GetValueOrDefault(arrivedVendor.VyoId)"
                               @onchange="@(e => ArrivedLcTtEdit[arrivedVendor.VyoId] = e.Value?.ToString() ?? "")" />
                    </div>
                    <div class="dc-foot">
                        <button class="dc-btn ghost" @onclick="CloseArrivedModal">Cancel</button>
                        <button class="dc-btn primary" @onclick="OpenArrivedConfirm">Continue</button>
                    </div>
                </div>
            </div>
        }

        @* ---- Confirm step before the arrived details are actually saved. ---- *@
        <ConfirmModal IsVisible="showArrivedConfirm"
                      Title="Confirm arrival details"
                      Icon="📦"
                      ConfirmText="✓ Yes, save"
                      BusyText="Saving…"
                      Busy="arrivedSaving"
                      OnResult="OnArrivedConfirmResult">
            <div class="dcf-sub">On vendor order <b>@arrivedVendor?.VyoNo</b>@(string.IsNullOrWhiteSpace(arrivedVendor?.Vendor) ? "" : $" · {arrivedVendor!.Vendor}")</div>
            <div class="dcf-note">
                Invoice <b>@ArrivedInvoiceEdit.GetValueOrDefault(arrivedVendor?.VyoId ?? 0)</b> ·
                @(ArrivedWeightEdit.GetValueOrDefault(arrivedVendor?.VyoId ?? 0)) kg ·
                Pragyapan <b>@ArrivedPragyapanEdit.GetValueOrDefault(arrivedVendor?.VyoId ?? 0)</b> ·
                LC/TT <b>@ArrivedLcTtEdit.GetValueOrDefault(arrivedVendor?.VyoId ?? 0)</b>
            </div>
        </ConfirmModal>

        @* ---- Confirm step for YarnControl approval / rejection. ---- *@
        <ConfirmModal IsVisible="showApprovalConfirm"
                      Title="@(isApprovingAction ? "Accept Yarn Order Approval?" : "Reject Yarn Order?")"
                      Icon="@(isApprovingAction ? "✓" : "✕")"
                      Danger="@(!isApprovingAction)"
                      ConfirmText="@(isApprovingAction ? "✓ Yes, Accept" : "✕ Yes, Reject")"
                      BusyText="Processing…"
                      Busy="approving"
                      OnResult="OnApprovalConfirmResult">
            <div class="dcf-sub">Yarn Order <b>@Selected?.YoNo</b></div>
            @if (!isApprovingAction)
            {
                <div style="margin-top:10px;">
                    <label style="display:block; font-size:12px; font-weight:600; margin-bottom:4px;">Rejection Note / Reason (optional):</label>
                    <textarea class="dc-note" style="width:100%; font-size:12px;" @bind="approvalNote" placeholder="Enter reason for rejection..."></textarea>
                </div>
            }
            else
            {
                <div class="dcf-note">Accepting will approve this yarn order and allow yarn users to place vendor sub-orders.</div>
            }
        </ConfirmModal>
    </div>
}
