@page "/yarn-orders"
@* /yarn-orders/{id} opens that order straight away — used by the BOM task cards on /tasks. *@
@page "/yarn-orders/{YoId:int?}"
@using NkplmErp.Shared.DTOs

<PageTitle>Saved Yarn Orders</PageTitle>

@if (AccessDenied)
{
    <div class="yo-denied">
        <h3>Access denied</h3>
        <p>You don't have permission to view yarn orders.</p>
    </div>
}
else
{
    <div class="yo-wrap">

        <div class="yo-header">
            <h1 class="yo-title">Saved Yarn Orders <small>PLACED PURCHASE ORDERS</small></h1>

            @* Order-state filter. Options come from spDropdown 'YarnOrderStatus'
               (All="1" makes the proc supply the leading "All" row), so adding
               "Pending" later is a database change, not a redeploy. *@
            <AutoCompleteSelect Type="YarnOrderStatus"
                                All="0"
                                Value="@StatusFilter"
                                ValueChanged="OnStatusFilterChangedAsync" />
        </div>

        <div class="yo-split">

            @* ============ LEFT : ORDER LIST ============ *@
            <div class="yo-col">
                <div class="yo-col-head">
                    <div class="t"><span class="dot imp"></span> Yarn Orders</div>
                    <span class="count">@FilteredOrders.Count()</span>
                </div>
                <div class="yo-col-tools">
                    <input class="yo-input" placeholder="🔍 Search yarn order no" @bind="Search" @bind:event="oninput" />
                </div>
                <div class="yo-col-body">
                    @if (IsLoadingList)
                    {
                        <div class="yo-empty">Loading…</div>
                    }
                    else if (!FilteredOrders.Any())
                    {
                        <div class="yo-empty">No yarn orders placed yet.</div>
                    }
                    else
                    {
                        @foreach (var o in FilteredOrders)
                        {
                            var isSelected = Selected?.YoId == o.YoId;
                            @* Fixed id on whichever card is selected, so the /yarn-orders/{id}
                               deep link can scroll it into view. Only one is ever selected, so
                               it stays unique. Null = attribute omitted. *@
                            <div class="yo-card @(isSelected ? "active" : "")"
                                 id="@(isSelected ? "yo-selected-order" : null)"
                                 @onclick="@(() => SelectOrderAsync(o))">
                                <div class="row1">
                                    <span class="no">@o.YoNo</span>
                                    <span class="kg">@o.TotalKg.ToString("N2") kg</span>
                                </div>
                                <div>
                                    <span class="ordno">@o.order_no</span>
                                </div>
                                <div class="row2">
                                    <span class="date">@o.CreatedDate.ToString("dd MMM yyyy, HH:mm")</span>
                                    <span class="meta">@o.LineCount line · @o.OrderCount order</span>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            @* ============ RIGHT : DETAIL ============ *@
            <div class="yo-col yo-detail">
                <div class="yo-col-head">
                    <div class="t">
                        <span class="dot need"></span> Order Detail
                        @if (Selected != null)
                        {
                            <span class="ord-tag">@Selected.YoNo</span>
                        }
                    </div>
                </div>

                @if (Selected == null)
                {
                    <div class="yo-col-body"><div class="yo-empty">Select a yarn order on the left to view its lines.</div></div>
                }
                else
                {
                    <div class="yo-strip">
                        <div><div class="k">Placed</div><div class="v">@Selected.CreatedDate.ToString("dd MMM yyyy, HH:mm")</div></div>
                        <div><div class="k">By</div><div class="v">@(string.IsNullOrWhiteSpace(Selected.CreatedBy) ? "—" : Selected.CreatedBy)</div></div>
                        <div><div class="k">Need</div><div class="v need">@Selected.TotalKg.ToString("N2") kg</div></div>
                        <div><div class="k">Order (cones)</div><div class="v imp">@DetailOrderKg.ToString("N0") kg</div></div>
                        <div><div class="k">Status</div><div class="v">@Selected.Status</div></div>
                    </div>
                    <div class="yo-col-body">
                        @if (!string.IsNullOrEmpty(StatusMessage))
                        {
                            <div class="yo-status @(IsError ? "err" : "ok")">@StatusMessage</div>
                        }

                        @if (IsLoadingDetail)
                        {
                            <div class="yo-empty">Loading detail…</div>
                        }
                        else if (!Detail.Any())
                        {
                            <div class="yo-empty">No lines on this order.</div>
                        }
                        else
                        {
                            @if (VendorOrders.Any())
                            {
                                <div class="vplaced">
                                    <div class="vplaced-h">Placed vendor orders</div>
                                    @foreach (var v in VendorOrders)
                                    {
                                        <div class="vplaced-card">
                                            <div class="vplaced-row">
                                                <span class="vno">@v.VyoNo</span>
                                                <span class="vname">@(string.IsNullOrWhiteSpace(v.Vendor) ? "—" : v.Vendor)</span>
                                                <span class="vmeta">@v.LineCount line · @v.TotalKg.ToString("N2") kg</span>
                                                @* The badge tracks the invoice, not the stored status column: no invoice
                                                   means the yarn is still with the vendor however long ago it was placed. *@
                                                <span class="vstat @(v.IsInvoiced ? "done" : "wait")">@(v.IsInvoiced ? "Completed" : "Pending")</span>
                                                <button class="vxl-btn" title="Download Excel PO" @onclick="@(() => DownloadVendorExcelAsync(v))">⬇ Excel</button>
                                            </div>
                                            <div class="vlife">
                                                <label class="vlife-lbl">Departure</label>
                                                <input type="date" class="vlife-date" value="@DepartureEdit.GetValueOrDefault(v.VyoId)"
                                                       @onchange="@(e => DepartureEdit[v.VyoId] = e.Value?.ToString() ?? "")" />
                                                <button class="vlife-save" @onclick="@(() => SaveDepartureAsync(v))">Save</button>

                                                <label class="vlife-lbl">Arrival</label>
                                                <input type="date" class="vlife-date" value="@ArrivalEdit.GetValueOrDefault(v.VyoId)"
                                                       @onchange="@(e => ArrivalEdit[v.VyoId] = e.Value?.ToString() ?? "")" />
                                                <button class="vlife-save" @onclick="@(() => SaveArrivalAsync(v))">Save</button>

                                                @* Invoice = "the yarn arrived from the vendor and is ready for use".
                                                   Saved ones collapse to a read-only chip so the number can't be
                                                   nudged by a stray keystroke; Edit reopens it for a correction. *@
                                                @if (v.IsInvoiced && InvoiceEditing != v.VyoId)
                                                {
                                                    <label class="vlife-lbl done">Invoice</label>
                                                    <span class="vlife-invno" title="@InvoiceTitle(v)">@v.InvoiceNo</span>
                                                    <button class="vlife-edit" title="Correct this invoice number"
                                                            @onclick="@(() => BeginInvoiceEdit(v))">Edit</button>
                                                }
                                                else
                                                {
                                                    <label class="vlife-lbl">Invoice</label>
                                                    <input class="vlife-inv" placeholder="Invoice no" maxlength="50"
                                                           value="@InvoiceEdit.GetValueOrDefault(v.VyoId)"
                                                           @onchange="@(e => InvoiceEdit[v.VyoId] = e.Value?.ToString() ?? "")" />
                                                    <button class="vlife-save" disabled="@(invoiceSaving)"
                                                            @onclick="@(() => OpenInvoiceConfirm(v))">Save</button>
                                                    @if (v.IsInvoiced)
                                                    {
                                                        <button class="vlife-cancel" @onclick="CancelInvoiceEdit">Cancel</button>
                                                    }
                                                }

                                                <button class="vlife-drop" title="Vendor dropped a color" @onclick="@(() => OpenDropModal(v))">⚠ Drop color</button>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }

                            @foreach (var vg in VendorGroups)
                            {
                                var placed = VendorPlaced(vg.Key);
                                var canPlace = vg.Key != "— No vendor —" && !placed;
                                <div class="vgroup">
                                    <div class="vhead">
                                        <div class="vh-left">
                                            <span class="vh-name">@vg.Key</span>
                                            <span class="vh-meta">@vg.Count() line · @vg.Sum(x => x.ImportKg).ToString("N2") kg</span>
                                        </div>
                                        @if (placed)
                                        {
                                            <span class="vh-badge done">✓ ordered</span>
                                        }
                                        else if (canPlace)
                                        {
                                            <button class="vh-btn" disabled="@(PlacingVendor != null)"
                                                    @onclick="@(() => PlaceVendorOrderAsync(vg.Key, vg.ToList()))">
                                                @(PlacingVendor == vg.Key ? "Placing…" : "📦 Place order")
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="vh-badge muted">no vendor</span>
                                        }
                                    </div>
                                    <table class="yo-table">
                                        <tbody>
                                            @foreach (var d in vg)
                                            {
                                                <tr>
                                                    <td class="l"><span class="yname">@d.Display</span></td>
                                                    <td class="l">
                                                        <span class="colorcell">@d.Color</span>
                                                        @if (!string.IsNullOrWhiteSpace(d.Ply))
                                                        {
                                                            <span class="sub">@d.Ply ply</span>
                                                        }
                                                    </td>
                                                    <td class="l"><span class="ochip">@d.OrderNo</span></td>
                                                    <td>@d.ImportKg.ToString("N2")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        }
                    </div>
                }
            </div>

        </div>

        @* ---- Drop-color modal (multi-select; persistence deferred server-side) ---- *@
        @if (showDropModal && dropVendor is not null)
        {
            <div class="dc-overlay" @onclick="CloseDropModal">
                <div class="dc-card" @onclick:stopPropagation="true">
                    <div class="dc-head">
                        <div class="dc-head-l"><span class="dc-ic">⚠</span><span>Drop a color</span></div>
                        <button class="dc-x" @onclick="CloseDropModal" aria-label="Close">✕</button>
                    </div>
                    <div class="dc-body">
                        <div class="dc-ctx">Vendor order <b>@dropVendor.VyoNo</b>@(string.IsNullOrWhiteSpace(dropVendor.Vendor) ? "" : $" · {dropVendor.Vendor}")</div>
                        <div class="dc-help">Select the color(s) the vendor can’t supply.</div>

                        @if (dropItems.Count == 0)
                        {
                            <div class="dc-empty">No color lines found for this vendor order.</div>
                        }
                        else
                        {
                            <div class="dc-sec">Ordered colors <span class="dc-cnt">@dropItems.Count</span></div>
                            <div class="dc-list">
                                @foreach (var item in dropItems)
                                {
                                    var on = dropSelected.Contains(item.Color);
                                    <label class="dc-row @(on ? "sel" : "")">
                                        <input type="checkbox" class="dc-cb" checked="@on"
                                               @onchange="@(e => ToggleDrop(item.Color, (bool)(e.Value ?? false)))" />
                                        <div class="dc-cinfo">
                                            <div class="dc-cname">@item.Color</div>
                                            <div class="dc-cmeta">@item.Yarn@(string.IsNullOrWhiteSpace(item.Ply) ? "" : $" · {item.Ply} ply")</div>
                                        </div>
                                        <span class="dc-qty">@item.Qty.ToString("N2") kg</span>
                                        @if (on)
                                        {
                                            <span class="dc-chip">TO DROP</span>
                                        }
                                    </label>
                                }
                            </div>
                        }

                        <label class="dc-note-l">Note <span>(optional)</span></label>
                        <textarea class="dc-note" @bind="dropNote" placeholder="e.g. vendor confirmed this shade is out of stock"></textarea>
                    </div>
                    <div class="dc-foot">
                        <span class="dc-status-txt">@(dropSelected.Count == 0 ? "No color selected" : $"{dropSelected.Count} selected")</span>
                        <button class="dc-btn ghost" @onclick="CloseDropModal">Cancel</button>
                        <button class="dc-btn danger" disabled="@(dropSelected.Count == 0 || dropping)" @onclick="OpenDropConfirm">
                            @(dropping ? "Dropping…" : "⚠ Drop selected")
                        </button>
                    </div>
                </div>
            </div>
        }

        @* ---- Reusable confirm step before actually dropping (Shared/Components/ConfirmModal) ---- *@
        <ConfirmModal IsVisible="showDropConfirm"
                      Title="Drop these colors?"
                      Icon="⚠"
                      Danger="true"
                      ConfirmText="@($"⚠ Yes, drop {dropSelected.Count} color(s)")"
                      BusyText="Dropping…"
                      Busy="dropping"
                      OnResult="OnDropConfirmResult">
            <div class="dcf-sub">On vendor order <b>@dropVendor?.VyoNo</b>@(string.IsNullOrWhiteSpace(dropVendor?.Vendor) ? "" : $" · {dropVendor!.Vendor}")</div>
            <div class="dcf-lbl">@dropSelected.Count color(s) selected</div>
            <div class="dcf-pills">
                @foreach (var c in dropSelected)
                {
                    <span class="dcf-pill">@c</span>
                }
            </div>
            <div class="dcf-note">This flags the color(s) as dropped by the vendor. Nothing is deleted.</div>
        </ConfirmModal>

        @* ---- Invoice confirm. Typing a number is a claim that the yarn physically arrived,
               so it never saves straight from the input — a typo would silently complete an
               order. Clearing one is the reverse claim, so it gets the destructive styling. ---- *@
        <ConfirmModal IsVisible="showInvoiceConfirm"
                      Title="@(IsClearingInvoice ? "Clear this invoice?" : "Confirm this yarn has arrived")"
                      Icon="@(IsClearingInvoice ? "⚠" : "📦")"
                      Danger="IsClearingInvoice"
                      ConfirmText="@(IsClearingInvoice ? "⚠ Yes, reopen it" : "✓ Yes, it arrived")"
                      BusyText="Saving…"
                      Busy="invoiceSaving"
                      OnResult="OnInvoiceConfirmResult">
            <div class="dcf-sub">On vendor order <b>@invoiceVendor?.VyoNo</b>@(string.IsNullOrWhiteSpace(invoiceVendor?.Vendor) ? "" : $" · {invoiceVendor!.Vendor}")</div>

            @if (IsClearingInvoice)
            {
                <div class="dcf-note">
                    Removing invoice <b>@invoiceVendor?.InvoiceNo</b> puts this vendor order back to
                    pending, and @(invoiceVendor?.TotalKg.ToString("N2")) kg stops counting as received.
                </div>
            }
            else
            {
                <div class="inv-box">
                    <div class="inv-k">Invoice number</div>
                    <div class="inv-v">@PendingInvoiceNo</div>
                </div>
                <div class="dcf-note">
                    Saving this marks @(invoiceVendor?.TotalKg.ToString("N2")) kg as received and ready for use.
                    @if (InvoiceCompletesOrder)
                    {
                        <text>
                            This is the last uninvoiced vendor order, so <b>@Selected?.YoNo</b> becomes
                            completed and a planning task is raised.
                        </text>
                    }
                    else
                    {
                        <text>
                            @OtherOpenVendorCount other vendor order(s) are still uninvoiced, so
                            <b>@Selected?.YoNo</b> stays pending.
                        </text>
                    }
                </div>
            }
        </ConfirmModal>
    </div>
}
