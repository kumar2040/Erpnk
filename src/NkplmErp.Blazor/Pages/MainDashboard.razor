                    <button type="button" class="text-blue-600 hover:text-blue-800 hover:underline text-left text-xs" @onclick="() => ShowYearlyHistory(context)">
                        @context.Year
                    </button>
                </TemplateColumn>

            <PropertyColumn Property="@(h => h.Knit)" Title="knit" Sortable="true" Align="Align.Right" />
            <PropertyColumn Property="@(h => h.Weave)" Title="Weave" Sortable="true" Align="Align.Right" />
            <PropertyColumn Property="@(h => h.Silk)" Title="Silk" Sortable="true" Align="Align.Right" />
            <PropertyColumn Property="@(h => h.Linen)" Title="Linen" Sortable="true" Align="Align.Right" />
            <PropertyColumn Property="@(h => h.Other)" Title="Other" Sortable="true" Align="Align.Right" />
             <PropertyColumn Property="@(h => h.NoofPos)" Title="No of POs" Sortable="true"  Align="Align.Right"/>
            <PropertyColumn Property="@(h => h.TotalWeight)" Title="Total Weight" Sortable="true" Align="Align.Right" />
            <PropertyColumn Property="@(h => h.TotalPcs)" Title="Total Qty" Sortable="true" Align="Align.Right" />
           
        </QuickGrid>

        @if (!SelectedBuyerHistory.Any() && !IsHistoryLoading)
        {
            <div class="py-12 text-center text-gray-400">
                <span class="oi oi-inbox text-3xl block mb-2 opacity-10"></span>
                <p class="text-xs font-medium">No history found for this buyer</p>
            </div>
        }
    </div>
</DataModal>
