@page "/main-dashboard"
@page "/dashboard"
@page "/"
@using Microsoft.AspNetCore.Components.QuickGrid
@using NkplmErp.Shared.DTOs
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<style>
    /* Premium Midnight Blue Theme Matching Mockup */
    :root {
        --midnight-blue: #002d54;
        --card-bg: #ffffff;
        --grid-header-bg: #002d54;
        --header-bg: #e5f1fd !important; /* Slightly more saturated light blue */
    }
    .col-proj-prod div,.col-qty-prod div,.col-ship-prod div{
        float:right;
    }

    /* Styling for QuickGrid specifically */
    .quick-grid {
        width: 100%;
        border-collapse: collapse;
    }

    .quick-grid thead th {
        background-color: var(--grid-header-bg) !important;
        color: white !important;
        font-size: 0.7rem !important;
        font-weight: 700 !important;
        text-transform: uppercase !important;
        letter-spacing: 0.05em !important;
        padding: 0.2rem 0.3rem !important;
        border: none !important;
        white-space: nowrap !important;
        border-radius: 0 !important;
    }

    .quick-grid tbody td, 
    .quick-grid tbody td *,
    table td,
    table td * {
        padding: 0.12rem 0.3rem !important;
        font-size: 0.75rem !important;
        color: #374151 !important;
        border-bottom: 1px solid #f3f4f6 !important;
        vertical-align: middle !important;
        white-space: nowrap !important;
        word-break: keep-all !important;
        overflow-wrap: normal !important;
    }

    /* Alternating row colors */
    .quick-grid tr:nth-child(even) td {
        background-color: #f8fafc !important;
    }

    .quick-grid tr:hover td {
        background-color: #eef2ff !important;
    }

    /* Column Alignment Fixes for Right-Aligned Sortable Columns */
    ::deep .col-dashboard-right {
        text-align: right !important;
        padding-right: 1.15rem !important; /* Synchronizes data cells with sortable header title */
    }

    /* Ensure specific horizontal padding for headers to match */
    .quick-grid thead th.col-dashboard-right {
        padding-right: 0.4rem !important; /* Header uses padding to contain the sort button */
    }

    /* Production Status Specific Column Widths & Alignment */
    ::deep .col-sn-prod { width: 30px; text-align: center; }
    ::deep .col-customer-prod { width: auto; min-width: 150px; }
    ::deep .col-order-prod { width: auto; min-width: 100px; }
    
    ::deep .text-right {
        text-align: right !important;
    }

    /* Force QuickGrid headers to align right when text-right is used */
    ::deep th.text-right .col-header-content,
    ::deep th.text-right .col-title {
        display: flex !important;
        justify-content: flex-end !important;
        text-align: right !important;
        width: 100% !important;
        padding-right: 0.5rem !important;
    }

    ::deep th.text-right .col-title-text {
        text-align: right !important;
        flex-grow: 1 !important;
    }

    /* Progress Bar Styles */
    .pg-bar-container {
        width: 100%;
        max-width: 60px;
        height: 4px;
        background-color: #e2e8f0;
        border-radius: 999px;
        overflow: hidden;
        display: inline-block;
        vertical-align: middle;
        margin-left: 8px;
    }
    .pg-bar-fill {
        height: 100%;
        background-color: #3b82f6;
        border-radius: 999px;
    }

    .text-center th, .text-center td {
        text-align: center !important;
    }

    .expand-btn {
        width: 18px;
        height: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #9ca3af;
        border: none;
        background: transparent;
        font-size: 10px;
        transition: all 0.2s;
    }

    .expand-btn:hover {
        color: var(--midnight-blue);
        transform: scale(1.1);
    }

    .card-header-compact {
        background-color: #e5f1fd !important;
        border-top-left-radius: 4px !important;
        border-top-right-radius: 4px !important;
        padding: 0.4rem 0.6rem !important;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid #d1e5f8;
    }

    .card-title-compact {
        font-weight: 800;
        color: var(--midnight-blue);
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .quick-grid table {
        table-layout: fixed !important;
    }

    .col-header-content {
        padding-right: 0px !important;
    }

    .col-sort-button::before {
        filter: brightness(0) invert(1);
    }

    .col-sort-direction {
        border-top-color: white !important;
        border-bottom-color: white !important;
    }

    .col-sort-button {
        color: white;
    }

    .modal-body table td {
        font-size: 0.8rem;
        padding: 0.25rem !important;
        white-space: nowrap !important;
    }

    .quickgrid[theme=default] .col-title {
        gap: 0.2rem !important;
    }

    .skeleton-text { height: 1rem; margin-bottom: 0.5rem; }
    .skeleton-title { height: 1.5rem; width: 60%; margin-bottom: 1rem; }
    .skeleton-row { height: 2.5rem; width: 100%; margin-bottom: 0.5rem; }
    .skeleton-profile { height: 4rem; width: 100%; margin-bottom: 1rem; }

    /* Column Widths for alignment */
    .col-sn { width: 40px !important; }
    .col-order-no { width: 120px !important; }
    .col-coll { width: 60px !important; }
    .col-ship-date { width: 100px !important; }
    .col-category { width: 60px !important; }
    .col-recv { width: 70px !important; }
    .col-order-pics { width: 80px !important; }
    .col-diff { width: 80px !important; }
    
    .col-customer { width: auto !important; min-width: 150px !important; text-align: left !important; }
    .col-totalpo { width: 70px !important; min-width: 70px !important; max-width: 70px !important; text-align: center !important; }
    .col-runningpo { width: 80px !important; min-width: 80px !important; max-width: 80px !important; text-align: center !important; }
    .col-waitingpo { width: 80px !important; min-width: 80px !important; max-width: 80px !important; text-align: center !important; }

    /* History Grid Column Widths */
    .col-year { width: 60px !important; }
    .col-month { width: 100px !important; }
    .col-knit { width: 60px !important; }
    .col-weave { width: 70px !important; }
    .col-silk { width: 60px !important; }
    .col-linen { width: 70px !important; }
    .col-other { width: 70px !important; }
    .col-noofpos { width: 80px !important; }
    .col-weight { width: 100px !important; }
    .col-qty { width: 100px !important; }

    .footer-label {
        font-weight: 800;
        color: #64748b;
        text-transform: uppercase;
        font-size: 10px;
    }
    
    .footer-val {
        font-weight: 700;
        text-align: center;
    }
</style>
<div class="min-h-screen bg-[#f8fafc] p-0 font-sans">
    @if (LastErrorMessage != null)
    {
        <div class="m-4 p-4 bg-red-50 border border-red-200 rounded-none text-red-700 text-sm">
            <h4 class="font-bold mb-1">System Error</h4>
            <p>@LastErrorMessage</p>
        </div>
    }

    <!-- 3-Column Layout -->
    <!-- NEW: Line Graph Section -->
     

   <div class="grid grid-cols-1 md:grid-cols-[35fr_45fr_20fr] gap-2 md:gap-2">
        
        <!-- Left Column: Order Status -->
        <div class="flex flex-col rounded-none border border-blue-100 bg-white shadow-md overflow-hidden h-[380px]">
            <div class="card-header-compact">
                <h3 class="card-title-compact">
                    <span>📋 Order Status</span>
                </h3>
                <button class="expand-btn" @onclick="OpenMainModal">
                    <span class="oi oi-fullscreen-enter"></span>
                </button>
            </div>
            
            <div class="flex-1 overflow-auto px-1 pb-1">
                @if (IsLoading)
                {
                    <div class="px-1 py-1">
                        <Skeleton Type="Skeleton.SkeletonType.Table" Rows="10" Columns="5" />
                    </div>
                }
                else
                {
                    <QuickGrid Items="@OrderSummaries" class="quick-grid">
                        <PropertyColumn Property="@(s => s.SN)" Title="SN"  Align="Align.Center" />
                        <TemplateColumn Title="Customer Name">
                            <button type="button" class="text-blue-600 hover:text-blue-800 hover:underline text-left text-xs whitespace-nowrap" @onclick="() => ShowHistory(context)">
                                @context.CustomerName
                            </button>
                        </TemplateColumn>
                        <PropertyColumn Property="@(s => s.TotalOrder)" Title="Total" Sortable="true" Align="Align.Center" />
                        <TemplateColumn Title="Running" Sortable="true" Align="Align.Center">
                            <button type="button" class="text-blue-600 hover:text-blue-800 hover:underline font-bold" @onclick="() => ShowRunningOrders(context)">
                                @context.RunningOrder
                            </button>
                        </TemplateColumn>
                        <TemplateColumn Title="Waiting" Sortable="true" Align="Align.Center">
                            <button type="button" class="text-blue-600 hover:text-blue-800 hover:underline font-bold" @onclick="() => ShowRunningOrders(context, 1)">
                                @context.NotStartedOrder
                            </button>
                        </TemplateColumn>
                        
                    </QuickGrid>

                    @if (!IsLoading && !OrderSummaries.Any())
                    {
                        <div class="py-8 text-center text-gray-400">
                            <span class="oi oi-inbox text-2xl block mb-2 opacity-10"></span>
                            <p class="text-[10px] font-medium">No records found</p>
                        </div>
                    }
                }
            </div>
        </div>

        <!-- Middle Column: Production Status -->
        <div class="flex flex-col rounded-none border border-blue-100 bg-white shadow-md overflow-hidden h-[380px]">
            <div class="card-header-compact">
                <h3 class="card-title-compact">
                    <span>🧵 Production Status · @(OrderStatusDetailList.Count()) Orders</span>
                </h3>
                <button class="expand-btn">
                    <span class="oi oi-fullscreen-enter"></span>
                </button>
            </div>
            <div class="flex-1 overflow-auto px-1 pb-1">
                @if (IsOrderDetailLoading)
                {
                    <div class="px-1 py-1">
                        <Skeleton Type="Skeleton.SkeletonType.Table" Rows="10" Columns="7" />
                    </div>
                }
                else
                {
                               <QuickGrid TGridItem="OrderStatusDetailDto" Items="@OrderStatusDetailList.Take(10)" class="quick-grid">
                        <PropertyColumn Property="@(s => s.SN)" Title="SN"   Align="Align.Center" Class="col-sn-prod" />
                        <TemplateColumn Title="Customer Name" Class="col-customer-prod">
                            <button type="button" class="text-blue-600 hover:text-blue-800 hover:underline text-left text-xs" @onclick="() => ShowHistory((OrderStatusDetailDto)context)">
                                @context.CustomerName
                            </button>
                        </TemplateColumn>
 
                        <TemplateColumn Title="Order No" Class="col-order-prod">
                            <button type="button" class="text-blue-600 hover:text-blue-800 hover:underline text-left text-xs whitespace-nowrap" @onclick="() => ShowProductionFlow((OrderStatusDetailDto)context)">
                                @context.OrderNo
                            </button>
                        </TemplateColumn>
 
                        <PropertyColumn Property="@(s => s.OrderQty)" Title="QTY"    Class="col-qty-prod text-right" />
                         <PropertyColumn Property="@(s => s.LatestShippingDate)" Title="SHIPPING"      Class="col-ship-prod text-right" />
                         
                       <PropertyColumn Property="@(s => s.Packingdate)" Title="PROJECTED"      Class="col-proj-prod text-right" />
                       

                    </QuickGrid>

                    @if (!IsOrderDetailLoading && !OrderStatusDetailList.Any())
                    {
                        <div class="py-8 text-center text-gray-400">
                            <span class="oi oi-inbox text-2xl block mb-2 opacity-10"></span>
                            <p class="text-[10px] font-medium">No records found</p>
                        </div>
                    }
                }
            </div>
        </div>

        <!-- Right Column: Setting Piece -->
        <div class="flex flex-col rounded-none border border-blue-100 bg-white shadow-md overflow-hidden h-[380px]">
            <div class="card-header-compact">
                <h3 class="card-title-compact">
                    <span>⚙️ Setting Piece</span>
                </h3>
                <button class="expand-btn">
                    <span class="oi oi-fullscreen-enter"></span>
                </button>
            </div>
            <div class="flex-1 overflow-auto px-1 pb-1 flex flex-col items-center justify-center gap-3">
                <a href="/order-planning" class="flex items-center gap-3 px-8 py-3 text-white font-bold rounded shadow-lg hover:shadow-indigo-500/20 hover:scale-[1.02] transition-all text-xs uppercase tracking-widest border border-white/10"
                   style="background: linear-gradient(135deg, #002d54 0%, #1e40af 100%); min-width: 250px; justify-content: center;">
                    <i class="fa-solid fa-calendar-check text-sm"></i>
                    Go to Order Planning
                </a>
                <a href="/for-master-planing" class="flex items-center gap-3 px-8 py-3 text-white font-bold rounded shadow-lg hover:shadow-teal-500/20 hover:scale-[1.02] transition-all text-xs uppercase tracking-widest border border-white/10"
                   style="background: linear-gradient(135deg, #115e59 0%, #2ab3b1 100%); min-width: 250px; justify-content: center;">
                    <i class="fa-solid fa-user-gear text-sm"></i>
                    Master Dash
                </a>
                <a href="/knit-gantt-chart" class="flex items-center gap-3 px-8 py-3 text-white font-bold rounded shadow-lg hover:shadow-amber-500/20 hover:scale-[1.02] transition-all text-xs uppercase tracking-widest border border-white/10"
                   style="background: linear-gradient(135deg, #92400e 0%, #f0a500 100%); min-width: 250px; justify-content: center;">
                    <i class="fa-solid fa-chart-gantt text-sm"></i>
                    Machine Load
                </a>
                <a href="/task" class="flex items-center gap-3 px-8 py-3 text-white font-bold rounded shadow-lg hover:shadow-purple-500/20 hover:scale-[1.02] transition-all text-xs uppercase tracking-widest border border-white/10"
                   style="background: linear-gradient(135deg, #5b21b6 0%, #7c3aed 100%); min-width: 250px; justify-content: center;">
                    <i class="fa-solid fa-list-check text-sm"></i>
                    Task
                </a>
                <p class="text-[10px] text-slate-400 font-medium italic">Production Schedule Management</p>
            </div>
        </div>

    </div>
</div>

<DataModal @bind-IsVisible="showModal" Title="Order Status Details" IsLoading="false" MaxWidth="95vw" FullScreen="true">
    <ChildContent>
        <div class="max-h-[85vh] overflow-y-auto">
            <!-- Header if needed -->
     
    
            <!-- The responsive two-column container -->
            <div class="flex flex-col lg:flex-row gap-6 lg:gap-8">
                @if (IsLoading)
                {
                    <div class="flex-1 bg-white rounded-none shadow border border-gray-200 p-2">
                        <div class="h-8 w-48 bg-slate-100 rounded mb-4 animate-pulse"></div>
                        <Skeleton Type="Skeleton.SkeletonType.Table" Rows="10" Columns="5" />
                    </div>
                    <div class="flex-1 bg-white rounded-none shadow border border-gray-200 p-2">
                        <div class="h-8 w-48 bg-slate-100 rounded mb-4 animate-pulse"></div>
                        <Skeleton Type="Skeleton.SkeletonType.Table" Rows="10" Columns="5" />
                    </div>
                }
                else
                {
    
                <!-- Left Grid Card -->
                <div class="flex-1 min-w-0 bg-white rounded-none shadow border border-gray-200 p-2">
                    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 mb-2">
                        <h3 class="text-lg font-semibold text-gray-800 tracking-tight">Performing Buyer Orders Summary</h3>
                        <div class="relative flex justify-end">
                            @if (showOrderSearch)
                            {
                                <div class="w-full sm:w-64 relative flex items-center">
                                    <i class="fa-solid fa-search absolute left-3 text-gray-400"></i>
                                    <input type="text" 
                                           class="w-full pl-9 pr-8 py-2 text-sm border border-gray-200 rounded-none bg-gray-50/50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all duration-200 text-black" 
                                           placeholder="Search customer..." 
                                           @bind="orderSearchTerm" 
                                           @bind:event="oninput" 
                                           autofocus />
                                    <button type="button" class="absolute right-2 text-gray-400 hover:text-gray-600" @onclick="() => { showOrderSearch = false; orderSearchTerm = string.Empty; }">
                                        <i class="fa-solid fa-times"></i>
                                    </button>
                                </div>
                            }
                            else
                            {
                                <button class="p-2 text-gray-500 hover:text-blue-600 transition-colors bg-gray-50 border border-gray-200 rounded-none w-9 h-9 flex items-center justify-center" @onclick="() => showOrderSearch = true">
                                    <i class="fa-solid fa-search"></i>
                                </button>
                            }
                        </div>
                    </div>
    
                    
                    @if (OrderStatusDetailList != null && OrderStatusDetailList.Any() && !string.IsNullOrEmpty(OrderStatusDetailList.First().Message))
                    {
                        <div class="py-16 text-center">
                            <div class="bg-blue-50 w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-4 border border-blue-100">
                                <i class="fa-solid fa-circle-info text-3xl text-blue-400"></i>
                            </div>
                            <h4 class="text-lg font-black text-slate-900 mb-1">System Message</h4>
                            <p class="text-sm font-bold text-slate-400 px-8">@OrderStatusDetailList.First().Message</p>
                        </div>
                    }
                    else
                    {
                        <div class="bg-white rounded-none shadow-sm border border-slate-200 quick-grid-container">
                            <QuickGrid Items="@FilteredOrderSummariesPop" class="quick-grid w-full text-sm" style="table-layout: fixed;">
                                <PropertyColumn Property="@(s => s.SN)" Title="SN" Sortable="true" Class="text-center col-sn" />
    
                                <TemplateColumn Title="Customer Name" Class="col-customer">
                                    <button type="button"
                                            class="text-blue-600 hover:text-blue-800 hover:underline text-left text-xs font-medium"
                                            @onclick="() => ShowHistory(context)">
                                        @context.CustomerName
                                    </button>
                                </TemplateColumn>
    
                                 <PropertyColumn Property="@(s => s.TotalOrder)" Title="TotalPO" Sortable="true" Align="Align.Center" Class="col-totalpo" />
                                <TemplateColumn Title="RunningPO" Sortable="true" Align="Align.Center" Class="col-runningpo">
                                    <button type="button" class="text-blue-600 hover:text-blue-800 hover:underline font-bold" @onclick="() => ShowRunningOrders(context)">
                                        @context.RunningOrder
                                    </button>
                                </TemplateColumn>
                                <TemplateColumn Title="WaitingPO" Sortable="true" Align="Align.Center" Class="col-waitingpo">
                                    <button type="button" class="text-blue-600 hover:text-blue-800 hover:underline font-bold" @onclick="() => ShowRunningOrders(context, 1)">
                                        @context.NotStartedOrder
                                    </button>
                                </TemplateColumn>
                            </QuickGrid>
    
                            <div class="footer-container">
                                <table class="grand-total-table" style="table-layout: fixed; width: 100%;">
                                    <tr>
                                        <!-- Use exact column classes to match header alignment precisely -->
                                        <td class="col-sn" style="background: transparent;"></td>
                                        <td class="footer-label col-customer">Total</td>
                                        
                                        @{
                                            // Calculate sums over the filtered items
                                            var items = FilteredOrderSummariesPop;
                                            var totalPoSum = items.Sum(x => x.TotalOrder);
                                            var runningPoSum = items.Sum(x => x.RunningOrder);
                                            var waitingPoSum = items.Sum(x => x.NotStartedOrder);
                                        }
                                        
                                        <td class="footer-val col-totalpo font-bold text-indigo-700 block-center">@totalPoSum</td>
                                        <td class="footer-val col-runningpo font-bold text-indigo-700 block-center">@runningPoSum</td>
                                        <td class="footer-val col-waitingpo font-bold text-indigo-700 block-center">@waitingPoSum</td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    }
                     
                </div>
    
                <!-- Right Grid Card -->
                <div class="flex-1 min-w-0 bg-white rounded-none shadow border border-gray-200 p-2">
                    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 mb-2">
                        <h3 class="text-lg font-semibold text-gray-800 tracking-tight">Passive Buyer List</h3>
                        <div class="relative flex justify-end">
                            @if (showAbsentSearch)
                            {
                                <div class="w-full sm:w-64 relative flex items-center">
                                    <i class="fa-solid fa-search absolute left-3 text-gray-400"></i>
                                    <input type="text" 
                                           class="w-full pl-9 pr-8 py-2 text-sm border border-gray-200 rounded-none bg-gray-50/50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all duration-200 text-black" 
                                           placeholder="Search customer..." 
                                           @bind="absentSearchTerm" 
                                           @bind:event="oninput" 
                                           autofocus />
                                    <button type="button" class="absolute right-2 text-gray-400 hover:text-gray-600" @onclick="() => { showAbsentSearch = false; absentSearchTerm = string.Empty; }">
                                        <i class="fa-solid fa-times"></i>
                                    </button>
                                </div>
                            }
                            else
                            {
                                <button class="p-2 text-gray-500 hover:text-blue-600 transition-colors bg-gray-50 border border-gray-200 rounded-none w-9 h-9 flex items-center justify-center" @onclick="() => showAbsentSearch = true">
                                    <i class="fa-solid fa-search"></i>
                                </button>
                            }
                        </div>
                    </div>
    
                    <div class="bg-white rounded-none shadow-sm border border-slate-200 quick-grid-container">
                        <QuickGrid Items="@FilteredAbsentBuyerList" Pagination="@absentPagination" class="quick-grid w-full text-sm">
                            <PropertyColumn Property="@(s => s.SN)" Title="SN" Sortable="true" Class="col-sn" />
    
                            <TemplateColumn Title="Customer Name">
                                <button type="button"
                                        class="text-blue-600 hover:text-blue-800 hover:underline text-left text-xs font-medium"
                                        @onclick="() => ShowHistory(context)">
                                    @context.CustomerName
                                </button>
                            </TemplateColumn>
                        
                            <PropertyColumn Property="@(s => s.JoinedDate)" Title="First PO" Sortable="true" Align="Align.Center" />
                            <PropertyColumn Property="@(s => s.RecentDate)" Title="Recent PO" Sortable="true" Align="Align.Center" />
                            <PropertyColumn Property="@(s => s.TotalPcs)" Title="Total Pcs" Sortable="true" Align="Align.Right" Class="col-dashboard-right" />
                        </QuickGrid>
                        
                        <div class="pagination-footer">
                            <Paginator State="@absentPagination" />
                        </div>
                    </div>
                </div>
                }
            </div>
        </div>
    </ChildContent>
</DataModal>

<DataModal
    @bind-IsVisible="showProductionFlowModal"
    Title="Production Flow"
    IsLoading="false" FullScreen="false" MaxWidth="95vw" ZIndex="2200">
    <ChildContent>
        <div class="w-full h-full min-w-0">
    
            <div class="flex flex-col md:flex-row gap-4 p-2">
    
                <!-- Left sidebar: running orders list (always visible) -->
                <div class="w-full md:w-[25%] lg:w-[18%] bg-white shadow rounded p-2 shrink-0 overflow-hidden flex flex-col" style="height: calc(100vh - 230px);">
                    <h2 class="text-xs font-bold text-[#002d54] mb-2 px-1 flex items-center gap-2">
                        <i class="fa-solid fa-clock-rotate-left text-indigo-500"></i>
                        Running Orders
                    </h2>
                    <div class="flex-1 overflow-y-auto pr-1 custom-scrollbar" style="height: calc(100vh - 220px);">
                        <ul class="space-y-1.5">
                            @foreach (var group in OrderStatusDetailList.GroupBy(x => x.CustomerId).OrderBy(g => g.First().CustomerName))
                            {
                                var buyer = group.First();
                                var customerId = buyer.CustomerId;
                                var orderCount = group.Count();
                                var isActive = customerId == ActiveFlowBuyerId;
                                
                                <li @onclick="() => ShowProductionFlowByBuyer(customerId)" 
                                    class="@(isActive ? "bg-indigo-100 border-indigo-300 ring-2 ring-indigo-500/20" : "bg-slate-50 border-slate-100") group flex items-center justify-between p-2 rounded-none transition-all hover:bg-white hover:shadow-sm hover:border-indigo-200 cursor-pointer mb-1 shadow-sm">
                                    <div class="min-w-0 flex-1 pr-2">
                                        <h4 class="text-[11px] font-bold @(isActive ? "text-indigo-900" : "text-slate-800") truncate leading-tight">@buyer.CustomerName</h4>
                                        <div class="flex items-center gap-2 mt-1">
                                             
                                            @if (isActive)
                                            {
                                                <span class="text-[8px] font-black text-indigo-500 uppercase tracking-widest flex items-center gap-1">
                                                    <span class="w-1 h-1 bg-indigo-500 rounded-full animate-pulse"></span>
                                                    Active
                                                </span>
                                            }
                                        </div>
                                    </div>
                                    <div class="flex items-center gap-1.5 shrink-0">
                                        <button @onclick:stopPropagation="true" @onclick="() => ShowHistory(buyer)" 
                                                class="w-7 h-7 flex items-center justify-center rounded-none @(isActive ? "bg-white text-indigo-600 shadow-sm border border-indigo-200" : "bg-white text-slate-400 border border-slate-200 hover:text-indigo-600 hover:border-indigo-200") transition-all"
                                                title="View Buyer Info">
                                            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                            </svg>
                                        </button>
                                        <button @onclick:stopPropagation="true" @onclick="() => ShowProductionFlowByBuyer(customerId)"
                                                class="w-7 h-7 flex items-center justify-center rounded-none @(isActive ? "bg-grey-600 text-white shadow-md shadow-indigo-200" : "bg-white text-slate-400 border border-slate-200 hover:text-indigo-600 hover:border-indigo-200") transition-all"
                                                title="View Flow Chart">
                                            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z" />
                                            </svg>
                                        </button>
                                    </div>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
    
                <!-- Right: Production Flow cards (loading only here) -->
                <div class="flex-1 shadow rounded flex flex-col relative bg-slate-50/50 overflow-y-auto lg:overflow-y-hidden" style="height: calc(100vh - 230px);">
                    <!-- Order Selection Tabs -->
                    <div class="bg-white border-b border-slate-200 flex-shrink-0">
                        <div class="flex items-center border-l border-slate-200">
                            @{
                                var visibleOrders = FlowOrderNoList.Take(10).ToList();
                                // More menu includes everything from index 6 onwards for tablet responsiveness
                                var overflowOrders = FlowOrderNoList.Skip(6).ToList();
                                var isAnyOverflowSelected = SelectedFlowOrderNo != null && FlowOrderNoList.IndexOf(SelectedFlowOrderNo) >= 6;
                                var tabIndex = 0;
                            }
                            @foreach (var orderNo in visibleOrders)
                            {
                                var isSelected = orderNo == SelectedFlowOrderNo;
                                var orderSummary = OrderStatusDetailList.FirstOrDefault(x => x.OrderNo == orderNo);
                                var isUrgent = orderSummary != null && 
                                               (orderSummary.LatestShippingDate < DateOnly.FromDateTime(DateTime.Now) || 
                                                orderSummary.RiskFlag == "High" || 
                                                orderSummary.RiskFlag == "Critical");

                                <button @onclick="() => SelectFlowOrder(orderNo)"
                                        class="relative py-3 px-2 lg:px-2.5 text-[11px] font-bold uppercase tracking-widest transition-all whitespace-nowrap flex items-center justify-center gap-1.5 border-r border-slate-200 @(isSelected ? "text-indigo-600 bg-indigo-50/50" : "text-slate-400 hover:text-slate-600 hover:bg-slate-50") @(tabIndex >= 6 ? "hidden lg:flex" : "flex")">
                                    @{ tabIndex++; }
                                    @orderNo
                                    @if (isUrgent)
                                    {
                                        <span class="flex h-2 w-2 rounded-full bg-red-500 shadow-sm animate-pulse"></span>
                                    }
                                    @if (isSelected)
                                    {
                                        <div class="absolute bottom-0 left-0 right-0 h-0.5 bg-indigo-600"></div>
                                    }
                                </button>
                            }

                            @if (FlowOrderNoList.Count > 6)
                            {
                                <div class="relative flex items-center @(FlowOrderNoList.Count <= 10 ? "lg:hidden" : "")">
                                    <button @onclick="() => showMoreOrdersMenu = !showMoreOrdersMenu"
                                            class="py-3 px-4 text-[11px] font-black text-indigo-600 hover:bg-indigo-50 transition-colors flex items-center gap-2 @(isAnyOverflowSelected ? "bg-indigo-50" : "")">
                                        More+
                                        <span class="oi oi-chevron-bottom text-[8px] @(showMoreOrdersMenu ? "rotate-180" : "") transition-transform"></span>
                                        @if (isAnyOverflowSelected)
                                        {
                                            <div class="absolute bottom-0 left-0 right-0 h-0.5 bg-indigo-600"></div>
                                        }
                                    </button>
                                    @if (showMoreOrdersMenu)
                                    {
                                        <div class="absolute top-full right-0 bg-white shadow-xl border border-slate-200 z-[100] min-w-[180px] py-1.5 mt-0.5 rounded-sm overflow-hidden animate-in fade-in slide-in-from-top-1 duration-200">
                                            @foreach (var order in overflowOrders)
                                            {
                                                var isItemVisibleOnDesktop = FlowOrderNoList.IndexOf(order) < 10;
                                                <button @onclick="() => SelectFlowOrder(order)"
                                                        class="w-full text-left px-4 py-2.5 text-[11px] font-bold hover:bg-slate-50 flex items-center justify-between group @(order == SelectedFlowOrderNo ? "text-indigo-600 bg-indigo-50/30" : "text-slate-600") @(isItemVisibleOnDesktop ? "lg:hidden" : "")">
                                                    <span>@order</span>
                                                    @if (order == SelectedFlowOrderNo)
                                                    {
                                                        <span class="oi oi-check text-[9px]"></span>
                                                    }
                                                </button>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    <div class="flex-1 overflow-y-hidden relative custom-scrollbar pr-1">
                    @if (IsProductionFlowLoading)
                    {
                        <div class="absolute inset-0 bg-white/50 backdrop-blur-[2px] z-10 p-4">
                            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                                @for (int i = 0; i < 6; i++)
                                {
                                    <Skeleton Type="Skeleton.SkeletonType.Card" Class="w-full h-48 border-white bg-slate-50/50 shadow-sm" />
                                }
                            </div>
                        </div>
                    }
                    <ProductionFlow Items="@ProductionFlowList" 
                                    OnShowOrderDetails="ShowOrderDetails"
                                    OnShowOrderAnalysis="ShowOrderAnalysis"
                                    OnStyleSelected="ShowStyleDetails" />
                </div>
            </div>
    
            </div>
        </div>
    </ChildContent>
</DataModal>

<DataModal @bind-IsVisible="showHistoryModal" Title="@($"Order History - {SelectedBuyerName}")" IsLoading="false" ZIndex="2400">
     
    <ChildContent>
        <div class="bg-white flex-1 min-w-0 bg-white rounded-none shadow border border-gray-200">  
            <div class="p-1">
               <div class="max-w-4xl mx-auto p-1">
                @if (IsHistoryLoading)
                {
                    <Skeleton Type="Skeleton.SkeletonType.Profile" Class="mb-4 p-3 bg-blue-50/20 rounded-none border border-blue-50 shadow-sm" />
                }
                else
                {
         
                  <div class="flex flex-row bg-blue-50/40 rounded-none border-l-4 border-l-blue-500 border border-blue-100 px-4 py-2 mb-2 shadow-sm items-center justify-between relative z-10">
                    <div class="flex items-center gap-4">
                        <button @onclick="() => isHistoryGridView = !isHistoryGridView" 
                                class="w-8 h-8 flex items-center justify-center bg-white text-indigo-600 rounded-none shadow-sm border border-indigo-100 hover:bg-red-600 hover:text-white transition-all group"
                                title="@(isHistoryGridView ? "Switch to Graph View" : "Switch to Table View")">
                            <i class="fa-solid @(isHistoryGridView ? "fa-arrow-up-right-dots text-red-600" : "fa-table-list")"></i>
                        </button>
                        <div class="flex items-center gap-6">
                            <div class="flex items-center gap-2">
                                <span class="text-[10px] font-black text-slate-500 uppercase tracking-widest">1st P.O:</span>
                                <span class="text-[12px] font-black text-slate-900">@SelectedBuyerProfile?.JoinedDate</span>
                            </div>
                            <div class="w-px h-4 bg-blue-200"></div>
                            <div class="flex items-center gap-2">
                                <span class="text-[10px] font-black text-slate-500 uppercase tracking-widest">Recent P.O:</span>
                                <span class="text-[12px] font-black text-slate-900">@SelectedBuyerProfile?.RecentDate</span>
                            </div>
                        </div>
                    <div class="flex items-center gap-1">
                      <a href="mailto:@SelectedBuyerProfile?.CustomerEmail" 
                         class="w-8 h-8 flex items-center justify-center bg-white text-blue-600 text-xs hover:bg-blue-600 hover:text-white transition-all shadow-sm border border-blue-200" 
                         title="Send Email">
                        <i class="fa-solid fa-envelope"></i>
                      </a>
                      
                      @if (!isHistoryGridView)
                      {
                        <div class="relative">
                            <button @onclick="() => showHistoryFilterDropdown = !showHistoryFilterDropdown" 
                                    class="w-8 h-8 flex items-center justify-center bg-white text-slate-600 rounded-none shadow-sm border border-slate-200 hover:bg-slate-50 transition-all ml-1"
                                    title="Filter Categories">
                                <i class="fa-solid fa-filter text-xs"></i>
                            </button>
                            
                            @if (showHistoryFilterDropdown)
                            {
                                <div class="absolute top-full right-0 mt-1 w-40 bg-white shadow-xl border border-slate-200 z-[9999] py-2 animate-in fade-in slide-in-from-top-1 duration-200">
                                    <div class="px-3 py-1 mb-1 border-b border-slate-100">
                                        <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Categories</span>
                                    </div>
                                    <button class="w-full text-left px-4 py-2 text-[11px] font-bold hover:bg-slate-50 flex items-center gap-3 group" @onclick='() => ToggleHistoryFilter("All")'>
                                        <i class="fa-solid @(showHistoryAll ? "fa-square-check text-[#2e2b8e]" : "fa-square text-slate-300") text-[14px]"></i>
                                        <span class="@(showHistoryAll ? "text-[#2e2b8e]" : "text-slate-600")">All</span>
                                    </button>
                                    <button class="w-full text-left px-4 py-2 text-[11px] font-bold hover:bg-slate-50 flex items-center gap-3 group" @onclick='() => ToggleHistoryFilter("Knit")'>
                                        <i class="fa-solid @(showHistoryKnit ? "fa-square-check text-red-600" : "fa-square text-slate-300") text-[14px]"></i>
                                        <span class="@(showHistoryKnit ? "text-red-600" : "text-slate-600")">Knit</span>
                                    </button>
                                    <button class="w-full text-left px-4 py-2 text-[11px] font-bold hover:bg-slate-50 flex items-center gap-3 group" @onclick='() => ToggleHistoryFilter("Weave")'>
                                        <i class="fa-solid @(showHistoryWeave ? "fa-square-check text-blue-600" : "fa-square text-slate-300") text-[14px]"></i>
                                        <span class="@(showHistoryWeave ? "text-blue-600" : "text-slate-600")">Weave</span>
                                    </button>
                                    <button class="w-full text-left px-4 py-2 text-[11px] font-bold hover:bg-slate-50 flex items-center gap-3 group" @onclick='() => ToggleHistoryFilter("Silk")'>
                                        <i class="fa-solid @(showHistorySilk ? "fa-square-check text-emerald-600" : "fa-square text-slate-300") text-[14px]"></i>
                                        <span class="@(showHistorySilk ? "text-emerald-600" : "text-slate-600")">Silk</span>
                                    </button>
                                    <button class="w-full text-left px-4 py-2 text-[11px] font-bold hover:bg-slate-50 flex items-center gap-3 group" @onclick='() => ToggleHistoryFilter("Linen")'>
                                        <i class="fa-solid @(showHistoryLinen ? "fa-square-check text-amber-600" : "fa-square text-slate-300") text-[14px]"></i>
                                        <span class="@(showHistoryLinen ? "text-amber-600" : "text-slate-600")">Linen</span>
                                    </button>
                                    <button class="w-full text-left px-4 py-2 text-[11px] font-bold hover:bg-slate-50 flex items-center gap-3 group" @onclick='() => ToggleHistoryFilter("Other")'>
                                        <i class="fa-solid @(showHistoryOther ? "fa-square-check text-[#8b5cf6]" : "fa-square text-slate-300") text-[14px]"></i>
                                        <span class="@(showHistoryOther ? "text-[#8b5cf6]" : "text-slate-600")">Other</span>
                                    </button>
                                </div>
                            }
                        </div>
                      }
                    </div>
                    </div>
                    
                </div>
                  }
                </div>
            </div> 
            
            <div class="p-1">
        
        
                @if (IsHistoryLoading)
                {
                    <div class="bg-white rounded-none shadow-sm border border-slate-200 p-4">
                        <Skeleton Type="Skeleton.SkeletonType.Table" Rows="5" Columns="10" />
                    </div>
                }
                else if (SelectedBuyerHistory.Any())
                {
                    @if (isHistoryGridView)
                    {
                        var knitTotal = SelectedBuyerHistory.Sum(h => h.Knit);
                        var weaveTotal = SelectedBuyerHistory.Sum(h => h.Weave);
                        var silkTotal = SelectedBuyerHistory.Sum(h => h.Silk);
                        var linenTotal = SelectedBuyerHistory.Sum(h => h.Linen);
                        var otherTotal = SelectedBuyerHistory.Sum(h => h.Other);
                        var posTotal = SelectedBuyerHistory.Sum(h => h.NoofPos);
                        var weightTotal = SelectedBuyerHistory.Sum(h => h.TotalWeight);
                        var qtyTotal = SelectedBuyerHistory.Sum(h => h.TotalPcs);
        
                        <div class="bg-white rounded-none shadow-sm border border-slate-200 quick-grid-container" style="max-height: calc(100vh - 200px);">
                            <QuickGrid Items="@SelectedBuyerHistory" class="quick-grid w-full" style="table-layout: fixed;">
                                <PropertyColumn Property="@(h => h.SN)" Title="SN"   Align="Align.Center" Class="col-sn" />
                                <TemplateColumn Title="Year" Align="Align.Center" Class="col-year">
                                    <button type="button" class="text-blue-600 hover:text-blue-800 hover:underline text-left text-xs font-bold" @onclick="() => ShowYearlyHistory(context)">
                                        @context.Year
                                    </button>
                                </TemplateColumn>
                                @if (knitTotal > 0) { <PropertyColumn Property="@(h => h.Knit)" Title="knit" Align="Align.Center" Class="col-knit" /> }
                                @if (weaveTotal > 0) { <PropertyColumn Property="@(h => h.Weave)" Title="Weave" Align="Align.Center" Class="col-weave" /> }
                                @if (silkTotal > 0) { <PropertyColumn Property="@(h => h.Silk)" Title="Silk" Align="Align.Center" Class="col-silk" /> }
                                @if (linenTotal > 0) { <PropertyColumn Property="@(h => h.Linen)" Title="Linen" Align="Align.Center" Class="col-linen" /> }
                                @if (otherTotal > 0) { <PropertyColumn Property="@(h => h.Other)" Title="Other" Align="Align.Center" Class="col-other" /> }
                                <PropertyColumn Property="@(h => (int)h.NoofPos)" Title="No of POs" Align="Align.Center" Class="col-noofpos" />
                                <PropertyColumn Property="@(h => h.TotalWeight)" Title="Total Weight" Align="Align.Center" Class="col-weight" />
                                <PropertyColumn Property="@(h => h.TotalPcs)" Title="Total Qty" Align="Align.Center" Class="col-qty" />
                            </QuickGrid>
        
                            <div class="footer-container">
                                <table class="grand-total-table" style="table-layout: fixed; width: 100%;">
                                    <tr>
                                        <td class="col-sn"></td>
                                        <td class="col-year footer-label" style="text-align: right; padding-right: .5rem !important;">TOTAL</td>
                                        @if (knitTotal > 0) { <td class="footer-val col-knit">@knitTotal</td> }
                                        @if (weaveTotal > 0) { <td class="footer-val col-weave">@weaveTotal</td> }
                                        @if (silkTotal > 0) { <td class="footer-val col-silk">@silkTotal</td> }
                                        @if (linenTotal > 0) { <td class="footer-val col-linen">@linenTotal</td> }
                                        @if (otherTotal > 0) { <td class="footer-val col-other">@otherTotal</td> }
                                        <td class="footer-val col-noofpos">@((int)posTotal)</td>
                                        <td class="footer-val col-weight font-bold text-indigo-700">@weightTotal</td>
                                        <td class="footer-val col-qty font-bold text-indigo-700">@qtyTotal</td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="h-[350px]">
                            <MultiLineGraph Title="@($"Production Trend: {SelectedBuyerName}")" 
                                           Series="@BuyerHistoryMultiGraphData" 
                                           XLabel="Year"
                                           YLabel="TOTAL QTY" />
                        </div>
                    }
                }
                else
                {
                    <div class="py-12 text-center text-gray-400">
                        <span class="oi oi-inbox text-3xl block mb-2 opacity-10"></span>
                        <p class="text-xs font-medium">No history found for this buyer</p>
                    </div>
                }
            </div>
        
            </div>
    </ChildContent>
</DataModal>
