            else if (IsLoadingStyleDetails)
            {
                <div class="p-6 space-y-6">
                    <Skeleton Type="Skeleton.SkeletonType.Rectangle" Height="300px" />
                    <Skeleton Type="Skeleton.SkeletonType.Table" Rows="5" />
                </div>
