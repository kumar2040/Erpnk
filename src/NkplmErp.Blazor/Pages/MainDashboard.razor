</DataModal>

<!-- ORDER DETAIL POPUP (HOISTED FOR SEPARATION) -->
<DataModal @bind-IsVisible="IsOrderDetailVisible" 
           Title="@($"Order Details - {SelectedOrderNo}")"
           IsLoading="IsLoadingOrderDetail"
           MaxWidth="1200px"
           ZIndex="2500">
    <ChildContent>
        <div class="flex-1 w-full relative min-h-[500px] bg-white" style="height: calc(90vh - 120px);">
            @if (IsOrderDetailVisible && !IsLoadingOrderDetail)
            {
                <div class="absolute inset-2 sm:inset-4 flex flex-col overflow-hidden">
                    <div class="bg-white rounded-none border border-slate-200 p-3 flex flex-wrap lg:flex-nowrap justify-between items-center gap-4 shrink-0 mb-4">
                        <div class="flex items-center gap-4">
                            <div class="w-12 h-12 bg-indigo-50 rounded-none flex items-center justify-center border border-indigo-100">
                                <i class="fa-solid fa-file-invoice text-indigo-500 text-xl"></i>
                            </div>
                            <div>
                                <h3 class="text-sm font-black text-slate-900 uppercase tracking-tight">Order Information</h3>
                                <p class="text-[10px] text-slate-400 font-bold uppercase tracking-widest">Summary View</p>
                            </div>
                        </div>

                        <div class="flex items-center gap-6 divide-x divide-slate-100">
                            <div class="px-4">
                                <span class="block text-[9px] text-slate-400 font-black uppercase tracking-widest mb-1">Total Pieces</span>
                                <span class="block text-lg font-black text-slate-900 tabular-nums">@SelectedOrderDetails.Sum(x => x.Qty).ToString("N0")</span>
                            </div>
                        </div>
                    </div>

                    <div class="bg-white rounded-none border border-slate-200 quick-grid-container flex-1 flex flex-col overflow-hidden min-h-0">
                        <div class="flex-1 min-h-0 overflow-y-auto">
                            <QuickGrid Items="@SelectedOrderDetails.AsQueryable()" class="quick-grid w-full">
                                <PropertyColumn Property="@(x => x.SN)" Title="S.N" Class="col-sn-ov" />
                                <PropertyColumn Property="@(x => x.StyleNo)" Title="Style" Sortable="true" Class="col-style-ov font-black text-slate-800" />
                                <PropertyColumn Property="@(x => x.ProductName)" Title="Product" Sortable="true" Class="col-product-ov text-slate-600" />
                                <PropertyColumn Property="@(x => x.Color)" Title="Color" Sortable="true" Class="col-color-ov" />
                                <PropertyColumn Property="@(x => x.Guage)" Title="Gg" Align="Align.Center" Class="col-guage-ov" />
                                <PropertyColumn Property="@(x => x.Ply)" Title="Ply" Align="Align.Center" Class="col-ply-ov" />
                                <PropertyColumn Property="@(x => x.Yarn)" Title="Yarn" Class="col-yarn-ov text-[10px]" />
                                
                                @foreach (var size in sizeHeaders)
                                {
                                    <TemplateColumn Title="@size" Align="Align.Center" Class="col-size-ov">
                                        @{
                                            var val = context.Sizes.TryGetValue(size, out var v) ? v : 0;
                                            <span class="@(val > 0 ? "font-bold text-slate-900" : "text-slate-300")">@(val > 0 ? val.ToString("N0") : "-")</span>
                                        }
                                    </TemplateColumn>
                                }

                                <PropertyColumn Property="@(x => x.Qty)" Title="Pieces" Sortable="true" Align="Align.Center" Format="N0" Class="col-pieces-ov font-black text-indigo-600 bg-indigo-50/30" />
                                <PropertyColumn Property="@(x => x.KnSl)" Title="Kn/Sl" Class="col-knsl-ov text-slate-600" />
                                <PropertyColumn Property="@(x => x.DaysRequired)" Title="Days Req" Align="Align.Center" Class="col-daysreq-ov font-semibold text-indigo-600" />
                            </QuickGrid>

                            <div class="footer-container shrink-0">
                                <table class="grand-total-table w-full">
                                    <tr>
                                        <td class="col-sn-ov"></td>
                                        <td class="col-style-ov"></td>
                                        <td class="col-product-ov"></td>
                                        <td class="col-color-ov"></td>
                                        <td class="col-guage-ov"></td>
                                        <td class="col-ply-ov"></td>
                                        <td class="col-yarn-ov footer-label font-black text-right pr-4 uppercase tracking-widest text-[#002d54]">Grand Totals</td>
                                        @foreach (var size in sizeHeaders)
                                        {
                                            <td class="footer-val-size col-size-ov text-center">@SelectedOrderDetails.Sum(x => x.Sizes.TryGetValue(size, out var val) ? val : 0)</td>
                                        }
                                        <td class="footer-val-total col-pieces-ov text-center font-black text-slate-900 bg-slate-100">@SelectedOrderDetails.Sum(x => x.Qty)</td>
                                        <td class="col-knsl-ov"></td>
                                        <td class="col-daysreq-ov"></td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else if (IsLoadingOrderDetail)
            {
                <div class="absolute inset-0 flex items-center justify-center bg-white/80 backdrop-blur-sm z-50">
                    <div class="flex flex-col items-center gap-3">
                        <div class="w-12 h-12 border-4 border-indigo-600/20 border-t-indigo-600 rounded-full animate-spin"></div>
                        <p class="text-xs font-black text-slate-400 uppercase tracking-[0.2em]">Loading Data</p>
                    </div>
                </div>
            }
        </div>
    </ChildContent>
</DataModal>

<!-- PRICE ANALYSIS POPUP (HOISTED FOR SEPARATION) -->
<DataModal @bind-IsVisible="IsAnalysisPopupVisible" 
           Title="@($"Price Analysis - {SelectedOrderNo}")"
           IsLoading="IsLoadingAnalysis"
           MaxWidth="1200px"
           ZIndex="3000">
    <ChildContent>
        <div class="flex-1 w-full relative min-h-[500px] bg-white" style="height: calc(90vh - 120px);">
            @if (IsAnalysisPopupVisible && !IsLoadingAnalysis)
            {
                <div class="absolute inset-2 sm:inset-4 flex flex-col overflow-hidden">
                    <div class="bg-white rounded-none border border-slate-200 quick-grid-container flex-1 flex flex-col overflow-hidden min-h-0 @(IsAnalysisUnmasked ? "" : "blur-md pointer-events-none") transition-all duration-500">
                        <div class="flex-1 min-h-0 overflow-y-auto">
                            <QuickGrid Items="@AnalysisItems.AsQueryable()" class="quick-grid w-full">
                                <PropertyColumn Property="@(x => x.SN)" Title="S.N" Class="col-sn-an" />
                                <PropertyColumn Property="@(x => x.ProductName)" Title="Product" Class="col-style-an font-black text-slate-800" />
                                <PropertyColumn Property="@(x => x.StyleGuage)" Title="Gg" Align="Align.Center" Class="col-guage-an" />
                                <PropertyColumn Property="@(x => x.StylePly)" Title="Ply" Align="Align.Center" Class="col-ply-an" />
                                <PropertyColumn Property="@(x => x.YarnInfo)" Title="Yarn" Class="col-yarn-an" />
                                <PropertyColumn Property="@(x => x.NetWet)" Title="Wt" Align="Align.Right" Class="col-wt-an" />
                                <PropertyColumn Property="@(x => x.TotalQuantity)" Title="Qty" Align="Align.Center" Format="N0" Class="col-qty-an" />
                                <PropertyColumn Property="@(x => x.OverratePerPcUsd)" Title="Overhead" Align="Align.Right" Format="C2" Class="col-overhead-an" />
                                <PropertyColumn Property="@(x => x.FinalCostPerPcUsd)" Title="Cost/Pc" Align="Align.Right" Format="C2" Class="col-prod-cost-an font-bold text-emerald-600" />
                                <PropertyColumn Property="@(x => x.TotalRevenueUsd)" Title="Revenue" Align="Align.Right" Format="C2" Class="col-value-an font-black text-slate-900 bg-slate-50" />
                            </QuickGrid>

                            <div class="footer-container shrink-0 relative @(IsAnalysisUnmasked ? "" : "pointer-events-none") z-10">
                                <table class="grand-total-table w-full">
                                    <tr>
                                        <td class="col-sn-an"></td>
                                        <td class="col-style-an"></td>
                                        <td class="col-guage-an"></td>
                                        <td class="col-ply-an"></td>
                                        <td class="col-yarn-an"></td>
                                        <td class="col-wt-an"></td>
                                        <td class="col-qty-an footer-val-total text-center font-bold">@AnalysisItems.Sum(x => (decimal)x.TotalQuantity).ToString("N0")</td>
                                        <td class="col-overhead-an"></td>
                                        <td class="col-prod-cost-an footer-label font-black text-right pr-4 uppercase tracking-widest text-[#002d54]">Total Value</td>
                                        <td class="col-value-an footer-val-total text-right font-black text-emerald-700 bg-emerald-50">@AnalysisItems.Sum(x => x.TotalRevenueUsd).ToString("C2")</td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                @if (!IsAnalysisUnmasked)
                {
                    <div class="absolute inset-0 z-[4000] flex items-center justify-center bg-white/60 backdrop-blur-md">
                        <div class="bg-white p-8 rounded-3xl shadow-2xl border border-slate-200 flex flex-col items-center gap-6 max-w-sm w-full mx-4 transform transition-all duration-300 scale-100 shadow-indigo-100">
                            <div class="w-16 h-16 bg-indigo-50 rounded-full flex items-center justify-center">
                                <i class="fa-solid fa-lock text-indigo-600 text-2xl"></i>
                            </div>
                            <div class="text-center">
                                <h3 class="text-lg font-black text-slate-900">Protected Content</h3>
                                <p class="text-xs font-bold text-slate-400 uppercase tracking-widest mt-1">Security PIN Required</p>
                            </div>
                            
                            <div class="w-full space-y-4">
                                <input type="password" 
                                       class="w-full px-4 py-3 bg-slate-50 border-2 border-slate-100 rounded-xl text-center text-2xl font-black tracking-[0.5em] focus:border-indigo-500 focus:bg-white outline-none transition-all"
                                       placeholder="••••"
                                       @bind="AnalysisPinInput"
                                       @onkeyup="@(e => e.Key == "Enter" ? VerifyAnalysisPin() : Task.CompletedTask)" />
                                
                                @if (!string.IsNullOrEmpty(AnalysisPinError))
                                {
                                    <p class="text-center text-[10px] font-black text-red-500 uppercase tracking-wider">@AnalysisPinError</p>
                                }

                                <button class="w-full py-4 bg-slate-900 text-white rounded-xl font-black uppercase tracking-widest text-xs hover:bg-indigo-600 transition-colors shadow-lg shadow-indigo-200"
                                        @onclick="VerifyAnalysisPin">
                                    Unlock Data
                                </button>
                            </div>
                        </div>
                    </div>
                }
            }
            else if (IsLoadingAnalysis)
            {
                <div class="absolute inset-0 flex items-center justify-center bg-white/80 backdrop-blur-sm z-50">
                    <div class="flex flex-col items-center gap-3">
                        <div class="w-12 h-12 border-4 border-indigo-600/20 border-t-indigo-600 rounded-full animate-spin"></div>
                        <p class="text-xs font-black text-slate-400 uppercase tracking-[0.2em]">Analyzing Data</p>
                    </div>
                </div>
            }
        </div>
    </ChildContent>
</DataModal>

