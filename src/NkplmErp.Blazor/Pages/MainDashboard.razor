                                    <div>
                                        <span class="block text-[10px] opacity-40 font-black uppercase mb-1">Net Weight</span>
                                        <span class="text-lg font-black tracking-tight">@SelectedStyleDetails?.GeneralInfo?.NetWet</span>
                                    </div>
