</DataModal>
<DataModal
    @bind-IsVisible="showProductionFlowModal"
    Title="Production Flow"
    IsLoading="false" FullScreen="true">
    <div class="max-w mx-auto p-2">

        <div class="flex flex-col lg:flex-row gap-4">

            <!-- Left sidebar: running orders list (always visible) -->
            <div class="w-full lg:w-[18%] bg-white shadow rounded p-2 shrink-0">
                <h2 class="text-sm font-bold text-[#002d54] mb-2 px-1">Running Orders</h2>
                <ul class="space-y-1">
                    @foreach (var order in OrderStatusDetailList)
                    {
                        <li class="p-1.5 bg-gray-50 border border-gray-100 rounded cursor-pointer hover:bg-indigo-50 hover:border-indigo-200 transition text-xs text-gray-700 truncate"
                            @onclick="() => ShowProductionFlowByBuyer(order.CustomerId)">
                            <span class="font-medium text-indigo-700">@order.CustomerName</span>
                            <br />
                            <span class="text-gray-500">@order.OrderNo</span>
                        </li>
                    }
                </ul>
            </div>

            <!-- Right: Production Flow cards (loading only here) -->
            <div class="flex-1 overflow-auto relative">
                @if (IsProductionFlowLoading)
                {
                    <div class="absolute inset-0 flex flex-col items-center justify-center bg-white/80 z-10 rounded-lg">
                        <div class="w-8 h-8 border-4 border-indigo-200 border-t-indigo-600 rounded-full animate-spin mb-3"></div>
                        <p class="text-xs text-gray-500 font-medium">Loading production flow...</p>
                    </div>
                }
                <ProductionFlow Items="@ProductionFlowList" />
            </div>

        </div>
    </div>
</DataModal>

