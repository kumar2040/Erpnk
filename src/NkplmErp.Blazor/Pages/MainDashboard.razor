@page "/main-dashboard"
@using Microsoft.AspNetCore.Components.QuickGrid
@using NkplmErp.Shared.DTOs
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<style>
    /* Premium Midnight Blue Theme Matching Mockup */
    :root {
        --midnight-blue: #002d54; /* Deep midnight blue from image */
        --card-bg: #ffffff;
        --grid-header-bg: #002d54;
    }

    /* Styling for QuickGrid specifically */
    ::deep .quick-grid {
        width: 100%;
        border-collapse: collapse;
    }

    ::deep thead th {
        background-color: var(--grid-header-bg) !important;
        color: #374151  !important;
        font-size: 0.75rem !important;
        font-weight: 700 !important;
        text-transform: none !important; /* Image uses Title Case headers */
        letter-spacing: 0.02em !important;
        padding: 0.875rem 1rem !important;
        border: none !important;
        white-space: nowrap !important;
    }

    ::deep thead th:first-child {
        border-top-left-radius: 0.4rem !important;
    }

    ::deep thead th:last-child {
        border-top-right-radius: 0.4rem !important;
    }

    ::deep tbody td {
        padding: 0.875rem 1rem !important;
        font-size: 0.85rem !important;
        color: #374151 !important; /* Gray 700 */
        border-bottom: 1px solid #f3f4f6 !important; /* Gray 100 */
        vertical-align: middle !important;
    }

    ::deep tr:hover td {
        background-color: #f9fafb !important;
    }

    /* Column specific alignment */
    ::deep .text-center th, ::deep .text-center td {
        text-align: center !important;
    }

    /* Expand button matching mockup */
    .expand-btn {
        width: 20px;
        height: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #9ca3af;
        border: 1px solid #f0f1f5;
        border-radius: 4px;
        font-size: 10px;
        transition: all 0.2s;
    }

    .expand-btn:hover {
        background-color: #f3f4f6;
        color: var(--midnight-blue);
    }
    .select-custom{
        color:#4C4C4C !important; 
    }
    table td{
        color:#4C4C4C;
        border-bottom:1px solid #f0f1f5;
        font-size:12px;
        padding:3px !important;


    }
    table tr:hover{
        background-color:#eaeff5 !important;
        color:#4C4C4C;
    }
    table thead{
        background-color:#00396A;
        color:#fff;
        font-size:14px;
        border-radius:4px;
    }
    .quick-grid table {
    table-layout: auto; /* instead of fixed */
}
 .col-header-content{
 
    padding-right:0px !important;
 }
 /* 1. Make the header text and sort button white */
::deep thead th {
    color: white;
}

/* 2. Target the sorting icon (SVG) */
::deep .col-sort-button::before {
    filter: brightness(0) invert(1); /* Turns black icons white */
}

/* 3. Handle the active sort indicators */
::deep .col-sort-direction {
    border-top-color: white !important;
    border-bottom-color: white !important;
}

/* 4. Ensure the button background doesn't interfere */
::deep .col-sort-button {
    color: white;
}
.modal-body{
    padding:0.4rem !important;
}
.modal-body table td{
        color:#4C4C4C;
        border-bottom:1px solid #f0f1f5;
        font-size:14px;
        padding:6px !important;


    }

  .quickgrid[theme=default] .col-title {
    gap:0.2rem !important;
    }  
</style>

<div class="min-h-screen bg-[#f8fafc] p-0 font-sans">
    @if (LastErrorMessage != null)
    {
        <div class="m-4 p-4 bg-red-50 border border-red-200 rounded-xl text-red-700 text-sm">
            <h4 class="font-bold mb-1">System Error</h4>
            <p>@LastErrorMessage</p>
        </div>
    }

    <!-- 3-Column Layout -->
   <div class="flex flex-col md:flex-row gap-4 md:gap-3">
        
        <!-- Left Column: Order Status -->
        <div class="rounded-2xl border border-gray-100 w-[35%] bg-white rounded-xl shadow p-1">
            <div class="p-2 flex justify-between items-center bg-white">
                <h3 class="font-bold text-[#002d54] text-sm">Order Status</h3>
                <button class="expand-btn" @onclick="OpenMainModal">
                    <span class="oi oi-fullscreen-enter"></span>
                </button>
            </div>
            
            <div class="flex-1 overflow-auto px-1 pb-1">
                @if (IsLoading)
                {
                    <div class="py-12 text-center text-gray-400">
                        <div class="spinner border-2 border-gray-100 border-t-blue-500 rounded-full w-4 h-4 animate-spin mx-auto mb-2"></div>
                        <p class="text-[10px]">Loading summaries...</p>
                    </div>
                }
                else
                {
                    <QuickGrid Items="@OrderSummaries" class="quick-grid">
                        <PropertyColumn Property="@(s => s.SN)" Title="SN" Sortable="true" />
                        <TemplateColumn Title="Customer Name">
                            <button type="button" class="text-blue-600 hover:text-blue-800 hover:underline text-left text-xs" @onclick="() => ShowHistory(context)">
                                @context.CustomerName
                            </button>
                        </TemplateColumn>
                        <PropertyColumn Property="@(s => s.TotalOrder)" Title="TotalPO" Sortable="true" Align="Align.Center" />
                        <PropertyColumn Property="@(s => s.RunningOrder)" Title="RunningPO" Sortable="true" Align="Align.Center" />
                        <PropertyColumn Property="@(s => s.NotStartedOrder)" Title="WaitingPO" Sortable="true" Align="Align.Center" />
                        
                    </QuickGrid>

                    @if (!OrderSummaries.Any())
                    {
                        <div class="py-8 text-center text-gray-400">
                            <span class="oi oi-inbox text-2xl block mb-2 opacity-10"></span>
                            <p class="text-[10px] font-medium">No records found</p>
                        </div>
                    }
                }
            </div>
        </div>

        <!-- Middle Column: Production Status -->
        <div class="w-[45%] bg-white rounded-xl shadow p-1">
            <div class="p-2 flex justify-between items-center bg-white">
                <h3 class="font-bold text-[#002d54] text-sm">Production Status</h3>
                <button class="expand-btn">
                    <span class="oi oi-fullscreen-enter"></span>
                </button>
            </div>
            <div class="flex-1 overflow-auto px-1 pb-1">
                @if (IsOrderDetailLoading)
                {
                    <div class="py-12 text-center text-gray-400">
                        <div class="spinner border-2 border-gray-100 border-t-blue-500 rounded-full w-4 h-4 animate-spin mx-auto mb-2"></div>
                        <p class="text-[10px]">Loading details...</p>
                    </div>
                }
                else
                {
                    <QuickGrid TGridItem="OrderStatusDetailDto" Items="@OrderStatusDetailList" class="quick-grid">
                        <TemplateColumn Title="Customer Name">
                            <button type="button" class="text-blue-600 hover:text-blue-800 hover:underline text-left text-xs" @onclick="() => ShowHistory((OrderStatusDetailDto)context)">
                                @context.CustomerName
                            </button>
                        </TemplateColumn>

                        <TemplateColumn Title="Order No">
                            <button type="button" class="text-blue-600 hover:text-blue-800 hover:underline text-left text-xs" @onclick="() => ShowProductionFlow((OrderStatusDetailDto)context)">
                                @context.OrderNo
                            </button>
                        </TemplateColumn>
                        
                        
                        
                        <PropertyColumn Property="@(s => s.OrderQty)" Title="OrderQty" Sortable="true"  Align="Align.Right" />
                        <TemplateColumn Title="Shipping Date" Sortable="true">
                            @(context.LatestShippingDate?.ToString("dd MMM yy") ?? "-")
                        </TemplateColumn>
                        <PropertyColumn Property="@(s => s.CoveragePercent)" Title="Progress" Sortable="true"  Align="Align.Right"/>
                        <TemplateColumn Title="Projected" Sortable="true">
                            @(context.Packingdate?.ToString("dd MMM yy") ?? "-")
                        </TemplateColumn>
                    </QuickGrid>

                    @if (!OrderStatusDetailList.Any())
                    {
                        <div class="py-8 text-center text-gray-400">
                            <span class="oi oi-inbox text-2xl block mb-2 opacity-10"></span>
                            <p class="text-[10px] font-medium">No records found</p>
                        </div>
                    }
                }
            </div>
        </div>

        <!-- Right Column: Setting Piece -->
        <div class="w-[20%] bg-white rounded-xl shadow p-1">
            <div class="p-4 flex justify-between items-center bg-white">
                <h3 class="font-bold text-[#002d54] text-sm">Setting Piece</h3>
                <button class="expand-btn">
                    <span class="oi oi-fullscreen-enter"></span>
                </button>
            </div>
            <div class="flex-1 overflow-auto px-4 pb-4">
                 
            </div>
        </div>

    </div>
</div>

<DataModal @bind-IsVisible="showModal" Title="Order Status Details" IsLoading="@IsLoading" FullScreen="true">
    <div class="p-4 sm:p-6 max-h-[85vh] overflow-y-auto">
        <!-- Header if needed -->
 

        <!-- The responsive two-column container -->
        <div class="flex flex-col lg:flex-row gap-6 lg:gap-8">

            <!-- Left Grid Card -->
            <div class="flex-1 min-w-0 bg-white rounded-lg shadow border border-gray-200 p-4">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 mb-4">
                    <h3 class="text-lg font-semibold text-gray-800 tracking-tight">Order Summary</h3>
                    <div class="relative w-full sm:w-64">
                        <input type="text" 
                               class="w-full pl-9 pr-3 py-2 text-sm border border-gray-200 rounded-lg bg-gray-50/50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all duration-200" 
                               placeholder="Search customer..." 
                               @bind="orderSearchTerm" 
                               @bind:event="oninput" />
                    </div>
                </div>

                <QuickGrid Items="@FilteredOrderSummariesPop" class="quick-grid w-full text-sm">
                    <PropertyColumn Property="@(s => s.SN)"                            Title="SN"            Sortable="true"                    Class="text-center" />

                    <TemplateColumn Title="Customer Name">
                        <button type="button"
                                class="text-blue-600 hover:text-blue-800 hover:underline text-left text-xs font-medium"
                                @onclick="() => ShowHistory(context)">
                            @context.CustomerName
                        </button>
                    </TemplateColumn>

                    <PropertyColumn Property="@(s => s.TotalOrder)"                        Title="TotalPO"       Sortable="true"
                                    Align="Align.Center" />

                    <PropertyColumn Property="@(s => s.RunningOrder)"              Title="RunningPO"                      Sortable="true"
                                    Align="Align.Center" />

                    <PropertyColumn Property="@(s => s.NotStartedOrder)"    Title="WaitingPO"            Sortable="true"
                                    Align="Align.Center" />
                </QuickGrid>
            </div>

            <!-- Right Grid Card -->
            <div class="flex-1 min-w-0 bg-white rounded-lg shadow border border-gray-200 p-4">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 mb-4">
                    <h3 class="text-lg font-semibold text-gray-800 tracking-tight">Absent Buyer List</h3>
                    <div class="relative w-full sm:w-64">
                        <input type="text" 
                               class="w-full pl-9 pr-3 py-2 text-sm border border-gray-200 rounded-lg bg-gray-50/50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all duration-200" 
                               placeholder="Search customer..." 
                               @bind="absentSearchTerm" 
                               @bind:event="oninput" />
                   
                    </div>
                </div>

                <QuickGrid Items="@FilteredAbsentBuyerList" Pagination="@absentPagination" class="quick-grid w-full text-sm">
                    <PropertyColumn Property="@(s => s.SN)" Title="SN"            Sortable="true"                    Class="text-center" />

                    <TemplateColumn Title="Customer Name">
                        <button type="button"
                                class="text-blue-600 hover:text-blue-800 hover:underline text-left text-xs font-medium"
                                @onclick="() => ShowHistory(context)">
                            @context.CustomerName
                        </button>
                    </TemplateColumn>
                 
                    <PropertyColumn Property="@(s => s.JoinedDate)" Title="First PO" Sortable="true" />
                    <PropertyColumn Property="@(s => s.RecentDate)" Title="Recent PO" Sortable="true"  />
                    <PropertyColumn Property="@(s => s.TotalPcs)" Title="Total Pcs" Sortable="true"  />
                    
                </QuickGrid>
                <div class="mt-4">
                    <Paginator State="@absentPagination" />
                </div>
            </div>
        </div>
    </div>
</DataModal>

<DataModal @bind-IsVisible="showHistoryModal" Title="@($"Order History - {SelectedBuyerName}")" IsLoading="@IsHistoryLoading">
    <div class="p-1">
       <div class="max-w-4xl mx-auto p-1">
