@page "/auth-debug"
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider
@inject NkplmErp.Blazor.Services.Auth.CustomAuthStateProvider CustomAuthProvider

<h3>Authentication Debug</h3>

<div style="padding: 20px; background: #f5f5f5; margin: 20px; border-radius: 8px;">
    <h4>Current Authentication Status</h4>
    
    <AuthorizeView>
        <Authorized>
            <div style="color: green; font-weight: bold;">✓ You are authenticated</div>
            <p>User: @context.User.Identity?.Name</p>
            <p>Claims:</p>
            <ul>
                @foreach (var claim in context.User.Claims)
                {
                    <li>@claim.Type: @claim.Value</li>
                }
            </ul>
        </Authorized>
        <NotAuthorized>
            <div style="color: red; font-weight: bold;">✗ You are NOT authenticated</div>
            <p>Please <a href="/login">login</a> first.</p>
        </NotAuthorized>
    </AuthorizeView>
    
    <hr />
    
    <h4>Token Status</h4>
    <p>Provider Instance ID: <strong>@CustomAuthProvider.InstanceId</strong></p>
    <p>Token in CustomAuthStateProvider: <strong>@(string.IsNullOrEmpty(CustomAuthProvider.AuthToken) ? "NOT FOUND" : $"FOUND (length: {CustomAuthProvider.AuthToken.Length})")</strong></p>
    
    @if (!string.IsNullOrEmpty(CustomAuthProvider.AuthToken))
    {
        <p style="word-break: break-all; background: #fff; padding: 10px; font-family: monospace; font-size: 12px;">
            @CustomAuthProvider.AuthToken
        </p>
    }
</div>

<div style="padding: 20px; background: #fff3cd; margin: 20px; border-radius: 8px; border: 1px solid #ffc107;">
    <h4>Instructions</h4>
    <ol>
        <li>If you see "NOT authenticated" above, go to <a href="/login">/login</a> and login with <code>admin@nkplm.erp</code> / <code>Password123!</code></li>
        <li>After successful login, come back to this page</li>
        <li>You should see "authenticated" and a token</li>
        <li>Then try the <a href="/main-dashboard">dashboard</a></li>
    </ol>
</div>
