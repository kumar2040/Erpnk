<DataModal @bind-IsVisible="IsMachineModalOpen"
           Title="@($"Gauge G-{ModalGauge} • Machine-wise Timeline")"
           BadgeText="GANTT"
           IsLoading="false"
           MaxWidth="1150px">
    <div class="planning-page p-3 bg-bg" style="max-height: 75vh; overflow: auto;">
        <!-- Summary strip -->
        <div class="flex flex-wrap items-center gap-2 mb-3">
            <div class="panel px-3 py-2 flex items-center gap-2">
                <span class="text-[9px] font-bold text-muted uppercase tracking-wider">Machines</span>
                <span class="text-sm font-bold text-navy">@ModalMachineGroups.Count</span>
            </div>
            <div class="panel px-3 py-2 flex items-center gap-2">
                <span class="text-[9px] font-bold text-muted uppercase tracking-wider">Orders</span>
                <span class="text-sm font-bold text-navy">@ModalPlans.Select(p => p.OrderNo).Distinct().Count()</span>
            </div>
            <div class="panel px-3 py-2 flex items-center gap-2">
                <span class="text-[9px] font-bold text-muted uppercase tracking-wider">Planned Qty</span>
                <span class="text-sm font-bold text-navy">@ModalPlans.Sum(p => p.Qty).ToString("N0")</span>
            </div>
