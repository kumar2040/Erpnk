        @if (!ModalMachineGroups.Any())
        {
            <div class="py-16 text-center text-muted">
                <span class="text-3xl block mb-2 opacity-30">📭</span>
                <h4 class="text-xs font-bold text-navy uppercase tracking-widest">No Machines Allocated</h4>
                <p class="text-[10px] text-muted mt-1">No machine allocations found for gauge G-@ModalGauge.</p>
            </div>
        }
        else
        {
            <div class="gantt-container" style="--timeline-columns: @CalendarDays.Count">
                <div class="gantt-grid" style="grid-template-columns: 150px 1fr;">
                    <!-- Axis Headers -->
                    <div class="gantt-axis-label flex items-center justify-center">Machine</div>
                    <div class="gantt-axis-timeline">
                        @for (int i = 0; i < CalendarDays.Count; i++)
                        {
                            var day = CalendarDays[i];
                            var widthPct = 100.0 / CalendarDays.Count;
                            var leftPct = i * widthPct;
                            var isWeekend = day.DayOfWeek == DayOfWeek.Saturday;
                            var isMonthStart = day.Day == 1 || i == 0;

                            <div class="gantt-axis-day @(isWeekend ? "gantt-day-weekend" : "")"
                                 style="left: @(leftPct.ToString("F3", System.Globalization.CultureInfo.InvariantCulture))%; width: @(widthPct.ToString("F3", System.Globalization.CultureInfo.InvariantCulture))%;">
                                @if (isMonthStart)
                                {
