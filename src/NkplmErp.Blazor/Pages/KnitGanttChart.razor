                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</DataModal>

@code {
    [Inject]
    private IProductionPlanningService PlanningService { get; set; } = null!;

    [Inject]
    private IJSRuntime JS { get; set; } = null!;

    [Inject]
    private NavigationManager Navigation { get; set; } = null!;

    [Inject]
    private NkplmErp.Blazor.Services.RoleManagement.PermissionService Permissions { get; set; } = null!;

    private List<KnitGanttChartDto> GanttData { get; set; } = new();
    private List<DateTime> CalendarDays { get; set; } = new();
    private KnitGanttChartDto? SelectedPlan { get; set; }
    private bool IsPlanDetailModalOpen { get; set; }

    // Filters
    private string OrderNoFilter { get; set; } = string.Empty;
    private string GaugeFilter { get; set; } = string.Empty;
    private List<string> AvailableGauges { get; set; } = new();
    private DateTime? StartDateFilter { get; set; }
    private DateTime? EndDateFilter { get; set; }
    private string ActiveViewMode { get; set; } = "thismonth";
    private bool IsDateDropdownOpen { get; set; } = false;

    // Dual Calendar picker temporary state variables
    private DateTime? TempStartDate { get; set; }
    private DateTime? TempEndDate { get; set; }
    private int DateSelectionStep { get; set; } = 0;
    private DateTime? LeftCalendarMonth { get; set; }
    private DateTime? HoveredDate { get; set; }

    private bool IsLoading { get; set; } = true;
    private DateTime MinTimelineDate { get; set; } = DateTime.Today;
    private DateTime MaxTimelineDate { get; set; } = DateTime.Today.AddDays(30);

    // Gauge machine-wise timeline modal
    private bool IsMachineModalOpen { get; set; }
    private string ModalGauge { get; set; } = string.Empty;
    private List<KnitGanttChartDto> ModalPlans { get; set; } = new();
    private List<IGrouping<string, KnitGanttChartDto>> ModalMachineGroups { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        // Zero Trust: page is permission-guarded like the rest of the app.
        if (!Permissions.IsLoaded)
        {
            await Permissions.LoadPermissionsAsync();
        }
        if (!Permissions.CanView("KnitGanttChart"))
        {
            Navigation.NavigateTo("/dashboard");
            return;
        }

        ActiveViewMode = "30days";
        UpdateDatesForViewMode();
        LeftCalendarMonth = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
        await FetchGanttData();
    }

    private void ToggleDateDropdown()
    {
        if (IsDateDropdownOpen)
        {
            IsDateDropdownOpen = false;
        }
        else
        {
            OpenDateDropdown();
        }
    }

    private void OpenDateDropdown()
    {
        IsDateDropdownOpen = true;
        TempStartDate = StartDateFilter;
        TempEndDate = EndDateFilter;
        DateSelectionStep = 0;
        LeftCalendarMonth = new DateTime((TempStartDate ?? DateTime.Today).Year, (TempStartDate ?? DateTime.Today).Month, 1);
    }

    private string GetDateRangeLabel()
    {
        if (StartDateFilter == null || EndDateFilter == null)
            return "Select Date Range";

        return $"{StartDateFilter.Value.ToString("MMMM dd, yyyy")} – {EndDateFilter.Value.ToString("MMMM dd, yyyy")}";
    }

    private void PrevMonth()
    {
        if (LeftCalendarMonth != null)
        {
            LeftCalendarMonth = LeftCalendarMonth.Value.AddMonths(-1);
        }
    }

    private void NextMonth()
    {
        if (LeftCalendarMonth != null)
        {
            LeftCalendarMonth = LeftCalendarMonth.Value.AddMonths(1);
        }
    }

    private void OnDayClick(DateTime date)
    {
        if (DateSelectionStep == 0)
        {
            TempStartDate = date;
            TempEndDate = null;
            DateSelectionStep = 1;
            ActiveViewMode = "custom";
        }
        else
        {
            if (date < TempStartDate)
            {
                TempStartDate = date;
                TempEndDate = null;
                DateSelectionStep = 1;
            }
            else
            {
                TempEndDate = date;
                DateSelectionStep = 0;
            }
        }
    }

    private void OnDayHover(DateTime date)
    {
        if (DateSelectionStep == 1)
        {
            HoveredDate = date;
        }
    }

    private bool IsDaySelected(DateTime date)
    {
        return date == TempStartDate || date == TempEndDate;
    }

    private bool IsDayInRange(DateTime date)
    {
        if (TempStartDate == null) return false;
        
        if (TempEndDate != null)
        {
            return date > TempStartDate && date < TempEndDate;
        }
        
        if (DateSelectionStep == 1 && HoveredDate != null && HoveredDate > TempStartDate)
        {
            return date > TempStartDate && date < HoveredDate;
        }
        
        return false;
    }

    private List<DateTime> GetCalendarDaysList(int year, int month)
    {
        var firstDay = new DateTime(year, month, 1);
        var startOfWeek = firstDay.AddDays(-(int)firstDay.DayOfWeek);
        
        var days = new List<DateTime>();
        for (int i = 0; i < 42; i++)
        {
            days.Add(startOfWeek.AddDays(i));
        }
        return days;
    }

    private async Task ApplyPreset(string preset)
    {
        ActiveViewMode = preset;
        IsDateDropdownOpen = false;
        UpdateDatesForViewMode();
        await FetchGanttData();
    }

    private void SelectPreset(string preset)
    {
        ActiveViewMode = preset;
        UpdateTempDatesForPreset();
        DateSelectionStep = 0;
        
        if (TempStartDate != null)
        {
            LeftCalendarMonth = new DateTime(TempStartDate.Value.Year, TempStartDate.Value.Month, 1);
        }
    }

    private void UpdateTempDatesForPreset()
    {
        var today = DateTime.Today;
        if (ActiveViewMode == "today")
        {
            TempStartDate = today;
            TempEndDate = today;
        }
        else if (ActiveViewMode == "yesterday")
        {
            TempStartDate = today.AddDays(-1);
            TempEndDate = today.AddDays(-1);
        }
        else if (ActiveViewMode == "thisweek")
        {
            TempStartDate = today.AddDays(-(int)today.DayOfWeek);
            TempEndDate = TempStartDate.Value.AddDays(6);
        }
        else if (ActiveViewMode == "last7days")
        {
            TempStartDate = today.AddDays(-6);
            TempEndDate = today;
        }
        else if (ActiveViewMode == "30days")
        {
            TempStartDate = today;
            TempEndDate = today.AddMonths(1);
        }
        else if (ActiveViewMode == "thismonth")
        {
            TempStartDate = new DateTime(today.Year, today.Month, 1);
            TempEndDate = TempStartDate.Value.AddMonths(1).AddDays(-1);
        }
        else if (ActiveViewMode == "lastmonth")
        {
            TempStartDate = new DateTime(today.Year, today.Month, 1).AddMonths(-1);
            TempEndDate = TempStartDate.Value.AddMonths(1).AddDays(-1);
        }
    }

    private void CancelDateTime()
    {
        IsDateDropdownOpen = false;
    }

    private async Task ApplyDateTime()
    {
        StartDateFilter = TempStartDate;
        EndDateFilter = TempEndDate;
        IsDateDropdownOpen = false;
        await FetchGanttData();
    }

    private void UpdateDatesForViewMode()
    {
        var today = DateTime.Today;
        if (ActiveViewMode == "today")
        {
            StartDateFilter = today;
            EndDateFilter = today;
        }
        else if (ActiveViewMode == "yesterday")
        {
            StartDateFilter = today.AddDays(-1);
            EndDateFilter = today.AddDays(-1);
        }
        else if (ActiveViewMode == "thisweek")
        {
            StartDateFilter = today.AddDays(-(int)today.DayOfWeek);
            EndDateFilter = StartDateFilter.Value.AddDays(6);
        }
        else if (ActiveViewMode == "last7days")
        {
            StartDateFilter = today.AddDays(-6);
            EndDateFilter = today;
        }
        else if (ActiveViewMode == "30days")
        {
            StartDateFilter = today;
            EndDateFilter = today.AddMonths(1);
        }
        else if (ActiveViewMode == "thismonth")
        {
            StartDateFilter = new DateTime(today.Year, today.Month, 1);
            EndDateFilter = StartDateFilter.Value.AddMonths(1).AddDays(-1);
        }
        else if (ActiveViewMode == "lastmonth")
        {
            StartDateFilter = new DateTime(today.Year, today.Month, 1).AddMonths(-1);
            EndDateFilter = StartDateFilter.Value.AddMonths(1).AddDays(-1);
        }
    }

    private async Task FetchGanttData()
    {
        IsLoading = true;
        StateHasChanged();
        await Task.Yield();

        try
        {
            var data = await PlanningService.GetKnitGanttChartDataAsync(StartDateFilter, EndDateFilter, OrderNoFilter, GaugeFilter);
            GanttData = data.ToList();

            // Populate the available gauges list dynamically from both planned Gantt data and machine setups
            try
            {
                var allMachines = await PlanningService.GetMachinePlaningAsync(null);
                var machineGauges = allMachines.Where(m => m.Gauge.HasValue)
                                               .Select(m => m.Gauge!.Value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture));
                var ganttGauges = GanttData.Select(x => x.Guage).Where(g => !string.IsNullOrEmpty(g));
                
                AvailableGauges = machineGauges.Union(ganttGauges)
                                               .Distinct()
                                               .OrderBy(g => double.TryParse(g, out double d) ? d : 999.0)
                                               .ToList();
            }
            catch
            {
                // Fallback to active Gantt data gauges if machine API fails
                AvailableGauges = GanttData.Select(x => x.Guage)
                                           .Where(g => !string.IsNullOrEmpty(g))
                                           .Distinct()
                                           .OrderBy(g => double.TryParse(g, out double d) ? d : 999.0)
                                           .ToList();
            }

            CalculateTimelineBoundaries();

            // Best-effort: knitter assignments so capsules can show who runs each plan.
            try
            {
                KnitterBusy = await PlanningService.GetKnitterBusyAsync();
                var ks = await PlanningService.GetKnittersByGaugeAsync(null);
                KnitterNames = ks.GroupBy(k => k.CardNo)
                                 .ToDictionary(g => g.Key, g => g.First().KnitterName, StringComparer.OrdinalIgnoreCase);
            }
            catch { KnitterBusy = new(); KnitterNames = new(StringComparer.OrdinalIgnoreCase); }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to fetch Gantt chart data: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private void CalculateTimelineBoundaries()
    {
        DateTime minDate = StartDateFilter ?? DateTime.Today;
        DateTime maxDate = EndDateFilter ?? DateTime.Today.AddDays(29);

        if (ActiveViewMode == "custom" && GanttData.Any())
        {
            minDate = StartDateFilter ?? GanttData.Min(x => x.StartDate);
            maxDate = EndDateFilter ?? GanttData.Max(x => x.EndDate);
        }

        MinTimelineDate = minDate;
        MaxTimelineDate = maxDate;

        // Generate full sequential calendar days list
        CalendarDays.Clear();
        var totalDays = (MaxTimelineDate - MinTimelineDate).Days + 1;
        
        // Safeguard calendar sizing to prevent render overflows if duration is excessively long
        if (totalDays > 120)
        {
            totalDays = 120;
            MaxTimelineDate = MinTimelineDate.AddDays(119);
        }

        for (int i = 0; i < totalDays; i++)
        {
            CalendarDays.Add(MinTimelineDate.AddDays(i));
        }
    }

    // ---- Knitter on capsules ----
    private List<KnitterBusyDto> KnitterBusy { get; set; } = new();
    private Dictionary<string, string> KnitterNames { get; set; } = new(StringComparer.OrdinalIgnoreCase);

    private string? GetPlanKnitter(int planId)
    {
        var b = KnitterBusy.FirstOrDefault(x => x.PlanId == planId);
        if (b == null) return null;
        return KnitterNames.TryGetValue(b.CardNo, out var n) && !string.IsNullOrEmpty(n)
            ? $"{n} ({b.CardNo})" : b.CardNo;
    }

    // ---- Today marker ----
    private double? TodayOffsetPct
    {
        get
        {
            var total = (MaxTimelineDate - MinTimelineDate).TotalDays;
            if (total <= 0) return null;
            var t = DateTime.Today;
            if (t < MinTimelineDate || t > MaxTimelineDate) return null;
            return (t - MinTimelineDate).TotalDays / total * 100.0;
        }
    }

    // ---- Stable colour per order (same order = same colour on every machine/gauge) ----
    private static readonly string[] OrderPalette =
    {
        "#1d6fb8", "#7048b6", "#b8336a", "#0e8f7e", "#c2702b", "#5a7d2a",
        "#2455a4", "#9c2f2f", "#386fa4", "#7d5ba6", "#27867d", "#aa4a8c"
    };

    private string OrderColor(string? orderNo)
    {
        if (string.IsNullOrEmpty(orderNo)) return "var(--navy)";
        int h = 17;
        foreach (var c in orderNo) h = unchecked(h * 31 + c);
        return OrderPalette[Math.Abs(h) % OrderPalette.Length];
    }

    private List<string> VisibleOrders =>
        GanttData.Select(p => p.OrderNo).Where(o => !string.IsNullOrEmpty(o)).Distinct().Take(14).ToList();

    // ---- Free-slot emphasis: % offset where a row becomes idle (null = busy to window end) ----
    private double? FreeFromPct(IEnumerable<KnitGanttChartDto> plans)
    {
        var total = (MaxTimelineDate - MinTimelineDate).TotalDays;
        if (total <= 0) return null;
        var list = plans.ToList();
        if (!list.Any()) return 0;
        var end = list.Max(p => p.EndDate);
        if (end >= MaxTimelineDate) return null;
        var d = (end - MinTimelineDate).TotalDays;
        if (d < 0) d = 0;
        return d / total * 100.0;
    }

    private (double Left, double Width) CalculateBlockPlacement(KnitGanttChartDto plan)
    {
        var totalTimelineDuration = (MaxTimelineDate - MinTimelineDate).TotalDays;
        if (totalTimelineDuration <= 0) return (0, 0);

        // Clip block start and end to active visible calendar window
        var blockStart = plan.StartDate < MinTimelineDate ? MinTimelineDate : plan.StartDate;
        var blockEnd = plan.EndDate > MaxTimelineDate ? MaxTimelineDate : plan.EndDate;

        if (blockEnd < blockStart) return (0, 0);

        var leftDays = (blockStart - MinTimelineDate).TotalDays;
        var blockDays = (blockEnd - blockStart).TotalDays;

        // Ensure at least 1 day width so block is visually visible even if single-day plans land on weekend
        if (blockDays <= 0) blockDays = 1.0;

        var leftOffsetPct = (leftDays / totalTimelineDuration) * 100.0;
        var widthPct = (blockDays / totalTimelineDuration) * 100.0;

        // Clip overflows at 100% boundary limit
        if (leftOffsetPct < 0) leftOffsetPct = 0;
        if (leftOffsetPct + widthPct > 100) widthPct = 100 - leftOffsetPct;

        return (leftOffsetPct, widthPct);
    }

    private void SelectPlan(KnitGanttChartDto plan)
    {
        SelectedPlan = plan;
        IsPlanDetailModalOpen = true;
        StateHasChanged();
    }

    private void OpenGaugeMachineModal(string gauge)
    {
        ModalGauge = gauge;
        ModalPlans = GanttData.Where(x => x.Guage == gauge).ToList();
        ModalMachineGroups = ModalPlans
            .GroupBy(x => x.Machine ?? string.Empty)
            .OrderBy(g => g.Key, StringComparer.OrdinalIgnoreCase)
            .ToList();
        IsMachineModalOpen = true;
        StateHasChanged();
    }

    private async Task ResetFilters()
    {
        OrderNoFilter = string.Empty;
        GaugeFilter = string.Empty;
        ActiveViewMode = "30days";
        UpdateDatesForViewMode();
        SelectedPlan = null;
        await FetchGanttData();
    }
