            <div class="flex gap-3 text-[9px] font-bold uppercase tracking-wider text-muted items-center">
                <span class="flex items-center gap-1"><span class="inline-block w-2 h-2 rounded-full" style="background: var(--navy);"></span> Active</span>
                <span class="flex items-center gap-1"><span class="inline-block w-2 h-2 rounded-full" style="background: var(--amber);"></span> Partial</span>
                <span class="flex items-center gap-1"><span class="inline-block w-2 h-2 rounded-full" style="background: var(--green);"></span> Completed</span>
