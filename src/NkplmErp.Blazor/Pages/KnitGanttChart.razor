                                @if (FreeFromPct(plansForMachine) is double mFreePct)
                                {
                                    <div class="gantt-free" style="left:@(mFreePct.ToString("F3", System.Globalization.CultureInfo.InvariantCulture))%;" title="Free from here"></div>
                                }
                                @if (TodayOffsetPct is double mTrp)
                                {
                                    <div class="gantt-today" style="left:@(mTrp.ToString("F3", System.Globalization.CultureInfo.InvariantCulture))%;"></div>
                                }

                                @foreach (var plan in plansForMachine)
                                {
                                    var (leftOffset, width) = CalculateBlockPlacement(plan);
                                    if (width <= 0) continue;

                                    var accClass = plan.PlaningStatus == "Completed"
                                        ? "gantt-acc-completed"
                                        : (plan.PlaningStatus == "Partial" ? "gantt-acc-partial" : "");
                                    var mKnitter = GetPlanKnitter(plan.MasterPlanChildId);

                                    <div class="gantt-block @accClass"
                                         style="left: @(leftOffset.ToString("F3", System.Globalization.CultureInfo.InvariantCulture))%; width: @(width.ToString("F3", System.Globalization.CultureInfo.InvariantCulture))%; background: @OrderColor(plan.OrderNo);">
                                        <span class="truncate block w-full text-center">@plan.OrderNo</span>
                                        <div class="gantt-tooltip">
                                            <div class="font-bold text-[10px] text-teal uppercase mb-1 flex items-center justify-between">
                                                <span>@(string.IsNullOrWhiteSpace(machineName) ? "Unassigned" : machineName)</span>
                                                <span class="bg-white/10 px-1 py-0.5 rounded text-[8px]">@plan.PlaningStatus</span>
                                            </div>
                                            <div class="grid grid-cols-[80px_1fr] gap-x-1 gap-y-0.5 mt-1 border-t border-slate-700/60 pt-1.5" style="font-weight: normal !important;">
                                                <span class="text-slate-400">Order No:</span>
                                                <span class="text-white">@plan.OrderNo</span>
                                                <span class="text-slate-400">Type:</span>
                                                <span class="text-white">@plan.OrderType / @plan.ProductionType</span>
                                                <span class="text-slate-400">Date Range:</span>
                                                <span class="text-white">@plan.StartDate.ToString("dd-MMM") to @plan.EndDate.ToString("dd-MMM")</span>
                                                <span class="text-slate-400">Planned Qty:</span>
                                                <span class="text-white">@plan.Qty.ToString("N0") pcs</span>
                                                <span class="text-slate-400">Knitter:</span>
                                                <span class="text-white">@(mKnitter ?? "Not assigned")</span>
