    <!-- Gauge Detail Modal -->
    <DataModal @bind-IsVisible="IsGaugeDetailModalOpen" 
               Title="@($"Gauge Details: {SelectedGauge}")" 
               BadgeText=" " 
               IsLoading="IsLoadingGaugeDetail"
               MaxWidth="1000px">
        <div class="flex flex-col h-full bg-bg overflow-hidden min-h-[400px]">
            <div class="p-2 bg-white border-b border-border flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="p-2 bg-sky-50 rounded-lg text-[#ccc]">
                        <i class="fa-solid fa-layer-group"></i>
                    </div>
                    <div>
                        <h4 class="text-sm font-bold text-[#000] uppercase letter-spacing-0.5">Order Breakdown</h4>
                        <p class="text-[10px] font-bold text-muted uppercase"> Styles Under Gauge @SelectedGauge</p>
                    </div>
                </div>

                @if (GaugeDetails != null && GaugeDetails.Any())
                {
                    <div class="flex border border-border rounded overflow-hidden bg-white">
                        <div class="px-3 py-1 flex flex-col items-center border-r border-border min-w-[70px]">
                            <span class="text-[8px] font-bold text-muted uppercase tracking-tighter">Styles</span>
                            <span class="text-[12px] font-bold text-[#222] leading-none">@GaugeDetails.Select(x => x.StyleNo).Distinct().Count()</span>
                        </div>
                        <div class="px-3 py-1 flex flex-col items-center border-r border-border min-w-[70px]">
                            <span class="text-[8px] font-bold text-muted uppercase tracking-tighter">Colors</span>
                            <span class="text-[12px] font-bold text-[#222] leading-none">@GaugeDetails.Select(x => x.OrderColor).Distinct().Count()</span>
                        </div>
                        <div class="px-3 py-1 flex flex-col items-center min-w-[80px]">
                            <span class="text-[8px] font-bold text-muted uppercase tracking-tighter">Total Qty</span>
                            <span class="text-[12px] font-bold text-[#222] leading-none">@GaugeDetails.Sum(x => x.BalanceQty).ToString("N0")</span>
                        </div>
                    </div>
                }
            </div>
            
            <div class="flex-1 overflow-y-auto custom-scroll">
                <table class="nk-table compact-table">
                    <thead class="sticky top-0 z-10 bg-white shadow-sm border-b border-border">
                        <tr>
                            <th class="w-10 text-center">S.N</th>
                            <th>Order No</th>
                            <th>Style No</th>
                            <th class="text-center">Color</th>
                            <th class="text-right">Order Qty</th>
                            <th class="text-right">Knitted Qty</th>
                            <th class="text-right">Balance</th>
                            <th class="text-center">Pnt</th>
                            <th class="text-center">Emb</th>
                            <th class="text-center">Req. Days</th>
                            <th class="text-right pr-4">Ship Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (GaugeDetails != null && GaugeDetails.Any())
                        {
                            int sn = 1;
                            foreach (var detail in GaugeDetails)
                            {
                                <tr>
                                    <td class="text-muted font-bold text-[9px] text-center">@(sn++)</td>
                                    <td class="font-bold text-navy">@detail.OrderNo</td>
                                    <td class="font-bold text-muted">@detail.StyleNo</td>
                                    <td class="text-center">
                                        <span class="px-2 py-0.5 rounded-full bg-white text-navy text-[10px] border border-border font-bold">@detail.OrderColor</span>
                                    </td>
                                    <td class="text-right font-bold">@detail.OrderPics.ToString("N0")</td>
                                    <td class="text-right font-bold text-green">@detail.TotalReceived.ToString("N0")</td>
                                    <td class="text-right font-bold text-red">@detail.BalanceQty.ToString("N0")</td>
                                    <td class="text-center">
                                        <div class="flex items-center justify-center gap-1">
                                            @if (detail.PrintStatus == "OK")
                                            {
                                               <span class="text-[9px] font-bold text-sky bg-sky/10 px-1.5 py-0.5 rounded">P</span>
                                            }
                                            @if (Regex.IsMatch(detail.StyleNo, @"\dDE", RegexOptions.IgnoreCase))
                                            {
                                                <span class="text-[9px] font-bold text-red bg-red/10 px-1.5 py-0.5 rounded" title="De-Knitted">DE</span>
                                            }
                                            @if (detail.StyleNo.Contains("SPACE", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span class="text-[9px] font-bold text-amber bg-amber/10 px-1.5 py-0.5 rounded" title="Space Dye">SP</span>
                                            }
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        @if (detail.EmbdStatus == "OK")
                                        {
                                           <span class="text-[9px] font-bold text-red bg-red/10 px-1.5 py-0.5 rounded">E</span>
                                        }
                                    </td>
                                    <td class="text-center text-navy font-bold">@detail.RequireDays.ToString("N1")</td>
                                    <td class="text-right font-bold text-muted pr-4">@detail.ShippingDate.ToString("dd-MMM")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            
            <div class="p-3 bg-white border-t border-border flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-teal animate-pulse"></span>
                    <p class="text-[10px] font-bold text-teal uppercase">Live Production Analysis</p>
                </div>
                <p class="text-[10px] font-bold text-muted">
                    Total Items: <span class="text-teal font-bold">@(GaugeDetails?.Count ?? 0)</span>
                </p>
            </div>
        </div>
    </DataModal>
    
