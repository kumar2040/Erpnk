            <div class="panel flex flex-col min-h-0">
                <div class="panel-header compact-panel-header" style="background: var(--navy); color: #fff;">
                    <div class="panel-header-left">
                        <i class="fa-solid fa-play text-[10px] mr-1"></i>
                        <span class="compact-panel-title font-bold">
                            @(SelectedKnitType == "Knit" ? "Gauge Machine Schedule & Availability" : "Running Details")
                        </span>
                    </div>
                </div>
                <div class="panel-body custom-scroll overflow-y-auto max-h-[300px]">
                    @if (SelectedKnitType == "Knit")
                    {
                        @if (MachinePlaningList != null && MachinePlaningList.Any())
                        {
                            <table class="nk-table compact-table border-0 w-full">
                                <thead class="sticky top-0 bg-white shadow-sm z-10">
                                    <tr class="bg-sky border-b border-border">
                                        <th class="text-[9px] text-left py-1.5 px-3">Machine No</th>
                                        <th class="text-center text-[9px] py-1.5">Gauge</th>
                                        
                                        <th class="text-center text-[9px] py-1.5">Available Date</th>
                                        <th class="text-center text-[9px] py-1.5">Status</th>
                                        <th class="text-left text-[9px] py-1.5 px-3">Current Workload</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var machine in MachinePlaningList)
                                    {
                                        <tr class="hover:bg-slate-100/70 transition-colors border-b border-border last:border-b-0 cursor-pointer" @onclick="() => OpenGanttModal(SelectedModalGauge)" title="Click to view full Machine Gantt Chart">
                                            <td class="text-[9px] py-1.5 px-3 text-navy font-bold">@machine.MachineNo</td>
                                            <td class="text-center py-1.5 font-mono text-[9px]">@machine.Gauge</td>
                                              
                                            <td class="text-center py-1.5 font-bold text-[9px]" style="color: @(machine.Status == "FREE" ? "var(--green)" : "var(--navy)")">
                                                @machine.FreeDate.ToString("dd-MMM-yyyy")
                                            </td>
                                            <td class="text-center py-1.5">
                                                @if (machine.Status == "FREE")
                                                {
                                                    <span class="border rounded px-2 py-0.5 text-[9px] inline-block font-bold" 
                                                          style="background: #edfaf4; color: var(--green); border-color: rgba(61, 191, 138, 0.2);">FREE</span>
                                                }
                                                else
                                                {
                                                    <span class="border rounded px-2 py-0.5 text-[9px] inline-block font-bold" 
                                                          style="background: #fffbeb; color: var(--navy); border-color: rgba(26, 51, 83, 0.2);">BUSY</span>
                                                }
                                            </td>
                                            <td class="text-left py-1.5 px-3 text-[9px]">
                                                @if (!string.IsNullOrEmpty(machine.OrderNo))
                                                {
                                                    <span class="text-navy font-bold">@machine.OrderNo</span>
                                                    <span class="text-muted ml-1">(@machine.PlannedQty Qty - @machine.PlaningStatus)</span>
                                                }
                                                else if (machine.Status == "BUSY")
                                                {
                                                    <span class="text-slate-400 italic">Labor Capacity Locked</span>
                                                }
                                                else
                                                {
                                                    <span class="text-slate-400 italic">None (Idle)</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <div class="text-center py-6 text-muted italic text-[10px]">
                                No machines available for selected gauge
                            </div>
                        }
                    }
                    else
                    {
                        <table class="nk-table compact-table">
                            <thead class="sticky top-0 bg-white shadow-sm z-10">
                                <tr>
                                    <th class="w-10 text-center">S.N</th>
                                    <th class="w-16 text-center">@(SelectedKnitType == "Silk" || SelectedKnitType == "Other" || SelectedKnitType == "Linen" ? "Master Name" : "Gauge")</th>
                                    <th class="text-center">Machine Load</th>
                                    <th class="text-center">MC</th>
                                    <th class="text-center">OT</th>
                                    <th class="text-center">Will be Free</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (SelectedKnitType == "Silk" || SelectedKnitType == "Other" || SelectedKnitType == "Linen")
                                {
                                    var activeMasters = FabricAnalysisData?.MasterWorkload?
                                        .Where(m => (m.ActivePlanQty ?? 0) > 0 || (OrderAllPlannedPlans?.Any(p => string.Equals(p.Gauge?.Trim(), m.MasterId?.ToString()?.Trim(), StringComparison.OrdinalIgnoreCase) || string.Equals(p.Gauge?.Trim(), m.MasterName?.Trim(), StringComparison.OrdinalIgnoreCase)) == true))
                                        .ToList();

                                    @if (activeMasters?.Any() == true)
                                    {
                                        int snRun = 1;
                                        @foreach (var item in activeMasters)
                                        {
                                            var plannedPlans = OrderAllPlannedPlans?
                                                .Where(p => string.Equals(p.Gauge?.Trim(), item.MasterId?.ToString()?.Trim(), StringComparison.OrdinalIgnoreCase) ||
                                                            string.Equals(p.Gauge?.Trim(), item.MasterName?.Trim(), StringComparison.OrdinalIgnoreCase))
                                                .ToList();
                                            var plannedMasterQty = plannedPlans?.Sum(p => p.Quantity) ?? 0;
                                            var displayMachines = plannedPlans?.Sum(p => int.TryParse(p.Mc, out int m) ? m : 0) ?? item.RunningMachines ?? 1;
                                            displayMachines = displayMachines > 0 ? displayMachines : 1;
                                            var freeDate = plannedPlans != null && plannedPlans.Any() ? plannedPlans.Max(p => p.EstEndDate) : (item.MasterFreeDate ?? DateTime.Today);

                                            <tr>
                                                <td class="text-muted text-[9px] text-center" style="font-weight: normal !important;">@(snRun++)</td>
                                                <td class="text-center">
                                                    <span class="gauge-chip" style="padding: 1px 6px; font-size: 9px;">@item.MasterName</span>
                                                </td>
                                                <td class="text-center" style="font-weight: normal !important;">@plannedMasterQty.ToString("N0")</td>
                                                <td class="text-center text-teal" style="font-weight: normal !important;">@displayMachines</td>
                                                <td class="text-center text-teal" style="font-weight: normal !important;"><input class="form-input text-[10px] w-8 text-center py-0" style="width:40px; font-size: 9px; color: #222 !important;" value="0" /></td>
                                                <td class="text-center text-navy" style="font-weight: normal !important;">@freeDate.ToString("dd-MMM-yyyy")</td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="6" class="text-center py-6 text-muted italic text-[10px]">
                                                No active planned loads for Silk/Other/Linen
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    var groupedTimeline = PlanningDetail?.ForwardTimeline?
                                        .GroupBy(t => t.Gauge)
                                        .Where(g => g.Sum(x => x.PlannedQtyLoad) > 0)
                                        .ToList();
                                    @if (groupedTimeline?.Any() == true)
                                    {
                                        int snRun = 1; 
                                        @foreach (var group in groupedTimeline)
                                        {
                                            <tr>
                                                <td class="text-muted text-[9px] text-center" style="font-weight: normal !important;">@(snRun++)</td>
                                                <td class="text-center">
                                                    <span class="gauge-chip" style="padding: 1px 6px; font-size: 9px;">@group.Key</span>
                                                </td>
                                                <td class="text-center" style="font-weight: normal !important;">@group.Sum(t => t.PlannedQtyLoad).ToString("N0")</td>
                                                <td class="text-center text-teal" style="font-weight: normal !important;">@group.Sum(t => t.EngagedMachines).ToString("N0")</td>
                                                <td class="text-center text-teal" style="font-weight: normal !important;"><input class="form-input text-[10px] w-8 text-center py-0" style="width:40px; font-size: 9px; color: #222 !important;" value="0" /></td>
                                                <td class="text-center text-navy" style="font-weight: normal !important;">@GetGaugeFreeDate(group.Key).ToString("dd-MMM")</td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="6" class="text-center py-6 text-muted italic text-[10px]">
                                                No running timeline details
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>

           
            <!-- Styles Detail Summary -->
            @{
                var styleDetails = ModalStyles.Where(s => s.PrintStatus != "OK" && s.EmbdStatus != "OK").ToList();
                var extraDetails = ModalStyles.Where(s => s.PrintStatus == "OK" || s.EmbdStatus == "OK").ToList();
            }

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-3 min-h-0 col-span-1">
                <!-- 1st Style Detail (noprint, noemb) -->
                <div class="panel flex flex-col min-h-0">
                    <div class="panel-header compact-panel-header" style="background: var(--navy); color: #fff;">
                        <div class="panel-header-left">
                            <i class="fa-solid fa-shirt text-[10px] mr-1"></i>
                            <span class="compact-panel-title font-bold  ">Style Detail @(string.IsNullOrEmpty(SelectedModalGauge) ? "" : $"- Gauge {SelectedModalGauge}")</span>
                        </div>
                        <span class="panel-count bg-teal" style="font-size: 8px;">Plan</span>
                    </div>
                    <div class="panel-body custom-scroll overflow-y-auto" style="height: 250px; min-height: 250px; max-height: 250px;">
                        <table class="nk-table compact-table" >
                            <thead class="sticky top-0 bg-white shadow-sm z-10">
                                <tr>
                                    <th class="text-left text-[10px]">Style No</th>
                                    <th class="text-center text-[10px]">Qty</th>
                                    <th class="text-center text-[10px]">Colors</th>
                                    <th class="text-center text-[10px]">Req.Days</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (IsLoadingModalStyles)
                                {
                                    @for (int i = 0; i < 4; i++)
                                    {
                                        <tr>
                                            <td class="py-2 px-3">
                                                <div class="h-2 bg-slate-200/80 rounded animate-pulse w-2/3"></div>
                                            </td>
                                            <td class="py-2">
                                                <div class="h-2 bg-slate-200/80 rounded animate-pulse w-1/2 mx-auto"></div>
                                            </td>
                                            <td class="py-2">
                                                <div class="h-2 bg-slate-200/80 rounded animate-pulse w-1/3 mx-auto"></div>
                                            </td>
                                            <td class="py-2">
                                                <div class="h-2 bg-slate-200/80 rounded animate-pulse w-2/5 mx-auto"></div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else if (styleDetails.Any())
                                {
                                    @foreach (var styleGroup in styleDetails.GroupBy(s => s.StyleNo))
                                    {
                                        <tr>
                                            <td class="text-navy text-[10px] py-1.5 px-3" style="font-weight: normal !important;">@styleGroup.Key</td>
                                            <td class="text-center py-1.5" style="font-weight: normal !important;">@styleGroup.Sum(s => s.OrderPics).ToString("N0")</td>
                                            <td class="text-center text-teal py-1.5" style="font-weight: normal !important;">@styleGroup.Count()</td>
                                            <td class="text-center text-muted py-1.5" style="font-weight: normal !important;">@styleGroup.Sum(s => s.RequireDays).ToString("N1")</td>
                                        </tr>
                                    }
                                }
                                else if (!string.IsNullOrEmpty(SelectedModalGauge))
                                {
                                    <tr>
                                        <td colspan="4" class="py-6 text-center">
                                            <div class="flex flex-col items-center opacity-40">
                                                <i class="fa-solid fa-circle-info text-xl mb-1 text-muted"></i>
                                                <p class="text-[9px] font-bold uppercase text-muted">No plain styles found</p>
                                            </div>
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="py-6 text-center">
                                            <div class="flex flex-col items-center opacity-40">
                                                <i class="fa-solid fa-arrow-pointer text-xl mb-1 text-muted"></i>
                                                <p class="text-[9px] font-bold uppercase text-muted">Select a Gauge</p>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            @if (styleDetails != null && styleDetails.Any())
                            {
                                <tfoot class="sticky bottom-0 bg-slate-50 border-t border-slate-200 z-10 font-bold" style="color: #222 !important;">
                                    <tr class="bg-slate-50 font-bold border-t border-slate-200" style="color: #222 !important; height: 28px;">
                                        <td class="py-1 px-3" style="font-weight: bold !important; color: #222 !important; height: 28px; vertical-align: middle;">Total</td>
                                        <td class="text-center py-1 font-bold" style="font-weight: bold !important; color: #222 !important; height: 28px; vertical-align: middle;">@styleDetails.Sum(s => s.OrderPics).ToString("N0")</td>
                                        <td class="text-center py-1 font-bold" style="font-weight: bold !important; color: #222 !important; height: 28px; vertical-align: middle;">@styleDetails.Count()</td>
                                        <td class="text-center py-1 font-bold" style="font-weight: bold !important; color: #222 !important; height: 28px; vertical-align: middle;">@styleDetails.Sum(s => s.RequireDays).ToString("N1")</td>
                                    </tr>
                                </tfoot>
                            }
                        </table>
                    </div>
                </div>

                <!-- 2nd Extradetail (print, emb) -->
                <div class="panel flex flex-col min-h-0">
                    <div class="panel-header compact-panel-header" style="background: var(--navy); color: #fff;">
                        <div class="panel-header-left">
                            <i class="fa-solid fa-palette text-[10px] mr-1"></i>
                            <span class="compact-panel-title font-bold  ">Extra Detail @(string.IsNullOrEmpty(SelectedModalGauge) ? "" : $"- Gauge {SelectedModalGauge}")</span>
                        </div>
                        <span class="panel-count bg-amber" style="font-size: 8px;">PRINT/EMB</span>
                    </div>
                    <div class="panel-body custom-scroll overflow-y-auto" style="height: 250px; min-height: 250px; max-height: 250px;">
                        <table class="nk-table compact-table"  >
                            <thead class="sticky top-0 bg-white shadow-sm z-10">
                                <tr>
                                    <th class="text-left text-[10px]">Style No</th>
                                    <th class="text-center text-[10px]">Qty</th>
                                    <th class="text-center text-[10px]">Colors</th>
                                    <th class="text-center text-[10px]">Req.Days</th>
                                    <th class="text-center text-[10px]">P/E</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (IsLoadingModalStyles)
                                {
                                    @for (int i = 0; i < 4; i++)
                                    {
                                        <tr>
                                            <td class="py-2 px-3">
                                                <div class="h-2 bg-slate-200/80 rounded animate-pulse w-3/4"></div>
                                            </td>
                                            <td class="py-2">
                                                <div class="h-2 bg-slate-200/80 rounded animate-pulse w-1/2 mx-auto"></div>
                                            </td>
                                            <td class="py-2">
                                                <div class="h-2 bg-slate-200/80 rounded animate-pulse w-1/3 mx-auto"></div>
                                            </td>
                                            <td class="py-2">
                                                <div class="h-2 bg-slate-200/80 rounded animate-pulse w-2/5 mx-auto"></div>
                                            </td>
                                            <td class="py-2 px-3">
                                                <div class="flex items-center justify-center gap-1">
                                                    <div class="h-3.5 bg-slate-200/85 rounded animate-pulse w-3.5"></div>
                                                    <div class="h-3.5 bg-slate-200/85 rounded animate-pulse w-3.5"></div>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else if (extraDetails.Any())
                                {
                                    @foreach (var styleGroup in extraDetails.GroupBy(s => s.StyleNo))
                                    {
                                        <tr>
                                            <td class="text-navy text-[10px] py-1.5 px-3" style="font-weight: normal !important;">@styleGroup.Key</td>
                                            <td class="text-center py-1.5" style="font-weight: normal !important;">@styleGroup.Sum(s => s.OrderPics).ToString("N0")</td>
                                            <td class="text-center text-teal py-1.5" style="font-weight: normal !important;">@styleGroup.Count()</td>
                                            <td class="text-center text-muted py-1.5" style="font-weight: normal !important;">@styleGroup.Sum(s => s.RequireDays).ToString("N1")</td>
                                            <td class="text-center py-1.5">
                                                <div class="flex items-center justify-center gap-1">
                                                    @if (styleGroup.Any(s => s.PrintStatus == "OK"))
                                                    {
                                                        <span class="text-[8px] font-normal text-sky bg-sky/15 px-1.5 py-0.5 rounded border border-sky/20" title="Print OK">P</span>
                                                    }
                                                    @if (styleGroup.Any(s => s.EmbdStatus == "OK"))
                                                    {
                                                        <span class="text-[8px] font-normal text-red bg-red/15 px-1.5 py-0.5 rounded border border-red/20" title="Embroidery OK">E</span>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else if (!string.IsNullOrEmpty(SelectedModalGauge))
                                {
                                    <tr>
                                        <td colspan="5" class="py-6 text-center">
                                            <div class="flex flex-col items-center opacity-40">
                                                <i class="fa-solid fa-circle-info text-xl mb-1 text-muted"></i>
                                                <p class="text-[9px] font-bold uppercase text-muted">No print/emb styles found</p>
                                            </div>
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="py-6 text-center">
                                            <div class="flex flex-col items-center opacity-40">
                                                <i class="fa-solid fa-arrow-pointer text-xl mb-1 text-muted"></i>
                                                <p class="text-[9px] font-bold uppercase text-muted">Select a Gauge</p>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            @if (extraDetails != null && extraDetails.Any())
                            {
                                <tfoot class="sticky bottom-0 bg-slate-50 border-t border-slate-200 z-10 font-bold" style="color: #222 !important;">
                                    <tr class="bg-slate-50 font-bold border-t border-slate-200" style="color: #222 !important; height: 28px;">
                                        <td class="py-1 px-3" style="font-weight: bold !important; color: #222 !important; height: 28px; vertical-align: middle;">Total</td>
                                        <td class="text-center py-1 font-bold" style="font-weight: bold !important; color: #222 !important; height: 28px; vertical-align: middle;">@extraDetails.Sum(s => s.OrderPics).ToString("N0")</td>
                                        <td class="text-center py-1 font-bold" style="font-weight: bold !important; color: #222 !important; height: 28px; vertical-align: middle;">@extraDetails.Count()</td>
                                        <td class="text-center py-1 font-bold" style="font-weight: bold !important; color: #222 !important; height: 28px; vertical-align: middle;">@extraDetails.Sum(s => s.RequireDays).ToString("N1")</td>
                                        <td></td>
                                    </tr>
                                </tfoot>
                            }
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </DataModal>

    <DataModal @bind-IsVisible="IsWeavePlanningDetailsModalOpen" 
               Title="@($"Planning Details: {(SelectedOrders.LastOrDefault()?.OrderNo ?? "N/A")} [{SelectedWeaveFactory}]")" 
               BadgeText="Weave"
               IsLoading="false"
               MaxWidth="1200px">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 p-2 planning-details-popup">
            <!-- Left Column: Planning Details (Yarn Statuses) & Running Details -->
            <div class="flex flex-col gap-4">
                <!-- Planning Details (Factory-wise load for selected order) -->
                <div class="panel flex flex-col min-h-0">
                    <div class="panel-header compact-panel-header" style="background: var(--navy); color: #fff;">
                        <div class="panel-header-left">
                            <i class="fa-solid fa-list-check text-[10px] mr-1"></i>
                            <span class="compact-panel-title font-bold">Planning Details</span>
                        </div>
                    </div>
                    <div class="panel-body custom-scroll overflow-y-auto max-h-[300px]">
                        <table class="nk-table compact-table">
                            <thead class="sticky top-0 bg-white shadow-sm z-10">
                                <tr>
                                    <th class="w-10 text-center">S.N</th>
                                    <th class="text-center">Start Date</th>
                                    <th class="text-center">Weave Factory</th>
                                    <th class="text-center pr-6">Qty</th>
                                    <th class="text-center">Mc</th>
                                    <th class="text-center">Days</th>
                                    <th class="text-center">Est. Date</th>
                                    <th class="text-center text-[10px]">Plan Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (WeaveAnalysisData?.FactorySummaries?.Any() == true)
                                {
                                    int fSn = 1;
                                    @foreach (var item in WeaveAnalysisData.FactorySummaries)
                                    {
                                        var plannedPlansForFactory = WeaveOrderAllPlannedPlans
                                            .Where(p => string.Equals(p.Gauge?.Trim(), item.WeaveFactory?.Trim(), StringComparison.OrdinalIgnoreCase))
                                            .ToList();
                                        var plannedQtyForFactory = plannedPlansForFactory.Sum(p => p.Quantity);
                                        bool isPlanned = plannedQtyForFactory > 0;
                                        bool isPartiallyPlanned = isPlanned && plannedQtyForFactory < item.Qty;

                                        var displayMachines = isPlanned ? plannedPlansForFactory.Sum(p => int.TryParse(p.Mc, out int m) ? m : 0) : 1;
                                        displayMachines = displayMachines > 0 ? displayMachines : 1;
                                        
                                        var displayDays = item.ReqMachineDays > 0 
                                            ? (decimal)(item.ReqMachineDays / displayMachines) 
                                            : ((decimal)item.Qty / (10m * displayMachines));
                                        var estEndDate = isPlanned ? plannedPlansForFactory.Max(p => p.EstEndDate) : AddWorkingDays(DateTime.Today.AddDays(1), (double)displayDays);
                                        var dateColorStyle = isPartiallyPlanned ? "color: var(--amber);" : "";
                                        var dateClass = isPartiallyPlanned ? "" : "text-navy";

                                        bool weaveShortageRow = string.Equals(item.YarnStatus, "Shortage", StringComparison.OrdinalIgnoreCase);
                                        bool weaveReadyRow = string.Equals(item.YarnStatus, "Ready", StringComparison.OrdinalIgnoreCase);
                                        bool weaveColorRow = (weaveShortageRow || weaveReadyRow) && SelectedWeaveFactory != item.WeaveFactory;
                                        bool weaveRedRow = weaveColorRow;
                                        var weaveRowBg = weaveShortageRow ? "#FF0000" : (weaveReadyRow ? "#00b050" : "");
                                        var weaveRedCell = weaveColorRow ? "color:#fff !important;" : "";

                                        <tr @onclick="() => SelectWeaveFactoryInModal(item.WeaveFactory)" style="@(weaveColorRow ? $"background:{weaveRowBg}; color:#fff;" : "")" class="cursor-pointer transition-colors @(SelectedWeaveFactory == item.WeaveFactory ? "selected-gauge-row" : "hover:bg-blue hover:text-white")">
                                            <td class="text-muted text-[9px] text-center" style="@weaveRedCell">@(fSn++)</td>
                                            <td class="text-center text-navy" style="@weaveRedCell">@DateTime.Today.AddDays(1).ToString("dd-MMM")</td>
                                            <td class="text-center">
                                                <div class="flex items-center gap-1 justify-center">
                                                    <span class="gauge-chip cursor-pointer hover:bg-teal hover:text-white transition-colors" 
                                                          style="padding: 1px 6px; font-size: 9px; @(SelectedWeaveFactory == item.WeaveFactory ? "background: var(--teal); color: #fff;" : "")">
                                                        @item.WeaveFactory
                                                    </span>
                                                </div>
                                            </td>
                                            <td class="text-center pr-6" style="@weaveRedCell">@item.Qty.ToString("N0")</td>
                                            <td class="text-center text-teal" style="@weaveRedCell">@displayMachines</td>
                                            <td class="text-center text-muted" style="@weaveRedCell">@displayDays.ToString("N1")d</td>
                                            <td class="text-center @dateClass" style="@(weaveRedRow ? "color:#fff !important;" : dateColorStyle)">
                                                <div class="flex items-center justify-center gap-1">
                                                    <span>@estEndDate.ToString("dd-MMM")</span>
                                                     @if (string.Equals(item.YarnStatus, "Shortage", StringComparison.OrdinalIgnoreCase))
                                                     {
                                                         <i class="fa-solid fa-circle-xmark text-[11px]" style="color: @(weaveColorRow ? "#fff" : "var(--red)");" title="SHORTAGE"></i>
                                                     }
                                                     else
                                                     {
                                                         <i class="fa-solid fa-circle-check text-[11px]" style="color: @(weaveColorRow ? "#fff" : "var(--green)");" title="READY"></i>
                                                     }
                                                </div>
                                            </td>
                                            <td class="text-center">
                                                @if (plannedQtyForFactory == 0)
                                                {
                                                    <span></span>
                                                }
                                                else if (plannedQtyForFactory >= item.Qty)
                                                {
                                                    <span class="rounded px-2 py-0.5 text-[10px] inline-block"
                                                          style="background: var(--green); color: #fff; font-weight: 700; letter-spacing: .03em; box-shadow: 0 1px 3px rgba(61,191,138,.35);"
                                                          title="Planned: @plannedQtyForFactory.ToString("N0") / @item.Qty.ToString("N0")">Planned</span>
                                                }
                                                else
                                                {
                                                    <span class="border rounded px-2 py-0.5 text-[9px] font-normal inline-block" 
                                                          style="background: #fffbeb; color: var(--amber); border-color: rgba(240, 165, 0, 0.2);" 
                                                          title="Partial: @plannedQtyForFactory.ToString("N0") / @item.Qty.ToString("N0")">Partial</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="8" class="text-center py-6 text-muted italic text-[10px]">No planning details found</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Running Details -->
                <div class="panel flex flex-col min-h-0">
                    <div class="panel-header compact-panel-header" style="background: var(--navy); color: #fff;">
                        <div class="panel-header-left">
                            <i class="fa-solid fa-play text-[10px] mr-1"></i>
                            <span class="compact-panel-title font-bold">Running Details (Factory Loads)</span>
                        </div>
                    </div>
                    <div class="panel-body custom-scroll overflow-y-auto max-h-[300px]">
                        <table class="nk-table compact-table">
                            <thead class="sticky top-0 bg-white shadow-sm z-10">
                                <tr>
                                    <th>Weave Factory</th>
                                    <th class="text-center">Order Qty</th>
                                    <th class="text-center">FreeDate</th>
                                    <th class="text-center">Machine Load Qty</th>
                                    <th class="text-center">Machines Allocated</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (WeaveFactoryDetails?.FactorySummaries?.Any() == true)
                                {
                                    @foreach (var factory in WeaveFactoryDetails.FactorySummaries)
                                    {
                                        var plannedPlansForFactory = WeaveOrderAllPlannedPlans
                                            .Where(p => string.Equals(p.Gauge?.Trim(), factory.WeaveFactory?.Trim(), StringComparison.OrdinalIgnoreCase))
                                            .ToList();
                                        var freeDate = plannedPlansForFactory.Any() 
                                            ? plannedPlansForFactory.Max(p => p.EstEndDate) 
                                            : DateTime.Today;

                                        <tr>
                                            <td class="font-bold text-navy" style="font-weight: normal !important;">@factory.WeaveFactory</td>
                                            <td class="text-center" style="font-weight: normal !important;">@factory.Qty.ToString("N0")</td>
                                            <td class="text-center text-navy" style="font-weight: normal !important;">@freeDate.ToString("dd-MMM-yyyy")</td>
                                            <td class="text-center text-amber" style="font-weight: normal !important;">@factory.TotalMachineLoadQty.ToString("N0")</td>
                                            <td class="text-center text-teal" style="font-weight: normal !important;">@factory.TotalMachinesAllocated</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center py-6 text-muted italic text-[10px]">No running details available</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Right Column: Machine Allocation & Styles / Extra Breakdowns -->
            <div class="flex flex-col gap-4">
                <!-- Machine Allocation Panel -->
                <div class="panel flex flex-col min-h-0">
                    <div class="panel-header compact-panel-header" style="background: var(--navy); color: #fff;">
                        <div class="panel-header-left">
                            <i class="fa-solid fa-calendar-plus text-[10px] mr-1"></i>
                            <span class="compact-panel-title font-bold">Machine Allocation For Weave Factory :: @SelectedWeaveFactory</span>
                        </div>
                    </div>
                    <div class="panel-body p-0 flex flex-col gap-3 max-h-[350px] overflow-y-auto">
                        @if (IsLoadingWeaveModalStyles)
                        {
                            <!-- Skeleton loader -->
                            <div class="border border-border rounded-lg overflow-hidden shadow-sm bg-white animate-pulse mb-3 p-3">
                                <div class="grid grid-cols-5 gap-3">
                                    <div class="h-8 bg-slate-100 rounded w-full"></div>
                                    <div class="h-8 bg-slate-100 rounded w-full"></div>
                                    <div class="h-8 bg-slate-100 rounded w-full"></div>
                                    <div class="h-8 bg-slate-100 rounded w-full"></div>
                                    <div class="h-8 bg-slate-200 rounded w-full"></div>
                                </div>
                            </div>
                        }
                        else if (!string.IsNullOrEmpty(SelectedWeaveFactory))
                        {
                            var plannedQty = WeaveDbPlannedPlans.Sum(p => p.Quantity);
                            var isFullyPlanned = WeaveBaseQty > 0 && plannedQty >= WeaveBaseQty;
                            var remainingQty = Math.Max(0, WeaveBaseQty - plannedQty);

                            @if (!isFullyPlanned)
                            {
                                <div class="p-0 bg-white">
                                    <table class="nk-table compact-table border-0 w-full">
                                        <thead>
                                            <tr class="bg-sky border-b border-border">
                                                <th class="text-[9px] text-left py-1.5 px-3">Start Date</th>
                                                <th class="text-right text-[9px] py-1.5 px-3">Quantity</th>
                                                @if (!string.Equals(SelectedWeaveFactory?.Trim(), "Gyatri Pashmina", StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <th class="text-center text-[9px] py-1.5 px-3">Mc</th>
                                                }
                                                <th class="text-center text-[9px] py-1.5 px-3">Est. End Date</th>
                                                <th class="text-center text-[9px] py-1.5 px-3 w-16">Action</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td class="py-1 px-3">
                                                    <input type="date" @bind="WeavePlanStartDate" @bind:event="onchange" class="form-input text-[10px] h-7 px-1.5 rounded border border-slate-200 shadow-sm focus:border-teal focus:ring-1 focus:ring-teal w-full" style="color: #222 !important; width:110px" />
                                                </td>
                                                <td class="py-1 px-3">
                                                    <input type="number" @bind="WeavePlanQty" max="@remainingQty" min="1" class="form-input text-[10px] h-7 px-1.5 rounded border border-slate-200 shadow-sm focus:border-teal focus:ring-1 focus:ring-teal w-full" style="color: #222 !important; text-align: right; width: 50px;" />
                                                </td>
                                                @if (!string.Equals(SelectedWeaveFactory?.Trim(), "Gyatri Pashmina", StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <td class="py-1 px-3">
                                                        <input type="number" @bind="WeavePlanMachines" max="@WeaveMaxMachinesAvailable" min="1" class="form-input text-[10px] h-7 px-1.5 rounded border border-slate-200 shadow-sm focus:border-teal focus:ring-1 focus:ring-teal w-full" style="color: #222 !important; text-align: center; width: 50px;" />
                                                    </td>
                                                }
                                                <td class="py-1 px-3">
                                                    @if (string.Equals(SelectedWeaveFactory?.Trim(), "Gyatri Pashmina", StringComparison.OrdinalIgnoreCase))
                                                    {
                                                        <input type="date" @bind="WeavePlanEndDate" @bind:event="onchange" class="form-input text-[10px] h-7 px-1.5 rounded border border-slate-200 shadow-sm focus:border-teal focus:ring-1 focus:ring-teal w-full" style="color: #222 !important; width:110px" />
                                                    }
                                                    else
                                                    {
                                                        <div class="form-input text-[10px] h-7 px-1.5 rounded border border-slate-100 bg-slate-50 flex items-center justify-center text-navy font-bold w-full" style="width:110px">
                                                            @WeavePlanEndDate.ToString("dd-MMM-yyyy")
                                                        </div>
                                                    }
                                                </td>
                                                <td class="py-1 px-3 text-center">
                                                    <button style="border: none; background: var(--navy); color: #fff; border-radius: 6px; padding: 6px 14px; font-size: 9px; font-weight: 700; letter-spacing: 0.5px; box-shadow: 0 2px 5px rgba(26, 51, 83, 0.2); transition: all 0.2s ease;"
                                                            class="uppercase text-white hover:bg-slate-700 active:scale-95 cursor-pointer whitespace-nowrap inline-block @(IsWeaveConfirmSaving ? "opacity-60 cursor-not-allowed" : "")"
                                                            @onclick="AddWeaveManualPlan" disabled="@IsWeaveConfirmSaving">
                                                        @if (IsWeaveConfirmSaving)
                                                        {
                                                            <i class="fa-solid fa-spinner fa-spin mr-1"></i><text>Saving...</text>
                                                        }
                                                        else
                                                        {
                                                            <text>Confirm</text>
                                                        }
                                                    </button>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            }

                            @if (WeaveDbPlannedPlans.Any())
                            {
                                <div class="border border-border rounded-lg overflow-hidden shadow-sm bg-white mt-3">
                                    <div class="bg-sky border-b border-slate-200/60 px-3 py-1.5 rounded-t-lg flex items-center justify-between">
                                        <h4 class="text-[10px] font-bold text-navy uppercase tracking-wider mb-0">Saved Allocation List</h4>
                                    </div>
                                    <table class="nk-table compact-table border-0 w-full">
                                        <thead>
                                            <tr class="bg-sky border-b border-border">
                                                <th class="text-[9px] text-left py-1.5 px-3">Start Date</th>
                                                <th class="text-center text-[9px] py-1.5">Gauge</th>
                                                <th class="text-center text-[9px] py-1.5">Qty</th>
                                                <th class="text-center text-[9px] py-1.5">Mc</th>
                                                <th class="text-center text-[9px] py-1.5 px-3">Est. End Date</th>
                                                <th class="text-center text-[9px] py-1.5 w-16">Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var plan in WeaveDbPlannedPlans)
                                            {
                                                @if (plan.MasterPlanChildId == WeaveEditingPlanId)
                                                {
                                                    <tr class="bg-teal-50/30 border-b border-border">
                                                        <td class="py-1 px-2">
                                                            <input type="date" @bind="WeaveEditStartDate" @bind:event="onchange" class="nk-input text-[9px] h-6 px-1 rounded border border-slate-200 shadow-sm focus:border-teal focus:ring-1 focus:ring-teal" style="color: #222 !important; max-width: 100px;" />
                                                        </td>
                                                        <td class="text-center py-1"><span class="gauge-chip">@plan.Gauge</span></td>
                                                        <td class="text-right py-1">
                                                            <input type="number" @bind="WeaveEditQty" max="@((double)WeaveEditMaxQty)" min="1" class="nk-input text-[9px] h-6 px-1 rounded border border-slate-200 shadow-sm focus:border-teal focus:ring-1 focus:ring-teal" style="color: #222 !important; max-width: 70px; text-align: right;" />
                                                        </td>
                                                        <td class="text-center py-1">
                                                            <input type="number" @bind="WeaveEditMachines" max="@WeaveEditMaxMachines" min="1" class="nk-input text-[9px] h-6 px-1 rounded border border-slate-200 shadow-sm focus:border-teal focus:ring-1 focus:ring-teal" style="color: #222 !important; max-width: 45px; text-align: center;" />
                                                        </td>
                                                        <td class="text-center text-navy text-[9px] py-1 px-2">@WeaveEditEndDate.ToString("dd-MMM-yyyy")</td>
                                                        <td class="text-center py-1 whitespace-nowrap">
                                                            <button class="text-emerald-600 hover:text-emerald-800 transition-colors p-1" title="Save" @onclick="() => SaveWeavePlanEdit(plan)">
                                                                <i class="fa-solid fa-circle-check text-[14px]"></i>
                                                            </button>
                                                            <button class="text-red-500 hover:text-red-700 transition-colors p-1 ml-1" title="Cancel" @onclick="CancelWeavePlanEdit">
                                                                <i class="fa-solid fa-circle-xmark text-[14px]"></i>
                                                            </button>
                                                        </td>
                                                    </tr>
                                                }
                                                else
                                                {
                                                    <tr class="hover:bg-slate-50/40 transition-colors border-b border-border last:border-b-0">
                                                        <td class="text-[9px] py-1.5 px-3 text-navy">@plan.StartDate.ToString("dd-MMM-yyyy")</td>
                                                        <td class="text-center py-1.5"><span class="gauge-chip">@plan.Gauge</span></td>
                                                        <td class="text-right py-1.5 font-mono pr-4">@plan.Quantity.ToString("N0")</td>
                                                        <td class="text-center text-teal py-1.5">@plan.Mc</td>
                                                        <td class="text-center text-navy text-[9px] py-1.5 px-3">@plan.EstEndDate.ToString("dd-MMM-yyyy")</td>
                                                        <td class="text-center py-1.5 whitespace-nowrap">
                                                            <button class="text-teal hover:text-teal-800 transition-colors p-0.5" title="Edit" @onclick="() => StartWeavePlanEdit(plan)">
                                                                <i class="fa-solid fa-pen-to-square text-[11px]"></i>
                                                            </button>
                                                            <button class="text-red hover:text-red-800 transition-colors p-0.5 ml-1.5" title="Delete" @onclick="() => DeleteWeavePlanDetail(plan)">
                                                                <i class="fa-solid fa-trash-can text-[11px]"></i>
                                                            </button>
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="flex flex-col items-center opacity-40 py-4">
                                <i class="fa-solid fa-arrow-pointer text-2xl mb-2 text-muted"></i>
                                <p class="text-[10px] font-bold uppercase text-muted">Click a Weave Factory to Plan</p>
                            </div>
                        }
                    </div>
                </div>

                <!-- Style Detail & Extra Detail Side by Side -->
                @{
                    var weaveStyleDetails = WeaveModalStyles.Where(s => s.PrintStatus != "OK" && s.EmbdStatus != "OK").ToList();
                    var weaveExtraDetails = WeaveModalStyles.Where(s => s.PrintStatus == "OK" || s.EmbdStatus == "OK").ToList();
                }
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-3 min-h-0">
                    <!-- Style Detail -->
                    <div class="panel flex flex-col min-h-0">
                        <div class="panel-header compact-panel-header" style="background: var(--navy); color: #fff;">
                            <div class="panel-header-left">
                                <i class="fa-solid fa-shirt text-[10px] mr-1"></i>
                                <span class="compact-panel-title font-bold">Style Detail</span>
                            </div>
                            <span class="panel-count bg-teal" style="font-size: 8px;">Plan</span>
                        </div>
                        <div class="panel-body custom-scroll overflow-y-auto" style="height: 250px; min-height: 250px; max-height: 250px;">
                            <table class="nk-table compact-table" style="height: 100%;">
                                <thead class="sticky top-0 bg-white shadow-sm z-10">
                                    <tr>
                                        <th class="text-left text-[10px]">Style No</th>
                                        <th class="text-center text-[10px]">Qty</th>
                                        <th class="text-center text-[10px]">Colors</th>
                                        <th class="text-center text-[10px]">Req.Days</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (IsLoadingWeaveModalStyles)
                                    {
                                        <tr>
                                            <td colspan="4" class="py-2 text-center">Loading...</td>
                                        </tr>
                                    }
                                    else if (weaveStyleDetails.Any())
                                    {
                                        @foreach (var styleGroup in weaveStyleDetails.GroupBy(s => s.StyleNo))
                                        {
                                            <tr>
                                                <td class="text-navy text-[10px] py-1.5 px-3">@styleGroup.Key</td>
                                                <td class="text-center py-1.5">@styleGroup.Sum(s => s.OrderPics).ToString("N0")</td>
                                                <td class="text-center text-teal py-1.5">@styleGroup.Count()</td>
                                                <td class="text-center text-muted py-1.5">@styleGroup.Sum(s => s.RequireDays).ToString("N1")</td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="4" class="py-4 text-center text-muted italic text-[9px]">No plain styles</td>
                                        </tr>
                                    }
                                </tbody>
                                @if (weaveStyleDetails != null && weaveStyleDetails.Any())
                                {
                                    <tfoot class="sticky bottom-0 bg-slate-50 border-t border-slate-200 z-10 font-bold" style="color: #222 !important;">
                                        <tr class="bg-slate-50 font-bold border-t border-slate-200" style="color: #222 !important; height: 28px;">
                                            <td class="py-1 px-3" style="font-weight: bold !important; color: #222 !important; height: 28px; vertical-align: middle;">Total</td>
                                            <td class="text-center py-1 font-bold" style="font-weight: bold !important; color: #222 !important; height: 28px; vertical-align: middle;">@weaveStyleDetails.Sum(s => s.OrderPics).ToString("N0")</td>
                                            <td class="text-center py-1 font-bold" style="font-weight: bold !important; color: #222 !important; height: 28px; vertical-align: middle;">@weaveStyleDetails.Count()</td>
                                            <td class="text-center py-1 font-bold" style="font-weight: bold !important; color: #222 !important; height: 28px; vertical-align: middle;">@weaveStyleDetails.Sum(s => s.RequireDays).ToString("N1")</td>
                                        </tr>
                                    </tfoot>
                                }
                            </table>
                        </div>
                    </div>

                    <!-- Extra Detail -->
                    <div class="panel flex flex-col min-h-0">
                        <div class="panel-header compact-panel-header" style="background: var(--navy); color: #fff;">
                            <div class="panel-header-left">
                                <i class="fa-solid fa-palette text-[10px] mr-1"></i>
                                <span class="compact-panel-title font-bold">Extra Detail</span>
                            </div>
                            <span class="panel-count bg-amber" style="font-size: 8px;">PRINT/EMB</span>
                        </div>
                        <div class="panel-body custom-scroll overflow-y-auto" style="height: 250px; min-height: 250px; max-height: 250px;">
                            <table class="nk-table compact-table" style="height: 100%;">
                                <thead class="sticky top-0 bg-white shadow-sm z-10">
                                    <tr>
                                        <th class="text-left text-[10px]">Style No</th>
                                        <th class="text-center text-[10px]">Qty</th>
                                        <th class="text-center text-[10px]">Colors</th>
                                        <th class="text-center text-[10px]">P/E</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (IsLoadingWeaveModalStyles)
                                    {
                                        <tr>
                                            <td colspan="4" class="py-2 text-center">Loading...</td>
                                        </tr>
                                    }
                                    else if (weaveExtraDetails.Any())
                                    {
                                        @foreach (var styleGroup in weaveExtraDetails.GroupBy(s => s.StyleNo))
                                        {
                                            <tr>
                                                <td class="text-navy text-[10px] py-1.5 px-3">@styleGroup.Key</td>
                                                <td class="text-center py-1.5">@styleGroup.Sum(s => s.OrderPics).ToString("N0")</td>
                                                <td class="text-center text-teal py-1.5">@styleGroup.Count()</td>
                                                <td class="text-center py-1.5">
                                                    <div class="flex items-center justify-center gap-1">
                                                        @if (styleGroup.Any(s => s.PrintStatus == "OK"))
                                                        {
                                                            <span class="text-[8px] font-normal text-sky bg-sky/15 px-1.5 py-0.5 rounded border border-sky/20" title="Print OK">P</span>
                                                        }
                                                        @if (styleGroup.Any(s => s.EmbdStatus == "OK"))
                                                        {
                                                            <span class="text-[8px] font-normal text-red bg-red/15 px-1.5 py-0.5 rounded border border-red/20" title="Embroidery OK">E</span>
                                                        }
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="4" class="py-4 text-center text-muted italic text-[9px]">No print/emb styles</td>
                                        </tr>
                                    }
                                </tbody>
                                @if (weaveExtraDetails != null && weaveExtraDetails.Any())
                                {
                                    <tfoot class="sticky bottom-0 bg-slate-50 border-t border-slate-200 z-10 font-bold" style="color: #222 !important;">
                                        <tr class="bg-slate-50 font-bold border-t border-slate-200" style="color: #222 !important; height: 28px;">
                                            <td class="py-1 px-3" style="font-weight: bold !important; color: #222 !important; height: 28px; vertical-align: middle;">Total</td>
                                            <td class="text-center py-1 font-bold" style="font-weight: bold !important; color: #222 !important; height: 28px; vertical-align: middle;">@weaveExtraDetails.Sum(s => s.OrderPics).ToString("N0")</td>
                                            <td class="text-center py-1 font-bold" style="font-weight: bold !important; color: #222 !important; height: 28px; vertical-align: middle;">@weaveExtraDetails.Count()</td>
                                            <td style="height: 28px; vertical-align: middle;"></td>
                                        </tr>
                                    </tfoot>
                                }
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </DataModal>

    <!-- Modern Machine Gantt Chart Modal -->
    <DataModal @bind-IsVisible="IsGanttModalOpen" MaxWidth="1320px" Title="Gauge Machine Allocation Timeline" ZIndex="3000">
        <div class="p-5 bg-white rounded-lg flex flex-col gap-4">
            <!-- Header Info -->
            <div class="flex items-center justify-between border-b border-slate-200 pb-3">
                <div>
                    <h3 class="text-base font-bold text-navy uppercase tracking-wider mb-1" style="font-weight: 700 !important;">Gauge @GanttModalGauge Machine Timeline</h3>
                    <p class="text-[12px] text-muted mb-0">30-Day Projections starting from <span class="font-semibold text-navy">@TodayDate.ToString("dd-MMM-yyyy")</span> &middot; Saturdays highlighted in light orange</p>
                </div>
                <div class="flex gap-4 text-[12px]">
                    <div class="flex items-center gap-1.5">
                        <span class="w-4 h-4 rounded inline-block shadow-sm" style="background: linear-gradient(135deg, var(--teal), #1ea2b1);"></span>
                        <span class="text-navy font-semibold">Active Plan</span>
                    </div>
                    <div class="flex items-center gap-1.5">
                        <span class="w-4 h-4 rounded bg-slate-50 border border-dashed border-slate-300 inline-block"></span>
                        <span class="text-muted">Idle</span>
                    </div>
                    <div class="flex items-center gap-1.5">
                        <span class="w-4 h-4 rounded inline-block bg-amber-100 border border-amber-300"></span>
                        <span class="text-amber-700 font-semibold">Saturday</span>
                    </div>
                </div>
            </div>

            <!-- Gantt Chart Container -->
            <div class="overflow-x-auto custom-scroll border border-slate-200 rounded-lg p-3 bg-slate-50/50">
                <div style="min-width: 1180px; display: flex; flex-direction: column; gap: 7px;">
                    <!-- Timeline Headers Row -->
                    <div class="grid" style="grid-template-columns: 120px repeat(30, minmax(34px, 1fr)); gap: 3px; margin-bottom: 2px;">
                        <!-- Top-Left Corner -->
                        <div class="flex items-center justify-center text-[12px] font-bold text-navy bg-sky rounded-md h-10 border border-slate-200" style="font-weight: 700 !important;">
                            Machine
                        </div>
                        <!-- Day Columns -->
                        @for (int d = 0; d < 30; d++)
                        {
                            var dayDate = TodayDate.AddDays(d);
                            var isSaturday = dayDate.DayOfWeek == DayOfWeek.Saturday;
                            <div class="flex flex-col items-center justify-center rounded-md h-10 border @(isSaturday ? "bg-amber-100 border-amber-300" : "bg-sky border-slate-200")">
                                <span class="text-[12px] font-bold leading-none @(isSaturday ? "text-amber-800" : "text-navy")" style="font-weight: 700 !important;">@dayDate.ToString("dd")</span>
                                <span class="text-[9px] uppercase font-semibold mt-0.5 leading-none @(isSaturday ? "text-amber-600" : "text-muted")">@dayDate.ToString("ddd")</span>
                            </div>
                        }
                    </div>

                    <!-- Timeline Data Rows -->
                    @if (MachinePlaningList != null && MachinePlaningList.Any())
                    {
                        @foreach (var machine in MachinePlaningList.OrderByDescending(m => {
                            var machinePlans = GanttChartPlans?
                                .Where(p => p.MachineID == m.Machine_ID || (!string.IsNullOrEmpty(p.Machine) && string.Equals(p.Machine.Trim(), m.MachineNo.Trim(), StringComparison.OrdinalIgnoreCase)))
                                .ToList() ?? new();
                            return machinePlans.Sum(p => p.Qty);
                        }))
                        {
                            <div class="grid relative border border-slate-200/60 rounded-md bg-white py-2 hover:border-teal/40 hover:shadow-sm transition-all"
                                 style="grid-template-columns: 120px repeat(30, minmax(34px, 1fr)); gap: 3px; min-height: 54px; align-items: center;">
                                <!-- Machine Row Header -->
                                <div style="grid-column: 1; grid-row: 1;" class="flex flex-col items-center justify-center font-bold text-navy border-r border-slate-200 pr-1 h-full select-none">
                                    <span class="text-teal font-bold text-[13px]" style="color: var(--teal); font-weight: 700 !important;">@machine.MachineNo</span>
                                    <span class="text-[10px] text-muted font-medium mt-0.5">@machine.Size</span>
                                </div>

                                <!-- Timeline Background Grid Cells (Highlights Saturdays) -->
                                @for (int d = 0; d < 30; d++)
                                {
                                    var dayDate = TodayDate.AddDays(d);
                                    var isSaturday = dayDate.DayOfWeek == DayOfWeek.Saturday;
                                    <div style="grid-column: @(d + 2); grid-row: 1;" class="h-full w-full rounded-sm @(isSaturday ? "bg-amber-50/30 border-r border-dashed border-amber-200/40" : "")"></div>
                                }

                                <!-- Active Plan Capsules Overlay (uses CSS Grid overlap positioning) -->
                                @{
                                    var machinePlans = GanttChartPlans?
                                        .Where(p => p.MachineID == machine.Machine_ID || (!string.IsNullOrEmpty(p.Machine) && string.Equals(p.Machine.Trim(), machine.MachineNo.Trim(), StringComparison.OrdinalIgnoreCase)))
                                        .OrderByDescending(p => p.Qty)
                                        .ToList() ?? new();
                                }
                                @foreach (var plan in machinePlans)
                                {
                                    var effStart = plan.StartDate < TodayDate ? TodayDate : plan.StartDate;
                                    var effEnd = plan.EndDate > TodayDate.AddDays(29) ? TodayDate.AddDays(29) : plan.EndDate;
                                    if (effStart <= effEnd)
                                    {
                                        var startCol = (effStart.Date - TodayDate.Date).Days;
                                        var daySpan = (effEnd.Date - effStart.Date).Days + 1;
                                        
                                        <div style="grid-column: @(startCol + 2) / span @daySpan; grid-row: 1; z-index: 10; margin: 5px 2px; background: linear-gradient(135deg, var(--teal), #1ea2b1); border: 1px solid rgba(255,255,255,0.2); font-size: 11px; font-weight: 700; line-height: 1.15; box-shadow: 0 2px 5px rgba(30,162,177,0.35);"
                                             class="rounded-md shadow-sm text-white flex items-center justify-center px-2 overflow-hidden transition-all duration-300 hover:scale-[1.02] hover:z-20 cursor-help h-9"
                                             title='@plan.OrderNo | Qty: @plan.Qty | @plan.StartDate.ToString("dd-MMM") to @plan.EndDate.ToString("dd-MMM")'>
                                            @if (daySpan >= 3)
                                            {
                                                <div class="flex flex-col items-center justify-center leading-tight select-none">
                                                    <span class="whitespace-nowrap" style="font-weight: 700 !important;">@plan.OrderNo</span>
                                                    @if (daySpan >= 5)
                                                    {
                                                        <span class="text-[9px] opacity-90 font-medium">@plan.Qty pcs</span>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-[10px]">&#9679;</span>
                                            }
                                        </div>
                                    }
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-8 text-muted italic text-[12px] bg-white border border-slate-200 rounded-md">
                            No plans scheduled for gauge machines
                        </div>
                    }
                </div>
            </div>
            
            <!-- Legend & Close Action -->
            <div class="flex items-center justify-between border-t border-slate-200 pt-3">
                <div class="text-[11px] text-muted italic">
                    <i class="fa-solid fa-circle-info mr-1"></i> Hover over plan capsules to see complete timeline dates, quantities, and order reference details.
                </div>
                <button type="button" @onclick="() => IsGanttModalOpen = false"
                        class="text-[12px] h-9 px-5 rounded-md border border-slate-200 bg-slate-50 hover:bg-slate-100 font-bold text-navy cursor-pointer select-none" style="width: auto; font-weight: 700 !important;">
                    Close Chart
                </button>
            </div>
        </div>
    </DataModal>

    @if (IsBulkOpen)
    {
        <div class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm flex items-center justify-center" style="z-index: 9000;">
            <div class="bg-white rounded-xl border border-slate-200 shadow-2xl w-full mx-4 overflow-hidden" style="max-width: 760px;">
                <div class="px-4 py-3 flex items-center justify-between" style="background: var(--navy); color: #fff;">
                    <span class="font-bold text-[12px] uppercase tracking-wide"><i class="fa-solid fa-wand-magic-sparkles mr-2" style="color: var(--teal);"></i>Plan All — Deadline Ordered</span>
                    <button @onclick="CloseBulkPlan" style="background:none;border:none;color:#fff;cursor:pointer;" disabled="@IsBulkBusy"><i class="fa-solid fa-xmark"></i></button>
                </div>
                <div class="px-4 pt-3 flex items-center justify-between gap-3 flex-wrap">
                    <div class="flex items-center gap-3 text-[10px]" style="color: var(--muted);">
                        <label class="flex items-center gap-1.5 cursor-pointer @(IsBulkBusy ? "opacity-50" : "")">
                            <input type="radio" name="bulkScope" checked="@BulkAllOrders" disabled="@IsBulkBusy"
                                   @onchange="@(() => SetBulkScope(true))" class="cursor-pointer" />
                            <span><b>All orders</b> (by ship deadline)</span>
                        </label>
                        <label class="flex items-center gap-1.5 cursor-pointer @(IsBulkBusy ? "opacity-50" : "")">
                            <input type="radio" name="bulkScope" checked="@(!BulkAllOrders)" disabled="@IsBulkBusy"
                                   @onchange="@(() => SetBulkScope(false))" class="cursor-pointer" />
                            <span>Current order only</span>
                        </label>
                    </div>
                    @if (BulkRows.Any(r => !r.DeadlineMet))
                    {
                        <span class="text-[10px] font-bold px-2 py-0.5 rounded" style="background:#fef2f2; color:#dc2626; border:1px solid #fecaca;">
                            <i class="fa-solid fa-triangle-exclamation mr-1"></i>@BulkRows.Count(r => !r.DeadlineMet) past deadline
                        </span>
                    }
                </div>
                <div class="p-4 pt-3" style="max-height: 56vh; overflow:auto;">
                    @if (IsBulkBusy)
                    {
                        <div class="text-center py-6 text-[12px]" style="color: var(--muted);">
                            <i class="fa-solid fa-spinner fa-spin mr-2"></i>@BulkPhase
                        </div>
                    }
                    else if (!BulkRows.Any())
                    {
                        <div class="text-center py-6 text-[12px]" style="color: var(--muted);">Nothing to plan — all gauges are fully planned or have no quantity.</div>
                    }
                    else
                    {
                        <table class="nk-table compact-table w-full text-[10px]">
                            <thead>
                                <tr style="background:#f1f5fa;">
                                    <th class="text-center py-1.5" style="width:36px;"></th>
                                    <th class="text-left py-1.5">Order</th>
                                    <th class="text-center py-1.5">Gauge</th>
                                    <th class="text-center py-1.5">Qty</th>
                                    <th class="text-center py-1.5">Mc</th>
                                    <th class="text-center py-1.5">Start</th>
                                    <th class="text-center py-1.5">Est. End</th>
                                    <th class="text-center py-1.5">Deadline</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{ string? lastOrder = null; }
                                @foreach (var r in BulkRows)
                                {
                                    bool newOrder = r.OrderNo != lastOrder;
                                    lastOrder = r.OrderNo;
                                    <tr class="border-b border-slate-100 @(r.DeadlineMet ? "" : "bg-red-50/60")">
                                        <td class="text-center py-1.5">
                                            <input type="checkbox" checked="@r.Selected" @onchange="(e) => r.Selected = (bool)(e.Value ?? false)" class="rounded w-3.5 h-3.5 cursor-pointer" />
                                        </td>
                                        <td class="text-left py-1.5 font-bold text-navy">@(newOrder ? r.OrderNo : "")</td>
                                        <td class="text-center py-1.5"><span class="gauge-chip">@r.Gauge</span></td>
                                        <td class="text-center py-1.5 font-bold">@r.Qty.ToString("N0")</td>
                                        <td class="text-center py-1.5">@r.Machines</td>
                                        <td class="text-center py-1.5">@r.Start.ToString("dd-MMM")</td>
                                        <td class="text-center py-1.5 font-bold @(r.DeadlineMet ? "text-navy" : "text-red-600")">@r.End.ToString("dd-MMM-yyyy")</td>
                                        <td class="text-center py-1.5">
                                            @if (r.Deadline != null)
                                            {
                                                @if (r.DeadlineMet)
                                                {
                                                    <span class="text-[9px] text-green-600 font-semibold" title="Finishes by deadline @r.Deadline?.ToString("dd-MMM-yyyy")"><i class="fa-solid fa-circle-check"></i> @r.Deadline?.ToString("dd-MMM")</span>
                                                }
                                                else
                                                {
                                                    <span class="text-[9px] text-red-600 font-bold" title="Misses deadline @r.Deadline?.ToString("dd-MMM-yyyy")"><i class="fa-solid fa-circle-xmark"></i> @r.Deadline?.ToString("dd-MMM")</span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-[9px] text-slate-400">—</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
                <div class="px-4 py-3 flex justify-end gap-2 border-t border-slate-100" style="background:#fafbfc;">
                    <button @onclick="CloseBulkPlan" disabled="@IsBulkBusy"
                            class="text-[11px] h-8 px-4 rounded border border-slate-200 bg-white font-bold text-navy cursor-pointer">Cancel</button>
                    <button @onclick="ApproveBulkPlan" disabled="@(IsBulkBusy || !BulkRows.Any(r => r.Selected))"
                            class="text-[11px] h-8 px-4 rounded border-0 font-bold text-white cursor-pointer" style="background: var(--navy);">
                        @if (IsBulkBusy)
                        {
                            <i class="fa-solid fa-spinner fa-spin mr-1"></i>
                        }
                        Approve &amp; Plan (@BulkRows.Count(r => r.Selected))
                    </button>
                </div>
            </div>
        </div>
    }

    @if (IsAlertOpen)
    {
        <div class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm flex items-center justify-center z-[9999] nk-fade-in" style="z-index: 9999;">
            <div class="bg-white rounded-xl border shadow-2xl max-w-[340px] w-full mx-4 overflow-hidden transform nk-scale-in"
                 style="border-color: @(AlertType == "error" ? "rgba(239, 68, 68, 0.25)" : "rgba(217, 119, 6, 0.25)");
                        box-shadow: 0 20px 25px -5px rgba(26, 51, 83, 0.1), 0 10px 10px -5px rgba(26, 51, 83, 0.04);">
                
                <!-- Status Top Accent Bar -->
                <div class="h-1 w-full" style="background: @(AlertType == "error" ? "var(--red)" : "var(--amber)");"></div>
                
                <div class="p-4.5 flex flex-col gap-4">
                    <div class="flex gap-3 items-start">
                        <!-- High Fidelity Icon Badge -->
                        <div class="w-9 h-9 rounded-xl flex items-center justify-center flex-shrink-0 shadow-sm relative overflow-hidden"
                             style="background: @(AlertType == "error" ? "rgba(239, 68, 68, 0.08)" : "rgba(217, 119, 6, 0.08)"); 
                                    color: @(AlertType == "error" ? "var(--red)" : "var(--amber)");
                                    border: 1px solid @(AlertType == "error" ? "rgba(239, 68, 68, 0.15)" : "rgba(217, 119, 6, 0.15)");">
                            <!-- Subtle pulsing background ring -->
                            <span class="absolute inset-0 rounded-xl animate-ping opacity-20" style="background-color: currentColor; animation-duration: 2s;"></span>
                            <i class="fa-solid @(AlertType == "error" ? "fa-circle-xmark text-base" : "fa-triangle-exclamation text-sm") relative z-10"></i>
                        </div>
                        
                        <!-- Content -->
                        <div class="flex-1 min-w-0">
                            <h4 class="text-[11px] font-bold text-slate-800 uppercase tracking-wide mb-1 flex items-center gap-1.5" style="font-weight: 700 !important; color: #1e293b;">
                                @AlertTitle
                            </h4>
                            <p class="text-[10px] text-slate-500 leading-normal font-normal" style="font-weight: normal !important; color: #64748b; line-height: 1.45;">
                                @AlertMessage
                            </p>
                        </div>
                    </div>
                    
                    <!-- Action Bar -->
                    <div class="flex justify-end gap-2 border-t border-slate-100/80 pt-3">
                        <button type="button" @onclick="() => IsAlertOpen = false"
                                class="px-4 py-1.5 rounded-lg text-[9px] font-bold text-white shadow-sm cursor-pointer select-none active:scale-95 transition-all uppercase tracking-wider flex items-center gap-1 hover:brightness-95"
                                style="background: @(AlertType == "error" ? "var(--red)" : "var(--navy)"); border: none; font-weight: 700 !important; letter-spacing: 0.5px;">
                            <span>Acknowledge</span>
                            <i class="fa-solid fa-chevron-right text-[7px] opacity-70"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }


<style>
    /* Custom Scrollbar for better UI */
    .scrollbar-thin::-webkit-scrollbar {
        width: 4px;
    }
    .scrollbar-thin::-webkit-scrollbar-track {
        background: transparent;
    }
    .scrollbar-thin::-webkit-scrollbar-thumb {
        background: #e2e8f0;
        border-radius: 20px;
    }
    .scrollbar-thin::-webkit-scrollbar-thumb:hover {
        background: #cbd5e1;
    }

    /* Normalize typography inside planning details popup */
    .planning-details-popup td,
    .planning-details-popup span,
    .planning-details-popup label,
    .planning-details-popup input,
    .planning-details-popup select,
    .planning-details-popup p,
    .planning-details-popup strong:not(.panel-title, .compact-panel-title, th, .font-bold) {
        font-weight: normal !important;
    }
    
    .planning-details-popup th,
    .planning-details-popup .panel-title,
    .planning-details-popup .compact-panel-title,
    .planning-details-popup .font-bold {
        font-weight: 700 !important;
    }

    /* High-fidelity Alert Entrance Animations */
    @@keyframes nkFadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }
    @@keyframes nkScaleIn {
        from { transform: scale(0.95); opacity: 0; }
        to { transform: scale(1); opacity: 1; }
    }
    
    .nk-fade-in {
        animation: nkFadeIn 0.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    
    .nk-scale-in {
        animation: nkScaleIn 0.2s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    }
</style>
