                        {
                            int sn = 1;
                            @foreach (var item in YarnColorDetails)
                            {
                                <tr>
                                    <td class="text-muted font-bold text-[9px] text-center">@(sn++)</td>
                                    <td class="font-bold text-navy">@item.Yarn</td>
                                    <td class="text-center">
                                        <span class="px-2 py-0.5 rounded-full bg-white text-navy text-[10px] border border-border font-bold">@item.OrderColor</span>
                                    </td>
                                    <td class="text-right font-bold text-teal">@item.StockAvailable.ToString("N1")</td>
                                    
                                    <td class="text-right font-bold text-amber">@item.RequiredKgs.ToString("N1")</td>
                                    <td class="text-right text-muted">@item.OtherRunningKgs.ToString("N1")</td>
                                     <td class="text-right font-bold text-slate-400">@((item.StockAvailable - item.OtherRunningKgs).ToString("N1"))</td>
                                    <td class="text-center">
                                        <div class="flex items-center justify-center">
                                            @if (item.StockStatus == "READY")
                                                    {
                                                        <i class="fa-solid fa-circle-check text-[12px]" style="color: var(--green);" title="READY"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="fa-solid fa-circle-xmark text-[12px]" style="color: var(--red);" title="@item.StockStatus"></i>
                                                    }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="py-12 text-center">
                                    <div class="flex flex-col items-center opacity-40">
                                        <i class="fa-solid fa-box-open text-3xl mb-2 text-muted"></i>
                                        <p class="text-xs font-bold uppercase text-muted">No Color Breakdown Found</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            
            <div class="p-3 bg-white border-t border-border flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-amber animate-pulse"></span>
                    <p class="text-[10px] font-bold text-amber uppercase">Analyzed Planning Data</p>
                </div>
                <p class="text-[10px] font-bold text-muted">
                    Color Variants: <span class="text-teal">@(YarnColorDetails?.Count ?? 0)</span>
                </p>
            </div>
        </div>
    </DataModal>

    <DataModal @bind-IsVisible="IsPlanningDetailsModalOpen"
               Title="@($"Planning Details: {(SelectedOrders.LastOrDefault()?.OrderNo ?? "N/A")}")"
               BadgeText=""
               IsLoading="false"
               MaxWidth="96vw">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 p-2 planning-details-popup">
            <!-- Planning Summary -->
            <div class="panel flex flex-col min-h-0">
                <div class="panel-header compact-panel-header" style="background: var(--navy); color: #fff; display:flex; align-items:center; justify-content:space-between;">
                    <div class="panel-header-left">
                        <i class="fa-solid fa-list-check text-[10px] mr-1"></i>
                        <span class="compact-panel-title font-bold">Planning Details</span>
                    </div>
                    @if (SelectedKnitType == "Knit")
                    {
                        <button @onclick="OpenBulkPlan" title="Auto-plan all remaining gauges (preview first)"
                                style="background: var(--teal); color:#fff; border:none; border-radius:6px; padding:4px 10px; font-size:9px; font-weight:700; cursor:pointer;">
                            <i class="fa-solid fa-wand-magic-sparkles mr-1"></i>PLAN ALL
                        </button>
                    }
                </div>
                <div class="panel-body custom-scroll overflow-y-auto max-h-[300px]">
                    <table class="nk-table compact-table">
                        <thead class="sticky top-0 bg-white shadow-sm z-10">
                            <tr>
                                <th class="w-10 text-center">S.N</th>
                                <th class="text-center">Start Date</th>
                                <th class="w-16 text-center">@(SelectedKnitType == "Silk" || SelectedKnitType == "Other" || SelectedKnitType == "Linen" ? "Master Name" : "Gauge")</th>
                                <th class="text-center pr-6">Qty</th>
                                <th class="text-center">Mc</th>
                                <th class="text-center">Days</th>
                                <th class="text-center">Est. Date</th>
                                <th class="text-center text-[10px]">Plan Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int sn = 1; }
                            @if (SelectedKnitType == "Silk" || SelectedKnitType == "Other" || SelectedKnitType == "Linen")
                            {
                                @foreach (var item in FabricAnalysisData.MasterWorkload.Where(i => i.NewOrderQty > 0))
                                {
                                    var itemKey = item.MasterId?.ToString() ?? item.MasterName;
                                    var plannedPlansForMaster = OrderAllPlannedPlans
                                        .Where(p => string.Equals(p.Gauge?.Trim(), item.MasterId?.ToString()?.Trim(), StringComparison.OrdinalIgnoreCase) ||
                                                    string.Equals(p.Gauge?.Trim(), item.MasterName?.Trim(), StringComparison.OrdinalIgnoreCase))
                                        .ToList();
                                        
                                    var plannedQtyForMaster = plannedPlansForMaster.Sum(p => p.Quantity);
                                    bool isPlanned = plannedQtyForMaster > 0;
                                    bool isPartiallyPlanned = isPlanned && plannedQtyForMaster < item.NewOrderQty;
                                    
                                    // Outstation master: machines are irrelevant - days always follow
                                    // the master's team capacity (NewOrderDaysByCapacity).
                                    var baseDays = (double)(item.NewOrderDaysByCapacity ?? 0);
                                    var displayDays = baseDays;
                                        
                                    var estEndDate = isPlanned 
                                        ? plannedPlansForMaster.Max(p => p.EstEndDate) 
                                        : AddWorkingDays((item.MasterFreeDate ?? DateTime.Today).AddDays(1), displayDays);
                                        
                                    var dateColorStyle = isPartiallyPlanned ? "color: var(--amber);" : "";
                                    var dateClass = isPartiallyPlanned ? "" : "text-navy";

                                    <tr @onclick='() => SelectGaugeInModal(itemKey)' class="cursor-pointer transition-colors @(SelectedModalGauge == itemKey ? "selected-gauge-row" : "hover:bg-blue hover:text-white")">
                                        <td class="text-muted text-[9px] text-center">@(sn++)</td>
                                        
                                        <td class="text-center text-navy">@((item.MasterFreeDate ?? DateTime.Today).AddDays(1).ToString("dd-MMM"))</td>
                                        <td class="text-center">
                                            <div class="flex items-center gap-1 justify-center">
                                                <span class="gauge-chip cursor-pointer hover:bg-teal hover:text-white transition-colors" 
                                                      style="padding: 1px 6px; font-size: 9px; @(SelectedModalGauge == itemKey ? "background: var(--teal); color: #fff;" : "")"
                                                     >@item.MasterName</span>
                                            </div>
                                        </td>
                                        <td class="text-center pr-6">@item.NewOrderQty.ToString("N0")</td>
                                        @{
                                            // Plan-derived values are shown only when the master is FULLY planned.
                                            bool isFullyPlannedRowM = item.NewOrderQty > 0 && plannedQtyForMaster >= item.NewOrderQty;
                                        }
                                        <td class="text-center text-teal"></td>
                                        <td class="text-center text-muted">@displayDays.ToString("N1")d</td>
                                        <td class="text-center @dateClass" style="@dateColorStyle">
                                            <div class="flex items-center justify-center gap-1">
                                                <span style="display:inline-block; width:42px; text-align:center;">@(isFullyPlannedRowM ? estEndDate.ToString("dd-MMM") : "")</span>
                                            </div>
                                        </td>
                                        <td class="text-center">
                                            @if (plannedQtyForMaster == 0)
                                            {
                                                <span></span>
                                            }
                                            else if (plannedQtyForMaster >= item.NewOrderQty)
                                            {
                                                <span class="rounded px-2 py-0.5 text-[10px] inline-block"
                                                      style="background: var(--green); color: #fff; font-weight: 700; letter-spacing: .03em; box-shadow: 0 1px 3px rgba(61,191,138,.35);"
                                                      title="Planned: @plannedQtyForMaster.ToString("N0") / @item.NewOrderQty.ToString("N0")">Planned</span>
                                            }
                                            else
                                            {
                                                <span class="border rounded px-2 py-0.5 text-[9px] font-normal inline-block"
                                                      style="background: #fffbeb; color: var(--amber); border-color: rgba(240, 165, 0, 0.2);"
                                                      title="Partial: @plannedQtyForMaster.ToString("N0") / @item.NewOrderQty.ToString("N0")">Partial @plannedQtyForMaster.ToString("N0")/@item.NewOrderQty.ToString("N0")</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                @foreach (var item in PlanningDetail.MachineStatus.Where(i => i.NewOrderQty > 0))
                                {
                                    var plannedPlansForGauge = OrderAllPlannedPlans
                                        .Where(p => string.Equals(p.Gauge?.Trim(), item.Gauge?.Trim(), StringComparison.OrdinalIgnoreCase))
                                        .ToList();
                                    var plannedQtyForGauge = plannedPlansForGauge.Sum(p => p.Quantity);
                                    bool isPlanned = plannedQtyForGauge > 0;
                                    bool isPartiallyPlanned = isPlanned && plannedQtyForGauge < item.NewOrderQty;
                                    
                                    var plannedMachinesForGauge = plannedPlansForGauge.Sum(p => int.TryParse(p.Mc, out int m) ? m : 0);
                                    var displayMachines = isPlanned ? (plannedMachinesForGauge > 0 ? plannedMachinesForGauge : item.SuggestedNewOrderMachines) : item.SuggestedNewOrderMachines;
                                    
                                    var estEndDate = isPlanned ? plannedPlansForGauge.Max(p => p.EstEndDate) : DateTime.Now.AddDays((double)(item.BacklogDays + item.NewOrderDays));
                                    var dateColorStyle = isPartiallyPlanned ? "color: var(--amber);" : "";
                                    var dateClass = isPartiallyPlanned ? "" : "text-navy";

                                    var displayDays = isPlanned && displayMachines > 0
                                        ? (item.NewOrderDays / displayMachines)
                                        : item.NewOrderDays;

                                    bool yarnShortageRow = item.YarnStatus == "SHORTAGE";
                                    bool yarnReadyRow = item.YarnStatus == "READY";
                                    bool colorRow = (yarnShortageRow || yarnReadyRow) && SelectedModalGauge != item.Gauge;
                                    bool redRow = colorRow; // kept name for existing icon/style refs
                                    var rowColorBg = yarnShortageRow ? "#FF0000" : (yarnReadyRow ? "#00b050" : "");
                                    var redCell = colorRow ? "color:#fff !important;" : "";

                                    <tr @onclick='() => SelectGaugeInModal(item.Gauge)' style="@(colorRow ? $"background:{rowColorBg}; color:#fff;" : "")" class="cursor-pointer transition-colors @(SelectedModalGauge == item.Gauge ? "selected-gauge-row" : "hover:bg-blue hover:text-white")">
                                        <td class="text-muted text-[9px] text-center" style="@redCell">@(sn++)</td>

                                        <td class="text-center text-navy" style="@redCell">@GetMachinePlanStartDate(GetGaugeSuggestedFreeDate(item.Gauge)).ToString("dd-MMM")</td>
                                         <td class="text-center">
                                            <div class="flex items-center gap-1 justify-center">
                                                
                                                <span class="gauge-chip cursor-pointer hover:bg-teal hover:text-white transition-colors"
                                                      style="padding: 1px 6px; font-size: 9px; @(SelectedModalGauge == item.Gauge ? "background: var(--teal); color: #fff;" : (colorRow ? "background:#fff; color:#1a3353;" : ""))"
                                                     >@item.Gauge</span>
                                            </div>
                                        </td>
                                        <td class="text-center pr-6" style="@redCell">@item.NewOrderQty.ToString("N0")</td>
                                        @{
                                            // Plan-derived values are shown only when the gauge is FULLY planned.
                                            bool isFullyPlannedRow = item.NewOrderQty > 0 && plannedQtyForGauge >= item.NewOrderQty;
                                        }
                                        <td class="text-center text-teal" style="@redCell">@(isFullyPlannedRow ? displayMachines.ToString() : "")</td>
                                        <td class="text-center text-muted" style="@redCell">@displayDays.ToString("N1")d</td>
                                        <td class="text-center @dateClass" style="@(redRow ? "color:#fff !important;" : dateColorStyle)">
                                            <div class="flex items-center justify-center gap-1">
                                                <span style="display:inline-block; width:42px; text-align:center;">@(isFullyPlannedRow ? estEndDate.ToString("dd-MMM") : "")</span>
                                                @if (item.YarnStatus == "SHORTAGE")
                                                {
                                                    <i class="fa-solid fa-circle-xmark text-[11px]" style="color: @(colorRow ? "#fff" : "var(--red)");" title="SHORTAGE"></i>
                                                }
                                                else if (item.YarnStatus == "READY")
                                                {
                                                    <i class="fa-solid fa-circle-check text-[11px]" style="color: @(colorRow ? "#fff" : "var(--green)");" title="READY"></i>
                                                }
                                            </div>
                                        </td>
                                        <td class="text-center">
                                            @if (plannedQtyForGauge == 0)
                                            {
                                                <span></span>
                                            }
                                            else if (plannedQtyForGauge >= item.NewOrderQty)
                                            {
                                                <span class="rounded px-2 py-0.5 text-[10px] inline-block"
                                                      style="background: var(--green); color: #fff; font-weight: 700; letter-spacing: .03em; box-shadow: 0 1px 3px rgba(61,191,138,.35);"
                                                      title="Planned: @plannedQtyForGauge.ToString("N0") / @item.NewOrderQty.ToString("N0")">Planned</span>
                                            }
                                            else
                                            {
                                                <span class="border rounded px-2 py-0.5 text-[9px] font-normal inline-block"
                                                      style="background: #fffbeb; color: var(--amber); border-color: rgba(240, 165, 0, 0.2);"
                                                      title="Partial: @plannedQtyForGauge.ToString("N0") / @item.NewOrderQty.ToString("N0")">Partial @plannedQtyForGauge.ToString("N0")/@item.NewOrderQty.ToString("N0")</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- manualPlan Summary -->
            @{
                // The large allocation popup is for KNIT only; Silk/Other/Linen
                // (outstation masters, like Weave) plan inline in the panel.
                bool allocAsPopup = SelectedKnitType == "Knit" && !string.IsNullOrEmpty(SelectedModalGauge);
            }
            @if (allocAsPopup)
            {
                <div class="alloc-backdrop" @onclick="CloseGaugeAllocation"></div>
            }
            <div class="panel flex flex-col min-h-0 relative @(allocAsPopup ? "alloc-modal" : "")"
                 style="@(allocAsPopup ? "" : "z-index: 20; overflow: visible;")">
                <div class="panel-header compact-panel-header" style="background: var(--navy); color: #fff; display:flex; align-items:center; justify-content:space-between;">
                    <div class="panel-header-left">
                        <i class="fa-solid fa-calendar-plus text-[10px] mr-1"></i>
                        <span class="compact-panel-title font-bold">Machine Allocation For @(SelectedKnitType == "Silk" || SelectedKnitType == "Other" || SelectedKnitType == "Linen" ? "Master" : "Gauge") :: @SelectedModalGauge</span>
                    </div>
                    @if (!string.IsNullOrEmpty(SelectedModalGauge))
                    {
                        <button @onclick="CloseGaugeAllocation" title="Close" class="px-2 text-[14px] hover:opacity-80" style="background:none; border:none; color:#fff; cursor:pointer;">
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                    }
                </div>
                <div class="panel-body p-0 flex flex-col gap-3" style="overflow: visible;">
                    @{
                        decimal requiredQty = 0;
                        if (SelectedKnitType == "Silk" || SelectedKnitType == "Other" || SelectedKnitType == "Linen")
                        {
                            var masterData = FabricAnalysisData?.MasterWorkload?.FirstOrDefault(m => 
                                string.Equals(m.MasterId?.ToString()?.Trim(), SelectedModalGauge?.Trim(), StringComparison.OrdinalIgnoreCase) ||
                                string.Equals(m.MasterName?.Trim(), SelectedModalGauge?.Trim(), StringComparison.OrdinalIgnoreCase));
                            requiredQty = masterData?.NewOrderQty ?? 0;
                        }
                        else
                        {
                            var machineData = PlanningDetail?.MachineStatus?.FirstOrDefault(m => string.Equals(m.Gauge?.Trim(), SelectedModalGauge?.Trim(), StringComparison.OrdinalIgnoreCase));
                            requiredQty = machineData?.NewOrderQty ?? 0;
                        }
                        var plannedQty = DbPlannedPlans.Sum(p => p.Quantity);
                        var isFullyPlanned = requiredQty > 0 && plannedQty >= requiredQty;
                        var remainingQty = Math.Max(0, requiredQty - plannedQty);
                    }
                    
                    @if (IsLoadingModalStyles)
                    {
                        <!-- Input Form Skeleton Loader -->
                        <div class="border border-border rounded-lg overflow-hidden shadow-sm bg-white animate-pulse mb-3">
                            <div class="bg-slate-200/60 h-8 rounded-t-lg border-b border-slate-200/40"></div>
                            <div class="p-3">
                                <div class="grid grid-cols-5 gap-3">
                                    <div class="h-8 bg-slate-100 rounded w-full"></div>
                                    <div class="h-8 bg-slate-100 rounded w-full"></div>
                                    <div class="h-8 bg-slate-100 rounded w-full"></div>
                                    <div class="h-8 bg-slate-100 rounded w-full"></div>
                                    <div class="h-8 bg-slate-200 rounded w-full"></div>
                                </div>
                            </div>
                        </div>

                        <!-- Plans List Table Skeleton Loader -->
                        <div class="border border-border rounded-lg overflow-hidden shadow-sm bg-white animate-pulse">
                            <table class="nk-table compact-table">
                                <thead>
                                    <tr class="bg-sky border-b border-border">
                                        <th class="h-4 bg-slate-200/40 w-20"></th>
                                        <th class="h-4 bg-slate-200/40 w-12"></th>
                                        <th class="h-4 bg-slate-200/40 w-16"></th>
                                        <th class="h-4 bg-slate-200/40 w-12"></th>
                                        <th class="h-4 bg-slate-200/40 w-24"></th>
                                        <th class="h-4 bg-slate-200/40 w-16"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int r = 0; r < 3; r++)
                                    {
                                        <tr>
                                            <td><div class="h-5 bg-slate-100 rounded w-full"></div></td>
                                            <td><div class="h-5 bg-slate-100 rounded w-full"></div></td>
                                            <td><div class="h-5 bg-slate-100 rounded w-full"></div></td>
                                            <td><div class="h-5 bg-slate-100 rounded w-full"></div></td>
                                            <td><div class="h-5 bg-slate-100 rounded w-full"></div></td>
                                            <td><div class="h-5 bg-slate-200 rounded w-full"></div></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(SelectedModalGauge))
                    {
                        @if (isFullyPlanned)
                        {
                            
                        }
                        else
                        {
                            <!-- Card Header with proper background -->
                            <div class="alloc-stack p-0 bg-white relative" style="overflow: visible; z-index: 30;">
                                <table class="nk-table compact-table border-0 w-full" style="overflow: visible;">
                                    @if (SelectedKnitType == "Knit")
                                    {
                                        <tbody style="overflow: visible;">
                                            <tr style="overflow: visible;">
                                                <td class="py-2 px-3 relative" style="z-index: 40; overflow: visible;">
                                                  <div class="flex items-end gap-4 flex-wrap" style="overflow: visible;">
                                                    <div class="flex items-center gap-2" style="overflow: visible;">
                                                    <label class="text-[9px] font-bold text-slate-500 whitespace-nowrap">Machine (Mc)</label>
                                                    <div class="relative inline-block" style="width: 140px;">
                                                        <button type="button" @onclick="ToggleMachineDropdown" 
                                                                class="form-input text-[10px] h-7 px-2 rounded border border-slate-200 shadow-sm bg-white flex items-center justify-between w-full cursor-pointer text-left text-navy font-medium">
                                                            <span>@(SelectedMachinesList.Any() ? $"{SelectedMachinesList.Count} MC Selected" : "Select Mc...")</span>
                                                            <span class="oi oi-chevron-bottom text-[8px] text-slate-400"></span>
                                                        </button>
                                                        
                                                        @if (IsMachineDropdownOpen)
                                                        {
                                                            <!-- Transparent underlay to capture outside click -->
                                                            <div class="fixed inset-0 z-40 bg-transparent" @onclick="() => IsMachineDropdownOpen = false" style="z-index: 45;"></div>
                                                            
                                                            <div class="absolute left-0 mt-1 bg-white border border-slate-200 rounded-lg overflow-hidden flex flex-col" style="min-width: 480px; max-width: min(640px, 86vw); max-height: 42vh; z-index: 6000; box-shadow: 0 16px 40px rgba(15,23,42,.25);">
                                                                <div class="flex justify-between items-center bg-slate-50 border-b border-slate-200 px-3 py-1.5 shrink-0">
                                                                    <span class="text-[9px] font-bold text-navy">Machine List</span>
                                                                    <div class="flex gap-2">
                                                                        <button type="button" @onclick="SelectAllMachines" @onclick:stopPropagation class="text-teal hover:underline text-[9px] font-bold">Select All</button>
                                                                        <span class="text-slate-300 text-[9px]">|</span>
                                                                        <button type="button" @onclick="DeselectAllMachines" @onclick:stopPropagation class="text-teal hover:underline text-[9px] font-bold">Deselect All</button>
                                                                    </div>
                                                                </div>
                                                                <div class="overflow-y-auto custom-scroll p-2 flex-grow">
                                                                    <table class="nk-table compact-table w-full text-[9px] border-collapse">
                                                                        <thead>
                                                                            <tr class="bg-slate-100 border-b border-slate-200 sticky top-0 z-10 shadow-sm">
                                                                                <th class="py-1 px-1.5 text-center font-bold text-slate-500 w-8">Select</th>
                                                                                <th class="py-1 px-1.5 text-center font-bold text-slate-500 w-8">S.N.</th>
                                                                                <th class="py-1 px-1.5 text-left font-bold text-slate-500 w-24">Start Date</th>
                                                                                <th class="py-1 px-1.5 text-left font-bold text-slate-500">Machine Name</th>
                                                                                <th class="py-1 px-1.5 text-right font-bold text-slate-500 w-16">Qty</th>
                                                                                <th class="py-1 px-1.5 text-center font-bold text-slate-500 w-24">Available Date</th>
                                                                            </tr>
                                                                        </thead>
                                                                        <tbody>
                                                                            @{
                                                                                int snMc = 1;
                                                                                int selectedCount = SelectedMachinesList.Count;
                                                                                
                                                                                // Divide PlanQty among selected machines
                                                                                decimal baseSharedQty = selectedCount > 0 ? Math.Floor(PlanQty / selectedCount) : 0;
                                                                                decimal remainderQty = selectedCount > 0 ? (PlanQty - (baseSharedQty * selectedCount)) : 0;
                                                                                
                                                                                // Keep track of which index we are at among selected machines to distribute remainder
                                                                                int selectedIdx = 0;
                                                                            }
                                                                            @foreach (var machine in MachinePlaningList)
                                                                            {
                                                                                var isChecked = SelectedMachinesList.Any(m => m.Machine_ID == machine.Machine_ID);
                                                                                decimal qtyPerMc = 0;
                                                                                if (isChecked)
                                                                                {
                                                                                    if (SizeAllocationRows.Any())
                                                                                    {
                                                                                        // One-color-per-machine: qty is this machine's allocated size total.
                                                                                        qtyPerMc = GetMachineAllocatedQty(machine.Machine_ID);
                                                                                    }
                                                                                    else
                                                                                    {
                                                                                        qtyPerMc = baseSharedQty;
                                                                                        // Add 1 from remainder until remainder runs out
                                                                                        if (selectedIdx < remainderQty)
                                                                                        {
                                                                                            qtyPerMc += 1;
                                                                                        }
                                                                                    }
                                                                                    selectedIdx++;
                                                                                }

                                                                                decimal capPerMc = (BaseQty / BaseDays) * OvertimeFactor; // BaseDays = single-machine days
                                                                                double daysNeeded = capPerMc > 0 ? (double)(qtyPerMc / capPerMc) : 0;
                                                                                DateTime mStartDate = GetMachinePlanStartDate(machine.FreeDate);
                                                                                DateTime mEndDate = AddWorkingDays(mStartDate, daysNeeded);

                                                                                <tr class="hover:bg-slate-50 cursor-pointer border-b border-slate-100 last:border-b-0 @(isChecked ? "bg-teal/5" : "")" @onclick="() => OnMachineSelectChanged(machine, !isChecked)" @onclick:stopPropagation>
                                                                                    <td class="py-1 px-1.5 text-center" @onclick:stopPropagation>
                                                                                        <input type="checkbox" checked="@isChecked" 
                                                                                               @onchange="(e) => OnMachineSelectChanged(machine, (bool)(e.Value ?? false))" 
                                                                                               class="rounded text-teal focus:ring-teal border-slate-300 w-3.5 h-3.5 cursor-pointer" />
                                                                                    </td>
                                                                                    <td class="py-1 px-1.5 text-center text-slate-500 font-mono">@snMc</td>
