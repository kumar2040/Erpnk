@namespace NkplmErp.Blazor.Components

<div class="line-graph-wrapper bg-white rounded-none border border-slate-200 shadow-sm p-4 h-full flex flex-col">
    @if (!string.IsNullOrEmpty(Title))
    {
        <div class="flex items-center justify-between mb-2">
            <h4 class="text-[12px] font-[900] text-[#2e2b8e] uppercase tracking-wider">@Title</h4>
        </div>
    }

    <div class="flex-1 min-h-0 relative">
        <svg viewBox="0 0 @Width @Height" class="w-full h-full preserve-aspect">
            <!-- Gradients -->
            <defs>
                <linearGradient id="lineFillGradient" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="@FillColor" stop-opacity="0.3" />
                    <stop offset="100%" stop-color="@FillColor" stop-opacity="0.0" />
                </linearGradient>
            </defs>

            <!-- Area Fill -->
            <path d="@_areaPath" fill="url(#lineFillGradient)" />

            <!-- Axis Labels -->
            @if (!string.IsNullOrEmpty(XLabel))
            {
                <svg:text x="@(Width / 2)" y="@(Height - 5)" text-anchor="middle" class="axis-title">@XLabel</svg:text>
            }
            @if (!string.IsNullOrEmpty(YLabel))
            {
                <svg:text x="10" y="@(Height / 2)" text-anchor="middle" class="axis-title" transform="rotate(-90 10,@(Height / 2))">@YLabel</svg:text>
            }

            <!-- The Line -->
            <path d="@_linePath" fill="none" stroke="@StrokeColor" stroke-width="3" stroke-linecap="round" class="draw-line" />

            <!-- Data Points -->
            @foreach (var p in _points)
            {
                <g class="point-group">
                    <circle cx="@p.X" cy="@p.Y" r="4" fill="white" stroke="@StrokeColor" stroke-width="2" class="point-circle" />
                    <svg:text x="@p.X" y="@(Height - 5)" text-anchor="middle" class="axis-label">@p.Label</svg:text>
                    
                    <!-- Tooltip Style Label (Visible on hover via CSS) -->
                    <g class="tooltip">
                        <rect x="@(p.X - 25)" y="@(p.Y - 25)" width="50" height="20" rx="0" fill="#1e293b" />
                        <svg:text x="@p.X" y="@(p.Y - 10)" text-anchor="middle" fill="white" font-size="10" font-weight="bold">@p.Value.ToString("N0")</svg:text>
                    </g>
                </g>
            }
        </svg>
    </div>
</div>
