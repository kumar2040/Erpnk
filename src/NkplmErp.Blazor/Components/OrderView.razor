@namespace NkplmErp.Blazor.Components
@using NkplmErp.Shared.DTOs
@using Microsoft.AspNetCore.Components.QuickGrid

<div class="order-view-container h-full flex flex-col gap-4">
    
    @{
        var firstItem = Data?.FirstOrDefault();
        var totalPieces = Data?.Sum(x => x.Qty) ?? 0;
    }

    @if (IsLoading)
    {
        <!-- Skeleton Summary Card -->
        <div class="bg-white rounded-none shadow-sm border border-slate-200 p-3 flex flex-wrap lg:flex-nowrap justify-between items-center gap-4 shrink-0">
            <div class="flex flex-col gap-2 min-w-[250px]">
                <Skeleton Type="Skeleton.SkeletonType.Text" Width="200px" Height="1.75rem" />
                <div class="flex items-center gap-3">
                    <Skeleton Type="Skeleton.SkeletonType.Text" Width="100px" Height="1rem" />
                    <Skeleton Type="Skeleton.SkeletonType.Text" Width="120px" Height="1rem" />
                </div>
            </div>
            <div class="flex gap-2">
                <Skeleton Type="Skeleton.SkeletonType.Rectangle" Width="80px" Height="40px" Class="rounded-none" />
            </div>
        </div>
    }
    else
    {
        <!-- TOP SECTION: Order Summary Card -->
        <div class="bg-white rounded-none shadow-sm border border-slate-200 p-3 flex flex-wrap lg:flex-nowrap justify-between items-center gap-4 shrink-0">
            <!-- Left: Basic Order Info -->
            <div class="flex flex-col gap-1 min-w-[250px]">
                
                <div class="flex items-center gap-3 text-[12px] font-bold text-slate-600">
                    
                    <div class="flex items-center gap-1.5"><i class="fa-solid fa-truck-fast text-emerald-500"></i>Shipping Date: <span class="text-slate-800">@(firstItem?.ShippingDate?.ToString("yyyy-MM-dd") ?? "-")</span></div>
                </div>
            </div>

            <!-- Right: Order Summary Info -->
            <div class="flex gap-2 flex-wrap justify-end">
                <div class="flex items-center gap-2 px-3 py-1.5 rounded-none border shadow-sm text-blue-500 bg-blue-50 border-blue-100">
                    <i class="fa-solid fa-calculator opacity-70"></i>
                    <div class="flex flex-col leading-none">
                        
                        <span class="text-[14px] font-black">@totalPieces</span>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (IsLoading)
    {
        <div class="bg-white rounded-none shadow-sm border border-slate-200 p-2 flex-1 min-h-0">
            <Skeleton Type="Skeleton.SkeletonType.Table" Rows="8" Columns="10" />
        </div>
    }
    else if (Data == null || !Data.Any())
    {
        <div class="py-16 text-center bg-white rounded-none shadow-sm border border-slate-200 flex-1 flex flex-col items-center justify-center">
            <div class="bg-slate-50 w-16 h-16 rounded-full flex items-center justify-center mb-3">
                <i class="fa-solid fa-file-invoice text-2xl text-slate-300"></i>
            </div>
            <h4 class="text-base font-bold text-slate-900 mb-1">No Order Details</h4>
            <p class="text-xs text-slate-400">There are no items to display for this order.</p>
        </div>
    }
    else
    {
        <!-- DATA GRID SECTION -->
        <div class="bg-white rounded-none shadow-sm border border-slate-200 quick-grid-container flex-1 min-h-0 flex flex-col">
            <div class="flex-1 min-h-0 overflow-y-auto">
                <QuickGrid Items="@Data.AsQueryable()" class="quick-grid w-full">
                    <TemplateColumn Title="Style No" Class="col-style font-medium text-slate-800">
                        <div class="cursor-pointer text-indigo-600 hover:text-indigo-800 hover:underline font-bold transition-colors flex items-center gap-1.5 min-w-0 overflow-hidden" @onclick="() => ShowStyleDetails(context)">
                            <i class="fa-solid fa-circle-info text-[10px] opacity-50 shrink-0"></i>
                            <span class="truncate" title="@context.StyleNo">@context.StyleNo</span>
                        </div>
                    </TemplateColumn>
                    <PropertyColumn Property="@(x => x.ProductName)" Title="Product Name" Class="col-product text-slate-700" />
                    <PropertyColumn Property="@(x => x.Color)" Title="Color" Class="col-color text-slate-700" />
                    <PropertyColumn Property="@(x => x.Guage)" Title="Guage" Class="col-guage text-slate-600" />
                    <PropertyColumn Property="@(x => x.Ply)" Title="Ply" Class="col-ply text-slate-600" />
                    <TemplateColumn Title="Yarn" Class="col-yarn text-slate-600 text-xs">
                        <div class="truncate-text" title="@context.Yarn">
                            @context.Yarn
                        </div>
                    </TemplateColumn>

                    @foreach (var size in SizeHeaders)
                    {
                        <TemplateColumn Title="@size" Align="Align.Center" Class="col-size border-x border-slate-100/50">
                            @{ var count = context.Sizes.TryGetValue(size, out var val) ? val : 0; }
                            <span class="@(count > 0 ? "text-slate-900 font-bold" : "text-transparent")">
                                @(count > 0 ? count.ToString() : "")
                            </span>
                        </TemplateColumn>
                    }

                    <PropertyColumn Property="@(x => x.Qty)" Title="Qty" Align="Align.Center" Class="col-pieces font-bold text-slate-900 bg-slate-50/30" />
                    <TemplateColumn Title="Print" Align="Align.Center" Class="col-print text-slate-600">
                        @if (!string.IsNullOrWhiteSpace(context.StylePrint) && context.StylePrint != "0")
                        {
                            <span title="@context.StylePrint" class="inline-flex items-center justify-center text-indigo-500">
                                <!-- clothing / screen-print icon -->
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M20.38 3.46 16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.57a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.57a2 2 0 0 0-1.34-2.23z"/>
                                </svg>
                            </span>
                        }
                    </TemplateColumn>
                    <PropertyColumn Property="@(x => x.KnSl)" Title="Kn/Sl" Class="col-knsl text-slate-600" />
                    <PropertyColumn Property="@(x => x.DaysRequired)" Title="Days Req" Align="Align.Center" Class="col-daysreq font-semibold text-indigo-600" />
                </QuickGrid>
            </div>

            <!-- STICKY FOOTER -->
            <div class="footer-container shrink-0 border-t-2 border-slate-300">
                <table class="grand-total-table w-full">
                    <tr>
                        <!-- Span across fixed columns before sizes -->
                        <td class="footer-label font-black text-right pr-4 uppercase tracking-widest text-[#002d54]">
                            Grand Totals
                        </td>
                        
                        <!-- Dynamic Size Totals -->
                        @foreach (var size in SizeHeaders)
                        {
                            <td class="footer-val-size col-size text-center">
                                @Data.Sum(x => x.Sizes.TryGetValue(size, out var val) ? val : 0)
                            </td>
                        }
                        
                        <!-- Fixed Columns Totals -->
                        <td class="footer-val-total col-pieces text-center font-black text-slate-900 bg-slate-100">@totalPieces</td>
                        <td class="col-print"></td>
                        <td class="col-knsl"></td>
                        <td class="col-daysreq"></td>
                    </tr>
                </table>
            </div>
        </div>
    }
</div>

<!-- STYLE DETAIL POPUP -->
<DataModal @bind-IsVisible="IsStyleModalVisible" 
           Title="@($"Style Details - {SelectedStyleItem?.StyleNo}")"
           BadgeText="@SelectedStyleDetails?.GeneralInfo?.StyleId.ToString()"
           IsLoading="false"
           MaxWidth="1100px"
           ZIndex="2800">
    <div class="h-full">
        <StyleComponent Details="SelectedStyleDetails" IsLoading="IsLoadingStyleHistory" />
    </div>
</DataModal>
