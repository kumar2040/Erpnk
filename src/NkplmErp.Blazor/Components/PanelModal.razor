@namespace NkplmErp.Blazor.Components

<style>
    .pm-overlay {
        position: fixed; inset: 0; z-index: 1000;
        display: flex; align-items: center; justify-content: center;
        background: rgba(15, 23, 42, 0.45);
        animation: pm-fade 0.15s ease-out;
    }
    .pm-modal {
        width: 96%; max-height: 90vh;
        display: flex; flex-direction: column;
        background: #fff; border-radius: 12px; overflow: hidden;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.35), 0 0 0 1px rgba(0, 0, 0, 0.04);
        animation: pm-pop 0.18s cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    .pm-header {
        flex: 0 0 auto;
        display: flex; align-items: center; justify-content: space-between;
        background: #1a3353; color: #fff; padding: 10px 16px;
    }
    .pm-header-left { display: flex; align-items: center; gap: 8px; min-width: 0; }
    .pm-header-icon { font-size: 13px; opacity: 0.85; }
    .pm-title {
        font-size: 14px; font-weight: 700; letter-spacing: 0.01em;
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .pm-close {
        background: none; border: 0; color: #fff; cursor: pointer;
        font-size: 16px; line-height: 1; padding: 2px 8px; border-radius: 6px;
        transition: background 0.15s;
    }
    .pm-close:hover { background: rgba(255, 255, 255, 0.16); }
    .pm-body { flex: 1 1 auto; min-height: 0; overflow-y: auto; background: #fff; padding: 18px 20px; }
    @@keyframes pm-pop { from { opacity: 0; transform: scale(0.96) translateY(8px); } to { opacity: 1; transform: none; } }
    @@keyframes pm-fade { from { opacity: 0; } to { opacity: 1; } }
</style>

@if (IsVisible)
{
    <div class="pm-overlay" @onclick="OnBackdropClick">
        <div class="pm-modal" style="max-width:@MaxWidth;" @onclick:stopPropagation="true">
            <div class="pm-header">
                <div class="pm-header-left">
                    @if (!string.IsNullOrEmpty(Icon))
                    {
                        <i class="@Icon pm-header-icon"></i>
                    }
                    <span class="pm-title">@Title</span>
                </div>
                @if (ShowClose)
                {
                    <button type="button" class="pm-close" @onclick="CloseAsync" aria-label="Close">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                }
            </div>
            <div class="pm-body @BodyClass">
                @ChildContent
            </div>
        </div>
    </div>
}
