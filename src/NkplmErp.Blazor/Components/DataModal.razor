@using NkplmErp.Shared.DTOs
@namespace NkplmErp.Blazor.Components

<style>
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
    
        display: flex;
        align-items: flex-start;
        justify-content: center;
        padding-top: 2.5rem;
        z-index: 1000;
        animation: fade-in 0.3s ease-out;
    }

    .modal-content {
        
        
        max-width: 800px;
        width: 99%;
        max-height: 80vh;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transform: scale(1);
        animation: retina-pop 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
     
    }

    .modal-header {
       
        padding:0rem;
        border-bottom: 1px solid #f9f9f9;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .modal-body {
        padding:0rem;
        overflow-y: auto;
        flex: 1;
        background: transparent;
    }

    .modal-footer {
        padding: 1rem 1.5rem;
        background: rgba(255, 255, 255, 0.4);
        border-top: 1px solid rgba(0, 0, 0, 0.05);
        display: flex;
        justify-content: flex-end;
        gap: 0.75rem;
    }

    .close-btn {
        background: none;
        border: none;
        font-size: 1.5rem;
        color: #991b1b;
        cursor: pointer;
        padding: 0;
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 6px;
        transition: all 0.2s;
    }
     /* compact modal */
    .modal-backdrop {
      background: rgba(239, 237, 237, 0.4);
      backdrop-filter: blur(5px);
    }
    .hidden-modal { display: none; }
    .modal-liquid-compact {
      
      border: 1px solid rgba(246, 241, 241, 0.8);
      border-radius: 0;
      box-shadow: 0 20px 35px -12px #0b1e30, inset 0 1px 4px white;
      
    }

    .close-btn:hover {
        background-color: #fee2e2;
        color: #7f1d1d;
    }

    .loading-spinner {
        text-align: center;
        padding: 3rem;
        color: #6b7280;
    }

    .spinner {
        border: 3px solid #f3f4f6;
        border-top: 3px solid #002d54;
        border-radius: 50%;
        width: 40px;
        height: 40px;
        animation: spin 1s linear infinite;
        margin: 0 auto 1rem;
    }

    @@keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }

    .modal-content.full-screen {
        width: calc(100vw - 80px);
        max-width: calc(100vw - 80px);
        height: calc(100vh - 80px);
        max-height: calc(100vh - 80px);
        border-radius: 0;
    }

    @@keyframes retina-pop {
        from { opacity: 0; transform: scale(0.95) translateY(10px); }
        to { opacity: 1; transform: scale(1) translateY(0); }
    }

    @@keyframes fade-in {
        from { opacity: 0; }
        to { opacity: 1; }
    }
    .modal-body table{
        width  :100%;
        }
      .modal-body table td{
         text-align:right;
        } 
      .modal-body table th{
         text-align:right;
        }  
        .modal-body table td:first-child {
    text-align: left;
} 
.modal-body table th:nth-child(2),
.modal-body table td:nth-child(2) {
  text-align: left;           /* ← this is what you asked for */
}  
</style>

@if (IsVisible)
{
    <div class="modal-overlay fixed inset-0 flex items-center justify-center modal-backdrop duration-300" 
         style="z-index: @_currentZIndex;"
         @onmousedown="HandleClick"
         @ontouchstart="HandleClick">
        @{
            var style = string.IsNullOrEmpty(MaxWidth) ? "" : $"max-width: {MaxWidth};";
        }
        <div class="modal-content @(FullScreen ? "full-screen" : "h-full sm:h-[90vh] sm:w-[90vw]") relative shadow-2xl flex flex-col overflow-hidden animate-in fade-in zoom-in-95 duration-200 modal-liquid-compact" 
             style="@style"
             @onmousedown="HandleClick"
             @ontouchstart="HandleClick"
             @onclick:stopPropagation="true"
             @attributes="AdditionalAttributes">
            <div class="modal-header px-3 py-2 border-b border-slate-200 bg-slate-50/80 backdrop-blur-sm">
                <div class="flex items-center gap-2.5">
                    <h3 class="font-[900] text-[#2e2b8e] text-base uppercase tracking-wider">@Title</h3>
                    @if (!string.IsNullOrEmpty(BadgeText))
                    {
                        <span class="text-[10px] font-bold text-slate-500 bg-white/80 px-2.5 py-0.5 rounded-full border border-slate-200/60 shadow-sm">ID: @BadgeText</span>
                    }
                    @HeaderExtra
                </div>
                <button class="close-btn w-7 h-7 text-lg opacity-70 hover:opacity-100 transition-opacity" @onclick="CloseModal">
                    <span class="leading-none">&times;</span>
                </button>
            </div>
            
            <div class="modal-body p-1">
                @if (IsLoading)
                {
                    <div class="loading-spinner">
                        <div class="spinner"></div>
                        <p class="text-sm">Loading data...</p>
                    </div>
                }
                else
                {
                    @ChildContent
                }
            </div>

            
        </div>
    </div>
}
