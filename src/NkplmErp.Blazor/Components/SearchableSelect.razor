@typeparam TItem
@namespace NkplmErp.Blazor.Components

<div class="relative w-full @Class">
    <div class="relative">
        <input type="text"
               class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all duration-200 bg-white"
               placeholder="@Placeholder"
               value="@_searchText"
               @oninput="HandleInput"
               @focus="() => _isDropdownOpen = true"
               @onblur="OnBlur" />
        
        <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none">
            <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
        </div>
    </div>

    @if (_isDropdownOpen)
    {
        <div class="absolute z-50 w-full mt-1 bg-white border border-gray-200 rounded-lg shadow-xl max-h-60 overflow-y-auto animate-in fade-in slide-in-from-top-2 duration-200">
            @if (!FilteredItems.Any())
            {
                <div class="px-4 py-3 text-sm text-gray-500 italic">
                    No results found...
                </div>
            }
            else
            {
                @foreach (var item in FilteredItems)
                {
                    <div class="px-4 py-2 cursor-pointer hover:bg-blue-50 hover:text-blue-700 transition-colors duration-150 text-sm @(item != null && item.Equals(Value) ? "bg-blue-50 text-blue-700 font-medium" : "text-gray-700")"
                         @onclick="() => SelectItem(item)">
                        @DisplayFunc(item)
                    </div>
                }
            }
        </div>
    }
</div>
