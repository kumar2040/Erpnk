<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\NkplmErp.Application\NkplmErp.Application.csproj" />
    <ProjectReference Include="..\NkplmErp.Security\NkplmErp.Security.csproj" />
    <ProjectReference Include="..\NkplmErp.Shared\NkplmErp.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Blazored.LocalStorage" Version="4.5.0" />
    <PackageReference Include="Fido2" Version="4.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="9.0.2" />
    <PackageReference Include="Microsoft.AspNetCore.Components.QuickGrid" Version="9.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Tailwind CSS Build Integration -->
  <Target Name="NpmInstall" BeforeTargets="BeforeBuild" Condition="!Exists('node_modules')">
    <Message Importance="high" Text="Running npm install..." />
    <Exec Command="npm install" />
  </Target>

  <Target Name="BuildTailwindCSS" BeforeTargets="BeforeBuild" DependsOnTargets="NpmInstall">
    <Message Importance="high" Text="Building Tailwind CSS..." />
    <Exec Command="npm run build:css" />
  </Target>

</Project>
