@namespace NkplmErp.Blazor.Components

<div class="line-graph-wrapper bg-white rounded-none border border-slate-200 shadow-sm p-4 h-full flex flex-col">
    @if (!string.IsNullOrEmpty(Title))
    {
        <div class="flex items-center justify-between mb-2">
            <h4 class="text-[12px] font-[900] text-[#2e2b8e] uppercase tracking-wider">@Title</h4>
        </div>
    }

    <div class="flex-1 min-h-0 relative">
        <svg viewBox="0 0 @Width @Height" class="w-full h-full preserve-aspect">
            <!-- Axis Labels -->
            @if (!string.IsNullOrEmpty(XLabel))
            {
                <text x="@(Width / 2)" y="@(Height - 5)" text-anchor="middle" class="axis-title">@XLabel</text>
            }
            @if (!string.IsNullOrEmpty(YLabel))
            {
                <text x="10" y="@(Height / 2)" text-anchor="middle" class="axis-title" transform="rotate(-90 10,@(Height / 2))">@YLabel</text>
            }

            <!-- Y-Axis Ticks & Grid Lines -->
            @foreach (var tick in _yTicks)
            {
                <line x1="@Padding" y1="@tick.Y" x2="@(Width - Padding)" y2="@tick.Y" stroke="#e2e8f0" stroke-width="1" stroke-dasharray="4" />
                <text x="@(Padding - 5)" y="@(tick.Y + 4)" text-anchor="end" class="axis-label" style="font-size: 9px; fill: #64748b; font-weight: 600;">@tick.Label</text>
            }

            <!-- The Lines -->
            @foreach (var sd in _seriesDrawData)
            {
                <path d="@sd.Path" fill="none" stroke="@sd.Series.Color" stroke-width="3" stroke-linecap="round" class="draw-line" />
            }

            <!-- Data Points & Tooltips -->
            @foreach (var p in _allPoints)
            {
                <g class="point-group">
                    <circle cx="@p.X" cy="@p.Y" r="4" fill="white" stroke="@p.Color" stroke-width="2" class="point-circle" />
                    
                    <g class="tooltip">
                        <rect x="@(p.X - 40)" y="@(p.Y - 35)" width="80" height="30" rx="4" fill="#1e293b" fill-opacity="0.9" />
                        <text x="@p.X" y="@(p.Y - 22)" text-anchor="middle" fill="white" font-size="9" font-weight="600">@p.SeriesName</text>
                        <text x="@p.X" y="@(p.Y - 10)" text-anchor="middle" fill="white" font-size="10" font-weight="bold">@p.Value.ToString("N0")</text>
                    </g>
                </g>
            }
            
            @if (_seriesDrawData.Any() && _seriesDrawData.First().Points.Any())
            {
                @foreach (var p in _seriesDrawData.First().Points)
                {
                    <text x="@p.X" y="@(Height - 5)" text-anchor="middle" class="axis-label" style="font-weight: 700;">@p.Label</text>
                }
            }
        </svg>
    </div>
</div>

<style>
    .line-graph-wrapper {
        min-height: 300px;
    }
    .draw-line {
        stroke-dasharray: 1000;
        stroke-dashoffset: 1000;
        animation: dash 2s linear forwards;
    }
    @@keyframes dash {
        to {
            stroke-dashoffset: 0;
        }
    }
    .point-circle {
        transition: r 0.2s ease-in-out;
    }
    .point-group:hover .point-circle {
        r: 6;
    }
    .tooltip {
        visibility: hidden;
        opacity: 0;
        transition: opacity 0.2s, visibility 0.2s;
        pointer-events: none;
        z-index: 100;
    }
    .point-group:hover .tooltip {
        visibility: visible;
        opacity: 1;
    }
    .axis-title {
        font-size: 11px;
        font-weight: 800;
        fill: #1e293b;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }
    .axis-label {
        font-size: 9px;
        fill: #64748b;
    }
</style>
