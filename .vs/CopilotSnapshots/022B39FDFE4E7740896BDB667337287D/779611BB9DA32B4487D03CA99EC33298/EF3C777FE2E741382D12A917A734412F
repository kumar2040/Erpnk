    public async Task<OrderProductionStatusDto> GetOrderProductionStatusAsync(string orderNo, int flag)
    {
        var result = new OrderProductionStatusDto();
        try
        {
            var connection = _context.Database.GetDbConnection();
            using (var command = connection.CreateCommand())
            {
                command.CommandText = "dbo.sp_GetOrderProductionStatus";
                command.CommandType = CommandType.StoredProcedure;
                command.Parameters.Add(new SqlParameter("@orderNo", orderNo));
                command.Parameters.Add(new SqlParameter("@flag", flag));

                if (connection.State != ConnectionState.Open)
                    await connection.OpenAsync();

                using (var reader = await command.ExecuteReaderAsync())
                {
                    // Result 1: Yarn & Color Related
                    while (await reader.ReadAsync())
                    {
                        var dto = new YarnColorStatusDto();
                        for (int i = 0; i < reader.FieldCount; i++)
                        {
                            string col = reader.GetName(i).Replace("_", "").ToLower();
                            if (reader.IsDBNull(i)) continue;

                            if (col == "productid") dto.ProductId = Convert.ToInt32(reader[i]);
                            else if (col == "yarn") dto.Yarn = reader[i].ToString() ?? string.Empty;
                            else if (col == "ordercolor") dto.OrderColor = reader[i].ToString() ?? string.Empty;
                            else if (col == "reqwt") dto.ReqWt = Convert.ToDecimal(reader[i]);
                            else if (col == "otherrunningwt") dto.OtherRunningWt = Convert.ToDecimal(reader[i]);
                            else if (col == "stockqty") dto.StockQty = Convert.ToDecimal(reader[i]);
                        }
                        result.YarnColorStatus.Add(dto);
                    }

                    // Result 2: Guage Wise Workload & Remarks
                    if (await reader.NextResultAsync())
                    {
                        while (await reader.ReadAsync())
                        {
                            var dto = new GuageWorkloadStatusDto();
                            for (int i = 0; i < reader.FieldCount; i++)
                            {
                                string col = reader.GetName(i).Replace("_", "").ToLower();
                                if (reader.IsDBNull(i)) continue;

                                if (col == "styleguage") dto.StyleGuage = reader[i].ToString() ?? string.Empty;
                                else if (col == "existingworkload") dto.ExistingWorkload = Convert.ToDecimal(reader[i]);
                                else if (col == "existingworkloaddays") dto.ExistingWorkloadDays = Convert.ToDecimal(reader[i]);
                                else if (col == "neworderworkload") dto.NewOrderWorkLoad = Convert.ToDecimal(reader[i]);
                                else if (col == "neworderworkdays") dto.NewOrderWorkDays = Convert.ToDecimal(reader[i]);
                                else if (col == "totaldays") dto.TotalDays = Convert.ToDecimal(reader[i]);
                                else if (col == "productionremark") dto.ProductionRemark = reader[i].ToString() ?? string.Empty;
                            }
                            result.GuageWorkloadStatus.Add(dto);
                        }
                    }
                }
            }
            return result;
        }
        catch (Exception)
        {
            throw;
        }
    }

    public async Task<OrderDeptCompletionDto?> GetOrderDeptCompletionDateAsync(string orderNo, string deptName)
    {
        try
        {
            var connection = _context.Database.GetDbConnection();
            using (var command = connection.CreateCommand())
            {
                command.CommandText = "dbo.orderDepCompletionDate";
                command.CommandType = CommandType.StoredProcedure;
                command.Parameters.Add(new SqlParameter("@OrderNo", orderNo));
                command.Parameters.Add(new SqlParameter("@DeptName", deptName));

                if (connection.State != ConnectionState.Open)
                    await connection.OpenAsync();

                using (var reader = await command.ExecuteReaderAsync())
                {
                    if (await reader.ReadAsync())
                    {
                        var dto = new OrderDeptCompletionDto();
                        for (int i = 0; i < reader.FieldCount; i++)
                        {
                            string col = reader.GetName(i).Replace("_", "").ToLower();
                            if (reader.IsDBNull(i)) continue;

                            if (col == "orderno") dto.OrderNo = reader[i].ToString() ?? string.Empty;
                            else if (col == "orderldate") dto.OrderLDate = Convert.ToDateTime(reader[i]);
                            else if (col == "entrydate") dto.EntryDate = Convert.ToDateTime(reader[i]);
                            else if (col == "dateentry") dto.DateEntry = Convert.ToDateTime(reader[i]);
                            else if (col == "deptcompletiondate") dto.DeptCompletionDate = Convert.ToDateTime(reader[i]);
                        }
                        return dto;
                    }
                }
            }
            return null;
        }
        catch (Exception)
        {
            throw;
        }
    }
}
