using Microsoft.Data.SqlClient;
using Microsoft.EntityFrameworkCore;
using NkplmErp.Application.Interfaces;
using NkplmErp.Infrastructure.Persistence;
using NkplmErp.Shared.DTOs;
using System.Data;

namespace NkplmErp.Infrastructure.Services;

public class ProductionPlanningService(ApplicationDbContext context) : IProductionPlanningService
{
    private readonly ApplicationDbContext _context = context;

    public async Task<IEnumerable<MonthlyOrderSummaryDto>> GetMonthlySummaryAsync(DateTime inputDate)
    {
        var results = new List<MonthlyOrderSummaryDto>();
        try
        {
            var connection = _context.Database.GetDbConnection();
            using (var command = connection.CreateCommand())
            {
                command.CommandText = "dbo.sp_GetMonthlyOrderReport";
                command.CommandType = CommandType.StoredProcedure;
                command.Parameters.Add(new SqlParameter("@InputDate", inputDate));
                command.Parameters.Add(new SqlParameter("@Flag", "months"));

                if (connection.State != ConnectionState.Open)
                    await connection.OpenAsync();

                using (var reader = await command.ExecuteReaderAsync())
                {
                    while (await reader.ReadAsync())
                    {
                        var dto = new MonthlyOrderSummaryDto();
                        for (int i = 0; i < reader.FieldCount; i++)
                        {
                            string col = reader.GetName(i).Replace(" ", "");
                            if (reader.IsDBNull(i)) continue;

                            if (col.Equals("Year", StringComparison.OrdinalIgnoreCase)) dto.Year = Convert.ToInt32(reader[i]);
                            else if (col.Equals("MonthName", StringComparison.OrdinalIgnoreCase)) dto.MonthName = reader[i].ToString() ?? string.Empty;
                            else if (col.Equals("MonthNum", StringComparison.OrdinalIgnoreCase)) dto.MonthNum = Convert.ToInt32(reader[i]);
                            else if (col.Equals("MonthStartDate", StringComparison.OrdinalIgnoreCase)) dto.MonthStartDate = Convert.ToDateTime(reader[i]);
                            else if (col.Equals("TotalPieces", StringComparison.OrdinalIgnoreCase)) dto.TotalPieces = Convert.ToDecimal(reader[i]);
                        }
                        results.Add(dto);
                    }
                }
            }
            return results;
        }
        catch (Exception)
        {
            throw;
        }
    }

