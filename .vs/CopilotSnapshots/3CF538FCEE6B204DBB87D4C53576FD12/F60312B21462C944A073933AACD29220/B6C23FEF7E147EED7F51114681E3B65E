                                       Series="@YearHistoryMultiGraphData"
                                       XLabel="Month"
                                       YLabel="Quantity" />
                        </div>
                    }
                }
                else
                {
                    <div class="py-12 text-center text-gray-400">
                        <span class="oi oi-inbox text-3xl block mb-2 opacity-10"></span>
                        <p class="text-xs font-medium">No Year history found for this buyer</p>
                    </div>
                }
            </div>
            </div>
    </ChildContent>
</DataModal>

<DataModal @bind-IsVisible="showRunningOrdersModal" Title="@($"{CurrentRunningOrdersTitle} - {SelectedBuyerName}")" IsLoading="false" FullScreen="false" MaxWidth="1000px" ZIndex="2600">
    <ChildContent>
        <div class="px-2 pb-4">
            @if (IsRunningOrdersLoading)
            {
                <div class="bg-white rounded-none shadow-sm border border-slate-200 p-4">
                    <Skeleton Type="Skeleton.SkeletonType.Table" Rows="8" Columns="12" />
                </div>
            }
            else if (RunningOrdersList.Any())
            {
    
                <div class="bg-white rounded-none shadow-sm border border-slate-200 quick-grid-container" style="max-height: calc(100vh - 180px);">
                    <QuickGrid Items="@RunningOrdersList" class="quick-grid w-full" style="table-layout: fixed;">
                        <PropertyColumn Property="@(h => h.SN)" Title="SN"      Align="Align.Center" Class="col-sn" />
                        <TemplateColumn Title="Order No"   Class="col-order-no">
                            <button type="button" class="text-blue-600 hover:text-blue-800 hover:underline font-bold text-left whitespace-nowrap" @onclick="() => ShowProductionFlowByOrder(context)">
                                @context.OrderNo
                            </button>
                        </TemplateColumn>
                        <PropertyColumn Property="@(h => h.Collection)" Title="Type"  Align="Align.Center" Class="col-coll" />
                        <PropertyColumn Property="@(h => h.ShippingDate)" Title="Ship Date" Align="Align.Center"  Format="yyyy-MM-dd" Class="col-ship-date" />
                        
                        @foreach (var cat in RunningOrderCategories)
                        {
                            <TemplateColumn Title="@cat"  Align="Align.Center" Class="col-category">
                                @{
                                    var val = context.Categories.GetValueOrDefault(cat);
                                    @(val == 0 ? "" : val.ToString())
                                }
                            </TemplateColumn>
                        }
    
                        <TemplateColumn Title="Knitted"  Align="Align.Center" Class="col-recv">
                            @(context.TotalKnitterItems == 0 ? "" : context.TotalKnitterItems.ToString())
                        </TemplateColumn>
                        <TemplateColumn Title="Total Qty"  Align="Align.Center" Class="col-order-pics">
                            @(context.TotalOrderPics == 0 ? "" : context.TotalOrderPics.ToString())
                        </TemplateColumn>
                        <TemplateColumn Title="Balance"  Align="Align.Center" Class="col-diff font-bold text-red-600">
                            @(context.Difference == 0 ? "" : context.Difference.ToString())
                        </TemplateColumn>
                    </QuickGrid>
    
                    <div class="footer-container">
                        <table class="grand-total-table" style="table-layout: fixed;">
                            <tr>
                                <td class="col-sn"></td>
                                <td class="col-order-no"></td>
                                <td class="col-coll"></td>
                                <td class="col-ship-date footer-label" style="text-align: right; padding-right: 1rem !important;">
                                    TOTAL
                                </td>
                                
                                @{
                                    var knitterTotal = RunningOrdersList.Sum(h => h.TotalKnitterItems);
                                    var orderPicsTotal = RunningOrdersList.Sum(h => h.TotalOrderPics);
                                    var diffTotal = RunningOrdersList.Sum(h => h.Difference);
                                }
    
                                @foreach (var cat in RunningOrderCategories)
                                {
                                    var catTotal = RunningOrdersList.Sum(h => h.Categories.GetValueOrDefault(cat));
                                    <td class="col-category footer-val">@(catTotal == 0 ? "" : catTotal.ToString())</td>
                                }
    
                                <td class="col-recv footer-val">@(knitterTotal == 0 ? "" : knitterTotal.ToString())</td>
                                <td class="col-order-pics footer-val">@(orderPicsTotal == 0 ? "" : orderPicsTotal.ToString())</td>
                                <td class="col-diff footer-val font-bold text-red-600">@(diffTotal == 0 ? "" : diffTotal.ToString())</td>
                            </tr>
                        </table>
                    </div>
                </div>
            }
            else
            {
                <div class="py-12 text-center text-gray-400">
                    <span class="oi oi-inbox text-3xl block mb-2 opacity-10"></span>
                    <p class="text-xs font-medium">No running orders found</p>
                </div>
            }
        </div>
    </ChildContent>
</DataModal>

<!-- GLOBAL STYLE DETAIL POPUP (ROOT LEVEL FOR PERFECT CENTERING) -->
<DataModal @bind-IsVisible="IsStyleModalVisible" 
