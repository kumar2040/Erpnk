<!-- ORDER DETAIL POPUP (HOISTED FOR SEPARATION) -->
<DataModal @bind-IsVisible="IsOrderDetailVisible" 
           Title="@($"Order Details - {SelectedOrderNo}")"
           IsLoading="IsLoadingOrderDetail"
           MaxWidth="1200px"
           ZIndex="2500">
    <div class="flex-1 w-full relative min-h-[500px] bg-white p-4 overflow-hidden flex flex-col">
        @if (SelectedOrderDetails != null && SelectedOrderDetails.Any())
        {
            var firstItem = SelectedOrderDetails.FirstOrDefault();
            var totalPieces = SelectedOrderDetails.Sum(x => x.Qty);
            var sizeHeaders = SelectedOrderDetails
                .SelectMany(x => x.Sizes)
                .Where(x => x.Value > 0)
                .Select(x => x.Key.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(s => {
                    var fixedOrder = new List<string> { "XXXS", "XXS", "XS", "S", "M", "L", "XL", "XXL", "XXXL", "OSFA" };
                    int idx = fixedOrder.IndexOf(s.ToUpper());
                    return idx == -1 ? 999 : idx;
                })
                .ToList();

            <!-- TOP SECTION: Order Summary Card -->
            <div class="bg-white rounded-none shadow-sm border border-slate-200 p-3 flex flex-wrap lg:flex-nowrap justify-between items-center gap-4 shrink-0 mb-4">
                <div class="flex flex-col gap-1 min-w-[250px]">
                    <div class="flex items-center gap-2 text-emerald-600">
                        <i class="fa-solid fa-truck-fast text-xs"></i>
                        <span class="text-[10px] font-black uppercase tracking-widest">Shipping Date:</span>
                        <span class="text-sm font-black">@(firstItem?.ShippingDate?.ToString("yyyy-MM-dd") ?? "-")</span>
                    </div>
                </div>
                <div class="flex items-center gap-3">
                    <div class="flex items-center gap-2 bg-indigo-50 border border-indigo-100 px-4 py-2 rounded-sm shadow-sm">
                        <i class="fa-solid fa-calculator text-indigo-400"></i>
                        <span class="text-lg font-black text-indigo-700">@totalPieces</span>
                    </div>
                </div>
            </div>

            <!-- DATA GRID SECTION -->
            <div class="bg-white rounded-none border border-slate-200 quick-grid-container flex-1 flex flex-col overflow-hidden min-h-0">
                <div class="flex-1 min-h-0 overflow-y-auto">
                    <QuickGrid Items="@SelectedOrderDetails.AsQueryable()" class="quick-grid w-full">
                        <TemplateColumn Title="Style No" Class="col-style font-medium text-slate-800">
                            <div class="cursor-pointer text-indigo-600 hover:text-indigo-800 hover:underline font-bold transition-colors flex items-center gap-1.5 min-w-0 overflow-hidden" @onclick="() => ShowStyleDetails(context.StyleNo)">
                                <i class="fa-solid fa-circle-info text-[10px] opacity-50 shrink-0"></i>
                                <span class="truncate" title="@context.StyleNo">@context.StyleNo</span>
                            </div>
                        </TemplateColumn>
                        <PropertyColumn Property="@(x => x.ProductName)" Title="Product Name" Class="col-product text-slate-700" />
                        <PropertyColumn Property="@(x => x.Color)" Title="Color" Class="col-color text-slate-700" />
                        <PropertyColumn Property="@(x => x.Guage)" Title="Guage" Class="col-guage text-slate-600" />
                        <PropertyColumn Property="@(x => x.Ply)" Title="Ply" Class="col-ply text-slate-600" />
                        <TemplateColumn Title="Yarn" Class="col-yarn text-slate-600 text-xs">
                            <div class="truncate text-[10px]" title="@context.Yarn">@context.Yarn</div>
                        </TemplateColumn>

                        @foreach (var size in sizeHeaders)
                        {
                            <TemplateColumn Title="@size" Align="Align.Center" Class="col-size">
                                @{ var count = context.Sizes.TryGetValue(size, out var val) ? val : 0; }
                                <span class="@(count > 0 ? "text-slate-900 font-bold" : "text-transparent")">@(count > 0 ? count.ToString() : "")</span>
                            </TemplateColumn>
                        }

                        <PropertyColumn Property="@(x => x.Qty)" Title="Qty" Align="Align.Center" Class="col-pieces font-bold text-slate-900 bg-slate-50/30" />
                        <PropertyColumn Property="@(x => x.KnSl)" Title="Kn/Sl" Class="col-knsl text-slate-600" />
                        <PropertyColumn Property="@(x => x.DaysRequired)" Title="Days Req" Align="Align.Center" Class="col-daysreq font-semibold text-indigo-600" />
                    </QuickGrid>
                </div>

                <div class="footer-container shrink-0">
                    <table class="grand-total-table w-full">
                        <tr>
                            <td colspan="6" class="footer-label font-black text-right pr-4 uppercase tracking-widest text-[#002d54]">Grand Totals</td>
                            @foreach (var size in sizeHeaders)
                            {
                                <td class="footer-val-size col-size text-center">@SelectedOrderDetails.Sum(x => x.Sizes.TryGetValue(size, out var val) ? val : 0)</td>
                            }
                            <td class="footer-val-total col-pieces text-center font-black text-slate-900 bg-slate-100">@totalPieces</td>
                            <td class="col-knsl"></td>
                            <td class="col-daysreq"></td>
                        </tr>
                    </table>
                </div>
            </div>
        }
    </div>
</DataModal>

<!-- PRICE ANALYSIS POPUP (HOISTED FOR SEPARATION) -->
<DataModal @bind-IsVisible="IsAnalysisPopupVisible" 
           Title="@($"Order Price Analysis - {SelectedOrderNo}")"
           BadgeText="@($"Rate: {UsdRate:N2}")"
           IsLoading="IsLoadingAnalysis"
           FullScreen="false" MaxWidth="85vw"
           ZIndex="2500"
           class="analysis-modal">
    <HeaderExtra>
        <div class="flex items-center gap-2 bg-indigo-50/50 px-3 py-1.5 rounded-full border border-indigo-100 shadow-sm ml-4">
            <span class="text-[10px] font-black text-indigo-400 uppercase tracking-widest">USD Rate</span>
            <input type="number" 
                   @bind="UsdRate" 
                   class="w-20 h-5 text-sm font-black text-indigo-600 bg-transparent border-none focus:ring-0 p-0 text-center" 
                   step="0.01" />
            <button @onclick="() => ShowOrderAnalysis(SelectedOrderNo)" 
                    class="ml-1 text-indigo-500 hover:text-indigo-700 transition-colors p-1"
                    title="Recalculate with new rate">
                <i class="fa-solid fa-arrows-rotate text-xs"></i>
            </button>
            @if (IsAnalysisUnmasked)
            {
                <button @onclick="() => IsAnalysisUnmasked = false" 
                        class="ml-1 text-slate-400 hover:text-rose-500 transition-colors p-1 border-l border-indigo-100 pl-2"
                        title="Lock pricing data">
                    <i class="fa-solid fa-lock-open text-xs"></i>
                </button>
            }
        </div>
    </HeaderExtra>
    <ChildContent>
        @if (IsAnalysisPopupVisible)
        {
            <div class="flex-1 w-full relative min-h-[500px] bg-white" style="height: calc(90vh - 120px);">
                <!-- Absolute inner container maps to padding to sever the flex-stretch bug entirely -->
                <div class="absolute inset-2 sm:inset-4 flex flex-col overflow-hidden">
                
                    @if (IsLoadingAnalysis)
                    {
                        <div class="space-y-4 flex-1 flex flex-col justify-center">
                            <Skeleton Type="Skeleton.SkeletonType.Table" Rows="12" Columns="8" />
                        </div>
                    }
                    else if (AnalysisItems != null && AnalysisItems.Any())
                    {
                        <div class="bg-white rounded-none shadow-sm border border-slate-200 quick-grid-container flex-1 flex flex-col overflow-hidden min-h-0">

                        <div class="flex-1 min-h-0 overflow-y-auto">
                            <QuickGrid Items="@AnalysisItems.AsQueryable()" class="quick-grid w-full">
                                <PropertyColumn Property="@(x => x.SN)" Title="S.N" Class="col-sn-an" />
                                <TemplateColumn Title="Style" Sortable="true" Class="col-style-an font-black text-slate-800">
                                    <div class="truncate" title="@context.ProductName">@context.ProductName</div>
                                </TemplateColumn>
                                <PropertyColumn Property="@(x => x.TotalQuantity)" Title="Qty" Sortable="true" Align="Align.Center" Format="N0" Class="col-qty-an" />
                                <PropertyColumn Property="@(x => x.StyleGuage)" Title="Guage" Class="col-guage-an" />
                                <PropertyColumn Property="@(x => x.StylePly)" Title="Ply" Class="col-ply-an" />
                                <TemplateColumn Title="Yarn" Class="col-yarn-an">
                                    <div class="truncate text-[10px]" title="@context.YarnInfo">@context.YarnInfo</div>
                                </TemplateColumn>
                                <PropertyColumn Property="@(x => x.NetWet)" Title="Weight" Sortable="true" Align="Align.Right" Format="N2" Class="col-wt-an text-right" />
                                
                                <PropertyColumn Property="@(x => x.OverratePerPcUsd)" Title="Overhead" Sortable="true" Align="Align.Right" Format="C2" Class="@($"col-overhead-an text-right text-amber-600 font-bold transition-all duration-500 {(IsAnalysisUnmasked ? "" : "blur-[6px] select-none opacity-50")}")" />
                                <PropertyColumn Property="@(x => x.FinalCostPerPcUsd)" Title="Prod.Cost" Sortable="true" Align="Align.Right" Format="C2" Class="@($"col-prod-cost-an text-right text-blue-600 font-bold transition-all duration-500 {(IsAnalysisUnmasked ? "" : "blur-[6px] select-none opacity-50")}")" />
                                
                                <PropertyColumn Property="@(x => x.GrandTotalProductionCostUsd)" Title="Total Cost" Sortable="true" Align="Align.Right" Format="C2" Class="@($"col-total-cost-an text-right bg-slate-50 font-black text-rose-600 transition-all duration-500 {(IsAnalysisUnmasked ? "" : "blur-[6px] select-none opacity-50")}")" />
                                <PropertyColumn Property="@(x => x.TotalRevenueUsd)" Title="S.Price" Sortable="true" Align="Align.Right" Format="C2" Class="@($"col-s-price-an text-right bg-emerald-50 font-black text-emerald-600 transition-all duration-500 {(IsAnalysisUnmasked ? "" : "blur-[6px] select-none opacity-50")}")" />
                                
                                <TemplateColumn Title="Gross Profit" Align="Align.Right" Class="@($"col-profit-an text-right font-black transition-all duration-500")">
                                    @{
                                        var profit = context.TotalRevenueUsd - context.GrandTotalProductionCostUsd;
                                    }
                                    <span class="@(profit >= 0 ? "text-emerald-600" : "text-rose-600") @(IsAnalysisUnmasked ? "" : "blur-[6px] select-none opacity-50") transition-all duration-500">
                                        @profit.ToString("C2")
                                    </span>
                                </TemplateColumn>
                            </QuickGrid>
                        </div>

                        <div class="footer-container shrink-0 relative @(IsAnalysisUnmasked ? "" : "pointer-events-none") z-10">
                            @if (!IsAnalysisUnmasked) { <div class="absolute inset-0 bg-slate-100/50 backdrop-blur-[1px] z-20 flex items-center justify-center"></div> }
                            <table class="grand-total-table w-full">
                                <tr class="transition-all duration-500">
                                    <td colspan="2" class="footer-label font-black text-right pr-4 uppercase tracking-widest text-[#002d54]">
                                        Total
                                    </td>
                                    <td class="footer-val col-qty-an text-center font-bold text-indigo-700">
                                        @AnalysisItems.Sum(x => x.TotalQuantity).ToString("N0")
                                    </td>
                                    <td colspan="3"></td>
                                    <td class="footer-val col-wt-an text-right font-bold text-slate-600">
                                        @AnalysisItems.Sum(x => x.NetWet).ToString("N2")
                                    </td>
                                    <td class="col-overhead-an"></td>
                                    <td class="footer-val col-prod-cost-an font-bold text-blue-600 @(IsAnalysisUnmasked ? "" : "blur-[6px] opacity-10")">
                                        @AnalysisItems.Sum(x => x.FinalCostPerPcUsd).ToString("C2")
                                    </td>
                                    <td class="footer-val col-total-cost-an font-black text-rose-600 bg-rose-50/30 @(IsAnalysisUnmasked ? "" : "blur-[6px] opacity-10")">
                                        @AnalysisItems.Sum(x => x.GrandTotalProductionCostUsd).ToString("C2")
                                    </td>
                                    <td class="footer-val col-s-price-an font-black text-emerald-600 bg-emerald-50/30 @(IsAnalysisUnmasked ? "" : "blur-[6px] opacity-10")">
                                        @AnalysisItems.Sum(x => x.TotalRevenueUsd).ToString("C2")
                                    </td>
                                    @{
                                        var totalProfit = AnalysisItems.Sum(x => x.TotalRevenueUsd) - AnalysisItems.Sum(x => x.GrandTotalProductionCostUsd);
                                    }
                                    <td class="footer-val col-profit-an font-black @(totalProfit >= 0 ? "text-emerald-600" : "text-rose-600") bg-slate-50 @(IsAnalysisUnmasked ? "" : "blur-[6px] opacity-10")">
                                        @totalProfit.ToString("C2")
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                    }
                </div>
                
                </div> <!-- END OF INSET CONTENT -->

                <!-- PIN OVERLAY (On top of everything, contained to modal bounds strictly) -->
                @if (!IsAnalysisUnmasked && AnalysisItems != null && AnalysisItems.Any() && !IsLoadingAnalysis)
                {
                    <div class="absolute inset-0 z-[100] bg-white/40 backdrop-blur-md pointer-events-auto"></div>
                    <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 z-[200] bg-white p-8 rounded-none shadow-2xl border border-slate-200 flex flex-col items-center gap-4 max-w-sm w-full">
                        <div class="w-16 h-16 bg-indigo-50 rounded-full flex items-center justify-center mb-2">
                            <i class="fa-solid fa-shield-halved text-2xl text-indigo-500"></i>
                        </div>
                        <div class="text-center">
                            <h3 class="text-lg font-black text-slate-900 leading-tight">Secure Access</h3>
                            <p class="text-xs text-slate-400 font-bold uppercase tracking-widest mt-1">PIN Required for Pricing</p>
                        </div>
                        <div class="w-full mt-2">
                            <input type="password" 
                                    @bind="AnalysisPinInput" 
                                    @bind:event="oninput"
                                    @onkeydown='@(e => { if (e.Key == "Enter") VerifyAnalysisPin(); })'
                                    placeholder="••••" 
                                    class="w-full h-12 text-[#222222] text-center text-xl font-black tracking-[1rem] border-2 border-slate-200 focus:border-indigo-500 rounded-none focus:ring-0 transition-all uppercase placeholder:tracking-normal placeholder:text-sm placeholder:font-bold" 
                                    maxlength="4" />
                            @if (!string.IsNullOrEmpty(AnalysisPinError))
                            {
                                <p class="text-[10px] text-rose-500 font-bold mt-2 text-center">@AnalysisPinError</p>
                            }
                        </div>
                        <button @onclick="VerifyAnalysisPin" class="w-full h-12 bg-slate-900 hover:bg-indigo-600 text-white font-black text-sm uppercase tracking-widest transition-all rounded-none shadow-lg">
                            Unlock Data
                        </button>
                        <p class="text-[9px] text-slate-300 uppercase font-black mt-2">Confidential Information</p>
                    </div>
                }
            </div>
        }

    </ChildContent>
</DataModal>

