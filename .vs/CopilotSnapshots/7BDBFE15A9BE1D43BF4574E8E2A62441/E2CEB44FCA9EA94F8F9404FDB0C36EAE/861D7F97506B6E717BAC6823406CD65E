</style>


@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private LoginRequest loginModel = new();
    private bool isSubmitting;
    private bool showMfa;
    private bool isRedirecting;
    private string mfaCode = "";

    protected override async Task OnInitializedAsync()
    {
        if (AuthState != null)
        {
            var state = await AuthState;
            if (state.User.Identity?.IsAuthenticated == true)
            {
                NavigationManager.NavigateTo("/main-dashboard", replace: true);
            }
        }
    }

    private async Task HandleLogin()
    {
        isSubmitting = true;

        try
        {
            var result = await AuthService.Login(loginModel);
            if (result.IsSuccess)
            {
                if (result.RequiresMfa)
                {
                    showMfa = true;
                }
                else
                {
                    isRedirecting = true;
                    ToastService.ShowSuccess("Welcome back! Login successful.");
                    await Task.Delay(500);
                    await JSRuntime.InvokeVoidAsync("submitToken", result.Token);
                }
            }
            else
            {
                ToastService.ShowError(result.Message ?? "Login failed");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Login error: {ex.Message}");
        }
        finally
        {
            if (!isRedirecting)
            {
                isSubmitting = false;
            }
        }
    }

    private async Task HandleMfa()
    {
        isSubmitting = true;

        try
        {
            var result = await AuthService.VerifyMfa(new MfaVerifyRequest
            {
                Email = loginModel.Email,
                Code = mfaCode
            });

            if (result.IsSuccess)
            {
                isRedirecting = true;
                ToastService.ShowSuccess("Verification successful.");
                await Task.Delay(500);
                await JSRuntime.InvokeVoidAsync("submitToken", result.Token);
            }
            else
            {
                ToastService.ShowError(result.Message ?? "MFA verification failed");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"MFA error: {ex.Message}");
        }
        finally
        {
            if (!isRedirecting)
            {
                isSubmitting = false;
            }
        }
    }

    private async Task HandleBiometricLogin()
    {
        isSubmitting = true;

        try
        {
            var emailToUse = string.IsNullOrWhiteSpace(loginModel.Email) ? null : loginModel.Email.Trim();
            var result = await AuthService.LoginBiometric(emailToUse);
            if (result.IsSuccess)
            {
                isRedirecting = true;
                ToastService.ShowSuccess("Biometric login successful.");
                await Task.Delay(500);
                await JSRuntime.InvokeVoidAsync("submitToken", result.Token);
            }
            else
            {
                var msg = result.Message ?? "Biometric login failed";
                if (msg.Contains("not found") || msg.Contains("credential"))
                {
                    msg = "Biometric device not recognized. Please register it in your Profile settings first.";
                }
                ToastService.ShowError(msg);
            }
        }
        catch (Exception ex)
        {
            var msg = ex.Message;
            if (msg.Contains("NotAllowedError") || msg.Contains("Assertion retrieval failed"))
            {
                msg = "Biometric check was cancelled or timed out. Please try again.";
            }
            else if (msg.Contains("not recognized"))
            {
               msg = "FaceID/Fingerprint not recognized. Please register in Profile first.";
            }
            ToastService.ShowError(msg);
        }
        finally
        {
            if (!isRedirecting)
            {
                isSubmitting = false;
            }
        }
    }

    private async Task ClearSession()
    {
        await AuthService.Logout();
        ToastService.ShowInfo("Session cleared. Please login again.");
    }
}
