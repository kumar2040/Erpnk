@using NkplmErp.Shared.DTOs
@using NkplmErp.Blazor.Components
@using Microsoft.AspNetCore.Components.QuickGrid

@if (Items != null && Items.Any() && !string.IsNullOrEmpty(Items.First().Message))
{
    <div class="py-16 text-center">
        <div class="bg-blue-50 w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-4 border border-blue-100">
            <i class="fa-solid fa-circle-info text-3xl text-blue-400"></i>
        </div>
        <h4 class="text-lg font-black text-slate-900 mb-1">System Message</h4>
        <p class="text-sm font-bold text-slate-400 px-8">@Items.First().Message</p>
    </div>
}
else if (Items == null || !Items.Any())
{
    <div class="py-16 text-center text-gray-400">
        <i class="fa-solid fa-box-open text-4xl mb-3 block opacity-20"></i>
        <p class="text-sm font-medium">No production flow data found.</p>
    </div>
}
else
{
    @foreach (var order in Items)
    {
        var progressPct = (order.totalDispatched ?? 0) * 100 / (order.PCS > 0 ? order.PCS.Value : 1);
        
        <div class="relative max-w-7xl mx-auto bg-white rounded-none shadow-lg mb-2 lg:mb-0 overflow-hidden" style="padding: 0px;">
            <!-- FOCUSED ORDER INFO CARD (Native App Header Style) -->
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 py-2 px-4 mb-6 bg-slate-50 border-b border-slate-200 relative z-10 shadow-sm">
                <!-- Left: Order Identity -->
                @{ var currentOrderNo = order.OrderNo ?? string.Empty; }
                <div class="flex items-center gap-3 cursor-pointer group/order transition-colors hover:text-indigo-600 shrink-0" 
                     @onclick="() => ShowOrderDetails(currentOrderNo)">
                    <div class="flex items-center gap-2">
                        <div class="bg-indigo-600 p-1.5 rounded-none shadow-sm group-hover/order:bg-indigo-700 transition-colors">
                            <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                            </svg>
                        </div>
                        <button class="bg-amber-50 hover:bg-amber-100 text-amber-700 p-1.5 rounded-full transition-all duration-200 shadow-sm border border-amber-200 group/stat" 
                                @onclick:stopPropagation="true"
                                @onclick="() => ShowOrderAnalysis(currentOrderNo)"
                                title="Price Analysis">
                            <svg class="w-4 h-4 group-hover/stat:scale-110 transition-transform" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <rect x="8" y="36" width="8" height="20" rx="1" fill="#FF9800" />
                                <rect x="22" y="44" width="8" height="12" rx="1" fill="#F44336" />
                                <rect x="36" y="28" width="8" height="28" rx="1" fill="#00BCD4" />
                                <rect x="50" y="38" width="8" height="18" rx="1" fill="#2196F3" />
                                <path d="M12 32L26 24L40 32L54 12" stroke="#374151" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
                                <circle cx="48" cy="40" r="12" fill="white" stroke="#374151" stroke-width="3" />
                                <circle cx="48" cy="40" r="8" fill="#BAE6FD" />
                                <path d="M56 48L62 54" stroke="#374151" stroke-width="4" stroke-linecap="round" />
                            </svg>
                        </button>
                    </div>
                    <div>
                        <span class="text-[9px] font-bold text-indigo-400 uppercase tracking-widest block leading-none mb-0.5 group-hover/order:text-indigo-500">Order No</span>
                        <h3 class="text-[14px] font-black text-slate-900 leading-none group-hover/order:text-indigo-700">@order.OrderNo</h3>
                    </div>
                </div>

                <!-- Center: Order Metadata (Compact & Impactful) -->
                <div class="flex flex-1 flex-wrap lg:flex-nowrap items-center justify-start md:justify-center gap-x-6 gap-y-2 px-2 md:px-4 lg:gap-x-8">
                    <!-- Dates Group -->
                    <div class="flex items-center gap-4 text-slate-400 bg-slate-50/50 px-3 py-1.5 border border-slate-100 rounded-sm">
                        <div class="flex flex-col">
                            <span class="text-[8px] font-bold uppercase tracking-wider mb-0.5">Entry</span>
                            <span class="text-[11px] font-black text-slate-700 leading-none">@(order.OrderEntryStart?.ToString("dd MMM, yy") ?? "-")</span>
                        </div>
                        <div class="w-px h-6 bg-slate-200"></div>
                        <div class="flex flex-col">
                            <span class="text-[8px] font-bold uppercase tracking-wider mb-0.5">ID Date</span>
                            <span class="text-[11px] font-black text-slate-700 leading-none">@(order.IDDate?.ToString("dd MMM, yy") ?? "-")</span>
                        </div>
                         <div class="w-px h-6 bg-slate-200"></div>
                        <div class="flex flex-col">
                            <span class="text-[8px] font-bold uppercase tracking-wider mb-0.5">Shipping</span>
                            <span class="text-[11px] font-black text-rose-500 leading-none">@(order.ShippingDate?.ToString("dd MMM, yy") ?? "-")</span>
                        </div>
                    </div>

                    <!-- Metrics Group -->
                    <div class="flex items-center gap-2">
                         <div class="flex items-center gap-2 bg-slate-900 text-white px-3 py-1.5 shadow-md">
                            <span class="text-[9px] font-black uppercase text-slate-400">Qty</span>
                            <span class="text-[14px] font-black">@order.PCS</span>
                        </div>

                        <div class="flex flex-col items-center bg-white border border-slate-200 px-3 py-1 min-w-[50px]">
                            <span class="text-[8px] font-bold text-slate-400 uppercase">Days</span>
                            <span class="text-[12px] font-black text-slate-800 leading-none">@order.ProductionDays</span>
                        </div>

                        @{
                            var daysLeft = DaysLeft(order);
                            var isUrgent = IsUrgent(daysLeft);
                            var urgencyClass = isUrgent ? "bg-rose-600 text-white shadow-rose-200" : "bg-emerald-500 text-white shadow-emerald-200";
                        }
                        <div class="flex items-center gap-2 @urgencyClass px-3 py-1.5 shadow-md">
                            <span class="text-[9px] font-black uppercase opacity-70">Left</span>
                            <span class="text-[14px] font-black">
                                @if (isUrgent && daysLeft.HasValue)
                                {
                                    <i class="fa-solid fa-fire-flame-curved mr-1 animate-pulse"></i>
                                }
                                @(daysLeft?.ToString() ?? "-")
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Right: Completion Progress -->
                <div class="pl-0 md:pl-6 md:border-l-2 border-slate-100 flex items-center gap-3 min-w-max">
                    <div class="flex flex-col items-end">
                        <span class="text-[10px] font-bold text-slate-400 uppercase leading-none mb-1.5">Dispatch</span>
                        <div class="flex items-baseline gap-1">
                            <span class="text-[18px] font-black text-emerald-600 leading-none">@progressPct</span>
                            <span class="text-[10px] font-bold text-emerald-500">%</span>
                        </div>
                    </div>
                    <div class="w-20 md:w-24">
                        <div class="w-full h-2 bg-slate-200 rounded-full overflow-hidden shadow-inner">
                            <div class="h-full bg-emerald-500 shadow-[0_0_8px_rgba(16,185,129,0.4)] transition-all duration-1000" style="width: @(progressPct)%"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TIMELINE AREA (Responsive Scroll Container) -->
            <div class="timeline-scroll-container custom-scrollbar lg:overflow-x-hidden">
                <div class="timeline-inner">
                    <svg viewBox="0 0 1300 400" preserveAspectRatio="none" class="absolute top-0 left-0 w-full h-full pointer-events-none z-0">
                        <defs>
                            <marker id="arrowhead-green" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orientation="auto">
                                <polygon points="0 0, 10 3.5, 0 7" fill="#22c55e" />
                            </marker>
                           <marker id="arrowhead-blue"
                                markerWidth="10"
                                markerHeight="7"
                                refX="9"
                                refY="3.5"
                                orient="auto-start-reverse">
                          <polygon points="0 0, 10 3.5, 0 7" fill="#3b82f6" />
                        </marker>
                            <marker id="arrowhead-cyan" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orientation="auto">
                                <polygon points="0 0, 10 3.5, 0 7" fill="#06b6d4" />
                            </marker>
                        </defs>

                        <!-- Line 1 Y = 50 (L to R: Order Qty -> DYE) -->
                        <path d="M160 50 H1120" stroke="#22c55e" stroke-width="3" fill="none" stroke-linecap="round" marker-end="url(#arrowhead-green)" />
                        
                        <!-- RIGHT CURVE (50 to 180) -->
                        <path d="M1120 50 A65 65 0 0 1 1185 115 A65 65 0 0 1 1120 180" stroke="#22c55e" stroke-width="3" fill="none" stroke-linecap="round" />

                        <!-- ROW 2 Line at Y=180 (R to L: Emborderery -> Hub) -->
                        <path d="M1120 180 H170" stroke="#22c55e" stroke-width="3" fill="none" stroke-linecap="round" marker-end="url(#arrowhead-blue)" />

                        <!-- LEFT CURVE (180 to 310) -->
                        <path d="M160 180 A65 65 0 0 0 95 245 A65 65 0 0 0 160 310" stroke="#06b6d4" stroke-width="3" fill="none" stroke-linecap="round" />

                        <!-- ROW 3 Line at Y=310 (L to R: Washing -> Dispatched) -->
                        <path d="M160 310 H1120" stroke="#22c55e" stroke-width="3" fill="none" stroke-linecap="round" marker-end="url(#arrowhead-green)" />
                    </svg>

                <!-- ROW 1 (L to R) -->
                <div class="grid grid-cols-6 absolute top-0 left-0 w-full z-10 px-[4.9%]" style="height: 100px;">
                    @foreach (var dept in new[] { 
                        new { Name = "Order Qty", Code = "ORD", Icon = "M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 014.515 8.25h14.97a1.125 1.125 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z", Color = "text-cyan-500", Count = (int?)(order.PCS ?? 0), Date = (DateOnly?)order.IDDate }, 
                        new { Name = "Not Started", Code = "NS", Icon = "M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z", Color = "text-slate-400", Count = (int?)(order.Ns ?? 0), Date = (DateOnly?)order.KNT_maxDate }, 
                        new { Name = "Knitter", Code = "KNT", Icon = "M9.53 16.122a3 3 0 00-5.78 1.128 2.25 2.25 0 01-2.4 2.245 4.5 4.5 0 008.4-2.245c0-.399-.078-.78-.22-1.128zm0 0a15.998 15.998 0 003.388-1.62m-5.043 9.02a.75.75 0 01-1.138-.9l.138-.41a3 3 0 00-5.78 1.128m11.382-4.102a.75.75 0 01-.138.41l-.138.41a3 3 0 005.78-1.128M15.998 14.502a15.998 15.998 0 01-3.388 1.62m3.388-1.62a3 3 0 01-4.102 4.102", Color = "text-indigo-500", Count = (int?)(order.Nr ?? 0), Date = (DateOnly?)order.KNT_maxDate }, 
                        new { Name = "Kacha Checking", Code = "CHK", Icon = "M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z", Color = "text-emerald-500", Count = (int?)(order.CHK ?? 0), Date = (DateOnly?)null }, 
                        new { Name = "Kacha", Code = "KCH", Icon = "M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V6.75zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z", Color = "text-amber-500", Count = (int?)(order.KCH ?? 0), Date = (DateOnly?)order.KCH_maxDate },                         new { Name = "Dye", Code = "DYE", Icon = "M9.75 3.104v1.244c0 .46.211.897.584 1.19.373.294.58.744.58 1.216 0 .47-.207.922-.58 1.215-.373.294-.584.73-.584 1.19v1.244m6 5.696V14.1c0 .46-.211.897-.584 1.19-.373.294-.58.744-.58 1.216 0 .47.207.922.58 1.215.373.294.584.73-.584 1.19v1.244M3 19.75h18M12 21V3", Color = "text-violet-500", Count = (int?)(order.DYE ?? 0), Date = (DateOnly?)order.DYE_maxDate }
                    })
                    {
                        bool isClickable = !new[] { "ORD" }.Contains(dept.Code);
                        <div class="flex flex-col h-full group relative">
                            <!-- Name Above -->
                            <div class="h-[28px] flex items-end justify-center pb-1">
                                <span class="txtblack  text-[11px] font-black text-slate-500 Capitalize tracking-tighter text-center @(isClickable ? "group-hover:text-indigo-600" : "")">@dept.Name</span>
                            </div>
                            <!-- Circle with Count and Icon -->
                            <div class="h-[45px] flex items-center justify-center relative">
                                <div class="bg-white rounded-full w-10 h-10 flex flex-col items-center justify-center shadow-md border-2 @((dept.Count ?? 0) > 0 ? "border-yellow-400 shadow-[0_0_10px_rgba(250,204,21,0.2)]" : "border-slate-600") transition-all duration-300 z-20 @(isClickable ? "cursor-pointer hover:border-indigo-400 hover:scale-110" : "")" 
                                     @onclick="async () => { if (isClickable) await ShowDepartmentDetails(order.OrderNo ?? string.Empty, dept.Code, dept.Name); }">
                                    <svg class="w-4 h-4 @dept.Color mb-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="@dept.Icon" />
                                    </svg>
                                    <span class="text-[11px] font-black text-slate-900 leading-none">@((dept.Count ?? 0) > 0 ? (dept.Count ?? 0).ToString() : "")</span>
                                </div>
                            </div>
                            <!-- Date Below -->
                            <div class="h-[24px] flex items-start justify-center pt-1">
                                @if (dept.Date.HasValue) { <span class="text-[8px] font-black text-slate-400">@dept.Date.Value.ToString("dd MMM")</span> }
                            </div>
                        </div>
                    }
                </div>

                <!-- ROW 2 (R to L) -->
                <div class="grid grid-cols-6 absolute left-0 w-full z-10 px-[4.9%]" style="top: 130px; height: 100px;">
                    @foreach (var dept in (new[] { 
                        new { Name = "Hub", Code = "HUB", Icon = "M3 7.5L7.5 3m0 0L12 7.5M7.5 3v13.5m9-6.75L21 21m0 0l-4.5-4.5M21 21h-13.5", Color = "text-cyan-400", Count = (int?)(order.HUB ?? 0), Date = (DateOnly?)order.HUB_maxDate },
                        new { Name = "Printing", Code = "PRND", Icon = "M6.75 12a.75.75 0 11-1.5 0 .75.75 0 011.5 0zM12.75 12a.75.75 0 11-1.5 0 .75.75 0 011.5 0zM18.75 12a.75.75 0 11-1.5 0 .75.75 0 011.5 0z", Color = "text-green-500", Count = (int?)(order.PRND ?? 0), Date = (DateOnly?)order.PRN_maxDate }, 
                        new { Name = "Linking", Code = "LNK", Icon = "M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244", Color = "text-cyan-500", Count = (int?)(order.LNK ?? 0), Date = (DateOnly?)order.LNK_maxDate }, 
                        new { Name = "Tailoring", Code = "TLR", Icon = "M7.875 14.25l1.214 1.942a2.25 2.25 0 001.908 1.058h2.004c.776 0 1.497-.4 1.908-1.058l1.214-1.942M2.41 9h4.636a2.25 2.25 0 011.872 1.002l.164.246a2.25 2.25 0 001.872 1.002h2.092a2.25 2.25 0 001.872-1.002l.164-.246A2.25 2.25 0 0116.954 9h4.636M2.41 9a2.25 2.25 0 00-.16.832V12a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 12V9.832c0-.287-.055-.57-.16-.832M2.41 9a2.25 2.25 0 01.382-.632l4.47-4.47a2.25 2.25 0 011.59-.658h6.294c.597 0 1.17.237 1.59.658l4.47 4.47c.145.145.273.307.382.482M18.75 12a1.125 1.125 0 11-2.25 0 1.125 1.125 0 012.25 0zm-11.25 0a1.125 1.125 0 11-2.25 0 1.125 1.125 0 012.25 0z", Color = "text-indigo-500", Count = (int?)(order.TLR ?? 0), Date = (DateOnly?)order.ShippingDate }, 
                        new { Name = "Mending", Code = "MND", Icon = "M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10", Color = "text-emerald-500", Count = (int?)(order.MND ?? 0), Date = (DateOnly?)order.MND_maxDate }, 
                        new { Name = "Emborderery", Code = "EMB", Icon = "M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.722L17.25 12l-1.009-3.278L13 7.712l3.241-.988L17.25 3.5l1.009 3.224 3.241.988-3.241.988z", Color = "text-emerald-400", Count = (int?)(order.EMB ?? 0), Date = (DateOnly?)null }
                    }).Reverse())
                    {
                        <div class="flex flex-col h-full group relative">
                            <!-- Name Above -->
                            <div class="h-[28px] flex items-end justify-center pb-1">
                                <span class="txtblack  text-[11px] font-black text-slate-500 Capitalize tracking-tighter text-center group-hover:text-indigo-600">@dept.Name</span>
                            </div>
                            <!-- Circle with Count and Icon -->
                            <div class="h-[45px] flex items-center justify-center relative">
                                <div class="bg-white rounded-full w-10 h-10 flex flex-col items-center justify-center shadow-md border-2 @((dept.Count ?? 0) > 0 ? "border-yellow-400 shadow-[0_0_10px_rgba(250,204,21,0.2)]" : "border-slate-600") transition-all duration-300 z-20 cursor-pointer hover:border-indigo-400 hover:scale-110" 
                                     @onclick="() => ShowDepartmentDetails(order.OrderNo ?? string.Empty, dept.Code, dept.Name)">
                                    <svg class="w-4 h-4 @dept.Color mb-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="@dept.Icon" />
                                    </svg>
                                    <span class="text-[11px] font-black text-slate-900 leading-none">@((dept.Count ?? 0) > 0 ? (dept.Count ?? 0).ToString() : "")</span>
                                </div>
                            </div>
                            <!-- Date Below -->
                            <div class="h-[24px] flex items-start justify-center pt-1">
                                @if (dept.Date.HasValue) { <span class="text-[8px] font-black text-slate-400">@dept.Date.Value.ToString("dd MMM")</span> }
                            </div>
                        </div>
                    }
                </div>

                <!-- ROW 3 (L to R) -->
                <div class="grid grid-cols-6 absolute left-0 w-full z-10 px-[4.9%]" style="top: 260px; height: 100px;">
                    @foreach (var dept in new[] { 
                        new { Name = "Washing", Code = "WSH", Icon = "M20.25 6.375c0 1.035-.84 1.875-1.875 1.875s-1.875-.84-1.875-1.875.84-1.875 1.875-1.875 1.875.84 1.875 1.875zM6.75 11.25a3.375 3.375 0 100-6.75 3.375 3.375 0 000 6.75zM12 18.75a3.375 3.375 0 100-6.75 3.375 3.375 0 000 6.75zM18.75 18.75a3.375 3.375 0 100-6.75 3.375 3.375 0 000 6.75z", Color = "text-green-400", Count = (int?)(order.WSH ?? 0), Date = (DateOnly?)order.WSH_maxDate }, 
                        new { Name = "PRESS", Code = "PRS", Icon = "M15.362 5.214A8.252 8.252 0 0112 21 8.25 8.25 0 016.038 7.048 8.287 8.287 0 009 9.6a8.983 8.983 0 013.361-6.867 8.21 8.21 0 003 2.48z", Color = "text-green-600", Count = (int?)(order.PRS ?? 0), Date = (DateOnly?)order.PRS_maxDate }, 
                        new { Name = "Packing", Code = "PCK", Icon = "M21 11.25v8.25a1.5 1.5 0 01-1.5 1.5H5.25a1.5 1.5 0 01-1.5-1.5v-8.25M12 4.875A2.625 2.625 0 109.375 7.5H12m0-2.625A2.625 2.625 0 1114.625 7.5H12m0 0V21m-8.625-13.5h17.25c.621 0 1.125.504 1.125 1.125v1.5c0 .621-.504 1.125-1.125-1.125H3.375c-.621 0-1.125-.504-1.125-1.125v-1.5c0-.621.504-1.125 1.125-1.125z", Color = "text-cyan-500", Count = (int?)(order.PCK ?? 0), Date = (DateOnly?)order.PCK_maxDate }, 
                        new { Name = "Dispatch Warehouse", Code = "DSP", Icon = "M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12v18H3V3z", Color = "text-cyan-400", Count = (int?)(order.Total_Dispatch ?? 0), Date = (DateOnly?)order.DSP_maxDate }, 
                        new { Name = "Boxed", Code = "BOX", Icon = "M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z", Color = "text-green-500", Count = (int?)(order.totalPacked ?? 0), Date = (DateOnly?)null }, 
                        new { Name = "Dispatched", Code = "SHP", Icon = "M8.25 18.75a1.5 1.5 0 01-3 0 1.5 1.5 0 013 0zM19.5 18.75a1.5 1.5 0 01-3 0 1.5 1.5 0 013 0z M3.375 14.25h17.25M3.375 5.25h13.125v10.5H3.375V5.25zm16.5 4.5h2.625l2.625 4.5v3h-5.25V9.75z", Color = "text-green-400", Count = (int?)(order.totalDispatched ?? 0), Date = (DateOnly?)order.SHP_maxDate } 
                    })
                    {
                        <div class="flex flex-col h-full group relative">
                            <!-- Name Above -->
                            <div class="h-[28px] flex items-end justify-center pb-1">
                                <span class="txtblack  text-[11px] font-black text-slate-500 Capitalize tracking-tighter text-center group-hover:text-indigo-600">@dept.Name</span>
                            </div>
                            <!-- Circle with Count and Icon -->
                            <div class="h-[45px] flex items-center justify-center relative">
                                <div class="bg-white rounded-full w-10 h-10 flex flex-col items-center justify-center shadow-md border-2 @((dept.Count ?? 0) > 0 ? "border-yellow-400 shadow-[0_0_10px_rgba(250,204,21,0.2)]" : "border-slate-600") transition-all duration-300 z-20 cursor-pointer hover:border-indigo-400 hover:scale-110" 
                                     @onclick="() => ShowDepartmentDetails(order.OrderNo ?? string.Empty, dept.Code, dept.Name)">
                                    <svg class="w-4 h-4 @dept.Color mb-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="@dept.Icon" />
                                    </svg>
                                    <span class="text-[11px] font-black text-slate-900 leading-none">@((dept.Count ?? 0) > 0 ? (dept.Count ?? 0).ToString() : "")</span>
                                </div>
                            </div>
                            <!-- Date Below -->
                            <div class="h-[24px] flex items-start justify-center pt-1">
                                @if (dept.Date.HasValue) { <span class="text-[8px] font-black text-slate-400">@dept.Date.Value.ToString("dd MMM")</span> }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

            <div style="height: 4px;"></div>
    }
}



<!-- DEPARTMENT STOCK POPUP -->
<DataModal @bind-IsVisible="IsStockPopupVisible" 
           Title="@($"{SelectedDeptName} Stock - {SelectedOrderNo}")"
           IsLoading="false"
           MaxWidth="800px"
           ZIndex="2500">
    <div class="h-full flex flex-col overflow-hidden">
        <!-- Tab Navigation -->
        <div class="flex items-center gap-1 mb-4 border-b border-slate-200">
            <button class="px-4 py-2 text-xs font-black uppercase tracking-wider transition-all relative @(ActiveStockTab == "Stock" ? "text-indigo-600" : "text-slate-400 hover:text-slate-600")"
                    @onclick='() => SetActiveTab("Stock")'>
                @SelectedOrderNo Stock
                @if (ActiveStockTab == "Stock")
                {
                    <div class="absolute bottom-0 left-0 w-full h-0.5 bg-indigo-600 animate-in slide-in-from-left duration-300"></div>
                }
            </button>
            <button class="px-4 py-2 text-xs font-black uppercase tracking-wider transition-all relative @(ActiveStockTab == "Details" ? "text-indigo-600" : "text-slate-400 hover:text-slate-600")"
                    @onclick='() => SetActiveTab("Details")'>
                @SelectedDeptName Stock
                @if (ActiveStockTab == "Details")
                {
                    <div class="absolute bottom-0 left-0 w-full h-0.5 bg-indigo-600 animate-in slide-in-from-left duration-300"></div>
                }
            </button>
        </div>

        @if (IsLoadingStock)
        {
            <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-4 mt-2">
                <Skeleton Type="Skeleton.SkeletonType.Table" Rows="5" Columns="8" />
            </div>
        }
        else if (ActiveStockTab == "Stock")
        {
            @if (StockItems != null && StockItems.Any())
            {
                var firstItem = StockItems.First();
                var grandTotal = StockItems.Sum(x => x.Sizes.Values.Sum());
                
                @if (!string.IsNullOrEmpty(firstItem.Message))
                {
                    <div class="py-16 text-center">
                        <div class="bg-blue-50 w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-4 border border-blue-100">
                            <i class="fa-solid fa-circle-info text-3xl text-blue-400"></i>
                        </div>
                        <h4 class="text-lg font-black text-slate-900 mb-1">System Message</h4>
                        <p class="text-sm font-bold text-slate-400 px-8">@firstItem.Message</p>
                    </div>
                }
                else if (grandTotal > 0)
                {
                    <div class="bg-white rounded-none shadow-sm border border-slate-200 quick-grid-container flex flex-col stock-popup-grid">
                        <div class="flex-1 min-h-0 overflow-y-auto">
                            <QuickGrid Items="@StockItems.AsQueryable()" class="quick-grid w-full">
                                <TemplateColumn Title="Style" SortBy="@(GridSort<DepartmentStockDto>.ByAscending(x => x.StyleNo))" Class="col-style">
                                    <div class="cursor-pointer text-indigo-600 hover:text-indigo-800 hover:underline font-bold transition-colors flex items-center gap-1.5" @onclick="() => ShowStyleDetails(context.StyleNo)">
                                        <i class="fa-solid fa-circle-info text-[10px] opacity-50"></i>
                                        @context.StyleNo
                                    </div>
                                </TemplateColumn>
                                <PropertyColumn Property="@(x => x.Color)" Title="Color" Sortable="true" Class="col-color" />

                                @foreach (var size in SizeHeaderColumns)
                                {
                                    <TemplateColumn Title="@size" Align="Align.Center" Class="col-size">
                                        @{
                                            var count = context.Sizes.TryGetValue(size, out var val) ? val : 0;
                                        }
                                        <span class="@(count > 0 ? "text-indigo-600 font-bold" : "text-slate-300")">
                                            @(count > 0 ? count.ToString() : "-")
                                        </span>
                                    </TemplateColumn>
                                }

                                <TemplateColumn Align="Align.Right" Class="bg-slate-50/50 font-bold col-total">
                                    <HeaderTemplate>
                                        <div class="w-full">Total</div>
                                    </HeaderTemplate>
                                    <ChildContent>
                                        <div class="w-full">@context.Sizes.Values.Sum()</div>
                                    </ChildContent>
                                </TemplateColumn>
                            </QuickGrid>

                            <!-- Sticky Grand Total Footer (Stock Tab) - Moved inside for alignment -->
                            <div class="footer-container shrink-0">
                                <table class="grand-total-table">
                                    <tr>
                                        <td class="footer-label col-style">Total for @SelectedOrderNo</td>
                                        <td class="col-color footer-label"></td>
                                        @foreach (var size in SizeHeaderColumns)
                                        {
                                            var colTotal = StockItems.Sum(x => x.Sizes.ContainsKey(size) ? x.Sizes[size] : 0);
                                            <td class="footer-val-size col-size">@colTotal</td>
                                        }
                                        <td class="footer-val-total col-total">@grandTotal</td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="py-16 text-center">
                    <div class="bg-slate-50 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-3">
                        <i class="fa-solid fa-layer-group text-2xl text-slate-300"></i>
                    </div>
                    <h4 class="text-base font-bold text-slate-900 mb-1">No Data Available</h4>
                    <p class="text-xs text-slate-400">There is currently no stock listed for this order in this department.</p>
                </div>
            }
        }
        else if (ActiveStockTab == "Details")
        {
            @if (DetailsItems != null && DetailsItems.Any())
            {
                var firstDetail = DetailsItems.First();
                var detailTotal = DetailsItems.Sum(x => x.Sizes.Values.Sum());

                @if (!string.IsNullOrEmpty(firstDetail.Message))
                {
                    <div class="py-16 text-center">
                        <div class="bg-blue-50 w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-4 border border-blue-100">
                            <i class="fa-solid fa-circle-info text-3xl text-blue-400"></i>
                        </div>
                        <h4 class="text-lg font-black text-slate-900 mb-1">Department Overview</h4>
                        <p class="text-sm font-bold text-slate-400 px-8">@firstDetail.Message</p>
                    </div>
                }
                else if (detailTotal > 0)
                {
                    <div class="bg-white rounded-none shadow-sm border border-slate-200 quick-grid-container flex flex-col stock-popup-grid">
                        <div class="flex-1 min-h-0 overflow-y-auto">
                            <QuickGrid Items="@DetailsItems.AsQueryable()" class="quick-grid w-full">
                                <PropertyColumn Property="@(x => x.OrderId ?? "-")" Title="Order #" Sortable="true" Class="col-order" />
                                <TemplateColumn Title="Style" SortBy="@(GridSort<DepartmentStockDto>.ByAscending(x => x.StyleNo))" Class="col-style">
                                    <div class="cursor-pointer text-indigo-600 hover:text-indigo-800 hover:underline font-bold transition-colors flex items-center gap-1.5" @onclick="() => ShowStyleDetails(context.StyleNo)">
                                        <i class="fa-solid fa-circle-info text-[10px] opacity-50"></i>
                                        @context.StyleNo
                                    </div>
                                </TemplateColumn>
                                <PropertyColumn Property="@(x => x.Color)" Title="Color" Sortable="true" Class="col-color" />

                                @foreach (var size in DetailsSizeHeaders)
                                {
                                    <TemplateColumn Title="@size" Align="Align.Center" Class="col-size">
                                        @{
                                            var count = context.Sizes.TryGetValue(size, out var val) ? val : 0;
                                        }
                                        <span class="@(count > 0 ? "text-indigo-600 font-bold" : "text-slate-300")">
                                            @(count > 0 ? count.ToString() : "-")
                                        </span>
                                    </TemplateColumn>
                                }

                                <TemplateColumn Align="Align.Right" Class="bg-slate-50/50 font-bold col-total">
                                    <HeaderTemplate>
                                        <div class="w-full">Total</div>
                                    </HeaderTemplate>
                                    <ChildContent>
                                        <div class="w-full">@context.Sizes.Values.Sum()</div>
                                    </ChildContent>
                                </TemplateColumn>
                            </QuickGrid>

                            <!-- Sticky Grand Total Footer (Details Tab) - Moved inside for alignment -->
                            <div class="footer-container shrink-0">
                                <table class="grand-total-table">
                                    <tr>
                                        <td class="footer-label col-order">Total for @SelectedDeptName</td>
                                        <td class="col-style footer-label"></td>
                                        <td class="col-color footer-label"></td>
                                        @foreach (var size in DetailsSizeHeaders)
                                        {
                                            var colTotal = DetailsItems.Sum(x => x.Sizes.ContainsKey(size) ? x.Sizes[size] : 0);
                                            <td class="footer-val-size col-size">@colTotal</td>
                                        }
                                        <td class="footer-val-total col-total">@detailTotal</td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="py-16 text-center">
                        <div class="bg-slate-50 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-3">
                            <i class="fa-solid fa-layer-group text-2xl text-slate-300"></i>
                        </div>
                        <h4 class="text-base font-bold text-slate-900 mb-1">No Data Available</h4>
                        <p class="text-xs text-slate-400">There is currently no stock listed for this department.</p>
                    </div>
                }
            }
        }
             
        
         
    </div>
</DataModal>

<!-- ORDER DETAIL POPUP -->
<DataModal @bind-IsVisible="IsOrderDetailVisible" 
           Title="@($"Order Details - {SelectedOrderNo}")"
           IsLoading="false"
           MaxWidth="1000px"
           ZIndex="2500">
    <div class="h-full flex flex-col overflow-hidden">
        <OrderView Data="@SelectedOrderDetails" IsLoading="IsLoadingOrderDetail" OnStyleSelected="OnStyleSelected" />
    </div>
</DataModal>

<!-- PRICE ANALYSIS POPUP -->
<DataModal @bind-IsVisible="IsAnalysisPopupVisible" 
           Title="@($"Order Price Analysis - {SelectedOrderNo}")"
           BadgeText="@($"Rate: {UsdRate:N2}")"
           IsLoading="IsLoadingAnalysis"
           FullScreen="false" MaxWidth="1400px"
           ZIndex="2500">
    <HeaderExtra>
        <div class="flex items-center gap-2 bg-indigo-50/50 px-3 py-1.5 rounded-full border border-indigo-100 shadow-sm ml-4">
            <span class="text-[10px] font-black text-indigo-400 uppercase tracking-widest">USD Rate</span>
            <input type="number" 
                   @bind="UsdRate" 
                   class="w-20 h-5 text-sm font-black text-indigo-600 bg-transparent border-none focus:ring-0 p-0 text-center" 
                   step="0.01" />
            <button @onclick="() => ShowOrderAnalysis(SelectedOrderNo)" 
                    class="ml-1 text-indigo-500 hover:text-indigo-700 transition-colors p-1"
                    title="Recalculate with new rate">
                <i class="fa-solid fa-arrows-rotate text-xs"></i>
            </button>
        </div>
    </HeaderExtra>
    <ChildContent>
        <div class="h-full flex flex-col overflow-hidden p-2 sm:p-4">
        @if (IsLoadingAnalysis)
        {
            <div class="space-y-4 h-full flex flex-col justify-center">
                <Skeleton Type="Skeleton.SkeletonType.Table" Rows="12" Columns="8" />
            </div>
        }
        else if (AnalysisItems != null && AnalysisItems.Any())
        {
            <div class="bg-white rounded-none shadow-sm border border-slate-200 quick-grid-container flex flex-col h-full overflow-auto">
                <QuickGrid Items="@AnalysisItems.AsQueryable()" class="quick-grid w-full">
                 <PropertyColumn Property="@(x => x.SN)" Title="S.No" Class="text-[10px] max-w-[200px] truncate" />
                    <PropertyColumn Property="@(x => x.ProductName)" Title="Style" Sortable="true" Class="col-style font-black text-slate-800" />
                    <PropertyColumn Property="@(x => x.TotalQuantity)" Title="Qty" Sortable="true" Align="Align.Center" Format="N0" />
                     <PropertyColumn Property="@(x => x.StyleGuage)" Title="Guage" Class="text-[10px] max-w-[200px] truncate" />
                     <PropertyColumn Property="@(x => x.StylePly)" Title="Ply" Class="text-[10px] max-w-[200px] truncate" />
                    <PropertyColumn Property="@(x => x.YarnInfo)" Title="Yarn" Class="text-[10px] max-w-[200px] truncate" />
                    <PropertyColumn Property="@(x => x.NetWet)" Title="Wt(g)" Sortable="true" Align="Align.Right" Format="N2" />
                    
                    <PropertyColumn Property="@(x => x.OverratePerPcUsd)" Title="Overhead" Sortable="true" Align="Align.Right" Format="C2" Class="text-amber-600 font-bold" />
                    <PropertyColumn Property="@(x => x.FinalCostPerPcUsd)" Title="Prod.Cost" Sortable="true" Align="Align.Right" Format="C2" Class="text-blue-600 font-bold" />
                    
                    <PropertyColumn Property="@(x => x.GrandTotalProductionCostUsd)" Title="Total Cost" Sortable="true" Align="Align.Right" Format="C2" Class="bg-slate-50 font-black text-rose-600" />
                    <PropertyColumn Property="@(x => x.TotalRevenueUsd)" Title="SellsAmount" Sortable="true" Align="Align.Right" Format="C2" Class="bg-emerald-50 font-black text-emerald-600" />
                    
                    <TemplateColumn Title=" Gross Profit" Align="Align.Right" Class="font-black">
                        @{
                            var profit = context.TotalRevenueUsd - context.GrandTotalProductionCostUsd;
                        }
                        <span class="@(profit >= 0 ? "text-emerald-600" : "text-rose-600")">
                            @profit.ToString("C2")
                        </span>
                    </TemplateColumn>
                </QuickGrid>
                
                <div class="mt-4 p-3 bg-slate-900 text-white rounded-sm flex justify-between items-center shadow-lg">
                    <div class="flex gap-8">
                        <div>
                            <span class="text-[10px] text-slate-400 uppercase block tracking-widest font-bold">Total Production Cost</span>
                            <span class="text-lg font-black text-rose-400">@AnalysisItems.Sum(x => x.GrandTotalProductionCostUsd).ToString("C2")</span>
                        </div>
                        <div class="w-px h-10 bg-slate-700"></div>
                        <div>
                            <span class="text-[10px] text-slate-400 uppercase block tracking-widest font-bold">Total Revenue</span>
                            <span class="text-lg font-black text-emerald-400">@AnalysisItems.Sum(x => x.TotalRevenueUsd).ToString("C2")</span>
                        </div>
                    </div>
                    <div class="text-right">
                        @{
                            var totalCost = AnalysisItems.Sum(x => x.GrandTotalProductionCostUsd);
                            var totalRev = AnalysisItems.Sum(x => x.TotalRevenueUsd);
                            var totalProfit = totalRev - totalCost;
                        }
                        <span class="text-[10px] text-slate-400 uppercase block tracking-widest font-bold">Estimated Net Profit</span>
                        <span class="text-2xl font-black @(totalProfit >= 0 ? "text-emerald-400" : "text-rose-400")">
                            @totalProfit.ToString("C2")
                        </span>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="py-16 text-center">
                <div class="bg-slate-50 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-3">
                    <i class="fa-solid fa-calculator text-2xl text-slate-300"></i>
                </div>
                <h4 class="text-base font-bold text-slate-900 mb-1">No Analysis Data</h4>
                <p class="text-xs text-slate-400">We couldn't find any pricing details for this order.</p>
            </div>
        }
    </ChildContent>
</DataModal>

