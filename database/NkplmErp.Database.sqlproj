<Project Sdk="Microsoft.Build.Sql/1.0.0">
  <PropertyGroup>
    <Name>NkplmErp.Database</Name>
    <DSP>Microsoft.Data.Tools.Schema.Sql.Sql160DatabaseSchemaProvider</DSP>
    <ModelCollation>1033, CI</ModelCollation>
    <TargetDatabaseSet>True</TargetDatabaseSet>
    <ProjectGuid>{8a528d2a-854d-4b73-b2db-55a4cf6ffb34}</ProjectGuid>
    <EnableDefaultSqlItems>false</EnableDefaultSqlItems>
  </PropertyGroup>
  <ItemGroup>
    <Build Remove="*.sql" />
    <Build Remove="NkplmErp.Migrations/**/*.sql" />
    <Build Include="dbo\Procedure\sp_GetYarnOrders.sql" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="dbo/*" />
    <Folder Include="identity/*" />
    <Folder Include="dbo\Procedure\" />
    <Folder Include="dbo\Table\" />
    <Folder Include="dbo\Script\" />
  </ItemGroup>
  <ItemGroup>
    <Build Include="dbo/**/*.sql" />
    <Build Include="identity/**/*.sql" />
    <!-- One-time data scripts (DML) ship in the repo but are not schema objects, so keep
         them out of the build - SSDT only accepts object definitions as Build items. -->
    <Build Remove="dbo\Script\**\*.sql" />
    <Build Remove="identity\Script\**\*.sql" />
    <None Include="dbo\Script\**\*.sql" />
    <None Include="identity\Script\**\*.sql" />
  </ItemGroup>
</Project>